---
export const prerender = false;
import "../styles/global.css";
const { title = "Platform Admin : ivyticketing" } = Astro.props;
const path = Astro.url.pathname;

function navClass(targetPath: string): string {
  const isActive = path === targetPath || path.startsWith(targetPath + "/");
  return isActive
    ? "flex items-center gap-3 rounded-xl bg-orange-500/10 border border-orange-500/30 px-3.5 py-2.5 text-xs font-bold text-orange-400 shadow-sm"
    : "flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-xs font-semibold text-slate-400 hover:bg-slate-800/80 hover:text-white transition-colors";
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      .font-display {
        font-family: "Oswald", system-ui, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased font-sans overflow-x-hidden">
    <!-- Mobile Top Navigation Bar (Shown on screens < md) -->
    <header class="sticky top-0 z-30 flex md:hidden items-center justify-between border-b border-slate-800 bg-slate-900/95 px-4 py-3 backdrop-blur">
      <div class="flex items-center gap-3">
        <button
          id="admin-sidebar-open-btn"
          type="button"
          class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg border border-slate-700 text-slate-300 hover:bg-slate-800 hover:text-white transition-colors cursor-pointer"
          aria-label="Buka Menu Admin"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <div class="flex items-center gap-2">
          <img src="/images/ivy-icon.svg" alt="IVY" class="h-7 w-7 shrink-0" />
          <span class="font-display text-base font-bold text-white uppercase tracking-tight">
            Ivy<span class="text-orange-500">Admin</span>
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/"
          target="_blank"
          class="min-h-[44px] inline-flex items-center text-xs text-slate-400 hover:text-white px-2 py-1"
          title="Buka Beranda Publik"
        >
          Web &rarr;
        </a>
      </div>
    </header>

    <!-- Mobile Sidebar Drawer Backdrop -->
    <div
      id="admin-sidebar-backdrop"
      class="fixed inset-0 z-40 hidden bg-black/70 backdrop-blur-sm md:hidden transition-opacity"
    ></div>

    <!-- Admin Left Sidebar (Fixed for desktop, drawer for mobile) -->
    <aside
      id="admin-sidebar"
      class="fixed inset-y-0 left-0 z-50 w-64 -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out border-r border-slate-800 bg-[#090f1d] flex flex-col justify-between shadow-2xl"
    >
      <!-- Sidebar Header -->
      <div>
        <div class="flex items-center justify-between border-b border-slate-800/80 px-5 py-4">
          <a href="/admin/warroom" class="flex items-center gap-2.5 group">
            <img src="/images/ivy-icon.svg" alt="IVY" class="h-8 w-8 shrink-0 transition-transform group-hover:scale-105" />
            <div class="flex flex-col">
              <span class="font-display text-lg font-bold tracking-tight text-white uppercase leading-none">
                Ivy<span class="text-orange-500">Ticketing</span>
              </span>
              <span class="text-[10px] font-bold tracking-widest text-slate-400 uppercase mt-0.5">
                Admin Console
              </span>
            </div>
          </a>

          <!-- Mobile Close Button -->
          <button
            id="admin-sidebar-close-btn"
            type="button"
            class="md:hidden min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg text-slate-400 hover:text-white"
            aria-label="Tutup Menu Admin"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Live Server Status Indicator -->
        <div class="mx-4 my-3 rounded-lg border border-emerald-500/20 bg-emerald-950/30 p-2.5 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            <span class="text-[11px] font-semibold text-emerald-400">Platform Online</span>
          </div>
          <span class="font-mono text-[10px] text-slate-400">v2.0.4</span>
        </div>

        <!-- Navigation Menu -->
        <nav class="px-3 py-2 space-y-1" aria-label="Navigasi Admin Utama">
          <p class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-500">
            Website & Platform Utama
          </p>

          <a href="/admin/settings" class={navClass("/admin/settings")}>
            <svg class="h-4 w-4 shrink-0 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Pengaturan Website Utama</span>
          </a>

          <p class="px-3 pt-3 pb-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-500">
            Manajemen Perlombaan
          </p>

          <a href="/admin/events" class={navClass("/admin/events")}>
            <svg class="h-4 w-4 shrink-0 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>Kelola Event & Template</span>
          </a>

          <a href="/admin/warroom" class={navClass("/admin/warroom")}>
            <svg class="h-4 w-4 shrink-0 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>War Room & Antrean</span>
          </a>

          <p class="px-3 pt-3 pb-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-500">
            Peran & Portal Pengguna
          </p>

          <a href="/admin/organizers" class={navClass("/admin/organizers")}>
            <svg class="h-4 w-4 shrink-0 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
            <span>Kelola Penyelenggara & Akun</span>
          </a>

          <a href="/org/ivy-sports/dashboard" class="flex items-center justify-between rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-400 hover:bg-slate-800/80 hover:text-white transition-colors">
            <span class="flex items-center gap-2.5">
              <svg class="h-4 w-4 shrink-0 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <span>Portal Organizer</span>
            </span>
            <span class="rounded bg-sky-950 px-1.5 py-0.5 text-[9px] font-bold text-sky-400 border border-sky-800/40 uppercase">Penyelenggara</span>
          </a>

          <a href="/participant/dashboard" class="flex items-center justify-between rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-400 hover:bg-slate-800/80 hover:text-white transition-colors">
            <span class="flex items-center gap-2.5">
              <svg class="h-4 w-4 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>Portal Peserta / Tiket</span>
            </span>
            <span class="rounded bg-emerald-950 px-1.5 py-0.5 text-[9px] font-bold text-emerald-400 border border-emerald-800/40 uppercase">Pelari</span>
          </a>

          <p class="px-3 pt-3 pb-1.5 text-[10px] font-bold uppercase tracking-widest text-slate-500">
            Infrastruktur & Keuangan
          </p>

          <a href="/admin/status" class={navClass("/admin/status")}>
            <svg class="h-4 w-4 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Status Layanan & Server</span>
          </a>

          <a href="/admin/billing" class={navClass("/admin/billing")}>
            <svg class="h-4 w-4 shrink-0 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            <span>Billing & Paket Organizer</span>
          </a>

          <a href="/admin/payments" class={navClass("/admin/payments")}>
            <svg class="h-4 w-4 shrink-0 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            <span>Gateway & Kanal Bayar</span>
          </a>
        </nav>
      </div>

      <!-- Sidebar Footer / Bottom Actions -->
      <div class="border-t border-slate-800/80 p-4 space-y-3 bg-slate-950/50">
        <a
          href="/"
          target="_blank"
          class="min-h-[44px] flex items-center justify-between rounded-xl border border-slate-800 bg-slate-900/60 px-3.5 py-2 text-xs font-semibold text-slate-300 hover:border-slate-700 hover:text-white transition-colors"
        >
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Lihat Web Publik
          </span>
          <span class="text-[10px] text-slate-500 font-mono">&rarr;</span>
        </a>

        <!-- Admin Identity & Logout Button -->
        <div class="flex items-center justify-between pt-1">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-orange-600 font-display font-bold text-xs text-white">
              AD
            </div>
            <div class="flex flex-col truncate">
              <span class="text-xs font-bold text-white truncate">Super Admin</span>
              <span class="text-[10px] text-slate-400 truncate">admin@ivyticketing.com</span>
            </div>
          </div>

          <button
            id="admin-logout-btn"
            type="button"
            class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg text-slate-400 hover:text-rose-400 hover:bg-rose-950/30 transition-colors cursor-pointer"
            title="Keluar dari Akun Admin"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </button>
        </div>
      </div>
    </aside>

    <!-- Main Content Area with Desktop Left Margin (md:pl-64) -->
    <div class="md:pl-64 flex flex-col min-h-screen w-full min-w-0 overflow-x-hidden">
      <slot />
    </div>

    <!-- Client Script: Auth Verification & Mobile Sidebar Drawer Toggle -->
    <script>
      import { getToken, logout } from "../lib/auth";
      import { authedFetch } from "../lib/api";

      if (!getToken()) {
        window.location.href = "/login";
      } else {
        // Verifikasi izin platform admin
        authedFetch<any>("/auth/me")
          .then((me) => {
            if (!me.user?.isPlatformAdmin) {
              window.location.href = "/participant/dashboard";
            }
          })
          .catch(() => {
            window.location.href = "/login";
          });
      }

      document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
        await logout();
        window.location.href = "/login";
      });

      // Mobile Sidebar Drawer Toggle
      const openBtn = document.getElementById("admin-sidebar-open-btn");
      const closeBtn = document.getElementById("admin-sidebar-close-btn");
      const sidebar = document.getElementById("admin-sidebar");
      const backdrop = document.getElementById("admin-sidebar-backdrop");

      function openSidebar() {
        sidebar?.classList.remove("-translate-x-full");
        backdrop?.classList.remove("hidden");
      }

      function closeSidebar() {
        sidebar?.classList.add("-translate-x-full");
        backdrop?.classList.add("hidden");
      }

      openBtn?.addEventListener("click", openSidebar);
      closeBtn?.addEventListener("click", closeSidebar);
      backdrop?.addEventListener("click", closeSidebar);
    </script>
  </body>
</html>
