---
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout title="Daftar Akun Baru : ivyticketing">
  <div class="mx-auto max-w-md py-10 px-4">
    <div class="mb-8 text-center">
      <a href="/" class="inline-flex items-center gap-2 group mb-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-orange-600 font-bold text-lg text-white shadow-md shadow-orange-600/30 group-hover:bg-orange-500 transition-colors">
          IVY
        </span>
      </a>
      <h1 class="text-2xl font-bold text-slate-900 tracking-tight">Daftar Akun Atlet</h1>
      <p class="mt-1 text-sm text-slate-600">
        Buat akun untuk pendaftaran lomba, pantau nomor BIB, dan unduh sertifikat finisher.
      </p>
    </div>

    <form id="register-form" class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="fullName">
          Nama Lengkap <span class="text-red-500">*</span>
        </label>
        <input
          id="fullName"
          type="text"
          required
          autocomplete="name"
          placeholder="Nama sesuai kartu identitas / KTP"
          class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="email">
          Alamat Email <span class="text-red-500">*</span>
        </label>
        <input
          id="email"
          type="email"
          required
          autocomplete="email"
          placeholder="nama@email.com"
          class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="phone">
          Nomor WhatsApp / Seluler
        </label>
        <input
          id="phone"
          type="tel"
          autocomplete="tel"
          placeholder="081234567890"
          class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="password">
          Kata Sandi <span class="text-red-500">*</span>
        </label>
        <input
          id="password"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          placeholder="Minimal 8 karakter"
          class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
        />
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="confirmPassword">
          Konfirmasi Kata Sandi <span class="text-red-500">*</span>
        </label>
        <input
          id="confirmPassword"
          type="password"
          required
          minlength="8"
          autocomplete="new-password"
          placeholder="Ulangi kata sandi"
          class="min-h-[44px] w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
        />
      </div>

      <div class="flex items-start gap-2 pt-1">
        <input
          id="terms"
          type="checkbox"
          required
          class="mt-1 h-4 w-4 rounded border-slate-300 text-orange-600 focus:ring-orange-500"
        />
        <label for="terms" class="text-xs text-slate-600 leading-snug cursor-pointer">
          Saya menyetujui ketentuan pendaftaran dan perlindungan data pribadi atlet IvyTicketing.
        </label>
      </div>

      <p id="error" class="text-sm font-medium text-red-600 hidden rounded bg-red-50 p-2.5 border border-red-200"></p>

      <button
        id="submit-btn"
        type="submit"
        class="min-h-[44px] w-full rounded-lg bg-orange-600 px-4 py-2.5 text-sm font-bold uppercase tracking-wider text-white shadow hover:bg-orange-500 active:scale-[0.99] transition-all disabled:opacity-50 flex items-center justify-center gap-2 cursor-pointer"
      >
        Daftar Akun Baru
      </button>

      <div class="pt-3 border-t border-slate-100 text-center text-xs text-slate-600">
        Sudah memiliki akun?
        <a href="/login" class="font-bold text-orange-600 hover:text-orange-700 underline underline-offset-2 ml-1">
          Masuk di sini
        </a>
      </div>
    </form>
  </div>

  <script>
    import { register, getMe } from "../lib/auth";

    const form = document.getElementById("register-form") as HTMLFormElement;
    const btn = document.getElementById("submit-btn") as HTMLButtonElement;
    const errEl = document.getElementById("error") as HTMLParagraphElement;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errEl.classList.add("hidden");

      const fullName = (document.getElementById("fullName") as HTMLInputElement).value.trim();
      const email = (document.getElementById("email") as HTMLInputElement).value.trim();
      const phone = (document.getElementById("phone") as HTMLInputElement).value.trim();
      const password = (document.getElementById("password") as HTMLInputElement).value;
      const confirmPassword = (document.getElementById("confirmPassword") as HTMLInputElement).value;
      const termsAccepted = (document.getElementById("terms") as HTMLInputElement).checked;

      if (!fullName || !email || !password) {
        errEl.textContent = "Nama lengkap, email, dan kata sandi wajib diisi.";
        errEl.classList.remove("hidden");
        return;
      }

      if (password.length < 8) {
        errEl.textContent = "Kata sandi harus terdiri dari minimal 8 karakter.";
        errEl.classList.remove("hidden");
        return;
      }

      if (password !== confirmPassword) {
        errEl.textContent = "Konfirmasi kata sandi tidak cocok dengan kata sandi.";
        errEl.classList.remove("hidden");
        return;
      }

      if (!termsAccepted) {
        errEl.textContent = "Anda wajib menyetujui ketentuan pendaftaran untuk melanjutkan.";
        errEl.classList.remove("hidden");
        return;
      }

      btn.disabled = true;
      btn.textContent = "Mendaftarkan Akun...";

      try {
        await register(fullName, email, password, phone);
        const me = await getMe();

        // Cek parameter redirect jika ada (misal dari checkout event)
        const params = new URLSearchParams(window.location.search);
        const redirectUrl = params.get("redirect");
        if (redirectUrl && redirectUrl.startsWith("/")) {
          window.location.href = redirectUrl;
          return;
        }

        if (me?.user?.isPlatformAdmin) {
          window.location.href = "/admin/warroom";
        } else if (me?.memberships && me.memberships.length > 0) {
          const orgId = me.memberships[0].organizationId;
          window.location.href = `/org/${orgId}/dashboard`;
        } else {
          window.location.href = "/participant/dashboard";
        }
      } catch (err) {
        btn.disabled = false;
        btn.textContent = "Daftar Akun Baru";
        const msg = (err as Error).message || "";
        if (msg.includes("Failed to fetch") || msg.includes("NetworkError")) {
          errEl.textContent = "Gagal terhubung ke server API. Pastikan server aktif dan port dapat diakses.";
        } else {
          errEl.textContent = msg || "Gagal melakukan pendaftaran. Silakan coba lagi.";
        }
        errEl.classList.remove("hidden");
      }
    });
  </script>
</PublicLayout>
