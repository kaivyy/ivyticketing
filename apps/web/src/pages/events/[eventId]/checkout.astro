          </button>
        </div>
      </div>
    `;

    document.body.appendChild(modal);

    const closeModal = () => modal.remove();
    document.getElementById("btn-close-modal")?.addEventListener("click", closeModal);
    document.getElementById("btn-edit-data")?.addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
    const handleEsc = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        closeModal();
        window.removeEventListener("keydown", handleEsc);
      }
    };
    window.addEventListener("keydown", handleEsc);

    document.getElementById("btn-confirm-submit")?.addEventListener("click", () => {
      closeModal();
      onConfirmed(athlete);
    });
  }

  // ── Step 1: Render Athlete Information Form ────────────────────────────────
  async function renderAthleteForm(
    event: MarathonEvent,
    category: MarathonCategory,
    theme: TemplateTheme,
    onComplete: (data: AthleteData) => void
  ) {
    const isBallot = urlMode === "BALLOT" || category.mode === "BALLOT";
    setStep(2, theme);

    let customFields: any[] = [];
    try {
      const publicForm = await fetchPublicForm(event.id);
      if (publicForm && Array.isArray(publicForm.fields) && publicForm.fields.length > 0) {
        customFields = publicForm.fields;
      }
    } catch {
      // fallback
    }

    if (customFields.length === 0 && event.customFormConfig?.fields?.length) {
      customFields = event.customFormConfig.fields;
    }

    const applicableCustomFields = customFields.filter((f: any) => {
      if (!f.categoryScope || f.categoryScope.length === 0) return true;
      return f.categoryScope.includes(category.id) || f.categoryScope.includes(category.code);
    });

    const customFieldsHtml = applicableCustomFields.length === 0 ? "" : `
      <!-- Section 4: Formulir Kustom Penyelenggara -->
      <div class="space-y-3 pt-3 border-t border-slate-100">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 flex items-center gap-2">
          <span class="h-2 w-2 rounded-full" style="background-color: ${theme.primaryColor};"></span>
          <span>4. Informasi Tambahan Penyelenggara</span>
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          ${applicableCustomFields.map((f: any) => {
            const fieldKey = f.fieldKey || f.id;
            const inputName = "custom_" + fieldKey;
            const reqStar = f.isRequired ? " *" : "";
            const reqAttr = f.isRequired ? "required" : "";
            const help = f.helpText ? `<p class="text-[10px] text-slate-400 mt-1">${escapeHtml(f.helpText)}</p>` : "";

            if (f.fieldType === "textarea") {
              return `
                <div class="sm:col-span-2">
                  <label for="${inputName}" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                    ${escapeHtml(f.label)}${reqStar}
                  </label>
                  <textarea
                    id="${inputName}"
                    name="${inputName}"
                    ${reqAttr}
                    rows="2"
                    class="w-full rounded-lg border border-slate-300 px-3.5 py-2 text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:outline-hidden focus:ring-2"
                    style="--tw-ring-color: ${theme.ringColor};"
                  ></textarea>
                  ${help}
                </div>
              `;
            }

            if (f.fieldType === "select" && Array.isArray(f.options) && f.options.length > 0) {
              return `
                <div>
                  <label for="${inputName}" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                    ${escapeHtml(f.label)}${reqStar}
                  </label>
                  <select
                    id="${inputName}"
                    name="${inputName}"
                    ${reqAttr}
                    class="w-full min-h-[44px] rounded-lg border border-slate-300 px-3.5 py-2 text-xs font-medium text-slate-900 focus:outline-hidden focus:ring-2 bg-white"
