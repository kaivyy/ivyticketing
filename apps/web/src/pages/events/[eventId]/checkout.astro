    // Live BIB character counter
    const bibInput = document.getElementById("bibName") as HTMLInputElement | null;
    const bibCount = document.getElementById("bib-char-count");
    if (bibInput && bibCount) {
      bibCount.textContent = `${bibInput.value.length}/12`;
      bibInput.addEventListener("input", () => {
        bibCount.textContent = `${bibInput.value.length}/12`;
      });
    }

    // Change category button
    const handleChangeCategory = () => {
      currentStep = "picker";
      categoryId = "";
      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.delete("categoryId");
      nextUrl.searchParams.set("step", "picker");
      history.replaceState({}, "", nextUrl.toString());
      renderCategoryPicker(event, theme);
    };
    document.getElementById("btn-change-category")?.addEventListener("click", handleChangeCategory);
    document.getElementById("btn-back-to-categories")?.addEventListener("click", handleChangeCategory);

    // Form submit listener
    const form = document.getElementById("athlete-form") as HTMLFormElement | null;
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      const customData: Record<string, any> = {};
      for (const [key, val] of formData.entries()) {
        if (key.startsWith("custom_")) {
          const fieldKey = key.slice(7);
          customData[fieldKey] = val;
        }
      }

      const athlete: AthleteData = {
        fullName: String(formData.get("fullName") || "").trim(),
        bibName: String(formData.get("bibName") || "").trim().toUpperCase(),
        idNumber: String(formData.get("idNumber") || "").trim(),
        gender: (formData.get("gender") as "MALE" | "FEMALE") || "MALE",
        birthDate: String(formData.get("birthDate") || ""),
        bloodType: String(formData.get("bloodType") || "O"),
        province: String(formData.get("province") || "DKI Jakarta"),
        city: String(formData.get("city") || "").trim(),
        phone: String(formData.get("phone") || "").trim(),
        email: String(formData.get("email") || "").trim().toLowerCase(),
        emergencyName: String(formData.get("emergencyName") || "").trim(),
        emergencyPhone: String(formData.get("emergencyPhone") || "").trim(),
        emergencyRelation: String(formData.get("emergencyRelation") || "Keluarga"),
        jerseySize: String(formData.get("jerseySize") || "M"),
        runningClub: String(formData.get("runningClub") || "").trim(),
        medicalNotes: String(formData.get("medicalNotes") || "").trim(),
        customFields: customData,
        ...customData,
      };

      saveAthlete(athlete);
      showReviewConfirmationModal(event, category, athlete, isBallot, theme, onComplete);
    });
  }

