  // ── Step 2: Render Payment Method Selection & Checkout Order ────────────────
  async function renderOrder(
    order: Awaited<ReturnType<typeof fetchOrder>>,
    athlete: AthleteData | null,
    theme: TemplateTheme
  ) {
    setStep(3, theme);
    const expired = order.expiredAt && new Date(order.expiredAt) < new Date();
    const canPay = (order.status === "PENDING" || order.status === "AWAITING_PAYMENT") && !expired;
    const currentAthlete = athlete || getStoredAthlete();

    await syncEventPaymentChannelsFromServer(eventId);

    const paymentSettings = getPaymentSettings();
    const availableChannels = getActiveChannelsForEvent(eventId);
    const activeGateway = paymentSettings.activeGateway || "xendit";

    let selectedChannel = availableChannels[0] || {
      code: "qris",
      name: "QRIS",
      method: "qris",
      channel: "qris",
      category: "qris",
      fee: 0,
      badge: "Instan",
      badgeBg: "bg-emerald-100",
      badgeFg: "text-emerald-800",
      logo: "QRIS",
      description: "Scan instan lewat GoPay, OVO, Dana, BCA, Livin Mandiri",
    };

    function calculateTotal(): number {
      const discount = order.discount || 0;
      return order.subtotal + (selectedChannel?.fee || 0) - discount;
    }

    function renderOrderContent() {
      const totalAmount = calculateTotal();

      root.innerHTML = `
        <div class="max-w-4xl mx-auto space-y-4 sm:space-y-5">
          <!-- Order Confirmation Card -->
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Kode Pesanan Resmi</span>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="font-mono text-base font-black text-slate-900">${escapeHtml(order.orderNumber || order.id)}</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-amber-100 text-amber-800">Menunggu Pembayaran</span>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button
                type="button"
                id="btn-copy-order-link"
                class="min-h-[44px] px-3.5 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs uppercase tracking-wider transition-colors shrink-0"
              >
                <span id="copy-link-label">Salin Link Pesanan</span>
              </button>
            </div>
          </div>

          <!-- Verified Athlete Bar -->
          ${currentAthlete ? `
            <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-4 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div class="flex items-center gap-2.5">
                <span class="h-6 w-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">✓</span>
                <div>
                  <span class="font-bold text-slate-900">${escapeHtml(currentAthlete.fullName)}</span>
                  <span class="text-slate-500 font-mono ml-2">BIB: ${escapeHtml(currentAthlete.bibName)}</span>
                </div>
              </div>
              <span class="text-slate-500 font-mono">${escapeHtml(currentAthlete.email)}</span>
            </div>
          ` : ""}

          <!-- Payment Channels Selector Card -->
          <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs space-y-4">
            <div class="border-b border-slate-100 pb-3">
              <h3 class="text-sm sm:text-base font-bold text-slate-900 uppercase tracking-tight">
                Pilih Kanal Pembayaran Resmi
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">
                Transaksi aman dan diverifikasi secara otomatis dalam hitungan detik.
              </p>
            </div>

            <!-- Channel Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="radiogroup">
              ${availableChannels.map((c) => {
                const isSelected = selectedChannel?.code === c.code;
                return `
                  <div
                    class="channel-card cursor-pointer min-h-[52px] rounded-xl border p-3.5 transition-all flex flex-col justify-between ${
                      isSelected
                        ? 'ring-2'
                        : 'border-slate-200 bg-white hover:border-slate-300'
                    }"
                    style="${isSelected ? `border-color: ${theme.primaryColor}; box-shadow: 0 0 0 2px ${theme.ringColor}; background-color: ${theme.lightBg};` : ''}"
                    data-channel-code="${c.code}"
                    role="radio"
                    aria-checked="${isSelected}"
                    tabindex="0"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase tracking-wider ${c.badgeBg || 'bg-slate-100'} ${c.badgeFg || 'text-slate-800'}">
                          ${c.logo || c.name}
                        </span>
                        <span class="font-bold text-xs text-slate-900">${c.name}</span>
                      </div>
                      <span class="h-4 w-4 rounded-full border flex items-center justify-center text-[10px] font-bold ${
                        isSelected ? 'bg-slate-900 text-white border-slate-900' : 'border-slate-300 bg-white'
                      }">
                        ${isSelected ? '✓' : ''}
                      </span>
                    </div>

                    <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
                      <span class="text-slate-500 text-[11px]">${c.description || 'Proses Instan'}</span>
                      <span class="font-mono font-bold text-slate-900">
                        ${c.fee > 0 ? fmt(c.fee) : '<span class="text-emerald-700">Bebas Biaya</span>'}
                      </span>
                    </div>
                  </div>
                `;
              }).join("")}
            </div>

            <!-- Price Breakdown Summary -->
            <div class="rounded-xl bg-slate-50 p-4 space-y-2 text-xs border border-slate-200">
              <div class="flex justify-between text-slate-600">
                <span>Subtotal Tiket Lomba</span>
                <span class="font-mono font-bold text-slate-900">${fmt(order.subtotal)}</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>Biaya Layanan (${selectedChannel ? selectedChannel.name : 'Kanal'})</span>
                <span class="font-mono font-bold text-slate-900">
                  ${selectedChannel && selectedChannel.fee > 0 ? fmt(selectedChannel.fee) : '<span class="text-emerald-700">GRATIS</span>'}
                </span>
              </div>
              <div class="border-t border-slate-200 pt-2 flex justify-between items-baseline font-bold text-slate-950">
                <span class="text-xs sm:text-sm">Total Tagihan Pembayaran</span>
                <span class="text-base sm:text-xl font-mono font-black" style="color: ${theme.primaryText === '#ffffff' ? theme.primaryColor : '#0f172a'};">
                  ${fmt(totalAmount)}
                </span>
              </div>
            </div>

            <p id="pay-error" class="text-red-600 text-xs font-medium hidden" role="alert"></p>

            ${canPay ? `
              <button
                id="btn-pay"
                type="button"
                class="w-full min-h-[48px] rounded-xl font-bold uppercase tracking-wider text-xs sm:text-sm transition-all shadow-md active:scale-[0.99] flex items-center justify-center gap-2"
                style="background-color: ${theme.primaryColor}; color: ${theme.primaryText};"
              >
                <span>Bayar Sekarang: ${fmt(totalAmount)}</span>
                <span>→</span>
              </button>
            ` : order.status === "PAID" ? `
              <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-6 text-center space-y-2">
                <p class="text-base font-bold text-emerald-800">Pembayaran Berhasil Dikonfirmasi!</p>
                <a href="/participant/orders/${order.id}" class="inline-block min-h-[44px] rounded-xl bg-slate-900 px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-slate-800 transition-colors">
                  Lihat E-Tiket Resmi Saya
                </a>
              </div>
            ` : `
              <p class="text-slate-500 text-xs text-center">Status Pesanan: ${order.status}</p>
            `}
          </div>
        </div>
      `;

      // Copy order URL handler
      document.getElementById("btn-copy-order-link")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const label = document.getElementById("copy-link-label");
          if (label) label.textContent = "Link Disalin!";
          setTimeout(() => {
            if (label) label.textContent = "Salin Link Pesanan";
          }, 2000);
        } catch {
          // fallback
        }
      });

      // Channel card selection
      document.querySelectorAll<HTMLElement>(".channel-card").forEach((card) => {
        const selectCard = () => {
          const code = card.dataset.channelCode;
          const match = availableChannels.find((c) => c.code === code);
          if (match) {
            selectedChannel = match;
            renderOrderContent();
          }
        };
        card.addEventListener("click", selectCard);
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            selectCard();
          }
        });
      });

      // Payment trigger button
      const payBtn = document.getElementById("btn-pay") as HTMLButtonElement | null;
      payBtn?.addEventListener("click", async () => {
        payBtn.disabled = true;
        payBtn.innerHTML = `
          <span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent"></span>
          <span>Menyiapkan Instruksi Pembayaran...</span>
        `;
        const errEl = document.getElementById("pay-error")!;
        errEl.classList.add("hidden");

        try {
          const payment = await initiatePayment(order.id, {
            gateway: activeGateway,
            method: selectedChannel.method,
            channel: selectedChannel.channel,
          });

          if (payment.payUrl && !payment.vaNumber && !payment.qrString) {
            window.location.href = payment.payUrl;
            return;
          }

          renderPaymentPresentation(order, payment, selectedChannel, currentAthlete, theme);
        } catch (err: unknown) {
          payBtn.disabled = false;
          payBtn.innerHTML = `<span>Bayar Sekarang: ${fmt(totalAmount)}</span> <span>→</span>`;
          errEl.textContent = err instanceof Error ? err.message : "Gagal memulai pembayaran.";
          errEl.classList.remove("hidden");
        }
      });
    }

    renderOrderContent();
  }

  // ── Render Step 2.5: Interactive In-App Payment Instructions ───────────────
  function renderPaymentPresentation(
    order: Awaited<ReturnType<typeof fetchOrder>>,
    payment: Awaited<ReturnType<typeof initiatePayment>>,
    channel: PaymentChannelConfig,
    athlete: AthleteData | null,
    theme: TemplateTheme
  ) {
    setStep(3, theme);

    let pollInterval: ReturnType<typeof setInterval> | null = null;
    let countdownInterval: ReturnType<typeof setInterval> | null = null;

    let remainingSeconds = 15 * 60;
    if (payment.expiresAt) {
      const expTime = new Date(payment.expiresAt).getTime();
      const diff = Math.floor((expTime - Date.now()) / 1000);
      if (diff > 0) remainingSeconds = diff;
    }

    function formatTime(sec: number): string {
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    }

    const totalToPay = order.subtotal + (channel.fee || 0) - (order.discount || 0);

    root.innerHTML = `
      <div class="max-w-2xl mx-auto space-y-5">
        <!-- Timer Banner -->
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 shadow-xs flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">⏳</span>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-900 block">Menunggu Pembayaran</span>
              <p class="text-[11px] text-amber-700">Selesaikan transaksi sebelum batas waktu habis.</p>
            </div>
          </div>
          <div class="text-right">
            <span class="text-[10px] uppercase font-bold text-amber-800 block">Sisa Waktu</span>
            <span class="font-mono text-lg font-black text-amber-900" id="countdown-timer">
              ${formatTime(remainingSeconds)}
            </span>
          </div>
        </div>

        <!-- Payment Card -->
        <div class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xs space-y-5">
          <div class="flex justify-between items-center border-b border-slate-100 pb-3">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Metode Pembayaran</span>
              <span class="text-sm font-bold text-slate-900">${escapeHtml(channel.name)}</span>
            </div>
            <div class="text-right">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Total Tagihan</span>
              <span class="text-base sm:text-lg font-mono font-black" style="color: ${theme.primaryText === '#ffffff' ? theme.primaryColor : '#0f172a'};">
                ${fmt(totalToPay)}
              </span>
            </div>
          </div>

          <!-- Channel Variant: QRIS -->
          ${channel.method === "qris" ? `
            <div class="text-center space-y-4">
              <div class="inline-block rounded-2xl border-2 border-slate-200 bg-white p-4 shadow-xs">
                <canvas id="qris-canvas" class="mx-auto rounded-lg" width="220" height="220"></canvas>
                <div class="mt-2 pt-2 border-t border-slate-100 text-[10px] font-bold uppercase text-slate-500">
                  NMID: ID1020038918290
                </div>
              </div>

              <div>
                <button
                  id="btn-download-qr"
                  type="button"
                  class="inline-flex items-center gap-2 min-h-[44px] rounded-xl border border-slate-300 bg-white px-5 py-2 text-xs font-bold uppercase tracking-wider text-slate-800 hover:bg-slate-50 transition-colors shadow-xs"
                >
                  <span>📥</span>
                  <span>Unduh Gambar QRIS</span>
                </button>
              </div>

              <div class="rounded-xl bg-slate-50 border border-slate-200 p-3.5 text-xs text-slate-600 max-w-md mx-auto text-left space-y-1">
                <span class="font-bold text-slate-800 block text-[11px] uppercase">Panduan Scan QRIS:</span>
                <p>1. Buka aplikasi m-Banking (BCA, Mandiri, BRI, BNI) atau E-Wallet (GoPay, OVO, Dana, ShopeePay).</p>
                <p>2. Pilih menu Bayar / Scan QR, lalu scan kode QR di atas.</p>
                <p>3. Periksa nama merchant (IVYTICKETING) dan konfirmasi pembayaran.</p>
              </div>
            </div>
          ` : `
            <!-- Channel Variant: Virtual Account -->
            <div class="space-y-4">
              <div class="rounded-xl bg-slate-50 border border-slate-200 p-4 text-center space-y-2">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Nomor Virtual Account</span>
                <div class="font-mono text-xl sm:text-2xl font-black text-slate-900 tracking-wider select-all" id="va-display-text">
                  ${escapeHtml(payment.vaNumber || "8277081294810294")}
                </div>
                <button
                  id="btn-copy-va"
                  type="button"
                  class="inline-flex items-center gap-1.5 min-h-[44px] px-4 rounded-lg bg-white border border-slate-300 text-xs font-bold uppercase tracking-wider text-slate-800 hover:bg-slate-100 transition-colors"
                >
                  <span id="copy-va-icon">📋</span>
                  <span id="copy-va-label">Salin Nomor VA</span>
                </button>
              </div>
            </div>
          `}

          <!-- Live Status Polling Indicator -->
          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span class="text-slate-500" id="poll-indicator">Menunggu transfer...</span>
            </div>
            <button
              type="button"
              id="btn-manual-check"
              class="min-h-[44px] px-3 font-bold text-xs uppercase tracking-wider underline text-slate-700 hover:text-slate-900"
            >
              Cek Status Sekarang
            </button>
          </div>
        </div>
      </div>
    `;

    // Render QRIS canvas if applicable
    if (channel.method === "qris") {
      const canvas = document.getElementById("qris-canvas") as HTMLCanvasElement | null;
      const qrData = payment.qrString || `00020101021226600016ID.CO.QRIS.WWW011893600918000000000102150000000000000000303UMI51440014ID.GO.BI.QRIS011893600918000000000102150000000000000000520458125303360540${totalToPay}5802ID5912IVYTICKETING6007JAKARTA62070703A016304`;
      if (canvas) {
        import("qrcode").then((mod) => {
          const qr = mod.default || mod;
          qr.toCanvas(canvas, qrData, { width: 220, margin: 1 });
        }).catch((err) => {
          console.warn("Gagal render QRIS:", err);
        });
      }

      document.getElementById("btn-download-qr")?.addEventListener("click", () => {
        if (!canvas) return;
        const link = document.createElement("a");
        link.download = `QRIS-${order.orderNumber || order.id}.png`;
        link.href = canvas.toDataURL("image/png");
        link.click();
      });
    }

    // Copy VA handler
    document.getElementById("btn-copy-va")?.addEventListener("click", async () => {
      const va = payment.vaNumber || "8277081294810294";
      try {
        await navigator.clipboard.writeText(va);
        const label = document.getElementById("copy-va-label");
        const icon = document.getElementById("copy-va-icon");
        if (label) label.textContent = "Nomor VA Disalin!";
        if (icon) icon.textContent = "✓";
        setTimeout(() => {
          if (label) label.textContent = "Salin Nomor VA";
          if (icon) icon.textContent = "📋";
        }, 2000);
      } catch {
        // fallback
      }
    });

    // Countdown interval
    const timerEl = document.getElementById("countdown-timer");
    countdownInterval = setInterval(() => {
      remainingSeconds--;
      if (remainingSeconds <= 0) {
        clearInterval(countdownInterval!);
        if (timerEl) timerEl.textContent = "00:00";
      } else if (timerEl) {
        timerEl.textContent = formatTime(remainingSeconds);
      }
    }, 1000);

    // Payment success handler
    function handlePaymentSuccess() {
      if (pollInterval) clearInterval(pollInterval);
      if (countdownInterval) clearInterval(countdownInterval);
      setStep(3, theme);

      root.innerHTML = `
        <div class="max-w-2xl mx-auto space-y-5 text-center">
          <div class="rounded-2xl border border-emerald-300 bg-white p-6 sm:p-8 shadow-xs space-y-5">
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 text-3xl font-bold">
              ✓
            </div>

            <div class="space-y-1">
              <span class="inline-block rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-emerald-800">
                Lunas & Terverifikasi
              </span>
              <h2 class="text-xl sm:text-2xl font-black text-slate-900 uppercase tracking-tight">
                Pembayaran Berhasil Dikonfirmasi!
              </h2>
              <p class="text-xs text-slate-500 max-w-md mx-auto">
                Registrasi resmi Anda telah tervalidasi. Nomor dada BIB dan E-Tiket Anda siap digunakan. Detail juga telah dikirimkan ke <strong>${escapeHtml(athlete?.email || "email Anda")}</strong>.
              </p>
            </div>

            <!-- Official BIB Runner Pass Card -->
            ${athlete ? `
              <div class="max-w-sm mx-auto rounded-xl border-2 border-slate-900 bg-slate-950 text-white p-5 text-left space-y-3 shadow-md">
                <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                  <span class="text-[10px] font-bold uppercase tracking-wider" style="color: ${theme.subColor};">Official Runner Pass</span>
                  <span class="text-[10px] font-mono text-slate-400">${order.orderNumber || order.id}</span>
                </div>
                <div class="flex items-baseline justify-between">
                  <div>
                    <span class="text-[10px] text-slate-400 block uppercase font-bold">Nama Dada BIB</span>
                    <span class="font-mono text-xl font-black text-white uppercase">${escapeHtml(athlete.bibName)}</span>
                  </div>
                  <div class="text-right">
                    <span class="text-[10px] text-slate-400 block uppercase font-bold">Jersey Finisher</span>
                    <span class="font-bold text-white">${escapeHtml(athlete.jerseySize)}</span>
                  </div>
                </div>
                <div class="border-t border-slate-800 pt-2 text-xs text-slate-300">
                  Peserta: <strong class="text-white">${escapeHtml(athlete.fullName)}</strong>
                </div>
              </div>
            ` : ""}

            <div class="pt-2 flex flex-col sm:flex-row justify-center gap-3">
              <a
                href="/participant/orders/${order.id}"
                class="inline-flex items-center justify-center min-h-[48px] rounded-xl px-8 py-2.5 text-xs font-bold uppercase tracking-wider transition-all shadow-md"
                style="background-color: ${theme.primaryColor}; color: ${theme.primaryText};"
              >
                Buka E-Tiket Resmi Saya →
              </a>
              <a
                href="/events/${eventId}"
                class="inline-flex items-center justify-center min-h-[48px] rounded-xl border border-slate-300 bg-white hover:bg-slate-50 px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-slate-700 transition-colors"
              >
                Kembali ke Event
              </a>
            </div>
          </div>
        </div>
      `;
    }

    async function checkStatus() {
      const pollInd = document.getElementById("poll-indicator");
      if (pollInd) pollInd.textContent = "Memverifikasi transfer...";
      try {
        const latestOrder = await fetchOrder(order.id);
        if (latestOrder.status === "PAID") {
          handlePaymentSuccess();
          return;
        }
      } catch {
        // network
      }
      if (pollInd) pollInd.textContent = "Menunggu transfer...";
    }

    document.getElementById("btn-manual-check")?.addEventListener("click", checkStatus);
    pollInterval = setInterval(checkStatus, 3000);
  }

  // ── Main Controller Orchestrator ───────────────────────────────────────────
  async function run() {
    // 1. If an active orderId is supplied in URL query, resume order payment directly
    if (orderId) {
      try {
        const order = await fetchOrder(orderId);
        const event = getMarathonEventById(eventId);
        const theme = event ? getTemplateTheme(event) : {
          templateId: "template-summarecon",
          navBg: "rgba(11, 15, 25, 0.98)",
          navBorder: "rgba(139, 92, 246, 0.35)",
          badgeBg: "#8b5cf6",
          badgeText: "#ffffff",
          badgeLabel: "SMR",
          brandTitle: "Pendaftaran Event",
          subText: "SUMMARECON NIGHT RUN FESTIVAL",
          subColor: "#a78bfa",
          primaryColor: "#8b5cf6",
          primaryHover: "#7c3aed",
          primaryText: "#ffffff",
          accentColor: "#a78bfa",
          lightBg: "rgba(139, 92, 246, 0.08)",
          ringColor: "#8b5cf6",
        };
        syncNavbarWithTemplate(theme);
        await renderOrder(order, getStoredAthlete(), theme);
      } catch (e) {
        showError("Pesanan tidak ditemukan atau tautan telah kedaluwarsa.");
      }
      return;
    }

    // 2. Load event configuration
    const currentEvent = getMarathonEventById(eventId);
    if (!currentEvent) {
      showError("Event tidak ditemukan atau belum dipublikasikan.");
      return;
    }

    // Synchronize navbar theme
    const theme = getTemplateTheme(currentEvent);
    syncNavbarWithTemplate(theme);

    // 3. Category & Queue routing logic
    const selectedCategory = categoryId
      ? currentEvent.categories.find(
          (c) => c.id === categoryId || c.code.toLowerCase() === categoryId.toLowerCase()
        )
      : null;

    const qCfg = currentEvent.layoutConfig?.queueConfig;
    const queueMode = qCfg?.mode || "auto";
    const trafficThreshold = qCfg?.trafficThreshold ?? 50;
    const activeWaiting = qCfg?.activeWaitingCount ?? 0;

    // A. If no category is selected or user clicked change category
    if (!selectedCategory || currentStep === "picker") {
      const isAnyWarQueue = currentEvent.categories.some((c) => c.mode === "WAR_QUEUE");
      const shouldQueueEvent = isAnyWarQueue && (
        queueMode === "always_queue" ||
        (queueMode === "auto" && activeWaiting >= trafficThreshold)
      ) && !admission && !grantToken;

      if (shouldQueueEvent) {
        window.location.href = `/events/${encodeURIComponent(eventId)}/queue`;
        return;
      }

      currentStep = "picker";
      renderCategoryPicker(currentEvent, theme);
      return;
    }

    // B. Category is selected: Check if category requires waiting in queue
    const isWarQueue = selectedCategory.mode === "WAR_QUEUE";
    const shouldQueueCategory = isWarQueue && (
      queueMode === "always_queue" ||
      (queueMode === "auto" && activeWaiting >= trafficThreshold)
    ) && !admission && !grantToken;

    if (shouldQueueCategory) {
      window.location.href = `/events/${encodeURIComponent(eventId)}/queue?categoryId=${encodeURIComponent(selectedCategory.id)}`;
      return;
    }

    // C. Direct access to Athlete Form (NORMAL, BALLOT, or WAR with calm traffic / 0 waiting users)
    currentStep = "form";
    const isBallot = urlMode === "BALLOT" || selectedCategory.mode === "BALLOT";

    // 5. Handle athlete submission
    async function handleAthleteSubmitted(athlete: AthleteData) {
      if (isBallot) {
        const drawNumber = `BAL-2026-${Math.floor(10000 + Math.random() * 90000)}`;
        try {
          const ballotRecord = {
            drawNumber,
            eventId,
            categoryId: selectedCategory!.id,
            categoryName: selectedCategory!.name,
            athlete,
            status: "PENDING_DRAW",
            createdAt: new Date().toISOString(),
          };
          localStorage.setItem(`ivy_ballot_${drawNumber}`, JSON.stringify(ballotRecord));
        } catch {
          // storage quota
        }
        renderBallotConfirmation(currentEvent!, selectedCategory!, athlete, drawNumber, theme);
        return;
      }

      root.innerHTML = `
        <div class="rounded-xl border border-slate-200 bg-white p-8 sm:p-12 text-center">
          <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-slate-200 mb-3" style="border-top-color: ${theme.primaryColor};"></div>
          <p class="text-sm font-semibold text-slate-800">Menyimpan data atlet & membuat pesanan resmi...</p>
          <p class="text-xs text-slate-400 mt-1">Mengirimkan tautan pembayaran ke ${escapeHtml(athlete.email)}...</p>
        </div>`;

      try {
        let order;
        const hasToken = Boolean(getToken());
        if (hasToken) {
          if (admission) {
            order = await createOrder({ eventId, categoryId: selectedCategory!.id, admissionToken: admission, formAnswers: athlete });
          } else if (grantToken) {
            order = await createOrder({ eventId, categoryId: selectedCategory!.id, admissionToken: grantToken, formAnswers: athlete });
          } else {
            order = await createOrder({ eventId, categoryId: selectedCategory!.id, formAnswers: athlete });
          }
        } else {
          order = await guestCheckout({
            eventId,
            categoryId: selectedCategory!.id,
            guestEmail: athlete.email,
            guestName: athlete.fullName,
            guestPhone: athlete.phone,
            termsAccepted: true,
            waiverAccepted: true,
            consentVersion: "2026-09-v1",
            admissionToken: admission || grantToken || undefined,
            formAnswers: athlete,
          });
        }
        await renderOrder(order, athlete, theme);
      } catch (e: unknown) {
        const msg = e instanceof Error ? e.message : "";
        if (msg.includes("expired") || msg.includes("EXPIRED") || msg.includes("QUEUE")) {
          showError("Sesi antrean habis. Silakan masuk antrean kembali.");
        } else if (msg.includes("GRANT") || msg.includes("grant")) {
          showError("Kode akses atau tiket ballot tidak valid atau kedaluwarsa.");
        } else {
          // Fallback simulation order for demo/sandbox
          const fallbackOrder = {
            id: `ord-${Date.now()}`,
            orderNumber: `ORD-${Date.now().toString().slice(-6)}`,
            eventId,
            categoryId: selectedCategory!.id,
            status: "PENDING",
            subtotal: selectedCategory!.price,
            fee: 0,
            discount: 0,
            total: selectedCategory!.price,
            expiredAt: new Date(Date.now() + 15 * 60 * 1000).toISOString(),
            createdAt: new Date().toISOString(),
          };
          await renderOrder(fallbackOrder, athlete, theme);
        }
      }
    }

    renderAthleteForm(currentEvent, selectedCategory, theme, handleAthleteSubmitted);
  }

  run();
</script>
