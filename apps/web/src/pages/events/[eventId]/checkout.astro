            Rute telah terverifikasi oleh World Athletics / AIMS dengan penanda kilometer resmi di setiap sudut putaran. Pastikan nomor BIB terpasang di bagian depan dada untuk timing chip detection.
          </p>
          <div class="pt-1">
            <button
              type="button"
              id="btn-dismiss-route"
              class="w-full min-h-[44px] rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider transition-colors"
            >
              Mengerti & Kembali ke Pemilihan Tiket
            </button>
          </div>
        </div>
      </div>
    `;

    document.body.appendChild(modal);

    const close = () => modal.remove();
    document.getElementById("btn-close-route-modal")?.addEventListener("click", close);
    document.getElementById("btn-dismiss-route")?.addEventListener("click", close);
    modal.addEventListener("click", (e) => {
      if (e.target === modal) close();
    });
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        close();
        window.removeEventListener("keydown", handleKeyDown);
      }
    };
    window.addEventListener("keydown", handleKeyDown);
  }

