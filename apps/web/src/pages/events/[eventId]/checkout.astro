---
export const prerender = false;
import ParticipantLayout from "../../../layouts/ParticipantLayout.astro";
import StatusBanner from "../../../components/StatusBanner.astro";
const { eventId } = Astro.params;
---
<ParticipantLayout title="Registrasi & Checkout | ivyticketing" hideHeader={true} fullWidth={true}>
  <!-- Parameter Stash Inline Script (Runs immediately on load) -->
  <script is:inline>
    (function () {
      var p = new URLSearchParams(window.location.search);
      window.__checkoutParams = {
        orderId:    p.get("orderId")    ?? "",
        categoryId: p.get("categoryId") ?? "",
        admission:  p.get("admission")  ?? "",
        grantToken: p.get("grantToken") ?? "",
        drawId:     p.get("drawId")     ?? "",
        source:     p.get("source")     ?? "",
        mode:       p.get("mode")       ?? "",
        step:       p.get("step")       ?? "",
      };
      var orgSlug   = p.get("orgSlug")   ?? "";
      var eventSlug = p.get("eventSlug") ?? "";
      var backLink  = document.getElementById("nav-back-link");
      if (backLink && orgSlug && eventSlug) {
        backLink.setAttribute("href", backLink.getAttribute("href") + "?orgSlug=" + encodeURIComponent(orgSlug) + "&eventSlug=" + encodeURIComponent(eventSlug));
      }
    })();
  </script>

  <!-- Sticky Event Checkout Navbar -->
  <header id="checkout-navbar" class="sticky top-0 z-50 w-full transition-colors duration-200 backdrop-blur-md bg-slate-900/95 border-b border-white/10 shadow-xs">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-3">
      <!-- Left: Back Button & Event Brand Badge -->
      <div class="flex items-center gap-2 sm:gap-3 min-w-0">
        <a
          id="nav-back-link"
          href={`/events/${eventId}`}
          class="inline-flex items-center gap-1.5 min-h-[44px] px-2.5 sm:px-3 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-colors shrink-0"
          aria-label="Kembali ke Halaman Event"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
            <path d="m15 18-6-6 6-6" />
          </svg>
          <span class="hidden sm:inline">Kembali ke Event</span>
          <span class="sm:hidden">Kembali</span>
        </a>

        <div class="h-4 sm:h-5 w-px bg-white/20 shrink-0"></div>

        <div class="flex items-center gap-2 min-w-0">
          <span
            id="nav-brand-badge"
            class="inline-flex items-center justify-center font-black text-[10px] sm:text-xs px-2 py-0.5 sm:py-1 rounded uppercase tracking-wider shrink-0 bg-white text-slate-950 shadow-xs"
          >
            IVY
          </span>
          <div class="min-w-0 truncate">
            <span id="nav-event-title" class="font-bold text-xs sm:text-sm text-white block truncate">
              Pendaftaran Event
            </span>
            <span id="nav-event-sub" class="hidden md:block text-[10px] uppercase font-bold tracking-wider text-slate-400 truncate">
              Official Athlete Portal
            </span>
          </div>
        </div>
      </div>

      <!-- Center: Security Badge -->
      <div class="hidden lg:flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300 text-xs font-medium">
        <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="nav-security-label">Pendaftaran Resmi Terenkripsi SSL 256-Bit</span>
      </div>

      <!-- Right: Step Progress Pill -->
      <div class="flex items-center gap-2 shrink-0">
        <div id="nav-step-pill" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/10 text-white font-mono text-[11px] sm:text-xs font-semibold">
          <span id="nav-step-text">Langkah 1/3</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Viewport Container -->
  <div id="checkout-container" class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 transition-all duration-300">
    <StatusBanner />

    <!-- Compact Stepper Bar -->
    <nav id="checkout-stepper-card" aria-label="Alur Pendaftaran" class="mb-4 sm:mb-6 rounded-xl border border-slate-200 bg-white p-2.5 sm:p-3 shadow-xs">
      <div class="grid grid-cols-3 gap-2 text-center text-xs">
        <div id="step-ind-1" class="flex items-center justify-center gap-1.5 sm:gap-2 font-bold text-slate-900 transition-colors">
          <span class="step-num flex h-6 w-6 sm:h-7 sm:w-7 items-center justify-center rounded-full bg-slate-900 text-white text-xs shrink-0">1</span>
          <span class="truncate">Tiket & Kategori</span>
        </div>
        <div id="step-ind-2" class="flex items-center justify-center gap-1.5 sm:gap-2 font-medium text-slate-400 transition-colors">
          <span class="step-num flex h-6 w-6 sm:h-7 sm:w-7 items-center justify-center rounded-full bg-slate-100 text-slate-500 text-xs shrink-0">2</span>
          <span class="truncate">Data Atlet & BIB</span>
        </div>
        <div id="step-ind-3" class="flex items-center justify-center gap-1.5 sm:gap-2 font-medium text-slate-400 transition-colors">
          <span class="step-num flex h-6 w-6 sm:h-7 sm:w-7 items-center justify-center rounded-full bg-slate-100 text-slate-500 text-xs shrink-0">3</span>
          <span class="truncate">Pembayaran & E-Tiket</span>
        </div>
      </div>
    </nav>

    <!-- Dynamic Checkout Content Root -->
    <div id="checkout-root" data-event-id={eventId}>
      <div class="rounded-xl border border-slate-200 bg-white p-8 sm:p-12 text-center">
        <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-slate-200 border-t-slate-900 mb-3"></div>
        <p class="text-sm font-medium text-slate-600">Menyiapkan pendaftaran atlet...</p>
      </div>
    </div>
  </div>
</ParticipantLayout>

<script>
  import { createOrder, guestCheckout, fetchOrder, initiatePayment } from "../../../lib/checkout";
  import { getToken } from "../../../lib/auth";
  import { fetchPublicForm } from "../../../lib/api";
  import { getPaymentSettings, getActiveChannelsForEvent, syncEventPaymentChannelsFromServer, type PaymentChannelConfig } from "../../../lib/payment-settings";
  import { getMarathonEventById, type MarathonCategory, type MarathonEvent, type CustomFormConfig, DEFAULT_FORM_CONFIG } from "../../../lib/events-store";

  const root = document.getElementById("checkout-root")!;
  const eventId = root.dataset.eventId!;

  // Strip sensitive params from URL on load
  const url = new URL(window.location.href);
  const sensitiveParams = ["grantToken", "admission"];
  sensitiveParams.forEach((p) => url.searchParams.delete(p));
  history.replaceState({}, "", url.toString());

  // Read entry-point params from the stash
  const stash = ((window as any).__checkoutParams as Record<string, string>) ?? {};
  const orderId    = stash["orderId"]    ?? "";
  let   categoryId = stash["categoryId"] ?? "";
  const admission  = stash["admission"]  ?? "";
  const grantToken = stash["grantToken"] ?? "";
  const drawId     = stash["drawId"]     ?? "";
  const source     = stash["source"]     ?? "";
  let   urlMode    = stash["mode"]       ?? "";
  let   currentStep = stash["step"]      ?? "";

  // 38 Official Indonesian Provinces + International
  const INDONESIAN_PROVINCES = [
    "Aceh",
    "Sumatera Utara",
    "Sumatera Barat",
    "Riau",
    "Kepulauan Riau",
    "Jambi",
    "Sumatera Selatan",
    "Kepulauan Bangka Belitung",
    "Bengkulu",
    "Lampung",
    "DKI Jakarta",
    "Banten",
    "Jawa Barat",
    "Jawa Tengah",
    "DI Yogyakarta",
    "Jawa Timur",
    "Bali",
    "Nusa Tenggara Barat",
    "Nusa Tenggara Timur",
    "Kalimantan Barat",
    "Kalimantan Tengah",
    "Kalimantan Selatan",
    "Kalimantan Timur",
    "Kalimantan Utara",
    "Sulawesi Utara",
    "Gorontalo",
    "Sulawesi Tengah",
    "Sulawesi Barat",
    "Sulawesi Selatan",
    "Sulawesi Tenggara",
    "Maluku",
    "Maluku Utara",
    "Papua",
    "Papua Barat",
    "Papua Selatan",
    "Papua Tengah",
    "Papua Pegunungan",
    "Papua Barat Daya",
    "Luar Negeri (International)",
  ];

  interface AthleteData {
    fullName: string;
    bibName: string;
    idNumber: string;
    gender: "MALE" | "FEMALE";
    birthDate: string;
    bloodType: string;
    province: string;
    city: string;
    phone: string;
    email: string;
    emergencyName: string;
    emergencyPhone: string;
    emergencyRelation: string;
    jerseySize: string;
    runningClub?: string;
    medicalNotes?: string;
    estimatedFinishTime?: string;
    customFields?: Record<string, any>;
    [key: string]: any;
  }

  interface TemplateTheme {
    templateId: string;
    navBg: string;
    navBorder: string;
    badgeBg: string;
    badgeText: string;
    badgeLabel: string;
    brandTitle: string;
    subText: string;
    subColor: string;
    primaryColor: string;
    primaryHover: string;
    primaryText: string;
    accentColor: string;
    lightBg: string;
    ringColor: string;
  }

  // ── Template Color & Style Mapping (Synchronized with index.astro) ──────────
  function getTemplateTheme(event: MarathonEvent): TemplateTheme {
    const templateId = event.layoutConfig?.templateId || "template-summarecon";
    const navCfg = event.layoutConfig?.navbarConfig;
    const customPrimary = event.layoutConfig?.customThemePrimary;
    const customAccent = event.layoutConfig?.customThemeAccent;

    if (templateId === "template-baa" || event.id.includes("baa") || event.id.includes("boston")) {
      return {
        templateId: "template-baa",
        navBg: "rgba(0, 23, 46, 0.98)",
        navBorder: "rgba(253, 218, 36, 0.35)",
        badgeBg: navCfg?.brandBadgeBg || "#fdda24",
        badgeText: navCfg?.brandBadgeColor || "#00172e",
        badgeLabel: navCfg?.brandBadgeText || "BAA",
        brandTitle: navCfg?.brandTitle || event.name,
        subText: navCfg?.brandSubtitle || "BOSTON ATHLETIC ASSOCIATION",
        subColor: "#fdda24",
        primaryColor: "#fdda24",
        primaryHover: "#e5c41e",
        primaryText: "#00172e",
        accentColor: "#002244",
        lightBg: "rgba(253, 218, 36, 0.08)",
        ringColor: "#fdda24",
      };
    }

    if (templateId === "template-tokyo" || event.id.includes("tokyo")) {
      return {
        templateId: "template-tokyo",
        navBg: "rgba(10, 10, 10, 0.98)",
        navBorder: "rgba(220, 38, 38, 0.35)",
        badgeBg: navCfg?.brandBadgeBg || "#dc2626",
        badgeText: navCfg?.brandBadgeColor || "#ffffff",
        badgeLabel: navCfg?.brandBadgeText || "TKY",
        brandTitle: navCfg?.brandTitle || event.name,
        subText: navCfg?.brandSubtitle || "TOKYO WORLD MARATHON MAJOR",
        subColor: "#f87171",
        primaryColor: "#dc2626",
        primaryHover: "#b91c1c",
        primaryText: "#ffffff",
        accentColor: "#ef4444",
        lightBg: "rgba(220, 38, 38, 0.08)",
        ringColor: "#dc2626",
      };
    }

    if (templateId === "template-ironman" || event.id.includes("ironman") || event.id.includes("triathlon")) {
      return {
        templateId: "template-ironman",
        navBg: "rgba(13, 13, 13, 0.98)",
        navBorder: "rgba(225, 29, 72, 0.35)",
        badgeBg: navCfg?.brandBadgeBg || "#e11d48",
        badgeText: navCfg?.brandBadgeColor || "#ffffff",
        badgeLabel: navCfg?.brandBadgeText || "IM",
        brandTitle: navCfg?.brandTitle || event.name,
        subText: navCfg?.brandSubtitle || "IRONMAN TRIATHLON SERIES",
        subColor: "#f43f5e",
        primaryColor: "#e11d48",
        primaryHover: "#be123c",
        primaryText: "#ffffff",
        accentColor: "#f43f5e",
        lightBg: "rgba(225, 29, 72, 0.08)",
        ringColor: "#e11d48",
      };
    }

    if (templateId === "template-berlin" || event.id.includes("berlin")) {
      return {
        templateId: "template-berlin",
        navBg: "rgba(2, 11, 30, 0.98)",
        navBorder: "rgba(14, 165, 233, 0.35)",
        badgeBg: navCfg?.brandBadgeBg || "#0284c7",
        badgeText: navCfg?.brandBadgeColor || "#ffffff",
        badgeLabel: navCfg?.brandBadgeText || "BER",
        brandTitle: navCfg?.brandTitle || event.name,
        subText: navCfg?.brandSubtitle || "BMW BERLIN MARATHON",
        subColor: "#38bdf8",
        primaryColor: "#0284c7",
        primaryHover: "#0369a1",
        primaryText: "#ffffff",
        accentColor: "#38bdf8",
        lightBg: "rgba(2, 132, 199, 0.08)",
        ringColor: "#0284c7",
      };
    }

    if (templateId === "template-borobudur" || event.id.includes("borobudur")) {
      return {
        templateId: "template-borobudur",
        navBg: "rgba(18, 16, 14, 0.98)",
        navBorder: "rgba(217, 119, 6, 0.35)",
        badgeBg: navCfg?.brandBadgeBg || "#d97706",
        badgeText: navCfg?.brandBadgeColor || "#000000",
        badgeLabel: navCfg?.brandBadgeText || "BRB",
        brandTitle: navCfg?.brandTitle || event.name,
        subText: navCfg?.brandSubtitle || "BOROBUDUR HERITAGE MARATHON",
        subColor: "#fbbf24",
        primaryColor: "#d97706",
        primaryHover: "#b45309",
        primaryText: "#000000",
        accentColor: "#fbbf24",
        lightBg: "rgba(217, 119, 6, 0.08)",
        ringColor: "#d97706",
      };
    }

    if (templateId === "template-sydney" || event.id.includes("sydney")) {
      return {
        templateId: "template-sydney",
        navBg: "rgba(7, 21, 39, 0.98)",
        navBorder: "rgba(14, 165, 233, 0.35)",
        badgeBg: navCfg?.brandBadgeBg || "#0ea5e9",
        badgeText: navCfg?.brandBadgeColor || "#ffffff",
        badgeLabel: navCfg?.brandBadgeText || "SYD",
        brandTitle: navCfg?.brandTitle || event.name,
        subText: navCfg?.brandSubtitle || "SYDNEY HARBOUR MARATHON",
        subColor: "#38bdf8",
        primaryColor: "#0ea5e9",
        primaryHover: "#0284c7",
        primaryText: "#ffffff",
        accentColor: "#0d9488",
        lightBg: "rgba(14, 165, 233, 0.08)",
        ringColor: "#0ea5e9",
      };
    }

    if (templateId === "template-bangkok" || event.id.includes("bangkok") || event.id.includes("bkk")) {
      return {
        templateId: "template-bangkok",
        navBg: "rgba(6, 11, 19, 0.98)",
        navBorder: "rgba(249, 115, 22, 0.35)",
        badgeBg: navCfg?.brandBadgeBg || "#f97316",
        badgeText: navCfg?.brandBadgeColor || "#000000",
        badgeLabel: navCfg?.brandBadgeText || "BKK",
        brandTitle: navCfg?.brandTitle || event.name,
        subText: navCfg?.brandSubtitle || "BANGKOK MIDNIGHT MARATHON",
        subColor: "#fb923c",
        primaryColor: "#f97316",
        primaryHover: "#ea580c",
        primaryText: "#ffffff",
        accentColor: "#fb923c",
        lightBg: "rgba(249, 115, 22, 0.08)",
        ringColor: "#f97316",
      };
    }

    if (templateId === "template-custom") {
      const pColor = customPrimary || "#ea580c";
      return {
        templateId: "template-custom",
        navBg: "rgba(10, 17, 32, 0.98)",
        navBorder: customAccent ? `${customAccent}4d` : "rgba(234, 88, 12, 0.35)",
        badgeBg: navCfg?.brandBadgeBg || pColor,
        badgeText: navCfg?.brandBadgeColor || "#ffffff",
        badgeLabel: navCfg?.brandBadgeText || "IVY",
        brandTitle: navCfg?.brandTitle || event.name,
        subText: navCfg?.brandSubtitle || "OFFICIAL ATHLETE REGISTRATION",
        subColor: customAccent || "#fb923c",
        primaryColor: pColor,
        primaryHover: customAccent || "#c2410c",
        primaryText: "#ffffff",
        accentColor: customAccent || "#fb923c",
        lightBg: "rgba(234, 88, 12, 0.08)",
        ringColor: pColor,
      };
    }

    // Default: Summarecon Bandung Night Run
    return {
      templateId: "template-summarecon",
      navBg: "rgba(11, 15, 25, 0.98)",
      navBorder: "rgba(139, 92, 246, 0.35)",
      badgeBg: navCfg?.brandBadgeBg || "#8b5cf6",
      badgeText: navCfg?.brandBadgeColor || "#ffffff",
      badgeLabel: navCfg?.brandBadgeText || "SMR",
      brandTitle: navCfg?.brandTitle || event.name,
      subText: navCfg?.brandSubtitle || "SUMMARECON NIGHT RUN FESTIVAL",
      subColor: "#a78bfa",
      primaryColor: "#8b5cf6",
      primaryHover: "#7c3aed",
      primaryText: "#ffffff",
      accentColor: "#a78bfa",
      lightBg: "rgba(139, 92, 246, 0.08)",
      ringColor: "#8b5cf6",
    };
  }

  // Synchronize top navbar style with active template
  function syncNavbarWithTemplate(theme: TemplateTheme) {
    const navbar = document.getElementById("checkout-navbar");
    if (navbar) {
      navbar.style.backgroundColor = theme.navBg;
      navbar.style.borderBottomColor = theme.navBorder;
    }
    const badge = document.getElementById("nav-brand-badge");
    if (badge) {
      badge.style.backgroundColor = theme.badgeBg;
      badge.style.color = theme.badgeText;
      badge.textContent = theme.badgeLabel;
    }
    const title = document.getElementById("nav-event-title");
    if (title) {
      title.textContent = theme.brandTitle;
    }
    const sub = document.getElementById("nav-event-sub");
    if (sub) {
      sub.textContent = theme.subText;
      sub.style.color = theme.subColor;
    }
  }

  // ── Helper Utilities ────────────────────────────────────────────────────────
  function escapeHtml(str: string): string {
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function fmt(amount: number): string {
    return new Intl.NumberFormat("id-ID", {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    }).format(amount);
  }

  function toShortPrice(price: number): string {
    if (price >= 1000) {
      const k = price / 1000;
      return `IDR ${Number.isInteger(k) ? k : k.toFixed(0)}K`;
    }
    return `IDR ${price}`;
  }

  function getStoredAthlete(): AthleteData | null {
    try {
      const raw = localStorage.getItem("ivy_checkout_athlete");
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function saveAthlete(athlete: AthleteData) {
    try {
      localStorage.setItem("ivy_checkout_athlete", JSON.stringify(athlete));
    } catch {
      // ignore
    }
  }

  function showError(message: string) {
    root.innerHTML = `
      <div class="rounded-xl border border-red-200 bg-red-50 p-6 sm:p-8 text-center space-y-4">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-red-100 text-red-600 text-xl font-bold">
          !
        </div>
        <p class="text-sm font-semibold text-red-800">${escapeHtml(message)}</p>
        <a href="/events/${eventId}" class="inline-flex items-center justify-center min-h-[44px] rounded-xl bg-slate-900 px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-slate-800 transition-colors">
          Kembali ke Event
        </a>
      </div>`;
  }

  function setStep(step: 1 | 2 | 3, theme: TemplateTheme) {
    const navStepText = document.getElementById("nav-step-text");
    if (navStepText) {
      navStepText.textContent = `Langkah ${step}/3`;
    }

    const steps = [
      { id: "step-ind-1", num: 1 },
      { id: "step-ind-2", num: 2 },
      { id: "step-ind-3", num: 3 },
    ];

    steps.forEach((s) => {
      const el = document.getElementById(s.id);
      if (!el) return;
      const numSpan = el.querySelector<HTMLElement>(".step-num");
      if (s.num === step) {
        el.className = "flex items-center justify-center gap-1.5 sm:gap-2 font-bold text-slate-900 transition-colors";
        if (numSpan) {
          numSpan.style.backgroundColor = theme.primaryColor;
          numSpan.style.color = theme.primaryText;
        }
      } else if (s.num < step) {
        el.className = "flex items-center justify-center gap-1.5 sm:gap-2 font-semibold text-emerald-700 transition-colors";
        if (numSpan) {
          numSpan.style.backgroundColor = "#10b981";
          numSpan.style.color = "#ffffff";
          numSpan.textContent = "✓";
        }
      } else {
        el.className = "flex items-center justify-center gap-1.5 sm:gap-2 font-medium text-slate-400 transition-colors";
        if (numSpan) {
          numSpan.style.backgroundColor = "#f1f5f9";
          numSpan.style.color = "#64748b";
          numSpan.textContent = String(s.num);
        }
      }
    });
  }

  // ── Open Interactive Route & Course Map Modal ──────────────────────────────
  function openRouteModal(category: MarathonCategory) {
    document.getElementById("route-modal")?.remove();

    const modal = document.createElement("div");
    modal.id = "route-modal";
    modal.className = "fixed inset-0 z-50 bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4 overflow-y-auto";
    modal.setAttribute("role", "dialog");
    modal.setAttribute("aria-modal", "true");
    modal.setAttribute("aria-labelledby", "route-modal-title");

    modal.innerHTML = `
      <div class="relative w-full max-w-lg rounded-2xl bg-white shadow-2xl border border-slate-200 overflow-hidden my-auto">
        <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3.5 bg-slate-50">
          <div class="min-w-0">
            <h3 id="route-modal-title" class="font-bold text-slate-900 text-sm sm:text-base uppercase tracking-tight truncate">
              Rute Resmi: ${escapeHtml(category.name)}
            </h3>
            <span class="text-xs text-slate-500 font-mono">Jarak: ${escapeHtml(category.distance)} | COT: ${escapeHtml(category.cutoffTime || "Standar")}</span>
          </div>
          <button
            type="button"
            id="btn-close-route-modal"
            class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors text-lg shrink-0"
            aria-label="Tutup popup rute"
          >
            ✕
          </button>
        </div>
        <div class="p-5 space-y-4 text-xs text-slate-700">
          <div class="rounded-xl border border-slate-200 bg-slate-50 p-4 space-y-2">
            <div class="flex justify-between font-medium">
              <span class="text-slate-500">Ketinggian Kumulatif (Elevation Gain):</span>
              <span class="font-bold text-slate-900 font-mono">480 m</span>
            </div>
            <div class="flex justify-between font-medium">
              <span class="text-slate-500">Pos Water Station (WS):</span>
              <span class="font-bold text-slate-900">Setiap 2.5 KM (Isotonik & Medis)</span>
            </div>
            <div class="flex justify-between font-medium">
              <span class="text-slate-500">Permukaan Lintasan:</span>
