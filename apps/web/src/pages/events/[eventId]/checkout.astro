                  >
                    <option value="">-- Pilih salah satu --</option>
                    ${f.options.map((opt: string) => `<option value="${escapeHtml(opt)}">${escapeHtml(opt)}</option>`).join("")}
                  </select>
                  ${help}
                </div>
              `;
            }

            if (f.fieldType === "checkbox") {
              return `
                <div class="sm:col-span-2 flex items-start gap-3 min-h-[44px] py-1">
                  <input
                    type="checkbox"
                    id="${inputName}"
                    name="${inputName}"
                    value="true"
                    ${reqAttr}
                    class="h-5 w-5 rounded border-slate-300 text-slate-900 focus:ring-2 mt-0.5 shrink-0"
                    style="--tw-ring-color: ${theme.ringColor};"
                  />
                  <div>
                    <label for="${inputName}" class="text-xs font-bold uppercase tracking-wider text-slate-700 cursor-pointer">
                      ${escapeHtml(f.label)}${reqStar}
                    </label>
                    ${help}
                  </div>
                </div>
              `;
            }

            const inputType = f.fieldType === "number" ? "number" : f.fieldType === "email" ? "email" : "text";
            return `
              <div>
                <label for="${inputName}" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                  ${escapeHtml(f.label)}${reqStar}
                </label>
                <input
                  type="${inputType}"
                  id="${inputName}"
                  name="${inputName}"
                  ${reqAttr}
                  class="w-full min-h-[44px] rounded-lg border border-slate-300 px-3.5 py-2 text-xs font-medium text-slate-900 placeholder:text-slate-400 focus:outline-hidden focus:ring-2"
                  style="--tw-ring-color: ${theme.ringColor};"
                />
                ${help}
              </div>
            `;
