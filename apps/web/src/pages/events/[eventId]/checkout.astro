    // ── Cart State Synchronizer ──
    function syncCartUI() {
      const itemsListEl = document.getElementById("cart-items-list");
      const subtotalEl = document.getElementById("cart-subtotal");
      const totalEl = document.getElementById("cart-total");
      const countEl = document.getElementById("cart-item-count");
      const checkoutBtn = document.getElementById("btn-cart-checkout") as HTMLButtonElement | null;
      const mobileTotalEl = document.getElementById("mobile-cart-total");
      const mobileCheckoutBtn = document.getElementById("btn-mobile-checkout") as HTMLButtonElement | null;

      const entries = Object.values(cart);
      const totalItems = entries.reduce((acc, cur) => acc + cur.qty, 0);
      const totalPrice = entries.reduce((acc, cur) => acc + (cur.price * cur.qty), 0);

      if (countEl) countEl.textContent = `${totalItems} Tiket`;
      if (subtotalEl) subtotalEl.textContent = fmt(totalPrice);
      if (totalEl) totalEl.textContent = fmt(totalPrice);
      if (mobileTotalEl) mobileTotalEl.textContent = fmt(totalPrice);

      if (itemsListEl) {
        if (entries.length === 0) {
          itemsListEl.innerHTML = `
            <p class="text-slate-400 text-center py-4 text-xs italic">
              Belum ada tiket dipilih. Tekan tombol + pada kategori di atas.
            </p>`;
        } else {
          itemsListEl.innerHTML = entries.map((entry) => `
            <div class="pt-1.5 first:pt-0 flex items-center justify-between gap-2">
              <div class="min-w-0">
                <p class="font-bold text-slate-900 truncate">${escapeHtml(entry.cat.name)}</p>
                <span class="text-[10px] text-slate-400 font-mono">${entry.tierName} (${entry.qty}x)</span>
              </div>
              <span class="font-mono font-bold text-slate-900 shrink-0">
                ${entry.price === 0 ? "Rp 0 (Ballot)" : fmt(entry.price * entry.qty)}
              </span>
            </div>
          `).join("");
        }
      }

      if (checkoutBtn) {
        checkoutBtn.disabled = totalItems === 0;
        checkoutBtn.style.opacity = totalItems === 0 ? "0.5" : "1";
      }
      if (mobileCheckoutBtn) {
        mobileCheckoutBtn.disabled = totalItems === 0;
        mobileCheckoutBtn.style.opacity = totalItems === 0 ? "0.5" : "1";
      }

      // Update active category border/ring styles
      document.querySelectorAll<HTMLElement>(".category-card").forEach((card) => {
        const cId = card.dataset.catId;
        const active = Boolean(cart[`${cId}_domestik`] || cart[`${cId}_intl`]);
        if (active) {
          card.style.borderColor = theme.primaryColor;
          card.style.boxShadow = `0 0 0 2px ${theme.ringColor}`;
          card.style.backgroundColor = theme.lightBg;
        } else {
          card.style.borderColor = "#e2e8f0";
          card.style.boxShadow = "none";
          card.style.backgroundColor = "#ffffff";
        }
      });
    }

    // Bind quantity click handlers
    document.querySelectorAll<HTMLButtonElement>(".btn-qty").forEach((btn) => {
      btn.addEventListener("click", () => {
        const catId = btn.dataset.catId!;
        const tier = btn.dataset.tier as "domestik" | "intl";
        const delta = parseInt(btn.dataset.delta || "0", 10);
        const cat = categories.find((c) => c.id === catId);
        if (!cat) return;

        const key = `${catId}_${tier}`;
        const currentQty = cart[key]?.qty || 0;
        const newQty = Math.max(0, Math.min(10, currentQty + delta));

        if (newQty === 0) {
          delete cart[key];
        } else {
          const price = tier === "domestik"
            ? (cat.mode === "BALLOT" ? 0 : cat.price)
            : (cat.mode === "BALLOT" ? 0 : Math.round(cat.price * 1.5));
          cart[key] = {
            cat,
            tierKey: tier,
            tierName: tier === "domestik" ? "DOMESTIK REGULER" : "INTERNATIONAL REGULER",
            price,
            qty: newQty,
          };
          categoryId = cat.id;
        }

        const span = document.getElementById(`qty-${catId}-${tier}`);
        if (span) span.textContent = String(newQty);

        syncCartUI();
      });
    });

    // Bind view route modals
    document.querySelectorAll<HTMLButtonElement>(".btn-view-route").forEach((btn) => {
      btn.addEventListener("click", () => {
        const catId = btn.dataset.catId!;
        const cat = categories.find((c) => c.id === catId);
        if (cat) openRouteModal(cat);
      });
    });

    // Checkout handler
    const handleProceedToForm = () => {
      const entries = Object.values(cart);
      if (entries.length === 0) return;

      const primary = entries[0];
      categoryId = primary.cat.id;
      urlMode = primary.cat.mode || "";
      currentStep = "form";

      const nextUrl = new URL(window.location.href);
      nextUrl.searchParams.set("categoryId", categoryId);
      nextUrl.searchParams.set("step", "form");
      if (urlMode === "BALLOT") {
        nextUrl.searchParams.set("mode", "BALLOT");
      } else {
        nextUrl.searchParams.delete("mode");
      }
      history.replaceState({}, "", nextUrl.toString());

      run();
    };

    document.getElementById("btn-cart-checkout")?.addEventListener("click", handleProceedToForm);
    document.getElementById("btn-mobile-checkout")?.addEventListener("click", handleProceedToForm);

    syncCartUI();
  }

