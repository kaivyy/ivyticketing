---
export const prerender = false;
import ParticipantLayout from "../../../layouts/ParticipantLayout.astro";
import Turnstile from "../../../components/security/Turnstile.astro";

const { eventId = "boston-marathon-2026" } = Astro.params;
const categoryId = Astro.url.searchParams.get("categoryId") || "";
const orgSlug = Astro.url.searchParams.get("orgSlug") || "";
const eventSlug = Astro.url.searchParams.get("eventSlug") || "";

const SPONSORS = [
  { name: "Bank of America", role: "Presenting Partner", logo: "/images/events/sponsor_bofa.png", h: "h-7" },
  { name: "adidas", role: "Official Footwear & Apparel", logo: "/images/events/sponsor_adidas.png", h: "h-8" },
  { name: "Abbott World Marathon Majors", role: "Official Series", logo: "/images/events/sponsor_abbott.png", h: "h-7" },
  { name: "Samuel Adams", role: "Official Beer", logo: "/images/events/sponsor_samadams.svg", h: "h-7" },
  { name: "Schneider Electric", role: "Sustainability Partner", logo: "/images/events/sponsor_schneider.png", h: "h-6" },
  { name: "New England Honda", role: "Official Vehicle", logo: "/images/events/sponsor_honda.svg", h: "h-6" },
  { name: "Maurten", role: "Official Sports Fuel", logo: "/images/events/sponsor_maurten.svg", h: "h-6" },
  { name: "Poland Spring", role: "Official Natural Spring Water", logo: "/images/events/sponsor_polandspring.svg", h: "h-7" },
  { name: "Shokz", role: "Official Headphones", logo: "/images/events/sponsor_shokz.svg", h: "h-6" },
  { name: "JetBlue", role: "Official Airline", logo: "/images/events/sponsor_jetblue.svg", h: "h-6" },
  { name: "Gatorade", role: "Official Sports Drink", logo: "/images/events/sponsor_gatorade.png", h: "h-7" },
  { name: "CITGO", role: "Official Landmark Partner", logo: "/images/events/sponsor_citgo.svg", h: "h-6" },
];
---

<ParticipantLayout title="Ruang Tunggu War Tiket : ivyticketing" hideHeader={true} fullWidth={true}>
  <Turnstile />

  <style>
    /* Moving Sponsor Reel Marquee */
    @keyframes baaSponsorMarquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    .baa-sponsor-track {
      display: flex;
      width: max-content;
      animation: baaSponsorMarquee 26s linear infinite;
    }
    .baa-sponsor-track:hover {
      animation-play-state: paused;
    }

    /* Radar Pulse Animation */
    @keyframes warRadarPulse {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.05); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .radar-pulse {
      animation: warRadarPulse 2.5s ease-in-out infinite;
    }

    /* Progress Ring Animation */
    .progress-ring-circle {
      transition: stroke-dashoffset 0.6s ease-in-out;
      transform: rotate(-90deg);
      transform-origin: 50% 50%;
    }
  </style>

  <!-- Sticky Event War Room Navbar -->
  <header
    id="queue-navbar"
    class="sticky top-0 z-50 w-full transition-colors duration-200 backdrop-blur-md bg-[#00172e]/95 border-b border-[#fdda24]/30 shadow-md"
  >
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between gap-3">
      <!-- Left: Back link & Authentic Brand Badge -->
      <div class="flex items-center gap-2 sm:gap-3 min-w-0">
        <a
          id="nav-back-link"
          href={`/events/${eventId}`}
          class="inline-flex items-center gap-1.5 min-h-[44px] px-2.5 sm:px-3 rounded-lg text-xs font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-colors shrink-0"
          aria-label="Kembali ke Halaman Event"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
            <path d="m15 18-6-6 6-6" />
          </svg>
          <span class="hidden sm:inline">Kembali ke Event</span>
          <span class="sm:hidden">Kembali</span>
        </a>

        <div class="h-4 sm:h-5 w-px bg-white/20 shrink-0"></div>

        <div class="flex items-center gap-2 min-w-0">
          <span
            id="nav-brand-badge"
            class="inline-flex items-center justify-center font-black text-[10px] sm:text-xs px-2 py-0.5 sm:py-1 rounded uppercase tracking-wider shrink-0 bg-[#fdda24] text-[#00172e] shadow-xs"
          >
            BAA
          </span>
          <div class="min-w-0 truncate">
            <span id="nav-event-title" class="font-bold text-xs sm:text-sm text-white block truncate">
              130th Boston Marathon 2026
            </span>
            <span class="text-[10px] text-slate-300 uppercase font-mono tracking-wider hidden sm:block">
              Ruang Tunggu War Tiket Resmi · FIFO Priority
            </span>
          </div>
        </div>
      </div>

      <!-- Right: Telemetry & Sound Toggle & Athlete Profile -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Sound Alert Toggle -->
        <button
          type="button"
          id="btn-sound-toggle"
          class="min-h-[44px] inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-slate-200 hover:bg-white/10 hover:text-white transition-colors cursor-pointer"
          title="Bunyikan Suara saat Giliran Tiba"
          aria-label="Pengaturan Suara Antrean"
        >
          <span id="sound-icon">🔔</span>
          <span class="hidden md:inline text-[11px]" id="sound-label">Suara Aktif</span>
        </button>

        <!-- Live Server Status Indicator -->
        <div class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-emerald-500/40 bg-emerald-950/60 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-emerald-300 backdrop-blur-xs">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span>War Online</span>
        </div>

        <!-- Athlete Chip -->
        <div id="athlete-profile-chip" class="inline-flex items-center gap-1.5 rounded-lg border border-white/15 bg-white/5 px-2.5 sm:px-3 py-1 text-xs text-slate-300">
          <span class="h-2 w-2 rounded-full bg-slate-400" id="athlete-dot"></span>
          <span id="athlete-chip-text" class="font-mono text-[11px] truncate max-w-[110px] sm:max-w-[140px]">Memeriksa...</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main War Room Container -->
