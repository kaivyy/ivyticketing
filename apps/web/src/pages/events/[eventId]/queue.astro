                  <span class="text-[11px] font-bold text-white leading-tight mt-0.5">{sp.name}</span>
                </div>
              </div>
            ))}
            <!-- Duplicated strip for infinite loop -->
            {SPONSORS.map((sp) => (
              <div class="flex items-center gap-2.5 rounded-lg border border-white/10 bg-[#002244]/80 px-3 py-1.5 shrink-0 backdrop-blur-md shadow-xs hover:border-[#fdda24]/60 transition-colors" aria-hidden="true">
                <img src={sp.logo} alt={sp.name} class={`${sp.h} w-auto max-w-[120px] object-contain shrink-0`} />
                <div class="flex flex-col text-left">
                  <span class="text-[8px] font-bold uppercase text-slate-400 leading-none">{sp.role}</span>
