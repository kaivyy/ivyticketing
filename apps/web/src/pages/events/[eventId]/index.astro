      window.addEventListener("ivy:homepage_config_changed", () => {
        if (currentEvent) {
          syncNavbarTheme(currentEvent.layoutConfig?.templateId || "", currentEvent);
        }
      });
      window.addEventListener("storage", (e) => {
        if (e.key === "ivy_platform_homepage_config" && currentEvent) {
          syncNavbarTheme(currentEvent.layoutConfig?.templateId || "", currentEvent);
        }
      });

      // Handler Toggle Drawer Mobile
      const mobileToggleBtn = document.getElementById("event-nav-mobile-btn");
      const mobileDrawer = document.getElementById("event-nav-mobile-drawer");
      const iconOpen = document.getElementById("event-nav-mobile-icon-open");
      const iconClose = document.getElementById("event-nav-mobile-icon-close");

      mobileToggleBtn?.addEventListener("click", () => {
        const isClosed = mobileDrawer?.classList.contains("hidden");
        if (isClosed) {
          mobileDrawer?.classList.remove("hidden");
          iconOpen?.classList.add("hidden");
          iconClose?.classList.remove("hidden");
          mobileToggleBtn.setAttribute("aria-expanded", "true");
        } else {
          mobileDrawer?.classList.add("hidden");
          iconOpen?.classList.remove("hidden");
          iconClose?.classList.add("hidden");
          mobileToggleBtn.setAttribute("aria-expanded", "false");
        }
      });

      // Smooth Anchor Scroll untuk Navigasi & Tombol CTA
      function setupNavSmoothScroll() {
        document.querySelectorAll(".event-nav-link, .event-mobile-nav-link, #nav-cta-btn, #event-nav-mobile-cta").forEach(anchor => {
          anchor.addEventListener("click", (e) => {
            const href = anchor.getAttribute("href");
            if (href && href.startsWith("#")) {
              e.preventDefault();
              mobileDrawer?.classList.add("hidden");
              iconOpen?.classList.remove("hidden");
              iconClose?.classList.add("hidden");
              mobileToggleBtn?.setAttribute("aria-expanded", "false");

              let target = document.querySelector(href);
              if (!target) {
                // Fallback cerdas mengikuti penamaan section di berbagai template
                if (href === "#section-categories") {
                  target = document.querySelector("#im-tiers") || document.querySelector("#section-race") || document.querySelector(".cat-container");
                } else if (href === "#section-route") {
                  target = document.querySelector("#im-course") || document.querySelector("#section-elevation");
                } else if (href === "#section-schedule") {
                  target = document.querySelector("#im-schedule");
                } else if (href === "#section-rpc") {
                  target = document.querySelector("#im-logistics");
                }
              }

              if (target) {
                target.scrollIntoView({ behavior: "smooth", block: "start" });
              } else {
                window.scrollTo({ top: 400, behavior: "smooth" });
              }
            }
          });
        });
      }

      loadAndRender();

      fetchMarathonEventByIdFromServer(targetId).then((serverEv) => {
        if (serverEv) {
          loadAndRender();
        }
      }).catch(() => {});

      window.addEventListener("ivy:events_changed", () => {
        loadAndRender();
      });
    </script>
  </body>
</html>
