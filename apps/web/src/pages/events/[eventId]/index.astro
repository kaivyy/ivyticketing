                  <h2 class="font-athletic text-5xl sm:text-7xl font-black uppercase text-white leading-none tracking-tight">
                    THE ROAD<br><span class="text-[#F5EB15]">${esc(lc?.summareconConfig?.closingPosterText || "IS FINALLY YOURS")}</span>
