          };
        } else if (templateId === "template-tokyo") {
          theme = {
            navBg: "rgba(0, 0, 0, 0.95)",
            navBorder: "rgba(255, 255, 255, 0.15)",
            badgeBg: "#dc2626",
            badgeText: "#ffffff",
            badgeLabel: "TKY",
            subText: "TOKYO WORLD MARATHON MAJOR",
            subColor: "#f87171",
            ctaBg: "#dc2626",
            ctaText: "#ffffff",
            ctaShadow: "0 4px 14px rgba(220, 38, 38, 0.4)",
            linkHoverColor: "#ffffff",
          };
        } else if (templateId === "template-berlin") {
          theme = {
            navBg: "rgba(2, 11, 30, 0.95)",
            navBorder: "rgba(14, 165, 233, 0.3)",
            badgeBg: "#0284c7",
            badgeText: "#ffffff",
            badgeLabel: "BER",
            subText: "BMW BERLIN WORLD RECORD TRACK",
            subColor: "#38bdf8",
            ctaBg: "linear-gradient(135deg, #0284c7 0%, #0369a1 100%)",
            ctaText: "#ffffff",
            ctaShadow: "0 4px 14px rgba(2, 132, 199, 0.45)",
            linkHoverColor: "#38bdf8",
          };
        } else if (templateId === "template-borobudur") {
          theme = {
            navBg: "rgba(18, 16, 14, 0.95)",
            navBorder: "rgba(217, 119, 6, 0.3)",
            badgeBg: "#d97706",
            badgeText: "#000000",
            badgeLabel: "BRB",
            subText: "BOROBUDUR HERITAGE MARATHON",
            subColor: "#fbbf24",
            ctaBg: "#d97706",
            ctaText: "#000000",
            ctaShadow: "0 4px 14px rgba(217, 119, 6, 0.4)",
            linkHoverColor: "#fbbf24",
          };
        } else if (templateId === "template-sydney") {
          theme = {
            navBg: "rgba(7, 21, 39, 0.95)",
            navBorder: "rgba(14, 165, 233, 0.25)",
            badgeBg: "#0ea5e9",
            badgeText: "#ffffff",
            badgeLabel: "SYD",
            subText: "SYDNEY HARBOUR MARATHON",
            subColor: "#38bdf8",
            ctaBg: "linear-gradient(135deg, #0284c7 0%, #0d9488 100%)",
            ctaText: "#ffffff",
            ctaShadow: "0 4px 14px rgba(2, 132, 199, 0.4)",
            linkHoverColor: "#38bdf8",
          };
        } else if (templateId === "template-baa") {
          theme = {
            navBg: "rgba(0, 23, 46, 0.95)",
            navBorder: "rgba(253, 218, 36, 0.35)",
            badgeBg: "#fdda24",
            badgeText: "#002244",
            badgeLabel: "BAA",
            subText: "BOSTON ATHLETIC ASSOCIATION",
            subColor: "#fdda24",
            ctaBg: "linear-gradient(135deg, #fdda24 0%, #f5a800 100%)",
            ctaText: "#002244",
            ctaShadow: "0 4px 14px rgba(253, 218, 36, 0.35)",
            linkHoverColor: "#fdda24",
          };
        } else if (templateId === "template-custom") {
          theme = {
            navBg: customBg ? `${customBg}f2` : "rgba(10, 17, 32, 0.95)",
            navBorder: customAccent ? `${customAccent}4d` : "rgba(234, 88, 12, 0.3)",
            badgeBg: customPrimary || "#ea580c",
            badgeText: "#ffffff",
            badgeLabel: "IVY",
            subText: "OFFICIAL ATHLETE PORTAL",
            subColor: customAccent || "#fb923c",
            ctaBg: customPrimary || "#ea580c",
            ctaText: "#ffffff",
            ctaShadow: "0 4px 14px rgba(234, 88, 12, 0.4)",
            linkHoverColor: customAccent || "#fb923c",
          };
        } else {
          // Default: Summarecon Bandung
          theme = {
            navBg: "rgba(11, 15, 25, 0.95)",
            navBorder: "rgba(139, 92, 246, 0.35)",
            badgeBg: "#8b5cf6",
            badgeText: "#ffffff",
            badgeLabel: "SMR",
            subText: "SUMMARECON NIGHT RUN FESTIVAL",
            subColor: "#a78bfa",
            ctaBg: "linear-gradient(135deg, #7c3aed 0%, #c026d3 100%)",
            ctaText: "#ffffff",
            ctaShadow: "0 4px 14px rgba(139, 92, 246, 0.45)",
            linkHoverColor: "#a78bfa",
          };
        }

        // Read global navbar configuration (opacity, blur, border)
        const hpCfg = getHomepageConfig();
        const customOpacity = hpCfg?.navbar?.opacity !== undefined ? Number(hpCfg.navbar.opacity) : 0.95;
        const blurLevel = hpCfg?.navbar?.blur || "md";
        const blurMap: Record<string, string> = {
          none: "none",
          sm: "blur(4px)",
          md: "blur(12px)",
          lg: "blur(20px)",
        };
        const blurStyle = blurMap[blurLevel] || "blur(12px)";

        let finalNavBg = theme.navBg;
        if (theme.navBg.startsWith("rgba(")) {
          finalNavBg = theme.navBg.replace(/,\s*[\d.]+\)$/, `, ${customOpacity})`);
        } else if (theme.navBg.startsWith("#")) {
          const hex = theme.navBg.replace("#", "");
          const r = parseInt(hex.substring(0, 2), 16) || 10;
          const g = parseInt(hex.substring(2, 4), 16) || 17;
          const b = parseInt(hex.substring(4, 6), 16) || 32;
          finalNavBg = `rgba(${r}, ${g}, ${b}, ${customOpacity})`;
        }

        // Apply theme styles to Navbar elements
        if (nav) {
          if (templateId === "template-ironman") {
            nav.style.background = "linear-gradient(180deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0) 100%)";
            nav.style.backgroundColor = "transparent";
            nav.style.backdropFilter = "none";
            nav.style.borderBottom = "none";

            const handleIronmanNavScroll = () => {
              if (window.scrollY > 60) {
                nav.style.background = "rgba(10, 10, 10, 0.96)";
                nav.style.backdropFilter = "blur(12px)";
                nav.style.borderBottom = "1px solid rgba(255, 255, 255, 0.1)";
              } else {
                nav.style.background = "linear-gradient(180deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0) 100%)";
                nav.style.backgroundColor = "transparent";
                nav.style.backdropFilter = "none";
                nav.style.borderBottom = "none";
              }
            };
            window.addEventListener("scroll", handleIronmanNavScroll, { passive: true });
          } else {
            nav.style.background = "";
            nav.style.backgroundColor = finalNavBg;
            nav.style.backdropFilter = blurStyle;
            if (hpCfg?.navbar?.showBorder === false) {
              nav.style.borderBottom = "none";
            } else {
              nav.style.borderColor = theme.navBorder;
            }
          }
        }
        if (drawer) {
          drawer.style.backgroundColor = templateId === "template-ironman" ? "rgba(10, 10, 10, 0.98)" : finalNavBg;
          drawer.style.backdropFilter = blurStyle;
          drawer.style.borderColor = templateId === "template-ironman" ? "rgba(255, 255, 255, 0.1)" : theme.navBorder;
        }
        const navCfg = lc?.navbarConfig;
        if (titleEl) {
          titleEl.textContent = navCfg?.brandTitle || ev.name || ev.title || "IvyTicketing Race";
        }
        if (subEl) {
          subEl.textContent = navCfg?.brandSubtitle || theme.subText;
          subEl.style.color = theme.subColor;
        }
        if (badge) {
          if (navCfg?.brandIconUrl) {
            badge.innerHTML = `<img src="${esc(navCfg.brandIconUrl)}" alt="Logo" class="h-full w-full object-contain rounded" />`;
            badge.style.backgroundColor = navCfg?.brandBadgeBg || "transparent";
          } else if (templateId === "template-ironman") {
            badge.innerHTML = `
              <svg viewBox="0 0 32 32" class="w-7 h-7 shrink-0" fill="currentColor" aria-label="IRONMAN M-Dot">
                <circle cx="16" cy="6" r="4.2" fill="#e10600" />
