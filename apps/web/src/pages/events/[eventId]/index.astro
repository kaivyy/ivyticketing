      // Main Load and Render Router
      function loadAndRender() {
        const ev = getMarathonEventById(targetId) || getMarathonEvents()[0];
        if (!ev) {
          loadingBox.innerHTML = '<p class="text-red-500 text-sm">Event tidak ditemukan.</p>';
          return;
        }

        currentEvent = ev;
        const templateId = ev.layoutConfig?.templateId || "template-summarecon";

        // Sinkronisasi tema dan warna navbar secara otomatis dengan template
        syncNavbarTheme(templateId, ev);

        // Render distinct template based on templateId
        if (templateId === "template-tokyo") {
          renderTarget.innerHTML = renderTokyoTemplate(ev);
        } else if (templateId === "template-berlin") {
          renderTarget.innerHTML = renderBerlinTemplate(ev);
        } else if (templateId === "template-borobudur") {
          renderTarget.innerHTML = renderBorobudurTemplate(ev);
        } else if (templateId === "template-sydney") {
          renderTarget.innerHTML = renderSydneyTemplate(ev);
        } else if (templateId === "template-bangkok") {
          renderTarget.innerHTML = renderBangkokTemplate(ev);
        } else if (templateId === "template-ironman") {
          renderTarget.innerHTML = renderIronmanTemplate(ev);
        } else if (templateId === "template-baa") {
          renderTarget.innerHTML = renderBaaTemplate(ev);
        } else if (templateId === "template-custom") {
          renderTarget.innerHTML = renderCustomTemplate(ev);
        } else {
          // Default: Summarecon Bandung
          renderTarget.innerHTML = renderSummareconTemplate(ev);
        }

        loadingBox.classList.add("hidden");
        renderTarget.classList.remove("hidden");

        // Aktifkan smooth scroll anchor untuk navbar & CTA
        setupNavSmoothScroll();

        // Start countdown timer
        startCountdown(ev.startsAt);

        // Bind category detail modal buttons
        document.querySelectorAll(".btn-open-cat-detail").forEach(btn => {
          btn.addEventListener("click", () => {
            const catId = btn.getAttribute("data-cat-id");
            const cat = ev.categories.find(c => c.id === catId);
            if (cat) openCategoryModal(cat);
          });
        });

        // Bind IRONMAN sticky menu selector tabs (smooth anchor scroll and active state)
        document.querySelectorAll(".im-menu-tab").forEach(tab => {
          tab.addEventListener("click", (e) => {
            const href = tab.getAttribute("href");
            if (href && href.startsWith("#")) {
              e.preventDefault();
              const target = document.querySelector(href);
              if (target) {
                target.scrollIntoView({ behavior: "smooth", block: "start" });
                document.querySelectorAll(".im-menu-tab").forEach(t => t.classList.remove("active"));
                tab.classList.add("active");
              }
            }
          });
        });

        // Bind IRONMAN interactive YouTube video player
        const imVideoPlayer = document.getElementById("im-video-player-wrap");
        if (imVideoPlayer) {
          imVideoPlayer.addEventListener("click", () => {
            const videoId = imVideoPlayer.getAttribute("data-video-id");
            if (videoId) {
              imVideoPlayer.innerHTML = `
                <iframe
                  class="w-full h-full border-0 aspect-video"
                  src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0"
                  title="YouTube video player"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                ></iframe>
              `;
              imVideoPlayer.classList.remove("cursor-pointer", "group");
            }
          });
        }
      }

      // Sinkronisasi Otomatis Warna dan Gaya Navbar Berdasarkan Template
      function syncNavbarTheme(templateId: string, ev: any) {
        const nav = document.getElementById("main-event-nav");
        const drawer = document.getElementById("event-nav-mobile-drawer");
        const badge = document.getElementById("event-nav-brand-badge");
