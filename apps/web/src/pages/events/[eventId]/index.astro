      function parseYouTubeVideoId(url: string | undefined): string | null {
        if (!url) return null;
        const str = url.trim();
        if (/^[a-zA-Z0-9_-]{11}$/.test(str)) return str;
        const match = str.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);
        return match ? match[1] : null;
      }

      function renderIronmanTemplate(ev: MarathonEvent) {
        const primaryHref = getPrimaryActionHref(ev);
        const lc = ev.layoutConfig;
        const align = lc?.heroAlignment || "left";
        const alignCls = align === "center" ? "text-center items-center mx-auto" : align === "right" ? "text-right items-end ml-auto" : "text-left items-start";
        const imc = lc?.ironmanConfig;

        const tagBadge = imc?.tagBadge || "FLEX90 ELIGIBLE";
        const heroPrimaryText = imc?.heroCtaPrimaryText || "VIEW ENTRY OPTIONS";
        const heroPrimaryLink = imc?.heroCtaPrimaryLink || "#im-tiers";
        const heroSecText = imc?.heroCtaSecondaryText || "COURSE OVERVIEW";
        const heroSecLink = imc?.heroCtaSecondaryLink || "#im-course";

        const metricsList = (imc?.metrics && imc.metrics.length === 6)
          ? imc.metrics
          : [
              { id: "swim", label: "Swim", value: imc?.swimMetric || "Ocean (1.9K)", iconType: "preset" as const, presetIcon: "swim" as const },
              { id: "bike", label: "Bike", value: imc?.bikeMetric || "Hilly (90K)", iconType: "preset" as const, presetIcon: "bike" as const },
              { id: "run", label: "Run", value: imc?.runMetric || "Flat (21.1K)", iconType: "preset" as const, presetIcon: "run" as const },
              { id: "airHigh", label: "High Air Temp", value: imc?.airTempMetric || "86 °F / 30 °C", iconType: "preset" as const, presetIcon: "sun" as const },
              { id: "airLow", label: "Low Air Temp", value: imc?.lowAirTempMetric || "75 °F / 24 °C", iconType: "preset" as const, presetIcon: "snowflake" as const },
              { id: "waterTemp", label: "Avg. Water Temp", value: imc?.waterTempMetric || "84 °F / 29 °C", iconType: "preset" as const, presetIcon: "water" as const },
            ];

        const splendorTitle = imc?.splendorTitle || "DIVE INTO THE TROPICAL SPLENDOR OF LANGKAWI";
        const ytId = parseYouTubeVideoId(imc?.youtubeUrl || "https://www.youtube.com/watch?v=17mCq3YV6c8");
        const videoThumb = imc?.videoThumbnailUrl || (ytId ? `https://img.youtube.com/vi/${ytId}/hqdefault.jpg` : ev.bannerUrl);
        const videoBadge = imc?.videoBadgeText || "Official Race Rewind & Highlights";

        const sealsList = (imc?.seals && imc.seals.length === 3)
          ? imc.seals
          : [
              { id: "seal-1", badgeTag: "QUALIFYING", title: "VinFast World Championship", subtitle: imc?.konaSlots || "45 Age-Group Slots to Kona", colorTheme: "blue" as const },
              { id: "seal-2", badgeTag: "ATHLETES' CHOICE", title: "Athletes' Choice Award", subtitle: "Top-Rated Global Race Experience", colorTheme: "gold" as const },
              { id: "seal-3", badgeTag: "FLEX90", title: "Flex90 Registration", subtitle: "Free deferral & transfer options within 90 days", colorTheme: "red" as const },
            ];

        const whyTagline = imc?.whySectionTagline || "RACE IN PARADISE";
        const whyTitle = imc?.whySectionTitle || "WHY DO IRONMAN 70.3 LANGKAWI";
        const whySubtitle = imc?.whySectionSubtitle || "Pengalaman triathlon kelas dunia di salah satu destinasi kepulauan tropis terindah di Asia Tenggara.";
        const whyBg = imc?.whyBgColor || "#c35607";
        const whyCards = (imc?.whyCards && imc.whyCards.length > 0)
          ? imc.whyCards
          : [
              { id: "why-1", iconEmoji: "🏖️", title: "Cenang Beach Finish", description: "Finish di pasir putih Pantai Cenang di bawah sorak ribuan penonton dengan panorama magis matahari terbenam Samudra Hindia." },
              { id: "why-2", iconEmoji: "❄️", title: "Comfort Meets Performance", description: "Satu-satunya zona transisi sepeda indoor berpendingin udara (AC) di sirkuit World Series (MIEC Hall)." },
              { id: "why-3", iconEmoji: "🌴", title: "Langkawi Racecation", description: "Berlomba sekaligus berlibur di pulau bebas bea dengan status UNESCO Global Geopark dan resor bintang lima dunia." },
