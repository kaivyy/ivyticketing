      // TEMPLATE 8: SUPER CUSTOM STUDIO TEMPLATE (100% granular customizable)
      // =========================================================================
      function renderCustomTemplate(ev: MarathonEvent) {
        const lc = ev.layoutConfig;
        const primaryHref = getPrimaryActionHref(ev);
        const align = lc?.heroAlignment || "center";
        const alignCls = align === "left" ? "text-left items-start" : align === "right" ? "text-right items-end ml-auto" : "text-center items-center mx-auto";

        const primaryColor = lc?.customThemePrimary || ev.themeColor || "#ea580c";
        const accentColor = lc?.customThemeAccent || ev.accentColor || "#f59e0b";

        return `
          <div class="bg-slate-950 text-slate-100 font-body">
            <!-- Hero Super Custom -->
            <section class="relative overflow-hidden border-b border-slate-800 py-16 sm:py-20 bg-cover bg-center" style="background-image: linear-gradient(to bottom, rgba(11,15,23,0.8) 0%, rgba(11,15,23,0.96) 100%), url('${esc(ev.bannerUrl)}');">
              <div class="mx-auto max-w-7xl px-4 sm:px-6 flex flex-col ${alignCls} space-y-6">
                <span class="rounded bg-orange-600 text-white font-athletic font-bold px-3 py-1 text-xs uppercase" style="background-color: ${esc(primaryColor)};">
                  ${esc(ev.eventType)} · ${esc(ev.city)}
                </span>

                <div class="max-w-4xl space-y-2">
                  <h1 class="font-athletic text-3xl sm:text-6xl md:text-8xl font-black uppercase text-white tracking-tight leading-none">
                    ${esc(ev.name)}
                  </h1>
                  <p class="font-athletic text-xl sm:text-3xl uppercase tracking-wide font-bold" style="color: ${esc(accentColor)};">
