                              <span class="text-[9px] font-bold uppercase text-slate-400 block font-athletic">Biaya Pendaftaran</span>
                              <span class="font-athletic text-lg font-bold text-white">Rp ${cat.price.toLocaleString("id-ID")}</span>
                            </div>
                          </div>

                          <button
                            type="button"
