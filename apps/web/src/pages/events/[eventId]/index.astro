    <!-- Main Multi-Template Renderer Script -->
    <script>
      import {
        getMarathonEventById,
        getMarathonEvents,
        getHomepageConfig,
        fetchMarathonEventByIdFromServer,
        type MarathonEvent,
        type MarathonCategory,
      } from "../../../lib/events-store";
      import { esc } from "../../../lib/safe";

      const targetId = document.getElementById("event-root")?.getAttribute("data-event-id") || "";
      const loadingBox = document.getElementById("loading-box")!;
      const renderTarget = document.getElementById("render-target")!;
      const catModal = document.getElementById("category-modal")!;

      let currentEvent: MarathonEvent | null = null;

      function formatDate(iso: string) {
        try {
          return new Date(iso).toLocaleDateString("id-ID", {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric",
          });
        } catch {
          return iso;
        }
      }

      function getPrimaryActionHref(ev: MarathonEvent) {
        return `/events/${encodeURIComponent(ev.id)}/checkout`;
      }

      function openCategoryModal(cat: MarathonCategory) {
        if (!currentEvent) return;

        document.getElementById("modal-cat-title")!.textContent = cat.name;
        document.getElementById("modal-cat-dist")!.textContent = cat.distance;
        document.getElementById("modal-cat-cot")!.textContent = cat.cutoffTime;
        document.getElementById("modal-cat-flagoff")!.textContent = currentEvent.flagOffTime;
        document.getElementById("modal-cat-price")!.textContent = `Rp ${cat.price.toLocaleString("id-ID")}`;

        const badgeEl = document.getElementById("modal-cat-badge")!;
        badgeEl.textContent = cat.mode === "WAR_QUEUE" ? "WAR TICKET" : cat.mode === "BALLOT" ? "SISTEM BALLOT" : "REGULER BUKA";

        const includesList = document.getElementById("modal-cat-includes")!;
        includesList.innerHTML = (cat.includes || []).map(inc => `
          <li class="flex items-center gap-2">
            <svg class="h-3.5 w-3.5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>${esc(inc)}</span>
          </li>
        `).join("");

        const actionBtn = document.getElementById("modal-cat-action") as HTMLAnchorElement;
        actionBtn.href = `/events/${encodeURIComponent(currentEvent.id)}/checkout?categoryId=${encodeURIComponent(cat.id)}`;
        actionBtn.textContent = "Pilih Kategori & Lanjut Checkout";
        actionBtn.className = "min-h-[44px] w-full sm:w-auto inline-flex items-center justify-center rounded-xl bg-orange-600 px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow hover:bg-orange-500 transition-colors font-athletic";

        catModal.classList.remove("hidden");
      }

      document.getElementById("btn-close-cat-modal")?.addEventListener("click", () => {
        catModal.classList.add("hidden");
      });

      function startCountdown(targetIso: string) {
        function update() {
          const target = new Date(targetIso).getTime();
          const now = Date.now();
          const diff = Math.max(0, target - now);

          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((diff % (1000 * 60)) / 1000);

          const elD = document.getElementById("h-days");
          const elH = document.getElementById("h-hours");
          const elM = document.getElementById("h-minutes");
          const elS = document.getElementById("h-seconds");

          if (elD) elD.textContent = String(days).padStart(2, "0");
          if (elH) elH.textContent = String(hours).padStart(2, "0");
          if (elM) elM.textContent = String(minutes).padStart(2, "0");
          if (elS) elS.textContent = String(seconds).padStart(2, "0");
        }

        update();
        setInterval(update, 1000);
      }

      function getBtnRadiusClass(ev: MarathonEvent): string {
        const shape = ev.layoutConfig?.buttonShape;
        if (shape === "pill") return "rounded-full";
        if (shape === "rounded") return "rounded-xl";
        if (shape === "square") return "rounded-lg";
        return "rounded";
      }

      // =========================================================================
      // TEMPLATE 1: SUMMARECON BANDUNG RUN FEST (Authentic reference styling)
      // =========================================================================
      function renderSummareconTemplate(ev: MarathonEvent) {
        const primaryHref = getPrimaryActionHref(ev);
        const lc = ev.layoutConfig;
        const align = lc?.heroAlignment || "center";
        const alignCls = align === "left" ? "text-left items-start" : align === "right" ? "text-right items-end ml-auto" : "text-center items-center mx-auto";
        const btnRadius = getBtnRadiusClass(ev);

        return `
          <div class="bg-black text-white font-body selection:bg-[#F5EB15] selection:text-black">
            <!-- Hero Header Summarecon -->
            <section class="relative overflow-hidden min-h-[75vh] flex items-center bg-cover bg-center border-b border-slate-900" style="background-image: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.95) 100%), url('${esc(ev.bannerUrl)}');">
              <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 w-full flex flex-col ${alignCls} space-y-6">
                <!-- Certi circle and logos -->
                <div class="flex flex-wrap items-center gap-3">
                  <span class="rounded bg-[#F5EB15] text-black px-3 py-1 text-xs font-black uppercase font-athletic tracking-wider shadow">
                    ${esc(ev.certifiedBy || "PASI & WORLD ATHLETICS")}
                  </span>
                  <span class="rounded border border-[#F5EB15]/40 bg-black/60 backdrop-blur px-3 py-1 text-xs font-bold text-[#F5EB15] font-athletic uppercase">
                    ELEVATION: ${esc(ev.elevationGain || "FLAT COURSE")}
                  </span>
                </div>

                <!-- Big authentic typography -->
                <div class="space-y-3">
                  <h1 class="font-athletic text-4xl sm:text-6xl md:text-8xl font-black uppercase tracking-tight text-white leading-none break-words">
                    ${esc(ev.name)}
                  </h1>
                  <p class="font-athletic text-2xl sm:text-4xl text-[#F5EB15] uppercase tracking-wider font-extrabold break-words">
                    ${esc(ev.tagline || "Taklukkan Rekor Terbaik Anda")}
                  </p>
                  <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
                    ${esc(ev.description)}
                  </p>
                </div>

                <!-- Event quick meta pill row -->
                <div class="flex flex-wrap gap-2 text-xs font-athletic uppercase tracking-wider">
                  <span class="bg-[#F5EB15] text-black font-bold px-3 py-1.5 sm:px-3.5 sm:py-2 rounded">
                    FLAG-OFF: ${esc(ev.flagOffTime)}
                  </span>
                  <span class="bg-slate-900 border border-slate-800 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded text-white">
                    ${esc(ev.venueName)}
                  </span>
                </div>

                <!-- CTA buttons -->
                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 pt-2 w-full sm:w-auto">
                  <a
                    href="${primaryHref}"
                    class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 ${btnRadius} bg-gradient-to-r from-[#2EAF4A] to-[#F5EB15] px-6 sm:px-8 py-3 text-sm font-bold uppercase tracking-wider text-black shadow-lg hover:brightness-110 transition-all font-athletic text-center"
                  >
                    <span>${esc(ev.layoutConfig?.ctaButtonText || "DAFTAR SEKARANG")}</span>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                  </a>
                  <a
                    href="#section-race"
                    class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center ${btnRadius} border border-slate-700 bg-black/80 px-6 py-3 text-sm font-bold uppercase tracking-wider text-[#F5EB15] hover:bg-slate-900 transition-colors font-athletic text-center"
                  >
                    LIHAT KATEGORI & RUTE
                  </a>
                </div>
              </div>
            </section>

            <!-- Signature Yellow Section (Extracted from reference Section 2) -->
            <section class="bg-[#F5EB15] text-black w-full py-10 sm:py-16 px-4 sm:px-8">
              <div class="mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-8 items-center">
                <div class="md:col-span-8 space-y-2">
                  <h2 class="font-athletic text-3xl sm:text-5xl md:text-7xl font-extrabold uppercase leading-none tracking-tight break-words">NEW BANDUNG</h2>
                  <h2 class="font-athletic text-3xl sm:text-5xl md:text-7xl font-extrabold uppercase leading-none tracking-tight break-words">NEW ROADS</h2>
                  <h2 class="font-athletic text-3xl sm:text-5xl md:text-7xl font-extrabold uppercase leading-none tracking-tight pb-2 break-words">NEW POSSIBILITIES</h2>
                  <p class="text-xs sm:text-base font-semibold max-w-2xl leading-relaxed">
                    Be part of something extraordinary. Run through Bandung's most iconic landmark and experience a race like never before with wide asphalt roads, vibrant cheer zones, and flat PB course.
                  </p>
                </div>
                <div class="md:col-span-4 flex flex-col items-start md:items-end justify-center space-y-3">
                  <span class="font-athletic text-lg sm:text-xl font-bold uppercase tracking-wider bg-black text-[#F5EB15] px-4 py-2 rounded">
                    SUPER FLAT COURSE
                  </span>
                  <span class="text-xs font-bold text-slate-800 uppercase font-athletic">Elevasi: ${esc(ev.elevationGain)}</span>
                </div>
              </div>
            </section>

            <!-- Signature Black Race Cards Section (Extracted from reference Section 3) -->
            <section id="section-race" class="bg-[#000000] w-full py-12 sm:py-16 px-4 sm:px-6">
              <div class="mx-auto max-w-7xl space-y-6 sm:space-y-8">
                <div class="border-b border-slate-800 pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
                  <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-[#F5EB15] font-athletic block">
                      OFFICIAL RACE CATEGORIES
