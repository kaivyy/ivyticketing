            <!-- Signature Callout Banner (Extracted from reference Section 6): The Road is Finally Yours -->
            <section class="py-16 sm:py-20 px-4 sm:px-8 bg-cover bg-center border-b border-slate-900 relative" style="background-image: linear-gradient(to right, #000 0%, rgba(0,0,0,0.85) 45%, rgba(0,0,0,0.5) 100%), url('${esc(ev.bannerUrl)}');">
              <div class="mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
