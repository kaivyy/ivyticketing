            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><circle cx="12" cy="24" r="5" /><circle cx="28" cy="24" r="5" /><path d="M12 24l5-9h4l4 9m-4-9l-5 9h9" stroke-linecap="round" stroke-linejoin="round" /><path d="M21 15v-2h3" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
          case "run":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><circle cx="23" cy="12" r="2.5" /><path d="M19 16l3 4 4-2" stroke-linecap="round" stroke-linejoin="round" /><path d="M19 16l-3 5 3 4" stroke-linecap="round" stroke-linejoin="round" /><path d="M22 20l-4 7-4-2" stroke-linecap="round" stroke-linejoin="round" /><path d="M22 20l3 4 4 3" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
          case "sun":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><circle cx="20" cy="20" r="6" /><path d="M20 7v3M20 30v3M7 20h3M30 20h3M11 11l2 2M27 27l2 2M11 29l2-2M27 13l2-2" stroke-linecap="round" /></svg>`;
          case "snowflake":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><path d="M20 9v22M9 20h22M12 12l16 16M12 28l16-16" stroke-linecap="round" /><path d="M17 11l3 3 3-3M17 29l3-3 3 3M11 17l3 3-3 3M29 17l-3 3 3 3" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
          case "water":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><path d="M20 10c0 0-7 9-7 13a7 7 0 0014 0c0-4-7-13-7-13z" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
          case "thermometer":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><path d="M18 22V11a2 2 0 114 0v11a4 4 0 11-4 0z" stroke-linecap="round" stroke-linejoin="round" /><circle cx="20" cy="25" r="2" fill="currentColor" /></svg>`;
          case "wind":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><path d="M10 16h13a3 3 0 000-6 3 3 0 00-3 3M8 20h19a3 3 0 010 6 3 3 0 01-3-3M12 24h10a2 2 0 000-4" stroke-linecap="round" /></svg>`;
          case "mountain":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><path d="M9 28l9-14 6 9 3-4 5 9H9z" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
          case "trophy":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><path d="M14 13h12v7a6 6 0 01-12 0v-7zM14 15H11a2 2 0 00-2 2v1a3 3 0 003 3h2M26 15h3a2 2 0 012 2v1a3 3 0 01-3 3h-2M20 26v4M16 30h8" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
          case "medal":
            return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><circle cx="20" cy="24" r="5" /><path d="M17 11l3 8 3-8M14 11l4 9M26 11l-4 9" stroke-linecap="round" /></svg>`;
          case "flag":
