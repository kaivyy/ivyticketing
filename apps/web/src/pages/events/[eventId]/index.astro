                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                  ${ev.categories.map((cat, idx) => {
                    const numStr = String(idx + 1).padStart(2, "0");
                    return `
                      <div
                        class="relative overflow-hidden rounded-xl border border-slate-800 bg-slate-950 flex flex-col justify-between min-h-[380px] sm:min-h-[420px] p-4 sm:p-6 bg-cover bg-center race-card-hover hover:border-[#2EAF4A]/80 hover:shadow-[0_20px_45px_rgba(46,175,74,0.25)] group"
                        style="background-image: linear-gradient(to top, rgba(0, 0, 0, 0.96) 0%, rgba(0, 0, 0, 0.8) 40%, rgba(0, 0, 0, 0.4) 100%), url('${esc(ev.bannerUrl)}');"
                      >
                        <div class="flex items-start justify-between">
