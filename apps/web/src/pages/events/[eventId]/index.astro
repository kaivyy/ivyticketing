                              ${esc(cat.mode === "WAR_QUEUE" ? "WAR TICKET" : cat.mode === "BALLOT" ? "UNDIAN BALLOT" : "REGULER BUKA")}
                            </h4>
                          </div>
                        </div>

                        <div class="my-auto space-y-1 pt-6">
