---
export const prerender = false;
import "../../styles/global.css";

const SPONSORS = [
  { name: "Bank of America", role: "Presenting Partner", logo: "/images/events/sponsor_bofa.png", h: "h-8" },
  { name: "adidas", role: "Official Footwear & Apparel", logo: "/images/events/sponsor_adidas.png", h: "h-9" },
  { name: "Abbott World Marathon Majors", role: "Official Series", logo: "/images/events/sponsor_abbott.png", h: "h-8" },
  { name: "Samuel Adams", role: "Official Beer", logo: "/images/events/sponsor_samadams.svg", h: "h-8" },
  { name: "Schneider Electric", role: "Sustainability Partner", logo: "/images/events/sponsor_schneider.png", h: "h-7" },
  { name: "New England Honda", role: "Official Vehicle", logo: "/images/events/sponsor_honda.svg", h: "h-7" },
  { name: "Maurten", role: "Official Sports Fuel", logo: "/images/events/sponsor_maurten.svg", h: "h-7" },
  { name: "Poland Spring", role: "Official Natural Spring Water", logo: "/images/events/sponsor_polandspring.svg", h: "h-8" },
  { name: "Shokz", role: "Official Headphones", logo: "/images/events/sponsor_shokz.svg", h: "h-6" },
  { name: "JetBlue", role: "Official Airline", logo: "/images/events/sponsor_jetblue.svg", h: "h-6" },
  { name: "Gatorade", role: "Official Sports Drink", logo: "/images/events/sponsor_gatorade.png", h: "h-8" },
  { name: "CITGO", role: "Official Landmark Partner", logo: "/images/events/sponsor_citgo.svg", h: "h-7" },
];
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jelajahi Event Marathon & Multi-Sports : ivyticketing</title>
    <meta
      name="description"
      content="Daftar resmi ajang lari marathon, half marathon, 10K, triathlon, dan fun run berstandar internasional. Sistem war antrean anti-bot dan undian ballot transparan."
    />
    <style is:global>
      /* Dynamic Theme Variables */
      :root {
        --color-bg-dark: #0a1120;
        --color-bg-rgb: 10, 17, 32;
        --color-surface-dark: #101a2e;
        --color-surface-rgb: 16, 26, 46;
        --color-surface-card: #17243d;
        --color-surface-card-rgb: 23, 36, 61;
        --color-accent: #ea580c;
        --color-accent-rgb: 234, 88, 12;
        --color-accent-hover: #c2410c;
        --color-text: #f8fafc;
      }

      .theme-bg-primary {
        background-color: var(--color-bg-dark);
      }
      .theme-surface {
        background-color: var(--color-surface-dark);
      }
      .theme-accent-bg {
        background-color: var(--color-accent);
      }
      .theme-accent-text {
        color: var(--color-accent);
      }
      .theme-accent-border {
        border-color: var(--color-accent);
      }

      /* Dynamic Corner Radius Enforcements (Square / Rounded / Pill) */
      .corner-square .theme-card,
      .corner-square .category-card,
      .corner-square .card-box,
      .corner-square article,
      .corner-square #catalog-control-bar,
      .corner-square #empty-state,
      .corner-square .rounded-xl,
      .corner-square .rounded-2xl,
      .corner-square .rounded-lg,
      .corner-square .rounded-md {
        border-radius: 0px !important;
      }
      .corner-square button,
      .corner-square .theme-accent-bg,
      .corner-square .sport-btn,
      .corner-square .mode-btn,
      .corner-square .dist-chip,
      .corner-square .mob-bottom-tab {
        border-radius: 0px !important;
      }

      .corner-pill .theme-card,
      .corner-pill .category-card,
      .corner-pill article,
      .corner-pill #catalog-control-bar {
        border-radius: 24px !important;
      }

      .corner-rounded .theme-card,
      .corner-rounded .category-card,
      .corner-rounded article,
      .corner-rounded #catalog-control-bar {
        border-radius: 12px !important;
      }

      /* Fixed navbar enforcement: header must never push content down in normal flow */
      #main-nav {
        position: fixed !important;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 50;
        box-sizing: border-box;
      }

      /* Liquid Glass Navbar Styling */
      .glass {
        position: relative;
        --glass-blur: 0px;
        --glass-saturate: 1;
        --glass-tint: rgba(255, 255, 255, 0.255);
        --glass-radius: 48px;

        box-sizing: border-box;
        -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
        backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
        background: var(--glass-tint);
        border-radius: var(--glass-radius);
        border: 1px solid rgba(255, 255, 255, 0.128);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.245);
      }

      .glass::before {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.38) 0%,
          rgba(255, 255, 255, 0.16) 35%,
          rgba(255, 255, 255, 0.04) 65%,
          rgba(255, 255, 255, 0.22) 100%
        );
        -webkit-mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
      }

      .glass > .glass-specular {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        overflow: hidden;
        pointer-events: none;
      }
      .glass > .glass-specular::before {
        content: "";
        position: absolute;
        top: 0;
        left: 24px;
        right: 24px;
        height: 50%;
        background: radial-gradient(
          ellipse at top,
          rgba(255, 255, 255, 0.42) 0%,
          rgba(255, 255, 255, 0) 70%
        );
      }

      @supports (background: paint(gg-glass-probe)) {
        .glass {
          -webkit-backdrop-filter: url(#gg-glass-filter) blur(var(--glass-blur)) saturate(var(--glass-saturate));
          backdrop-filter: url(#gg-glass-filter) blur(var(--glass-blur)) saturate(var(--glass-saturate));
        }
      }

      @media (prefers-reduced-transparency: reduce) {
        .glass {
          -webkit-backdrop-filter: none;
          backdrop-filter: none;
          background: #0f172a;
          border-color: rgba(255, 255, 255, 0.15);
        }
      }

      /* Moving Sponsor Reel Marquee */
      @keyframes baaSponsorMarquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }
      .baa-sponsor-track {
        display: flex;
        width: max-content;
        animation: baaSponsorMarquee 28s linear infinite;
      }
      .baa-sponsor-track:hover {
        animation-play-state: paused;
      }
    </style>
  </head>
  <body class="theme-bg-primary corner-square text-slate-100 antialiased selection:bg-orange-500 selection:text-white flex flex-col min-h-screen">
    <!-- SVG Refraction Filter for Liquid Glass Navbar (720x72) -->
    <svg class="pointer-events-none absolute h-0 w-0" aria-hidden="true" focusable="false">
      <defs>
        <filter id="gg-glass-filter" filterUnits="userSpaceOnUse" x="0" y="0" width="720" height="72">
          <feTurbulence type="fractalNoise" baseFrequency="0.02 0.05" numOctaves="1" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="5" xChannelSelector="R" yChannelSelector="G" />
        </filter>
      </defs>
    </svg>

    <!-- Navbar Navigasi Utama (Bentuk, Transparansi & Brand Dinamis dari Admin) -->
    <header
      id="main-nav"
      class="fixed top-0 left-0 right-0 w-full z-50 transition-all duration-300 overflow-hidden"
    >
      <span class="glass-specular hidden" id="main-nav-specular" aria-hidden="true"></span>
      <div id="main-nav-inner" class="mx-auto flex max-w-7xl items-center justify-between px-3 py-2.5 sm:px-6 sm:py-3 w-full h-full">
        <!-- Brand Link dengan Mode Kustomisasi: icon_only / text_only / both -->
        <a href="/" id="nav-brand-container" class="flex items-center gap-2.5 sm:gap-3 group focus:outline-hidden focus:ring-2 focus:ring-orange-500 rounded-lg p-1 min-w-0" aria-label="Kembali ke Beranda">
          <!-- Athletic Vector Icon (Default: IVY Icon Only) -->
          <div id="nav-brand-icon-wrapper" class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center shrink-0">
            <img
              id="nav-brand-icon-img"
              src="/images/ivy-icon.svg"
              alt="IVY Icon"
              class="h-9 w-9 sm:h-10 sm:w-10 shrink-0 transition-transform group-hover:scale-105"
            />
          </div>
          <!-- Brand Text (Hidden by default in icon_only mode) -->
          <div id="nav-brand-text-wrapper" class="hidden flex-col min-w-0">
            <span id="nav-brand-title" class="font-display text-lg sm:text-2xl font-bold tracking-tight text-white uppercase leading-none truncate">
              Ivy<span class="brand-accent-highlight theme-accent-text">Ticketing</span>
            </span>
            <span id="nav-brand-tagline" class="text-[9px] sm:text-[10px] font-semibold tracking-widest text-slate-400 uppercase truncate max-w-[140px] sm:max-w-none">
              Sports Registration Engine
            </span>
          </div>
        </a>

        <!-- Menu Desktop (Sama Persis dengan Beranda dan Halaman Lain) -->
        <nav class="hidden items-center gap-6 xl:gap-7 text-sm font-medium text-slate-300 lg:flex" aria-label="Navigasi Utama">
          <a href="/#featured-events" class="transition-colors hover:text-orange-400">Event Pilihan</a>
          <a href="/#categories" class="transition-colors hover:text-orange-400">Kategori Lomba</a>
          <a href="/#registration-modes" class="transition-colors hover:text-orange-400">Sistem War & Ballot</a>
          <a href="/#templates" class="transition-colors hover:text-orange-400">Template Organizer</a>
          <a href="/events" class="transition-colors text-white font-bold border-b-2 theme-accent-border pb-0.5">Jelajahi Semua</a>
        </nav>

        <!-- CTA Desktop -->
        <div class="hidden items-center gap-2.5 sm:flex">
          <a
            href="/login"
            class="min-h-[44px] inline-flex items-center justify-center rounded-lg border border-slate-700 bg-slate-900/80 px-3.5 py-2 text-xs sm:text-sm font-medium text-slate-200 transition-colors hover:border-slate-500 hover:bg-slate-800"
          >
            Masuk Akun
          </a>
          <a
            href="/register"
            class="min-h-[44px] inline-flex items-center justify-center rounded-lg border border-orange-500/40 bg-orange-950/40 px-3.5 py-2 text-xs sm:text-sm font-bold text-orange-400 transition-colors hover:bg-orange-900/60"
          >
            Daftar Akun
          </a>
          <a
            href="/admin/events"
            class="min-h-[44px] inline-flex items-center justify-center rounded-lg theme-accent-bg px-4 py-2 text-xs sm:text-sm font-bold uppercase tracking-wide text-white shadow-md transition-all active:scale-95 hover:opacity-90"
          >
            Kelola Admin
          </a>
        </div>

        <!-- Tombol Mobile Menu -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-white/20 bg-white/5 text-slate-200 hover:bg-white/10 hover:text-white focus:outline-hidden active:scale-95 lg:hidden transition-all"
          aria-label="Buka Menu Navigasi"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Drawer Navigasi Mobile -->
      <div id="mobile-menu" class="hidden px-4 py-5 lg:hidden max-h-[calc(100vh-5rem)] overflow-y-auto transition-all">
        <nav class="flex flex-col gap-4 text-base font-medium text-slate-200">
          <a href="/#featured-events" class="mobile-nav-link py-1 hover:text-orange-400">Event Pilihan</a>
          <a href="/#categories" class="mobile-nav-link py-1 hover:text-orange-400">Kategori Lomba</a>
          <a href="/#registration-modes" class="mobile-nav-link py-1 hover:text-orange-400">Sistem War & Ballot</a>
          <a href="/#templates" class="mobile-nav-link py-1 hover:text-orange-400">Template Organizer</a>
          <a href="/events" class="mobile-nav-link py-1 text-orange-400 font-bold">Jelajahi Semua Event</a>
          <div class="mt-3 flex flex-col gap-2.5 pt-3 border-t border-white/10">
            <div class="grid grid-cols-2 gap-2">
              <a
                href="/login"
                class="min-h-[44px] flex items-center justify-center rounded-lg border border-slate-700 py-2.5 text-sm font-medium text-slate-200 hover:bg-slate-800"
              >
                Masuk
              </a>
              <a
                href="/register"
                class="min-h-[44px] flex items-center justify-center rounded-lg border border-orange-500/40 bg-orange-950/40 py-2.5 text-sm font-bold text-orange-400 hover:bg-orange-900/60"
              >
                Daftar Akun
              </a>
            </div>
            <a
              href="/admin/events"
              class="min-h-[44px] flex items-center justify-center rounded-lg theme-accent-bg py-2.5 text-sm font-bold uppercase text-white shadow-md hover:opacity-90"
            >
              Kelola di Admin
            </a>
          </div>
        </nav>
      </div>
    </header>

    <!-- Mobile Bottom Navigation Bar (Khusus Layar Mobile: 4 Menu Utama Ergonomis) -->
    <nav
      id="mobile-bottom-nav"
      class="fixed bottom-0 left-0 right-0 z-50 flex lg:hidden items-center justify-around border-t border-white/10 bg-slate-950/95 backdrop-blur-xl px-2 py-1.5 pb-[max(0.5rem,env(safe-area-inset-bottom))] shadow-2xl transition-all duration-200"
      aria-label="Navigasi Utama Mobile"
    >
      <a
        href="/"
        id="mob-tab-home"
        class="mob-bottom-tab flex flex-1 flex-col items-center justify-center min-h-[48px] py-1 text-[11px] font-semibold tracking-tight text-slate-400 hover:text-slate-200 transition-colors"
      >
        <svg class="h-5 w-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Beranda</span>
      </a>

      <a
        href="/events"
        id="mob-tab-events"
        class="mob-bottom-tab active flex flex-1 flex-col items-center justify-center min-h-[48px] py-1 text-[11px] font-bold tracking-tight text-orange-500 transition-colors"
      >
        <svg class="h-5 w-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Event</span>
      </a>

      <a
        href="/#registration-modes"
        id="mob-tab-war"
        class="mob-bottom-tab flex flex-1 flex-col items-center justify-center min-h-[48px] py-1 text-[11px] font-semibold tracking-tight text-slate-400 hover:text-slate-200 transition-colors"
      >
        <svg class="h-5 w-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>War & Ballot</span>
      </a>

      <a
        href="/login"
        id="mob-tab-account"
        class="mob-bottom-tab flex flex-1 flex-col items-center justify-center min-h-[48px] py-1 text-[11px] font-semibold tracking-tight text-slate-400 hover:text-slate-200 transition-colors"
      >
        <svg class="h-5 w-5 mb-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>Akun</span>
      </a>
    </nav>

    <!-- Main Content Area with Dynamic Padding Top based on Navbar Style -->
    <main id="main-content" class="flex-1 pt-24 sm:pt-28 pb-24 lg:pb-12 transition-all duration-300">
      <!-- Compact Athletic Hero Strip -->
      <section class="relative overflow-hidden border-b border-white/10 bg-slate-900/70 py-6 sm:py-8">
        <div class="absolute inset-0 z-0 opacity-15">
          <img
            src="/images/events/hero_marathon.jpg"
            alt="Latar Belakang Pelari Marathon"
            class="h-full w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/80 to-transparent"></div>
        </div>

        <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1.5 max-w-2xl">
              <div class="inline-flex items-center gap-2 rounded-full border border-orange-500/30 bg-orange-500/10 px-2.5 py-0.5 text-[11px] font-semibold text-orange-400">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-500 animate-pulse"></span>
                <span>Kalender Resmi Musim Lomba 2026</span>
              </div>
              <h1 class="font-display text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-white uppercase leading-tight">
                Jelajahi Ajang Lari & Multi-Sports Bergengsi
              </h1>
              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
                Pilih lintasan impian Anda. Dari panggung World Marathon Majors Boston & Tokyo, lintasan rekor dunia Berlin, hingga ajang bersejarah Borobudur dan IRONMAN Triathlon.
              </p>
            </div>

            <!-- Factual Metadata Badges -->
            <div class="flex flex-wrap md:flex-col gap-2 shrink-0">
              <div class="inline-flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-900/90 px-3 py-1.5 text-xs text-slate-300">
                <span>🏆</span>
                <span>Sertifikasi PASI, AIMS & World Athletics</span>
              </div>
              <div class="inline-flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-900/90 px-3 py-1.5 text-xs text-orange-300">
                <span>⚡</span>
                <span>Sistem War Anti-Bot & Ballot Transparan</span>
              </div>
              <div class="inline-flex items-center gap-2 rounded-lg border border-slate-800 bg-slate-900/90 px-3 py-1.5 text-xs text-emerald-300">
                <span>💳</span>
                <span>QRIS Dinamis & Virtual Account Resmi</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Animated Moving Sponsor Reel / Ticker ("gambar sponsor bergerak") -->
      <section class="relative border-b border-white/10 bg-slate-950 py-3 shadow-inner overflow-hidden" aria-label="Official Partners Reel">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 mb-2 flex items-center justify-between">
          <span class="text-[10px] font-black uppercase tracking-widest text-orange-400 font-mono">
            OFFICIAL PARTNERS OF WORLD ATHLETICS & MARATHON SERIES
          </span>
          <span class="font-mono text-[10px] text-slate-400 hidden sm:inline">
            Auto-Scroll · Pause on Hover
          </span>
        </div>

        <div class="relative overflow-hidden w-full">
          <div class="baa-sponsor-track flex items-center gap-4 py-1">
            <!-- First Strip of Sponsor Logos -->
            {SPONSORS.map((sp) => (
              <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-slate-900/80 px-4 py-2 shrink-0 backdrop-blur-md shadow-sm hover:border-orange-500/60 transition-colors">
                <img src={sp.logo} alt={sp.name} class={`${sp.h} w-auto max-w-[140px] object-contain shrink-0`} />
                <div class="flex flex-col text-left">
                  <span class="text-[9px] font-bold uppercase text-slate-400 leading-none">{sp.role}</span>
                  <span class="text-xs font-bold text-white leading-tight mt-0.5">{sp.name}</span>
                </div>
              </div>
            ))}

            <!-- Duplicated Strip for Seamless Infinite Loop -->
            {SPONSORS.map((sp) => (
              <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-slate-900/80 px-4 py-2 shrink-0 backdrop-blur-md shadow-sm hover:border-orange-500/60 transition-colors" aria-hidden="true">
                <img src={sp.logo} alt={sp.name} class={`${sp.h} w-auto max-w-[140px] object-contain shrink-0`} />
                <div class="flex flex-col text-left">
                  <span class="text-[9px] font-bold uppercase text-slate-400 leading-none">{sp.role}</span>
                  <span class="text-xs font-bold text-white leading-tight mt-0.5">{sp.name}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Filter & Event Showcase Section (Immediate Viewport Focus) -->
      <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 space-y-6">
        <!-- Unified Control Bar: Search, Sports, Modes, and Distances -->
        <div id="catalog-control-bar" class="rounded-2xl border border-slate-800 bg-slate-900/90 p-4 sm:p-5 space-y-3.5 shadow-sm transition-colors">
          <!-- Row 1: Search & Counter -->
          <div class="flex flex-col sm:flex-row gap-3 items-center justify-between">
            <div class="relative w-full sm:w-96">
              <input
                id="search-input"
                type="text"
                placeholder="Cari nama event, kota, atau penyelenggara..."
                class="min-h-[44px] w-full rounded-xl border border-slate-700 bg-slate-950 pl-10 pr-4 text-xs sm:text-sm text-white placeholder-slate-500 focus:border-orange-500 focus:outline-hidden focus:ring-1 focus:ring-orange-500 transition-colors"
              />
              <svg class="absolute left-3.5 top-3.5 h-4 w-4 text-slate-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
              <span id="event-count-badge" class="text-xs font-semibold text-slate-400 font-mono">
                Memuat kalender event...
              </span>
              <button
                type="button"
                id="btn-reset-filters"
