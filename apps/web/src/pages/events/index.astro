    <!-- Script Rendering, Live Synchronized Navbar & Themed Cards from Admin -->
    <script>
      import { getMarathonEvents, getHomepageConfig, syncHomepageConfigFromServer, syncMarathonEventsFromServer, type MarathonEvent, type HomepageConfig } from "../../lib/events-store";
      import { esc } from "../../lib/safe";

      const HOMEPAGE_CONFIG_STORAGE_KEY = "ivy_platform_homepage_config";

      function getSavedConfig(): HomepageConfig {
        return getHomepageConfig();
      }

      function hexToRgb(hex: string) {
        if (!hex) return { r: 10, g: 17, b: 32 };
        let clean = String(hex).replace("#", "").trim();
        if (clean.length === 3) {
          clean = clean.split("").map((c) => c + c).join("");
        }
        const num = parseInt(clean, 16);
        if (isNaN(num)) return { r: 10, g: 17, b: 32 };
        return {
          r: (num >> 16) & 255,
          g: (num >> 8) & 255,
          b: num & 255,
        };
      }

      function adjustHexBrightness(hex: string, percent: number) {
        const { r, g, b } = hexToRgb(hex);
        const adjust = (val: number) => Math.min(255, Math.max(0, Math.round(val + (val * percent) / 100)));
        const nr = adjust(r).toString(16).padStart(2, "0");
        const ng = adjust(g).toString(16).padStart(2, "0");
        const nb = adjust(b).toString(16).padStart(2, "0");
        return `#${nr}${ng}${nb}`;
      }

      // ── 1. Sinkronisasi Brand Navbar dengan Pengaturan Admin ──
      function applyBrandConfig(brand: any) {
        if (!brand) return;
        const iconWrapper = document.getElementById("nav-brand-icon-wrapper");
        const textWrapper = document.getElementById("nav-brand-text-wrapper");
        const iconImg = document.getElementById("nav-brand-icon-img") as HTMLImageElement | null;
        const titleEl = document.getElementById("nav-brand-title");
        const tagEl = document.getElementById("nav-brand-tagline");

        const mode = brand.displayMode || "icon_only";

        if (iconWrapper && textWrapper) {
          if (mode === "icon_only") {
            iconWrapper.classList.remove("hidden");
            textWrapper.classList.add("hidden");
          } else if (mode === "text_only") {
            iconWrapper.classList.add("hidden");
            textWrapper.classList.remove("hidden");
            textWrapper.classList.add("flex");
          } else {
            // both
            iconWrapper.classList.remove("hidden");
            textWrapper.classList.remove("hidden");
            textWrapper.classList.add("flex");
          }
        }

        if (iconImg && brand.customIconUrl) {
          iconImg.src = brand.customIconUrl;
        }

        if (titleEl && brand.brandName) {
          titleEl.innerHTML = brand.brandName.includes("Ivy")
            ? brand.brandName.replace("Ivy", 'Ivy<span class="brand-accent-highlight theme-accent-text">') + "</span>"
            : brand.brandName;
        }
        if (tagEl && brand.tagline) {
          tagEl.textContent = brand.tagline;
        }
      }

      // ── 2. Sinkronisasi Bentuk, Transparansi & Efek Navbar ──
      function applyNavbarConfig(navCfg: any) {
        const nav = document.getElementById("main-nav");
        const specular = document.getElementById("main-nav-specular");
        const inner = document.getElementById("main-nav-inner");
        const mobileMenu = document.getElementById("mobile-menu");
        const mainContent = document.getElementById("main-content");
        if (!nav) return;

        const isMobile = window.innerWidth < 1024;
        const style = navCfg?.style || "full_width";
        const op = navCfg.opacity !== undefined ? Number(navCfg.opacity) : 0.92;
        const blurMap: Record<string, string> = { none: "none", sm: "blur(4px)", md: "blur(12px)", lg: "blur(20px)" };
        const chosenBlur = blurMap[navCfg.blur || "md"] || "blur(12px)";
        const showBorder = navCfg.showBorder !== false;
        const isMenuOpen = mobileMenu && !mobileMenu.classList.contains("hidden");

        const currentTheme = getSavedConfig().theme;
        const bgRgb = hexToRgb(currentTheme?.bgColor || "#0a1120");
        const navBg = `rgba(${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}, ${op})`;
        const navBgSolid = `rgba(${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}, 0.98)`;

        nav.style.position = "fixed";
        nav.style.zIndex = "50";

        if (style === "liquid_glass") {
          nav.classList.add("glass");

          const gBlur = navCfg.glassBlur !== undefined ? Number(navCfg.glassBlur) : 0;
          const gSat = navCfg.glassSaturate !== undefined ? Number(navCfg.glassSaturate) : 1;
          const gTint = navCfg.glassTint || "rgba(255, 255, 255, 0.255)";
          const gRad = navCfg.glassRadius !== undefined ? Number(navCfg.glassRadius) : 48;

          nav.style.setProperty("--glass-blur", `${gBlur}px`);
          nav.style.setProperty("--glass-saturate", `${gSat}`);
          nav.style.setProperty("--glass-tint", gTint);
          nav.style.setProperty("--glass-radius", `${gRad}px`);

          if (isMobile) {
            nav.style.top = "12px";
            nav.style.left = "50%";
            nav.style.right = "auto";
            nav.style.transform = "translateX(-50%)";
            nav.style.width = "calc(100vw - 1.5rem)";
            nav.style.maxWidth = "720px";
            nav.style.minHeight = "64px";
            nav.style.borderRadius = isMenuOpen ? "24px" : `${gRad}px`;
            nav.style.overflow = "hidden";
            nav.style.boxShadow = "0 12px 32px rgba(0, 0, 0, 0.35)";
          } else {
            nav.style.top = "16px";
            nav.style.left = "50%";
            nav.style.right = "auto";
            nav.style.transform = "translateX(-50%)";
            nav.style.width = "min(720px, calc(100vw - 2rem))";
            nav.style.maxWidth = "720px";
            nav.style.minHeight = "72px";
            nav.style.borderRadius = `${gRad}px`;
            nav.style.overflow = "hidden";
            nav.style.boxShadow = "";
          }

          nav.style.border = "";
          nav.style.borderBottom = "";
          nav.style.backgroundColor = "";
          nav.style.backdropFilter = "";

          if (specular) specular.classList.remove("hidden");
          if (inner) {
            inner.style.maxWidth = "720px";
            inner.style.padding = isMobile ? "0 16px" : "0 20px";
            inner.style.height = isMobile ? "64px" : "72px";
          }

          if (mobileMenu) {
            mobileMenu.style.backgroundColor = navBgSolid;
            mobileMenu.style.borderTop = "1px solid rgba(255, 255, 255, 0.12)";
            mobileMenu.style.borderBottom = "none";
          }

          if (mainContent) {
            mainContent.style.paddingTop = isMobile ? "88px" : "104px";
          }
        } else if (style === "floating_compact") {
          nav.classList.remove("glass");

          if (isMobile) {
            nav.style.top = "12px";
            nav.style.left = "50%";
            nav.style.right = "auto";
            nav.style.transform = "translateX(-50%)";
            nav.style.width = "calc(100vw - 1.5rem)";
            nav.style.maxWidth = "1152px";
            nav.style.minHeight = "64px";
            nav.style.borderRadius = "16px";
            nav.style.overflow = "hidden";
          } else {
            nav.style.top = "16px";
            nav.style.left = "50%";
            nav.style.right = "auto";
            nav.style.transform = "translateX(-50%)";
            nav.style.width = "min(1152px, calc(100vw - 2rem))";
            nav.style.maxWidth = "1152px";
            nav.style.minHeight = "64px";
            nav.style.borderRadius = "16px";
            nav.style.overflow = "hidden";
          }

          nav.style.backgroundColor = navBg;
          nav.style.backdropFilter = chosenBlur;
          (nav.style as any).webkitBackdropFilter = chosenBlur;
          nav.style.border = showBorder ? "1px solid rgba(255, 255, 255, 0.12)" : "none";
          nav.style.boxShadow = "0 8px 30px rgba(0, 0, 0, 0.3)";

          if (specular) specular.classList.add("hidden");
          if (inner) {
            inner.style.maxWidth = "1152px";
            inner.style.padding = isMobile ? "0 16px" : "0 16px";
            inner.style.height = "64px";
          }

          if (mobileMenu) {
            mobileMenu.style.backgroundColor = navBgSolid;
            mobileMenu.style.borderTop = showBorder ? "1px solid rgba(255, 255, 255, 0.12)" : "none";
            mobileMenu.style.borderBottom = "none";
          }

          if (mainContent) {
            mainContent.style.paddingTop = isMobile ? "88px" : "96px";
          }
        } else {
          // full_width
          nav.classList.remove("glass");

          nav.style.top = "0";
          nav.style.left = "0";
          nav.style.right = "0";
          nav.style.transform = "none";
          nav.style.width = "100%";
          nav.style.maxWidth = "none";
          nav.style.minHeight = "64px";
          nav.style.borderRadius = "0";
          nav.style.overflow = "hidden";
          nav.style.backgroundColor = navBg;
          nav.style.backdropFilter = chosenBlur;
          (nav.style as any).webkitBackdropFilter = chosenBlur;
          nav.style.border = "none";
          nav.style.borderBottom = showBorder ? "1px solid rgba(255, 255, 255, 0.1)" : "none";
          nav.style.boxShadow = "none";

          if (specular) specular.classList.add("hidden");
          if (inner) {
            inner.style.maxWidth = "1280px";
            inner.style.padding = isMobile ? "0 16px" : "0 24px";
            inner.style.height = "64px";
          }

          if (mobileMenu) {
            mobileMenu.style.backgroundColor = navBgSolid;
            mobileMenu.style.borderTop = showBorder ? "1px solid rgba(255, 255, 255, 0.1)" : "none";
            mobileMenu.style.borderBottom = "none";
          }

          if (mainContent) {
            mainContent.style.paddingTop = "64px";
          }
        }

        // Kontrol visibilitas Mobile Bottom Navbar vs Top Bar
        const mobileNavType = navCfg?.mobileNavType || "bottom_nav";
        const bottomNav = document.getElementById("mobile-bottom-nav");
        const menuBtn = document.getElementById("mobile-menu-btn");

        if (isMobile) {
          if (mobileNavType === "bottom_nav") {
            if (bottomNav) bottomNav.classList.remove("hidden");
            if (menuBtn) menuBtn.classList.add("hidden");
            if (mobileMenu) mobileMenu.classList.add("hidden");
          } else {
            if (bottomNav) bottomNav.classList.add("hidden");
            if (menuBtn) menuBtn.classList.remove("hidden");
          }
        } else {
          if (bottomNav) bottomNav.classList.add("hidden");
          if (menuBtn) menuBtn.classList.add("hidden");
          if (mobileMenu) mobileMenu.classList.add("hidden");
        }
      }

      // ── 2b. Sinkronisasi Gaya Sudut Elemen (Kotak Tegas / Rounded / Pill) ──
      function applyCornerConfig(cornerCfg: any) {
        const cornerStyle = cornerCfg?.style || "square";
        document.body.classList.remove("corner-square", "corner-rounded", "corner-pill");
        document.body.classList.add(`corner-${cornerStyle}`);
      }

      // ── 3. Sinkronisasi Tema Global Website ──
      function applyThemeConfig(themeCfg: any) {
        if (!themeCfg) return;
        const bg = themeCfg.bgColor || "#0a1120";
        const surface = themeCfg.surfaceColor || "#101a2e";
        const text = themeCfg.textColor || "#f8fafc";
        const accent = themeCfg.accentColor || "#ea580c";
        const accentHover = adjustHexBrightness(accent, -15);
        const cardBg = adjustHexBrightness(surface, 12);

        const bgRgb = hexToRgb(bg);
        const surfaceRgb = hexToRgb(surface);
        const cardRgb = hexToRgb(cardBg);
        const accentRgb = hexToRgb(accent);

        const root = document.documentElement;
        root.style.setProperty("--color-bg-dark", bg);
        root.style.setProperty("--color-bg-rgb", `${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}`);
        root.style.setProperty("--color-surface-dark", surface);
        root.style.setProperty("--color-surface-rgb", `${surfaceRgb.r}, ${surfaceRgb.g}, ${surfaceRgb.b}`);
        root.style.setProperty("--color-surface-card", cardBg);
        root.style.setProperty("--color-surface-card-rgb", `${cardRgb.r}, ${cardRgb.g}, ${cardRgb.b}`);
        root.style.setProperty("--color-accent", accent);
        root.style.setProperty("--color-accent-rgb", `${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}`);
        root.style.setProperty("--color-accent-hover", accentHover);
        root.style.setProperty("--color-text", text);

        document.body.style.backgroundColor = bg;
        document.body.style.color = text;

        // Update brand accent highlight
        document.querySelectorAll(".brand-accent-highlight").forEach((el) => {
          (el as HTMLElement).style.color = accent;
        });

        // Update active buttons & borders
        document.querySelectorAll(".theme-accent-bg").forEach((el) => {
          (el as HTMLElement).style.backgroundColor = accent;
        });
        document.querySelectorAll(".theme-accent-border").forEach((el) => {
          (el as HTMLElement).style.borderColor = accent;
        });

        // Refresh control bar background
        const controlBar = document.getElementById("catalog-control-bar");
        if (controlBar) {
          controlBar.style.backgroundColor = `rgba(${surfaceRgb.r}, ${surfaceRgb.g}, ${surfaceRgb.b}, 0.92)`;
        }

        // Refresh navbar color with new theme bg
        const navCfg = getSavedConfig().navbar;
        if (navCfg) {
          applyNavbarConfig(navCfg);
        }
      }

      // ── 4. Fitur Tambahan (Sport Filter Toggling) ──
      function applyFeaturesConfig(features: any) {
        const filterContainer = document.getElementById("homepage-sport-filter-container");
        if (filterContainer) {
          if (features && features.showSportFilter === false) {
            filterContainer.classList.add("hidden");
          } else {
            filterContainer.classList.remove("hidden");
          }
        }
      }

      // ── 5. Inisialisasi Tampilan dari Config Admin ──
      function initFromConfig() {
        const cfg = getSavedConfig();
        applyBrandConfig(cfg.brand);
        applyNavbarConfig(cfg.navbar);
        applyCornerConfig(cfg.corners);
        applyThemeConfig(cfg.theme);
        applyFeaturesConfig(cfg.features);
      }

      // ── 6. Mobile Menu Toggle & Dynamic Radius ──
      function updateNavRadiusForMenu(isOpen: boolean) {
        const nav = document.getElementById("main-nav");
        if (!nav) return;
        const cfg = getSavedConfig();
        const style = cfg.navbar?.style || "full_width";
        const isMobile = window.innerWidth < 1024;
        if (style === "liquid_glass") {
          const gRad = cfg.navbar?.glassRadius !== undefined ? Number(cfg.navbar.glassRadius) : 48;
          nav.style.borderRadius = (isOpen && isMobile) ? "24px" : `${gRad}px`;
        } else if (style === "floating_compact") {
          nav.style.borderRadius = "16px";
        } else {
          nav.style.borderRadius = "0";
        }
      }

      const menuBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("menu-icon-open");
      const iconClose = document.getElementById("menu-icon-close");

      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener("click", () => {
          const isOpen = !mobileMenu.classList.contains("hidden");
          if (isOpen) {
            mobileMenu.classList.add("hidden");
            menuBtn.setAttribute("aria-expanded", "false");
            iconOpen?.classList.remove("hidden");
            iconClose?.classList.add("hidden");
            updateNavRadiusForMenu(false);
          } else {
            mobileMenu.classList.remove("hidden");
            menuBtn.setAttribute("aria-expanded", "true");
            iconOpen?.classList.add("hidden");
            iconClose?.classList.remove("hidden");
            updateNavRadiusForMenu(true);
          }
        });

        document.querySelectorAll(".mobile-nav-link").forEach((link) => {
          link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            menuBtn.setAttribute("aria-expanded", "false");
            iconOpen?.classList.remove("hidden");
            iconClose?.classList.add("hidden");
            updateNavRadiusForMenu(false);
          });
        });

        document.addEventListener("click", (e) => {
          if (!mobileMenu.classList.contains("hidden")) {
            const nav = document.getElementById("main-nav");
            if (nav && !nav.contains(e.target as Node)) {
              mobileMenu.classList.add("hidden");
              menuBtn.setAttribute("aria-expanded", "false");
              iconOpen?.classList.remove("hidden");
              iconClose?.classList.add("hidden");
              updateNavRadiusForMenu(false);
            }
          }
        });
      }

      // ── 7. Listener Live Event dari Admin ──
      window.addEventListener("ivy:homepage_config_changed", (ev: any) => {
        if (ev.detail) {
          applyBrandConfig(ev.detail.brand);
          applyNavbarConfig(ev.detail.navbar);
          applyCornerConfig(ev.detail.corners);
          applyThemeConfig(ev.detail.theme);
          applyFeaturesConfig(ev.detail.features);
        }
      });

      window.addEventListener("storage", (e) => {
        if (e.key === HOMEPAGE_CONFIG_STORAGE_KEY) {
          initFromConfig();
        }
      });

      window.addEventListener("resize", () => {
        const cfg = getSavedConfig();
        applyNavbarConfig(cfg.navbar);
      });

      // ── 8. Logika Filter & Rendering Kartu Event ──
      interface EventCardTheme {
        badgeLabel: string;
        badgeBg: string;
        badgeText: string;
        primaryColor: string;
        primaryText: string;
        subText: string;
        accentBorder: string;
      }

      function getEventCardTheme(ev: MarathonEvent): EventCardTheme {
        const tId = ev.layoutConfig?.templateId || "template-summarecon";
        const navCfg = ev.layoutConfig?.navbarConfig;

        if (tId === "template-baa" || ev.id.includes("baa") || ev.id.includes("boston")) {
          return {
            badgeLabel: navCfg?.brandBadgeText || "BAA",
            badgeBg: navCfg?.brandBadgeBg || "#fdda24",
            badgeText: navCfg?.brandBadgeColor || "#00172e",
            primaryColor: "#fdda24",
            primaryText: "#00172e",
            subText: "World Marathon Major",
            accentBorder: "#fdda24",
          };
        }
        if (tId === "template-tokyo" || ev.id.includes("tokyo")) {
          return {
            badgeLabel: navCfg?.brandBadgeText || "TKY",
            badgeBg: navCfg?.brandBadgeBg || "#dc2626",
            badgeText: navCfg?.brandBadgeColor || "#ffffff",
            primaryColor: "#dc2626",
            primaryText: "#ffffff",
            subText: "Tokyo Marathon Major",
            accentBorder: "#dc2626",
          };
        }
        if (tId === "template-ironman" || ev.id.includes("ironman") || ev.id.includes("triathlon")) {
          return {
            badgeLabel: navCfg?.brandBadgeText || "IM",
            badgeBg: navCfg?.brandBadgeBg || "#e11d48",
            badgeText: navCfg?.brandBadgeColor || "#ffffff",
            primaryColor: "#e11d48",
            primaryText: "#ffffff",
            subText: "IRONMAN Triathlon Series",
            accentBorder: "#e11d48",
          };
        }
        if (tId === "template-berlin" || ev.id.includes("berlin")) {
          return {
            badgeLabel: navCfg?.brandBadgeText || "BER",
            badgeBg: navCfg?.brandBadgeBg || "#0284c7",
            badgeText: navCfg?.brandBadgeColor || "#ffffff",
            primaryColor: "#0284c7",
            primaryText: "#ffffff",
            subText: "World Record Track",
            accentBorder: "#0284c7",
          };
        }
        if (tId === "template-borobudur" || ev.id.includes("borobudur")) {
          return {
            badgeLabel: navCfg?.brandBadgeText || "BRB",
            badgeBg: navCfg?.brandBadgeBg || "#d97706",
            badgeText: navCfg?.brandBadgeColor || "#000000",
            primaryColor: "#d97706",
            primaryText: "#000000",
            subText: "Borobudur Heritage",
            accentBorder: "#d97706",
          };
        }
        if (tId === "template-sydney" || ev.id.includes("sydney")) {
          return {
            badgeLabel: navCfg?.brandBadgeText || "SYD",
            badgeBg: navCfg?.brandBadgeBg || "#0ea5e9",
            badgeText: navCfg?.brandBadgeColor || "#ffffff",
            primaryColor: "#0ea5e9",
            primaryText: "#ffffff",
            subText: "Sydney Harbour Major",
            accentBorder: "#0ea5e9",
          };
        }
        if (tId === "template-bangkok" || ev.id.includes("bangkok") || ev.id.includes("bkk")) {
          return {
            badgeLabel: navCfg?.brandBadgeText || "BKK",
            badgeBg: navCfg?.brandBadgeBg || "#f97316",
            badgeText: navCfg?.brandBadgeColor || "#000000",
            primaryColor: "#f97316",
            primaryText: "#ffffff",
            subText: "Midnight Marathon",
            accentBorder: "#f97316",
          };
        }
        // default / summarecon
        return {
          badgeLabel: navCfg?.brandBadgeText || "SMR",
          badgeBg: navCfg?.brandBadgeBg || "#8b5cf6",
          badgeText: navCfg?.brandBadgeColor || "#ffffff",
          primaryColor: "#8b5cf6",
          primaryText: "#ffffff",
          subText: "Night Run Festival",
          accentBorder: "#8b5cf6",
        };
      }

      const grid = document.getElementById("events-grid")!;
      const emptyState = document.getElementById("empty-state")!;
      const searchInput = document.getElementById("search-input") as HTMLInputElement;
      const countBadge = document.getElementById("event-count-badge")!;
      const sportBtns = document.querySelectorAll(".sport-btn");
      const modeBtns = document.querySelectorAll(".mode-btn");
      const distChips = document.querySelectorAll(".dist-chip");
      const resetBtn = document.getElementById("btn-reset-filters");
      const emptyResetBtn = document.getElementById("empty-reset-btn");

      let currentSport = "all";
      let currentMode = "ALL";
      let currentDist = "ALL";
      let currentQuery = "";

      function formatDate(iso: string) {
        try {
          return new Date(iso).toLocaleDateString("id-ID", {
            day: "numeric",
            month: "short",
            year: "numeric",
          });
        } catch {
          return iso;
        }
      }

      function getModeBadge(event: MarathonEvent) {
        const hasWar = event.categories.some((c) => c.mode === "WAR_QUEUE");
        const hasBallot = event.categories.some((c) => c.mode === "BALLOT");

        if (hasBallot) {
          return {
            label: "Sistem Ballot",
            classes: "bg-purple-950/80 text-purple-300 border-purple-500/40",
            dot: "bg-purple-400",
          };
        }
        if (hasWar) {
          return {
            label: "War Ticket",
            classes: "bg-amber-950/80 text-amber-300 border-amber-500/40",
            dot: "bg-amber-400",
          };
        }
        return {
          label: "Pendaftaran Buka",
          classes: "bg-emerald-950/80 text-emerald-300 border-emerald-500/40",
          dot: "bg-emerald-400",
        };
      }

      function renderCard(ev: MarathonEvent) {
        const theme = getEventCardTheme(ev);
        const badge = getModeBadge(ev);
        const minPrice = Math.min(...ev.categories.map((c) => c.earlyBirdPrice ?? c.price));
        const totalQuota = ev.categories.reduce((acc, c) => acc + (c.quota || 0), 0);
        const totalRegistered = ev.categories.reduce((acc, c) => acc + (c.registeredCount || 0), 0);
        const percentFilled = totalQuota > 0 ? Math.min(100, Math.round((totalRegistered / totalQuota) * 100)) : 0;

        const isBallot = ev.categories.some((c) => c.mode === "BALLOT");
        const isWar = ev.categories.some((c) => c.mode === "WAR_QUEUE");
        const qCfg = ev.layoutConfig?.queueConfig;
        const queueMode = qCfg?.mode || "auto";
        const trafficThreshold = qCfg?.trafficThreshold ?? 50;
        const activeWaiting = qCfg?.activeWaitingCount ?? 0;
        const isQueueActive = isWar && (
          queueMode === "always_queue" ||
          (queueMode === "auto" && activeWaiting >= trafficThreshold)
        );

        let actionHref = `/events/${encodeURIComponent(ev.id)}/checkout`;
        let actionLabel = "Daftar Tiket";

        if (isQueueActive) {
          actionHref = `/events/${encodeURIComponent(ev.id)}/queue`;
          actionLabel = "Masuk Antrean War";
        } else if (isBallot) {
          actionHref = `/events/${encodeURIComponent(ev.id)}/ballot`;
          actionLabel = "Ikut Ballot";
        } else if (isWar) {
          actionHref = `/events/${encodeURIComponent(ev.id)}/checkout`;
          actionLabel = "Daftar Tiket War";
        }

        return `
          <article class="group overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/90 shadow-lg transition-all duration-300 hover:border-slate-700 hover:shadow-2xl flex flex-col justify-between">
            <div>
              <!-- Banner Image with Template Badge & Chips -->
              <div class="relative h-44 sm:h-48 w-full overflow-hidden bg-slate-950">
                <img
                  src="${esc(ev.bannerUrl || ev.coverUrl || '/images/events/hero_marathon.jpg')}"
                  alt="${esc(ev.name)}"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>

                <!-- Top Left: Authentic Template Brand Badge -->
                <div class="absolute top-3 left-3 flex items-center gap-1.5 shadow-sm">
                  <span
                    class="px-2.5 py-1 rounded-md text-[10px] sm:text-xs font-black uppercase tracking-wider shadow-xs"
                    style="background-color: ${theme.badgeBg}; color: ${theme.badgeText};"
                  >
                    ${esc(theme.badgeLabel)}
                  </span>
                </div>

                <!-- Top Right: Registration Mode Status Pill -->
                <div class="absolute top-3 right-3 flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider backdrop-blur-md ${badge.classes}">
                  <span class="h-1.5 w-1.5 rounded-full ${badge.dot} animate-pulse"></span>
                  <span>${badge.label}</span>
                </div>

                <!-- Bottom Banner Tags -->
                <div class="absolute bottom-2.5 left-3 right-3 flex flex-wrap gap-1">
                  ${ev.categories
                    .slice(0, 3)
                    .map(
                      (c) => `
                    <span class="rounded bg-slate-950/85 border border-slate-700/70 px-1.5 py-0.5 text-[10px] font-mono font-bold text-slate-200 backdrop-blur-xs">
                      ${esc(c.distance || c.code)}
                    </span>
                  `
                    )
                    .join("")}
                  ${ev.categories.length > 3 ? `<span class="rounded bg-slate-950/85 border border-slate-700/70 px-1.5 py-0.5 text-[10px] font-mono font-bold text-slate-400">+${ev.categories.length - 3}</span>` : ""}
                </div>
              </div>

              <!-- Content Area -->
              <div class="p-4 sm:p-5 space-y-3">
                <!-- Location & Date Ribbon -->
                <div class="flex items-center justify-between text-[11px] text-slate-400 font-medium">
                  <span class="truncate max-w-[160px]">📍 ${esc(ev.city)}, ${esc(ev.country || "Indonesia")}</span>
                  <span class="shrink-0 font-mono">📅 ${formatDate(ev.startsAt)}</span>
                </div>

                <!-- Event Title -->
                <div>
                  <h2 class="font-display text-base sm:text-lg font-bold uppercase text-white group-hover:text-orange-400 transition-colors line-clamp-1 leading-snug">
                    <a href="/events/${encodeURIComponent(ev.id)}">
                      ${esc(ev.name)}
                    </a>
                  </h2>
                  <p class="text-xs text-slate-400 mt-1 line-clamp-2 leading-relaxed">
                    ${esc(ev.description || "Ajang olahraga prestisius dengan sertifikasi resmi dan pencatatan waktu berakurasi tinggi.")}
                  </p>
                </div>

                <!-- Race Metadata Grid -->
                <div class="grid grid-cols-2 gap-2 text-[11px] border-y border-slate-800/80 py-2.5 text-slate-300">
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="text-slate-500">Flag-Off:</span>
                    <strong class="font-mono text-slate-200">${esc(ev.flagOffTime || "05:00 WIB")}</strong>
                  </div>
                  <div class="flex items-center gap-1.5 truncate">
                    <span class="text-slate-500">Elevasi:</span>
                    <strong class="font-mono text-slate-200">${esc(ev.elevationGain || "+120m")}</strong>
                  </div>
                </div>

                <!-- Quota Fill Progress Bar -->
                <div class="space-y-1">
                  <div class="flex justify-between text-[10px] font-semibold">
                    <span class="text-slate-400">Kuota Terdaftar</span>
                    <span class="text-slate-300 font-mono">${percentFilled}% (${totalRegistered.toLocaleString("id-ID")} / ${totalQuota.toLocaleString("id-ID")})</span>
                  </div>
                  <div class="h-1.5 w-full rounded-full bg-slate-800 overflow-hidden">
                    <div class="h-full rounded-full ${percentFilled > 85 ? "bg-amber-500" : "bg-emerald-500"} transition-all duration-500" style="width: ${percentFilled}%"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Action Bar -->
            <div class="p-4 sm:p-5 pt-0">
              <div class="flex items-center justify-between gap-3 border-t border-slate-800/80 pt-3">
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">Mulai Dari</span>
                  <span class="text-sm sm:text-base font-bold text-white font-mono">
                    ${minPrice === 0 ? "Rp 0 (Ballot)" : `Rp ${minPrice.toLocaleString("id-ID")}`}
                  </span>
                </div>

                <div class="flex items-center gap-2">
                  <a
                    href="/events/${encodeURIComponent(ev.id)}"
                    class="min-h-[44px] inline-flex items-center justify-center rounded-xl border border-slate-700 bg-slate-800/80 px-3 py-2 text-xs font-semibold text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
                  >
                    Detail Rute
                  </a>
                  <a
                    href="${actionHref}"
                    class="min-h-[44px] inline-flex items-center justify-center rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider transition-all shadow-md"
                    style="background-color: ${theme.primaryColor}; color: ${theme.primaryText};"
                  >
                    ${actionLabel}
                  </a>
                </div>
              </div>
            </div>
          </article>
        `;
      }

      function updateView() {
        const events = getMarathonEvents();
        const query = currentQuery.toLowerCase().trim();

        const filtered = events.filter((ev) => {
          // Search filter
          if (query) {
            const inName = ev.name.toLowerCase().includes(query);
            const inCity = ev.city.toLowerCase().includes(query);
            const inVenue = (ev.venueName || "").toLowerCase().includes(query);
            const inDesc = (ev.description || "").toLowerCase().includes(query);
            const inOrg = (ev.organizer || "").toLowerCase().includes(query);
            if (!inName && !inCity && !inVenue && !inDesc && !inOrg) return false;
          }

          // Sport discipline filter
          if (currentSport !== "all") {
            if (currentSport === "triathlon") {
              const isTri = ev.eventType === "TRIATHLON" || ev.id.includes("ironman") || ev.categories.some((c) => c.distance.toLowerCase().includes("swim") || c.code.toLowerCase().includes("tri"));
              if (!isTri) return false;
            } else if (currentSport === "cycling") {
              const isBike = ev.eventType === "CYCLING" || ev.id.includes("bike") || ev.name.toLowerCase().includes("bike") || ev.categories.some((c) => c.name.toLowerCase().includes("bike") || c.distance.toLowerCase().includes("bike"));
              if (!isBike) return false;
            } else if (currentSport === "trail") {
              const isTrail = ev.eventType === "TRAIL_RUN" || ev.id.includes("trail") || ev.name.toLowerCase().includes("trail") || ev.categories.some((c) => c.name.toLowerCase().includes("trail"));
              if (!isTrail) return false;
            } else if (currentSport === "swimming") {
              const isSwim = ev.eventType === "SWIMMING" || ev.categories.some((c) => c.distance.toLowerCase().includes("swim"));
              if (!isSwim) return false;
            } else if (currentSport === "running") {
              const isRun = ev.eventType === "MARATHON" || ev.eventType === "ROAD_RACE" || ev.id.includes("marathon") || ev.id.includes("run");
              if (!isRun) return false;
            }
          }

          // Mode filter
          if (currentMode !== "ALL") {
            const hasMode = ev.categories.some((c) => c.mode === currentMode);
            if (!hasMode) return false;
          }

          // Distance filter
          if (currentDist !== "ALL") {
            const hasDist = ev.categories.some((c) => {
              const d = (c.distance || c.code || "").toUpperCase();
              if (currentDist === "42K") return d.includes("42") || d.includes("FM");
              if (currentDist === "21K") return d.includes("21") || d.includes("HM");
              if (currentDist === "10K") return d.includes("10");
              if (currentDist === "5K") return d.includes("5") || d.includes("KIDS");
              if (currentDist === "TRI") return d.includes("70.3") || d.includes("140.6") || ev.eventType === "TRIATHLON";
              return false;
            });
            if (!hasDist) return false;
          }

          return true;
        });

        countBadge.textContent = `Menampilkan ${filtered.length} dari ${events.length} Event Resmi`;

        if (filtered.length === 0) {
          grid.innerHTML = "";
          emptyState.classList.remove("hidden");
        } else {
          emptyState.classList.add("hidden");
          grid.innerHTML = filtered.map(renderCard).join("");
        }
      }

      // Sports filter buttons listener
      sportBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          sportBtns.forEach((b) => {
            b.className = "sport-btn min-h-[44px] shrink-0 whitespace-nowrap rounded-lg border border-slate-700/80 bg-slate-800/70 px-3.5 py-1.5 text-xs font-semibold text-slate-300 hover:border-slate-500 hover:text-white transition-all cursor-pointer";
          });
          btn.className = "sport-btn active min-h-[44px] shrink-0 whitespace-nowrap rounded-lg px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider transition-all bg-orange-600 text-white cursor-pointer";
          currentSport = btn.getAttribute("data-sport") || "all";
          updateView();
        });
      });

      // Mode filter tabs listener
      modeBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          modeBtns.forEach((b) => {
            b.className = "mode-btn min-h-[38px] rounded-lg border border-slate-700/70 bg-slate-800/60 px-2.5 py-1 text-xs font-medium text-slate-300 hover:text-white transition-all cursor-pointer shrink-0";
          });
          btn.className = "mode-btn active min-h-[38px] rounded-lg px-2.5 py-1 text-xs font-bold uppercase tracking-wider transition-all bg-slate-100 text-slate-950 cursor-pointer shrink-0";
          currentMode = btn.getAttribute("data-mode") || "ALL";
          updateView();
        });
      });

      // Distance chip listener
      distChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          distChips.forEach((c) => {
            c.className = "dist-chip min-h-[36px] rounded-md border border-slate-700 bg-slate-800/70 px-2.5 py-0.5 text-xs font-medium text-slate-300 hover:border-slate-500 hover:text-white transition-colors cursor-pointer";
          });
          chip.className = "dist-chip active min-h-[36px] rounded-md border border-orange-500 bg-orange-500/20 px-2.5 py-0.5 text-xs font-bold text-orange-300 cursor-pointer";
          currentDist = chip.getAttribute("data-dist") || "ALL";
          updateView();
        });
      });

      // Search input listener
      searchInput.addEventListener("input", (e) => {
        currentQuery = (e.target as HTMLInputElement).value;
        updateView();
      });

      // Reset filters handler
      function resetFilters() {
        currentSport = "all";
        currentMode = "ALL";
        currentDist = "ALL";
        currentQuery = "";
        searchInput.value = "";

        sportBtns.forEach((b, i) => {
          b.className = i === 0
            ? "sport-btn active min-h-[44px] shrink-0 whitespace-nowrap rounded-lg px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider transition-all bg-orange-600 text-white cursor-pointer"
            : "sport-btn min-h-[44px] shrink-0 whitespace-nowrap rounded-lg border border-slate-700/80 bg-slate-800/70 px-3.5 py-1.5 text-xs font-semibold text-slate-300 hover:border-slate-500 hover:text-white transition-all cursor-pointer";
        });

        modeBtns.forEach((b, i) => {
          b.className = i === 0
            ? "mode-btn active min-h-[38px] rounded-lg px-2.5 py-1 text-xs font-bold uppercase tracking-wider transition-all bg-slate-100 text-slate-950 cursor-pointer shrink-0"
            : "mode-btn min-h-[38px] rounded-lg border border-slate-700/70 bg-slate-800/60 px-2.5 py-1 text-xs font-medium text-slate-300 hover:text-white transition-all cursor-pointer shrink-0";
        });

        distChips.forEach((c, i) => {
          c.className = i === 0
            ? "dist-chip active min-h-[36px] rounded-md border border-orange-500 bg-orange-500/20 px-2.5 py-0.5 text-xs font-bold text-orange-300 cursor-pointer"
            : "dist-chip min-h-[36px] rounded-md border border-slate-700 bg-slate-800/70 px-2.5 py-0.5 text-xs font-medium text-slate-300 hover:border-slate-500 hover:text-white transition-colors cursor-pointer";
        });

        updateView();
      }

      resetBtn?.addEventListener("click", resetFilters);
      emptyResetBtn?.addEventListener("click", resetFilters);

      // Listen to admin event modifications
      window.addEventListener("ivy:events_changed", () => {
        initFromConfig();
        updateView();
      });

      // Initial execution
      initFromConfig();
      updateView();
      syncHomepageConfigFromServer().then(() => {
        initFromConfig();
        updateView();
      }).catch(() => {});
      syncMarathonEventsFromServer().then(() => {
        updateView();
      }).catch(() => {});
    </script>
  </body>
</html>
