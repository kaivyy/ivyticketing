---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Billing Platform : ivyticketing">
  <div class="border-b border-slate-800 bg-slate-900/60 px-4 py-3 sm:px-6">
    <div class="mx-auto flex max-w-6xl items-center justify-between">
      <h1 class="text-base font-bold uppercase tracking-wider text-white">Billing & Manajemen Paket Platform</h1>
      <span class="text-xs text-slate-400">Paket Langganan & Rekonsiliasi Pendapatan Fee</span>
    </div>
  </div>

  <main class="mx-auto max-w-6xl p-4 sm:p-6">
    <div id="billing" class="space-y-6">
      <p class="text-slate-400">Memuat data billing…</p>
    </div>
  </main>

  <script>
    import {
      adminListPackages,
      adminCreatePackage,
      adminRevenue,
      adminAssignSubscription,
      FEATURE_LABELS,
      type Package,
      type RevenueRow,
      type UpsertPackage,
    } from "../../lib/billing";
    import { esc } from "../../lib/safe";

    const root = document.getElementById("billing")!;

    function fmtMoney(v: number): string {
      return "Rp " + (v ?? 0).toLocaleString("id-ID");
    }
    function fmtBps(bps: number): string {
      return (bps / 100).toFixed(2).replace(/\.00$/, "") + "%";
    }

    function msg(text: string, isError = false) {
      const el = document.getElementById("admin-msg");
      if (!el) return;
      el.textContent = text;
      el.className = isError ? "text-sm text-red-400 font-medium" : "text-sm text-emerald-400 font-medium";
    }

    function featureChips(features: string[]): string {
      if (!features || features.length === 0) {
        return `<span class="text-xs text-slate-500">-</span>`;
      }
      return features
        .map(
          (f) =>
            `<span class="rounded bg-slate-800 px-1.5 py-0.5 text-xs text-slate-300 border border-slate-700">${esc(FEATURE_LABELS[f] ?? f)}</span>`
        )
        .join(" ");
    }

    function packageRows(pkgs: Package[]): string {
      if (pkgs.length === 0) {
        return `<p class="text-sm text-slate-400">Belum ada paket.</p>`;
      }
      return `
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-800 text-left text-xs uppercase tracking-wider text-slate-400">
                <th class="py-2.5 pr-3">Slug</th>
                <th class="py-2.5 pr-3">Nama</th>
                <th class="py-2.5 pr-3">Harga/bln</th>
                <th class="py-2.5 pr-3">Maks Event</th>
                <th class="py-2.5 pr-3">Fee</th>
                <th class="py-2.5 pr-3">Fitur</th>
                <th class="py-2.5 pr-3">Aktif</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80">
              ${pkgs
                .map(
                  (p) => `
                  <tr>
                    <td class="py-2.5 pr-3 font-mono text-xs text-orange-400">${esc(p.slug)}</td>
                    <td class="py-2.5 pr-3 font-medium text-white">${esc(p.name)}</td>
                    <td class="py-2.5 pr-3 text-slate-200">${fmtMoney(p.priceMonthly)}</td>
                    <td class="py-2.5 pr-3 text-slate-300">${p.maxEvents == null ? "Unlimited" : p.maxEvents}</td>
                    <td class="py-2.5 pr-3 text-slate-300">${fmtBps(p.feeBps)}</td>
                    <td class="py-2.5 pr-3">${featureChips(p.features)}</td>
                    <td class="py-2.5 pr-3">
                      <span class="rounded px-2 py-0.5 text-xs font-semibold ${p.isActive ? "bg-emerald-950 text-emerald-400 border border-emerald-500/30" : "bg-slate-800 text-slate-400"}">
                        ${p.isActive ? "Aktif" : "Nonaktif"}
                      </span>
                    </td>
                  </tr>`
                )
                .join("")}
            </tbody>
          </table>
        </div>`;
    }

    function revenueRows(rows: RevenueRow[]): string {
      if (rows.length === 0) {
        return `<p class="text-sm text-slate-400">Belum ada pendapatan tercatat.</p>`;
      }
      const total = rows.reduce((s, r) => s + (r.totalFees ?? 0), 0);
      return `
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-800 text-left text-xs uppercase tracking-wider text-slate-400">
                <th class="py-2.5 pr-3">Bulan</th>
                <th class="py-2.5 pr-3 text-right">Pesanan Berhasil</th>
                <th class="py-2.5 pr-3 text-right">Volume Transaksi</th>
                <th class="py-2.5 pr-3 text-right">Total Fee Platform</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80">
              ${rows
                .map(
                  (r) => `
                  <tr>
                    <td class="py-2.5 pr-3 font-mono text-xs text-white">${esc(r.month)}</td>
                    <td class="py-2.5 pr-3 text-right text-slate-300">${(r.paidOrders ?? 0).toLocaleString("id-ID")}</td>
                    <td class="py-2.5 pr-3 text-right text-slate-300">${fmtMoney(r.grossRevenue)}</td>
                    <td class="py-2.5 pr-3 text-right font-semibold text-emerald-400">${fmtMoney(r.totalFees)}</td>
                  </tr>`
                )
                .join("")}
            </tbody>
            <tfoot>
              <tr class="border-t-2 border-slate-700 font-semibold text-white">
                <td class="py-2.5 pr-3" colspan="3">Total Seluruh Periode</td>
                <td class="py-2.5 pr-3 text-right font-bold text-emerald-400">${fmtMoney(total)}</td>
              </tr>
            </tfoot>
          </table>
        </div>`;
    }

    function render(pkgs: Package[], revRows: RevenueRow[]) {
      const allFeatures = Object.keys(FEATURE_LABELS);
      root.innerHTML = `
        <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-6">
          <h2 class="mb-4 text-base font-bold text-white uppercase tracking-wider">Pendapatan Platform</h2>
          ${revenueRows(revRows)}
        </section>

        <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-6">
          <h2 class="mb-4 text-base font-bold text-white uppercase tracking-wider">Daftar Paket Langganan</h2>
          ${packageRows(pkgs)}
        </section>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <!-- Form Buat Paket -->
          <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-6">
            <h2 class="mb-4 text-base font-bold text-white uppercase tracking-wider">Buat / Perbarui Paket</h2>
            <form id="pkg-form" class="space-y-4">
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="slug">Slug Paket</label>
                <input id="slug" name="slug" required placeholder="pro, enterprise" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" />
              </div>
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="name">Nama Paket</label>
                <input id="name" name="name" required placeholder="Pro Organizer" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" />
              </div>
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="desc">Deskripsi</label>
                <input id="desc" name="description" placeholder="Cocok untuk event skala menengah" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" />
              </div>
              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="price">Harga (IDR)</label>
                  <input id="price" name="priceMonthly" type="number" min="0" value="0" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" />
                </div>
                <div>
                  <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="feeBps">Fee (bps)</label>
                  <input id="feeBps" name="feeBps" type="number" min="0" value="250" title="250 = 2.5%" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" />
                </div>
                <div>
                  <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="maxEv">Maks Event</label>
                  <input id="maxEv" name="maxEvents" type="number" min="1" placeholder="Kosong=∞" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" />
                </div>
              </div>
              <div>
                <p class="text-xs uppercase tracking-wider text-slate-400 mb-2">Fitur yang Disertakan</p>
                <div class="grid grid-cols-2 gap-2 text-xs">
                  ${allFeatures
                    .map(
                      (f) => `
                      <label class="flex items-center gap-2 text-slate-300">
                        <input type="checkbox" name="feat" value="${esc(f)}" class="rounded border-slate-700 text-orange-600 focus:ring-0" />
                        <span>${esc(FEATURE_LABELS[f] ?? f)}</span>
                      </label>`
                    )
                    .join("")}
                </div>
              </div>
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="sortOrder">Urutan Tampilan</label>
                <input id="sortOrder" name="sortOrder" type="number" value="0" class="w-24 rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" />
              </div>
              <button type="submit" class="rounded-lg bg-orange-600 px-4 py-2 text-sm font-bold uppercase tracking-wider text-white hover:bg-orange-500 transition-colors">
                Simpan Paket
              </button>
            </form>
            <p id="admin-msg" class="mt-3"></p>
          </section>

          <!-- Form Tetapkan Langganan -->
          <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-6">
            <h2 class="mb-4 text-base font-bold text-white uppercase tracking-wider">Tetapkan Paket ke Organizer</h2>
            <form id="assign-form" class="space-y-4">
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="assign-org">ID Organisasi</label>
                <input id="assign-org" name="orgId" required placeholder="UUID Organisasi" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-orange-500" />
              </div>
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="assign-pkg">Pilih Paket</label>
                <select id="assign-pkg" name="packageId" required class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500">
                  <option value="">Pilih paket...</option>
                  ${pkgs.map((p) => `<option value="${esc(p.id)}">${esc(p.name)} (${esc(p.slug)})</option>`).join("")}
                </select>
              </div>
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="assign-exp">Tanggal Kedaluwarsa</label>
                <input id="assign-exp" name="expiresAt" type="date" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" />
                <p class="text-xs text-slate-500 mt-1">Kosongkan jika paket berlaku selamanya.</p>
              </div>
              <button type="submit" class="rounded-lg bg-slate-800 border border-slate-700 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 transition-colors">
                Tetapkan Langganan
              </button>
            </form>
            <p id="assign-msg" class="mt-3"></p>
          </section>
        </div>`;

      document.getElementById("pkg-form")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target as HTMLFormElement);
        const maxEventsRaw = fd.get("maxEvents");
        const features = fd.getAll("feat").map(String);
        const body: UpsertPackage = {
          slug: String(fd.get("slug") ?? "").trim(),
          name: String(fd.get("name") ?? "").trim(),
          description: String(fd.get("description") ?? "").trim(),
          priceMonthly: Number(fd.get("priceMonthly") ?? 0),
          feeBps: Number(fd.get("feeBps") ?? 0),
          maxEvents: maxEventsRaw === "" ? null : Number(maxEventsRaw),
          features,
          isActive: true,
          sortOrder: Number(fd.get("sortOrder") ?? 0),
        };
        try {
          await adminCreatePackage(body);
          msg("Paket berhasil dibuat.");
          await reload();
        } catch (err) {
          msg((err as Error).message, true);
        }
      });

      document.getElementById("assign-form")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target as HTMLFormElement);
        const orgId = String(fd.get("orgId") ?? "").trim();
        const packageId = String(fd.get("packageId") ?? "");
        const expRaw = String(fd.get("expiresAt") ?? "").trim();
        const expiresAt = expRaw === "" ? null : new Date(expRaw + "T00:00:00Z").toISOString();
        const el = document.getElementById("assign-msg");
        try {
          await adminAssignSubscription(orgId, packageId, expiresAt);
          if (el) { el.textContent = "Langganan berhasil ditetapkan."; el.className = "mt-2 text-sm text-emerald-400 font-medium"; }
        } catch (err) {
          if (el) { el.textContent = (err as Error).message; el.className = "mt-2 text-sm text-red-400 font-medium"; }
        }
      });
    }

    async function reload() {
      const [pkgs, rows] = await Promise.all([
        adminListPackages().catch(() => [] as Package[]),
        adminRevenue().catch(() => [] as RevenueRow[]),
      ]);
      render(pkgs ?? [], rows ?? []);
    }

    reload().catch((e) => {
      root.innerHTML = `<p class="text-red-400">Gagal memuat: ${esc((e as Error).message)}</p>`;
    });
  </script>
</AdminLayout>
