---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Template & Manajemen Event Marathon : ivyticketing">
  <!-- Top Command Header -->
  <div class="border-b border-slate-800 bg-slate-900/60 px-4 py-3 sm:px-6">
    <div class="w-full min-w-0 mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3 max-w-7xl">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-sm sm:text-base font-bold uppercase tracking-wider text-white">
            Template & Manajemen Event Marathon
          </h1>
          <span class="rounded bg-orange-950 px-2 py-0.5 text-[10px] font-bold uppercase text-orange-400 border border-orange-500/30">
            Studio Kustomisasi Penuh
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-0.5 hidden sm:block">
          Kustomisasi super fleksibel: posisi judul (kiri/tengah/kanan), varian hero (poster/split/centered/cinematic), tema visual, blok konten bebas, hingga rute dan formulir pelari.
        </p>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <a
          href="/admin/events/edit?new=1"
          id="btn-create-event"
          class="min-h-[44px] w-full sm:w-auto inline-flex items-center justify-center gap-1.5 rounded-xl bg-orange-600 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow hover:bg-orange-500 transition-colors text-center"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Buat Event Kustom Baru</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Top Navigation Tabs: Pemisahan Jelas Event vs Website Utama -->
  <div class="border-b border-slate-800 bg-slate-950 px-4 py-2 sm:px-6">
    <div class="w-full min-w-0 mx-auto flex items-center justify-between gap-4 max-w-7xl">
      <div class="flex items-center gap-2 overflow-x-auto py-0.5 w-full sm:w-auto scrollbar-none">
        <a
          href="/admin/events"
          class="min-h-[40px] flex items-center gap-2 rounded-lg bg-orange-500/20 border border-orange-500/40 px-3.5 py-1.5 text-xs font-bold text-orange-400 shrink-0"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Kelola Event & Template</span>
        </a>

        <a
          href="/admin/settings"
          class="min-h-[40px] flex items-center gap-2 rounded-lg px-3.5 py-1.5 text-xs font-medium text-slate-400 hover:bg-slate-800 hover:text-white transition-colors shrink-0"
        >
          <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Pengaturan Website Utama</span>
        </a>
      </div>

      <div class="hidden sm:flex items-center gap-2 text-[11px] text-slate-400 shrink-0">
        <span>Peran:</span>
        <span class="font-bold text-orange-400">Superadmin Platform</span>
      </div>
    </div>
  </div>

  <main class="w-full min-w-0 mx-auto max-w-7xl p-3.5 sm:p-6 space-y-6 sm:space-y-8">
    <!-- Toast Notification -->
    <div id="toast-msg" class="hidden rounded-xl border border-emerald-500/40 bg-emerald-950/90 p-4 text-emerald-300 text-xs font-semibold shadow-lg backdrop-blur transition-all">
      Perubahan berhasil disimpan!
    </div>

    <!-- Summary Stats Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-4">
      <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-3 sm:p-4">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block truncate">Total Event</span>
        <span class="text-base sm:text-xl font-black text-white block mt-0.5" id="stat-total-events">0 Event</span>
        <span class="text-[10px] sm:text-[11px] text-emerald-400 block truncate">Siap Ditampilkan di Web</span>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-3 sm:p-4">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block truncate">Event Mode War</span>
        <span class="text-base sm:text-xl font-black text-amber-400 block mt-0.5" id="stat-war-events">0 Event</span>
        <span class="text-[10px] sm:text-[11px] text-slate-400 block truncate">Antrean High-Speed</span>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-3 sm:p-4">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block truncate">Event Mode Ballot</span>
        <span class="text-base sm:text-xl font-black text-blue-400 block mt-0.5" id="stat-ballot-events">0 Event</span>
        <span class="text-[10px] sm:text-[11px] text-slate-400 block truncate">Sistem Undian Adil</span>
      </div>
      <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-3 sm:p-4">
        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block truncate">Template Otentik</span>
        <span class="text-base sm:text-xl font-black text-orange-400 block mt-0.5">8 Desain Asli</span>
        <span class="text-[10px] sm:text-[11px] text-slate-400 block truncate">1-Klik Terapkan</span>
      </div>
    </div>

    <!-- Quick Section Navigation / Mobile Filter Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none pb-1 w-full max-w-full min-w-0 overscroll-x-contain" id="section-filter-bar" role="tablist" aria-label="Filter Tampilan Bagian">
      <button
        type="button"
        class="filter-tab-btn min-h-[40px] shrink-0 inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-xs font-bold transition-all text-white bg-orange-600 shadow-sm cursor-pointer"
        data-target="all"
      >
        Semua Bagian
      </button>
      <button
        type="button"
        class="filter-tab-btn min-h-[40px] shrink-0 inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-xs font-semibold text-slate-400 bg-slate-900 border border-slate-800 hover:text-white hover:border-slate-700 transition-all cursor-pointer"
        data-target="events"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>Daftar Event</span>
        <span id="tab-count-events" class="rounded-full bg-slate-800 px-1.5 py-0.2 text-[10px] text-slate-300">8</span>
      </button>
      <button
        type="button"
        class="filter-tab-btn min-h-[40px] shrink-0 inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-xs font-semibold text-slate-400 bg-slate-900 border border-slate-800 hover:text-white hover:border-slate-700 transition-all cursor-pointer"
        data-target="templates"
      >
        <span class="h-2 w-2 rounded-full bg-orange-500"></span>
        <span>Template Instan</span>
        <span class="rounded-full bg-slate-800 px-1.5 py-0.2 text-[10px] text-slate-300">8</span>
      </button>
      <button
        type="button"
        class="filter-tab-btn min-h-[40px] shrink-0 inline-flex items-center gap-1.5 rounded-xl px-4 py-2 text-xs font-semibold text-slate-400 bg-slate-900 border border-slate-800 hover:text-white hover:border-slate-700 transition-all cursor-pointer"
        data-target="gallery"
      >
        <span class="h-2 w-2 rounded-full bg-blue-500"></span>
        <span>Galeri Banner AI</span>
        <span class="rounded-full bg-slate-800 px-1.5 py-0.2 text-[10px] text-slate-300">6</span>
      </button>
    </div>

    <!-- Section 1: Template Event Siap Pakai (1-Klik Apply) -->
    <section id="sec-templates" class="w-full min-w-0 rounded-2xl border border-slate-800 bg-slate-900/80 p-4 sm:p-6 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-sm sm:text-base font-bold uppercase tracking-wider text-white">
              1. Template Marathon & Triathlon Siap Pakai
            </h2>
            <span class="rounded bg-orange-950 px-2 py-0.5 text-[10px] font-bold uppercase text-orange-400 border border-orange-500/30">
              8 Desain Otentik
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">
            Pilih template di bawah untuk membuat event baru secara instan dengan arsitektur visual unik, rute standar, dan kuota marathon dunia.
          </p>
        </div>
        <div class="flex items-center gap-2 justify-between sm:justify-end">
          <span class="text-[11px] text-slate-400 sm:hidden flex items-center gap-1 font-medium">
            Geser kartu &rarr;
          </span>
          <span class="text-xs text-orange-400 font-semibold font-mono hidden sm:inline-block">1-Klik Deploy</span>
        </div>
      </div>

      <!-- Mobile: Horizontal Swipe Carousel | Desktop: 3-Col Grid -->
      <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-3 overflow-x-auto sm:overflow-visible snap-x snap-mandatory gap-3 sm:gap-4 pb-3 sm:pb-0 scrollbar-none w-full max-w-full min-w-0 overscroll-x-contain" id="templates-grid">
        <!-- Rendered by JS -->
      </div>
    </section>

    <!-- Section 2: Galeri Gambar AI Generated -->
    <section id="sec-gallery" class="w-full min-w-0 rounded-2xl border border-slate-800 bg-slate-900/80 p-4 sm:p-5 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-sm font-bold uppercase tracking-wider text-white">
              2. Galeri Gambar Banner Resmi
            </h2>
            <span class="rounded bg-blue-950 px-2 py-0.5 text-[10px] font-bold uppercase text-blue-400 border border-blue-500/30">
              AI Photography Assets
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">
            Gambar fotografi resolusi tinggi yang bebas digunakan untuk cover event apapun.
          </p>
        </div>
        <span class="text-[11px] text-slate-400 sm:hidden flex items-center gap-1 font-medium">
          Geser banner &rarr;
        </span>
      </div>

      <!-- Mobile: Horizontal Swipe Carousel | Desktop: 4-Col Grid -->
      <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-4 overflow-x-auto sm:overflow-visible snap-x snap-mandatory gap-3 sm:gap-4 pb-3 sm:pb-0 scrollbar-none w-full max-w-full min-w-0 overscroll-x-contain" id="preset-gallery">
        <!-- Rendered by JS -->
      </div>
    </section>

    <!-- Section 3: Daftar Event & Tombol Customizer -->
    <section id="sec-events" class="w-full min-w-0 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-3">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-sm sm:text-base font-bold uppercase tracking-wider text-white">
              3. Daftar Event Aktif & Studio Kustomisasi
            </h2>
            <span id="badge-events-count" class="rounded bg-emerald-950 px-2 py-0.5 text-[10px] font-bold uppercase text-emerald-400 border border-emerald-500/30">
              Memuat...
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">
            Setiap event dapat dikustomisasi di halaman penuh: posisi judul, tata letak hero, tema warna, blok konten tambahan, kategori tiket, rute, hingga formulir pelari.
          </p>
        </div>

        <div class="flex items-center gap-2 w-full sm:w-auto">
          <button
            type="button"
            id="btn-reset-events"
            class="min-h-[44px] w-full sm:w-auto rounded-xl border border-slate-700 bg-slate-800 px-3.5 py-1.5 text-xs font-semibold text-slate-400 hover:bg-slate-700 hover:text-white transition-colors cursor-pointer text-center"
          >
            Reset ke Data Standar
          </button>
        </div>
      </div>

      <div id="events-list-container" class="w-full min-w-0 space-y-3.5 sm:space-y-4">
        <!-- Event Cards with Edit Button -->
      </div>
    </section>

    <!-- Banner Pemisahan Pengaturan Website Utama -->
    <section class="w-full min-w-0 rounded-2xl border border-slate-800 bg-gradient-to-r from-slate-900 via-slate-900 to-slate-950 p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex items-center gap-2">
          <span class="rounded bg-orange-950 px-2 py-0.5 text-[10px] font-bold uppercase text-orange-400 border border-orange-500/30">
            Halaman Terpisah
          </span>
          <h2 class="text-sm sm:text-base font-bold uppercase tracking-wider text-white">
            Pengaturan Website Utama & Desain Platform
          </h2>
        </div>
        <p class="text-xs text-slate-400 max-w-2xl leading-relaxed">
          Pengaturan logo brand, navbar (Liquid Glass / Full Width), tingkat transparansi, navigasi mobile, sudut elemen, tema global, dan slider hero telah dipisahkan ke halaman khusus Superadmin agar manajemen event tetap fokus dan rapi.
        </p>
      </div>

      <a
        href="/admin/settings"
        class="min-h-[44px] w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 rounded-xl bg-orange-600 px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-orange-500 transition-all shadow-md shadow-orange-600/20 active:scale-95 text-center"
      >
        <span>Buka Pengaturan Website</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </section>
  </main>

  <script>
    import {
      getMarathonEvents,
      saveMarathonEvent,
      deleteMarathonEvent,
      resetMarathonEvents,
      GENERATED_IMAGE_PRESETS,
      MARATHON_TEMPLATES,
      AVAILABLE_TEMPLATES,
      DEFAULT_LAYOUT_CONFIG,
      type MarathonEvent,
      type MarathonTemplateId,
    } from "../../lib/events-store";
    import { esc } from "../../lib/safe";

    const container = document.getElementById("events-list-container")!;
    const toast = document.getElementById("toast-msg")!;
    const templatesGrid = document.getElementById("templates-grid")!;
    const presetGallery = document.getElementById("preset-gallery")!;

    function showToast(msg: string) {
      toast.textContent = msg;
      toast.classList.remove("hidden");
      setTimeout(() => {
        toast.classList.add("hidden");
      }, 3500);
    }

    // 1. Render Template Presets (Swipeable on mobile, 3-col on desktop)
    templatesGrid.innerHTML = MARATHON_TEMPLATES.map(tpl => `
      <div class="flex flex-col justify-between rounded-xl border border-slate-800 bg-slate-950 p-3.5 sm:p-4 space-y-3 w-[260px] sm:w-auto shrink-0 sm:shrink snap-start min-w-0">
        <div class="space-y-2">
          <div class="relative h-24 w-full overflow-hidden rounded-lg bg-slate-900">
            <img src="${tpl.defaultBanner}" alt="${tpl.name}" class="h-full w-full object-cover" />
            <span class="absolute top-2 left-2 rounded px-2 py-0.5 text-[9px] font-bold uppercase border ${tpl.badgeClass}">
              ${tpl.badge}
            </span>
          </div>
          <div>
            <h3 class="text-xs font-bold text-white uppercase">${tpl.name}</h3>
            <p class="text-[11px] text-slate-400 mt-0.5 line-clamp-2">${tpl.description}</p>
          </div>
          <div class="flex flex-wrap gap-1">
            ${tpl.sampleCategories.map(c => `
              <span class="rounded bg-slate-900 px-1.5 py-0.2 text-[9px] font-bold text-slate-300 border border-slate-800">
                ${esc(c.code)}
              </span>
            `).join("")}
          </div>
        </div>

        <button
          type="button"
          class="apply-template-btn min-h-[44px] w-full rounded-lg bg-orange-600/20 border border-orange-500/40 text-xs font-bold uppercase tracking-wider text-orange-300 hover:bg-orange-600 hover:text-white transition-colors cursor-pointer"
          data-template-id="${tpl.id}"
        >
          Gunakan Template Ini &rarr;
        </button>
      </div>
    `).join("");

    // Bind Apply Template buttons -> creates event and redirects to dedicated editor
    document.querySelectorAll(".apply-template-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-template-id");
        const tpl = MARATHON_TEMPLATES.find(t => t.id === id);
        if (!tpl) return;

        const newId = `marathon-${Date.now()}`;
        const newEvent: MarathonEvent = {
          id: newId,
          slug: `${tpl.id}-${Date.now()}`,
          name: `${tpl.name} 2026`,
          tagline: tpl.sampleHighlights[0] ?? "Ajang Lari Resmi",
          description: tpl.description,
          eventType: tpl.id === "template-ironman" ? "TRIATHLON" : "MARATHON",
          status: "published",
          organizerName: "IvyTicketing Official Organizer",
          organizerSlug: "ivy-organizer",
          city: tpl.id === "template-summarecon" ? "Bandung" :
                tpl.id === "template-tokyo" ? "Tokyo" :
                tpl.id === "template-berlin" ? "Berlin" :
                tpl.id === "template-borobudur" ? "Magelang" :
                tpl.id === "template-sydney" ? "Sydney" :
                tpl.id === "template-bangkok" ? "Bangkok" :
                tpl.id === "template-ironman" ? "Langkawi" :
                tpl.id === "template-baa" ? "Boston" : "Jakarta",
          province: tpl.id === "template-summarecon" ? "Jawa Barat" :
                    tpl.id === "template-tokyo" ? "Kanto" :
                    tpl.id === "template-berlin" ? "Berlin State" :
                    tpl.id === "template-borobudur" ? "Jawa Tengah" :
                    tpl.id === "template-sydney" ? "New South Wales" :
                    tpl.id === "template-bangkok" ? "Bangkok Metropolis" :
                    tpl.id === "template-ironman" ? "Kedah" :
                    tpl.id === "template-baa" ? "Massachusetts" : "DKI Jakarta",
          country: (tpl.id === "template-tokyo" ? "Jepang" : tpl.id === "template-berlin" ? "Jerman" : tpl.id === "template-sydney" ? "Australia" : tpl.id === "template-bangkok" ? "Thailand" : tpl.id === "template-ironman" ? "Malaysia" : tpl.id === "template-baa" ? "Amerika Serikat" : "Indonesia"),
          venueName: tpl.id === "template-summarecon" ? "Summarecon Mall Bandung" :
                     tpl.id === "template-tokyo" ? "Tokyo Metropolitan Government Building" :
                     tpl.id === "template-berlin" ? "Strasse des 17. Juni" :
                     tpl.id === "template-borobudur" ? "Taman Wisata Candi Borobudur" :
                     tpl.id === "template-sydney" ? "Bradfield Park Milsons Point" :
                     tpl.id === "template-bangkok" ? "Sanam Chai Road (Grand Palace)" :
                     tpl.id === "template-ironman" ? "Pelangi Beach Resort Pantai Cenang" :
                     tpl.id === "template-baa" ? "Hopkinton to Copley Square (Boylston St)" : "Gelora Bung Karno Senayan",
          venueAddress: "Official Race Arena",
          startsAt: new Date(Date.now() + 60 * 86400000).toISOString(),
          flagOffTime: tpl.sampleSchedule[1]?.time || "05:00 WIB",
          bannerUrl: tpl.defaultBanner,
          logoUrl: tpl.defaultBanner,
          themeColor: tpl.themeColor,
          accentColor: tpl.accentColor,
          certifiedBy: tpl.certifiedBy,
          elevationGain: tpl.elevationGain,
          waterStationsCount: 16,
          medicalStationsCount: 10,
          categories: JSON.parse(JSON.stringify(tpl.sampleCategories)),
          routeHighlights: JSON.parse(JSON.stringify(tpl.sampleHighlights)),
          racepackInfo: {
            dates: "H-2 dan H-1 Hari Lomba",
            venue: "Race Village Official Expo",
            address: "Kompleks Olahraga Utama",
            hours: "10:00 - 20:00 WIB",
            requirements: ["E-KTP / Paspor", "QR Konfirmasi", "Surat Keterangan Sehat"],
          },
          schedule: JSON.parse(JSON.stringify(tpl.sampleSchedule)),
          faqs: [
            { q: "Apakah rute tersertifikasi?", a: "Ya, rute telah diukur dan disertifikasi resmi." }
          ],
          sponsors: [{ name: "IvyBank", role: "Title Sponsor" }],
          customFormConfig: {
            requireIdNumber: true,
            requireBloodType: true,
            requireEmergencyContact: true,
            requireJerseySize: true,
            requireBibName: true,
            requireMedicalConditions: true,
            requireClubName: false,
            requireEstimatedFinishTime: false,
          },
          layoutConfig: {
            ...DEFAULT_LAYOUT_CONFIG,
            ...(tpl.defaultLayout || { templateId: tpl.id }),
          },
          updatedAt: new Date().toISOString(),
        };

        saveMarathonEvent(newEvent);
        window.location.href = `/admin/events/edit?id=${encodeURIComponent(newEvent.id)}`;
      });
    });

    // 2. Render Preset Image Gallery (Swipeable on mobile, 4-col on desktop)
    presetGallery.innerHTML = GENERATED_IMAGE_PRESETS.map(p => `
      <div class="overflow-hidden rounded-xl border border-slate-800 bg-slate-950 p-2.5 space-y-2 group w-[220px] sm:w-auto shrink-0 sm:shrink snap-start min-w-0">
        <div class="relative h-28 w-full overflow-hidden rounded-lg bg-slate-900">
          <img src="${p.url}" alt="${p.name}" class="h-full w-full object-cover group-hover:scale-105 transition-transform" />
        </div>
        <div>
          <span class="text-xs font-bold text-white block truncate">${p.name}</span>
          <span class="text-[10px] text-slate-400 block line-clamp-2 mt-0.5">${p.description}</span>
        </div>
        <button
          type="button"
          class="copy-preset-btn min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-800 text-[11px] font-semibold text-slate-200 hover:bg-slate-700 transition-colors cursor-pointer"
          data-url="${p.url}"
        >
          Salin URL Banner
        </button>
      </div>
    `).join("");

    document.querySelectorAll(".copy-preset-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const url = btn.getAttribute("data-url") || "";
        navigator.clipboard.writeText(url);
        showToast(`URL ${url} disalin ke clipboard!`);
      });
    });

    // 3. Section Filter Tabs Logic
    const filterBtns = document.querySelectorAll(".filter-tab-btn");
    const secTemplates = document.getElementById("sec-templates");
    const secGallery = document.getElementById("sec-gallery");
    const secEvents = document.getElementById("sec-events");

    filterBtns.forEach(btn => {
      btn.addEventListener("click", () => {
        const target = btn.getAttribute("data-target");

        // Reset style all tabs
        filterBtns.forEach(b => {
          b.classList.remove("text-white", "bg-orange-600", "shadow-sm");
          b.classList.add("text-slate-400", "bg-slate-900", "border", "border-slate-800");
        });
        // Active tab style
        btn.classList.remove("text-slate-400", "bg-slate-900", "border", "border-slate-800");
        btn.classList.add("text-white", "bg-orange-600", "shadow-sm");

        if (target === "all") {
          secTemplates?.classList.remove("hidden");
          secGallery?.classList.remove("hidden");
          secEvents?.classList.remove("hidden");
        } else if (target === "events") {
          secEvents?.classList.remove("hidden");
          secTemplates?.classList.add("hidden");
          secGallery?.classList.add("hidden");
        } else if (target === "templates") {
          secTemplates?.classList.remove("hidden");
          secEvents?.classList.add("hidden");
          secGallery?.classList.add("hidden");
        } else if (target === "gallery") {
          secGallery?.classList.remove("hidden");
          secEvents?.classList.add("hidden");
          secTemplates?.classList.add("hidden");
        }
      });
    });

    // 4. Render Events List with Responsive Layout
    function renderEventsList() {
      const events = getMarathonEvents();

      // Stats
      const statTotalEl = document.getElementById("stat-total-events");
      const statWarEl = document.getElementById("stat-war-events");
      const statBallotEl = document.getElementById("stat-ballot-events");
      const badgeCountEl = document.getElementById("badge-events-count");
      const tabCountEl = document.getElementById("tab-count-events");

      if (statTotalEl) statTotalEl.textContent = `${events.length} Event`;
      if (statWarEl) statWarEl.textContent = `${events.filter(e => e.categories.some(c => c.mode === "WAR_QUEUE")).length} Event`;
      if (statBallotEl) statBallotEl.textContent = `${events.filter(e => e.categories.some(c => c.mode === "BALLOT")).length} Event`;
      if (badgeCountEl) badgeCountEl.textContent = `${events.length} Event`;
      if (tabCountEl) tabCountEl.textContent = String(events.length);

      if (events.length === 0) {
        container.innerHTML = `
          <div class="rounded-2xl border border-dashed border-slate-800 bg-slate-900/60 p-8 text-center text-slate-400">
            Belum ada event terdaftar. Klik "Buat Event Kustom Baru" atau pilih salah satu template di atas.
          </div>
        `;
        return;
      }

      container.innerHTML = events.map(ev => {
        const primaryMode = ev.categories.find(c => c.mode === "WAR_QUEUE") ? "War Ticket" :
                           ev.categories.find(c => c.mode === "BALLOT") ? "Sistem Ballot" : "Reguler";

        const alignLabel = ev.layoutConfig?.heroAlignment === "left" ? "Kiri" :
                           ev.layoutConfig?.heroAlignment === "right" ? "Kanan" : "Tengah";

        const variantLabel = ev.layoutConfig?.heroVariant === "split" ? "Split-Screen" :
                             ev.layoutConfig?.heroVariant === "centered" ? "Centered Tokyo" :
                             ev.layoutConfig?.heroVariant === "cinematic" ? "Cinematic Heritage" : "Poster Summarecon";

        const themeLabel = ev.layoutConfig?.themeStyle === "borobudur_heritage" ? "Borobudur Emas" :
                           ev.layoutConfig?.themeStyle === "tokyo_platinum" ? "Tokyo Platinum" :
                           ev.layoutConfig?.themeStyle === "berlin_speed" ? "Berlin Speed" :
                           ev.layoutConfig?.themeStyle === "custom" ? "Tema Kustom" : "Summarecon Neon";

        const tplId = ev.layoutConfig?.templateId || "template-summarecon";
        const tplMeta = AVAILABLE_TEMPLATES.find(t => t.id === tplId);
        const tplBadgeClass = tplMeta?.badgeClass || "bg-orange-500/20 text-orange-300 border-orange-500/30";
        const tplDisplayName = tplMeta?.badge || tplMeta?.name || tplId;

        return `
          <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 rounded-2xl border border-slate-800 bg-slate-900/90 p-4 sm:p-5 hover:border-slate-700 transition-colors w-full min-w-0">
            <!-- Left / Content Area: Banner + Details -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3.5 sm:gap-4 w-full md:w-auto min-w-0">
              <!-- Event Banner Preview (Mobile: Full-width poster | Desktop: 128px thumbnail) -->
              <div class="relative h-32 sm:h-20 w-full sm:w-32 shrink-0 overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
                <img src="${esc(ev.bannerUrl)}" alt="${esc(ev.name)}" class="h-full w-full object-cover" />
                <span class="absolute top-2 left-2 sm:hidden rounded bg-slate-950/85 backdrop-blur px-2 py-0.5 text-[9px] font-bold uppercase text-orange-400 border border-orange-500/40">
                  ${primaryMode}
                </span>
              </div>

              <!-- Metadata & Information -->
              <div class="space-y-1.5 w-full min-w-0">
                <!-- Badges Row -->
                <div class="flex flex-wrap items-center gap-1.5">
                  <span class="hidden sm:inline-flex rounded bg-orange-950/80 px-2 py-0.5 text-[10px] font-bold uppercase text-orange-400 border border-orange-500/30">
                    ${primaryMode}
                  </span>
                  <span class="rounded px-2 py-0.5 text-[10px] font-bold uppercase border ${tplBadgeClass}">
                    ${tplDisplayName}
                  </span>
                  <span class="rounded bg-slate-800 px-2 py-0.5 text-[10px] font-bold text-slate-300">
                    Judul: ${alignLabel}
                  </span>
                  <span class="rounded bg-slate-800 px-2 py-0.5 text-[10px] font-bold text-slate-300">
                    Layout: ${variantLabel}
                  </span>
                  <span class="rounded bg-slate-800 px-2 py-0.5 text-[10px] font-bold text-slate-300">
                    ${themeLabel}
                  </span>
                </div>

                <!-- Event Name & Info -->
                <h3 class="text-base sm:text-lg font-bold text-white leading-snug break-words">${esc(ev.name)}</h3>
                <p class="text-xs text-slate-400 leading-relaxed break-words">${esc(ev.venueName)} · Flag-off: <span class="font-mono text-slate-300 font-medium">${esc(ev.flagOffTime)}</span> · ${esc(ev.city)}</p>

                <!-- Category Chips -->
                <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                  ${ev.categories.map(c => `
                    <span class="rounded bg-slate-800/80 px-2 py-0.5 text-[10px] font-bold text-slate-200 border border-slate-700/60 font-mono">
                      ${esc(c.code)}: Rp ${c.price.toLocaleString("id-ID")}
                    </span>
                  `).join("")}
                </div>

                <!-- Quick Template Switcher -->
                <div class="flex flex-col sm:flex-row sm:items-center gap-1.5 pt-1.5 min-w-0">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 shrink-0">Template Cepat:</span>
                  <select
                    class="quick-template-select min-h-[40px] w-full sm:w-auto rounded-lg border border-slate-700 bg-slate-950 px-3 py-1.5 text-xs font-semibold text-orange-400 focus:border-orange-500 focus:outline-none cursor-pointer max-w-full"
                    data-event-id="${ev.id}"
                  >
                    ${AVAILABLE_TEMPLATES.map(t => `
                      <option value="${t.id}" ${t.id === tplId ? "selected" : ""}>
                        ${t.name} (${t.badge})
                      </option>
                    `).join("")}
                  </select>
                </div>
              </div>
            </div>

            <!-- Action Buttons (Mobile: Full-width primary CTA + secondary toolbar | Desktop: Inline row) -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full md:w-auto shrink-0 border-t sm:border-t-0 border-slate-800/80 pt-3 sm:pt-0 min-w-0">
              <a
                href="/admin/events/edit?id=${encodeURIComponent(ev.id)}"
                class="min-h-[44px] flex-1 sm:flex-initial inline-flex items-center justify-center gap-1.5 rounded-xl bg-orange-600 px-4 py-2.5 text-xs font-bold uppercase tracking-wider text-white hover:bg-orange-500 transition-colors shadow shadow-orange-600/20 text-center"
              >
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
                <span>Studio Kustomisasi</span>
              </a>

              <div class="flex items-center gap-2">
                <a
                  href="/events/${encodeURIComponent(ev.id)}"
                  target="_blank"
                  class="min-h-[44px] flex-1 sm:flex-initial inline-flex items-center justify-center rounded-xl border border-slate-700 bg-slate-800 px-3.5 py-2 text-xs font-semibold text-slate-300 hover:bg-slate-700 hover:text-white transition-colors text-center"
                >
                  Lihat di Web &rarr;
                </a>
                <button
                  type="button"
                  class="btn-delete-event min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-red-500/30 bg-red-950/30 text-red-400 hover:bg-red-900/60 hover:text-white transition-colors cursor-pointer"
                  data-id="${ev.id}"
                  data-name="${esc(ev.name)}"
                  title="Hapus Event"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join("");

      document.querySelectorAll(".quick-template-select").forEach(sel => {
        sel.addEventListener("change", (e) => {
          const evId = (e.target as HTMLElement).getAttribute("data-event-id");
          const chosenTpl = (e.target as HTMLSelectElement).value as MarathonTemplateId;
          const evList = getMarathonEvents();
          const target = evList.find(ev => ev.id === evId);
          if (!target) return;

          const tplPreset = MARATHON_TEMPLATES.find(t => t.id === chosenTpl);
          target.layoutConfig = {
            ...(target.layoutConfig || DEFAULT_LAYOUT_CONFIG),
            templateId: chosenTpl,
            ...(tplPreset?.defaultLayout ? {
              themeStyle: tplPreset.defaultLayout.themeStyle,
              heroVariant: tplPreset.defaultLayout.heroVariant,
              heroAlignment: tplPreset.defaultLayout.heroAlignment,
              paperTexture: tplPreset.defaultLayout.paperTexture,
              tickerText: tplPreset.defaultLayout.tickerText,
            } : {}),
          };

          saveMarathonEvent(target);
          renderEventsList();
          showToast(`Template untuk "${target.name}" berhasil diubah ke ${tplPreset?.name || chosenTpl}!`);
        });
      });

      document.querySelectorAll(".btn-delete-event").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-id");
          const name = btn.getAttribute("data-name");
          if (!id) return;
          if (confirm(`Yakin ingin menghapus event "${name}"? Tindakan ini tidak dapat dibatalkan.`)) {
            deleteMarathonEvent(id);
            renderEventsList();
            showToast(`Event "${name}" berhasil dihapus.`);
          }
        });
      });
    }

    // Reset Semua Event ke Default
    document.getElementById("btn-reset-events")?.addEventListener("click", () => {
      if (confirm("Kembalikan seluruh daftar event ke data bawaan asli? Event yang baru dibuat akan dihapus.")) {
        resetMarathonEvents();
        renderEventsList();
        showToast("Daftar event berhasil direset ke setelan standar.");
      }
    });

    renderEventsList();
  </script>
</AdminLayout>
