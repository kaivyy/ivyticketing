---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Kelola Penyelenggara : Admin IvyTicketing">
  <div class="space-y-6 pb-12">
    <!-- Header Page -->
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-b border-slate-800 pb-5">
      <div>
        <h1 class="font-display text-2xl font-bold uppercase tracking-tight text-white sm:text-3xl">
          Kelola Penyelenggara (Organizers)
        </h1>
        <p class="text-xs text-slate-400 mt-1 max-w-2xl leading-relaxed">
          Manajemen penyelenggara (organizer / EO), penambahan organizer manual, penugasan akun PIC, serta pemantauan event lomba dan staf di platform IvyTicketing.
        </p>
      </div>
      <div class="flex items-center gap-2.5">
        <button
          id="btn-quick-organizer-login"
          type="button"
          class="inline-flex items-center gap-1.5 rounded-lg border border-sky-500/30 bg-sky-950/40 px-3.5 py-2 text-xs font-semibold text-sky-400 hover:bg-sky-900/50 hover:text-sky-300 transition-colors cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
          </svg>
          <span>Masuk sebagai Organizer Demo</span>
        </button>

        <button
          id="btn-open-create-modal"
          type="button"
          class="inline-flex items-center gap-2 rounded-lg bg-orange-600 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-lg hover:bg-orange-500 transition-colors cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>+ Tambah Organizer Manual</span>
        </button>
      </div>
    </div>

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Organisasi</span>
        <div id="stat-total-orgs" class="font-display text-2xl font-bold text-white mt-1">--</div>
        <span class="text-[10px] text-emerald-400 font-medium">Terdaftar di Database</span>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Event Dikelola</span>
        <div id="stat-total-events" class="font-display text-2xl font-bold text-orange-400 mt-1">--</div>
        <span class="text-[10px] text-slate-400 font-medium">Lintas Penyelenggara</span>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Staf / Anggota</span>
        <div id="stat-total-members" class="font-display text-2xl font-bold text-sky-400 mt-1">--</div>
        <span class="text-[10px] text-slate-400 font-medium">Akses RBAC Aktif</span>
      </div>

      <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-4">
        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Status Platform</span>
        <div class="flex items-center gap-2 mt-1">
          <span class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-display text-lg font-bold text-emerald-400">Multi-Tenant OK</span>
        </div>
        <span class="text-[10px] text-slate-400 font-medium">Auto-Isolation Guard</span>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between bg-slate-900/40 p-3 rounded-xl border border-slate-800">
      <div class="relative flex-1">
        <input
          id="search-input"
          type="text"
          placeholder="Cari organisasi, slug, atau email PIC..."
          class="w-full rounded-lg border border-slate-700 bg-slate-900/80 px-3.5 py-2 pl-9 text-xs text-white placeholder-slate-500 focus:border-orange-500 focus:outline-none"
        />
        <svg class="absolute left-3 top-2.5 h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs text-slate-400">Jumlah:</span>
        <span id="badge-count" class="rounded bg-slate-800 px-2 py-0.5 text-xs font-bold text-slate-300">--</span>
      </div>
    </div>

    <!-- Table Container -->
    <div class="rounded-xl border border-slate-800 bg-slate-900/60 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-300">
          <thead class="border-b border-slate-800 bg-slate-950/80 text-[10px] font-bold uppercase tracking-wider text-slate-400">
            <tr>
              <th scope="col" class="px-4 py-3">Organisasi</th>
              <th scope="col" class="px-4 py-3">Slug URL</th>
              <th scope="col" class="px-4 py-3">Lead PIC / Organizer</th>
              <th scope="col" class="px-4 py-3 text-center">Event</th>
              <th scope="col" class="px-4 py-3 text-center">Staf</th>
              <th scope="col" class="px-4 py-3">Terdaftar</th>
              <th scope="col" class="px-4 py-3 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody id="organizers-tbody" class="divide-y divide-slate-800/60">
            <tr>
              <td colspan="7" class="px-4 py-8 text-center text-slate-400">
                Memuat data organisasi...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Modal Tambah Organizer Manual -->
    <div id="create-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-950/80 p-4 backdrop-blur-xs">
      <div class="w-full max-w-lg rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div>
            <h2 class="font-display text-lg font-bold uppercase text-white tracking-wide">
              Tambah Penyelenggara Baru
            </h2>
            <p class="text-[11px] text-slate-400 mt-0.5">
              Daftarkan institusi organizer dan buat akun PIC yang memiliki hak akses penuh ke portal.
            </p>
          </div>
          <button id="btn-close-modal" type="button" class="text-slate-400 hover:text-white text-xl cursor-pointer">&times;</button>
        </div>

        <form id="create-organizer-form" class="space-y-4">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1" for="org-name">
              Nama Organisasi / Event Management <span class="text-red-400">*</span>
            </label>
            <input
              id="org-name"
              name="name"
              required
              placeholder="Contoh: Mandalika Racing & Marathon"
              class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1" for="org-slug">
              Slug URL Organisasi <span class="text-slate-500 font-normal">(otomatis)</span>
            </label>
            <input
              id="org-slug"
              name="slug"
              placeholder="mandalika-sports"
              class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none font-mono"
            />
          </div>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1" for="lead-name">
                Nama Lengkap PIC <span class="text-red-400">*</span>
              </label>
              <input
                id="lead-name"
                name="leadFullName"
                required
                placeholder="Ahmad Dani Organizer"
                class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
              />
            </div>

            <div>
              <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1" for="lead-phone">
                Nomor Telepon / WhatsApp
              </label>
              <input
                id="lead-phone"
                name="leadPhone"
                type="tel"
                placeholder="081234567890"
                class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1" for="lead-email">
              Alamat Email Akun Organizer <span class="text-red-400">*</span>
            </label>
            <input
              id="lead-email"
              name="leadEmail"
              type="email"
              required
              placeholder="lead@mandalikasports.com"
              class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-1" for="lead-pass">
              Kata Sandi Login Awal <span class="text-red-400">*</span>
            </label>
            <input
              id="lead-pass"
              name="leadPassword"
              type="text"
              required
              value="Organizer123!"
              placeholder="Minimal 8 karakter"
              class="w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none font-mono"
            />
            <span class="text-[10px] text-slate-500 mt-1 block">Default: Organizer123! (Organizer dapat mengubahnya setelah masuk).</span>
          </div>

          <div id="modal-err" class="hidden rounded-lg bg-red-950/60 border border-red-800/80 p-2.5 text-xs text-red-300"></div>

          <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-800">
            <button
              id="btn-cancel-modal"
              type="button"
              class="rounded-lg border border-slate-700 px-3.5 py-2 text-xs font-semibold text-slate-300 hover:bg-slate-800 transition-colors cursor-pointer"
            >
              Batal
            </button>
            <button
              id="btn-submit-org"
              type="submit"
              class="rounded-lg bg-orange-600 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-orange-500 transition-colors cursor-pointer"
            >
              Simpan & Buat Akun
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal Detail & Event Organizer -->
    <div id="detail-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center bg-slate-950/80 p-4 backdrop-blur-xs">
      <div class="w-full max-w-xl rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
          <div class="flex items-center gap-3">
            <div id="detail-badge" class="flex h-10 w-10 items-center justify-center rounded-xl bg-orange-600 font-bold text-white uppercase">
              OR
            </div>
            <div>
              <h2 id="detail-title" class="font-display text-lg font-bold text-white uppercase">
                Nama Organisasi
              </h2>
              <span id="detail-slug" class="font-mono text-xs text-slate-400">slug-organisasi</span>
            </div>
          </div>
          <button id="btn-close-detail" type="button" class="text-slate-400 hover:text-white text-xl cursor-pointer">&times;</button>
        </div>

        <div class="space-y-3 text-xs">
          <div class="rounded-xl bg-slate-950/70 border border-slate-800/80 p-3.5 space-y-2">
            <div class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Informasi Akun Utama</div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <span class="text-slate-500 block">Lead PIC:</span>
                <span id="detail-lead-name" class="font-semibold text-white">--</span>
              </div>
              <div>
                <span class="text-slate-500 block">Email:</span>
                <span id="detail-lead-email" class="font-mono text-slate-300">--</span>
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Event yang Dikelola</span>
              <span id="detail-events-count" class="text-[10px] font-semibold text-orange-400">0 Event</span>
            </div>
            <div id="detail-events-list" class="space-y-2">
              <p class="text-slate-500 italic">Memuat daftar event...</p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-3 border-t border-slate-800">
          <button id="btn-close-detail-footer" type="button" class="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-400 hover:text-white">
            Tutup
          </button>
          <a
            id="detail-open-portal"
            href="#"
            class="inline-flex items-center gap-1.5 rounded-lg bg-sky-600 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-sky-500 transition-colors"
          >
            <span>Buka Portal Organizer &rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { authedFetch } from "../../lib/api";
    import { login } from "../../lib/auth";
    import { esc } from "../../lib/safe";

    let rawOrgs: any[] = [];

    const tbody = document.getElementById("organizers-tbody") as HTMLTableSectionElement;
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    const badgeCount = document.getElementById("badge-count") as HTMLSpanElement;

    // Stat elements
    const statTotalOrgs = document.getElementById("stat-total-orgs") as HTMLDivElement;
    const statTotalEvents = document.getElementById("stat-total-events") as HTMLDivElement;
    const statTotalMembers = document.getElementById("stat-total-members") as HTMLDivElement;

    // Modals
    const createModal = document.getElementById("create-modal") as HTMLDivElement;
    const createForm = document.getElementById("create-organizer-form") as HTMLFormElement;
    const modalErr = document.getElementById("modal-err") as HTMLDivElement;
    const submitBtn = document.getElementById("btn-submit-org") as HTMLButtonElement;

    const detailModal = document.getElementById("detail-modal") as HTMLDivElement;

    // Open/Close Create Modal
    document.getElementById("btn-open-create-modal")?.addEventListener("click", () => {
      createForm.reset();
      (document.getElementById("lead-pass") as HTMLInputElement).value = "Organizer123!";
      modalErr.classList.add("hidden");
      createModal.classList.remove("hidden");
    });
    document.getElementById("btn-close-modal")?.addEventListener("click", () => createModal.classList.add("hidden"));
    document.getElementById("btn-cancel-modal")?.addEventListener("click", () => createModal.classList.add("hidden"));

    // Auto-generate slug from organization name
    const orgNameInput = document.getElementById("org-name") as HTMLInputElement;
    const orgSlugInput = document.getElementById("org-slug") as HTMLInputElement;
    orgNameInput?.addEventListener("input", () => {
      const slug = orgNameInput.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
      orgSlugInput.value = slug;
    });

    // Close Detail Modal
    document.getElementById("btn-close-detail")?.addEventListener("click", () => detailModal.classList.add("hidden"));
    document.getElementById("btn-close-detail-footer")?.addEventListener("click", () => detailModal.classList.add("hidden"));

    // Quick login as demo organizer
    document.getElementById("btn-quick-organizer-login")?.addEventListener("click", async () => {
      try {
        await login("organizer@ivyticketing.com", "organizer123456");
        window.location.href = "/org/ivy-sports/dashboard";
      } catch (err: any) {
        alert("Gagal masuk sebagai demo organizer: " + (err.message || "Error"));
      }
    });

    const fmtDate = (iso: string) => {
      if (!iso) return "-";
      return new Date(iso).toLocaleDateString("id-ID", {
        day: "numeric",
        month: "short",
        year: "numeric",
      });
    };

    function renderTable(list: any[]) {
      badgeCount.textContent = `${list.length} Organisasi`;
      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-slate-400">
              Tidak ada organisasi yang sesuai dengan pencarian.
            </td>
          </tr>`;
        return;
      }

      tbody.innerHTML = list
        .map((org) => {
          const initials = (org.name || "OR").substring(0, 2).toUpperCase();
          const leadName = org.leadName || "Belum Ditugaskan";
          const leadEmail = org.leadEmail || "-";
          const eventsCount = org.eventCount ?? 0;
          const membersCount = org.memberCount ?? 1;

          return `
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="px-4 py-3">
                <div class="flex items-center gap-2.5">
                  <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-orange-600 font-bold text-xs text-white">
                    ${esc(initials)}
                  </div>
                  <div>
                    <button
                      type="button"
                      class="btn-view-detail text-left font-semibold text-white hover:text-orange-400 transition-colors cursor-pointer"
                      data-org-id="${esc(org.id)}"
                      data-org-name="${esc(org.name)}"
                      data-org-slug="${esc(org.slug)}"
                      data-lead-name="${esc(leadName)}"
                      data-lead-email="${esc(leadEmail)}"
                      data-events-count="${eventsCount}"
                    >
                      ${esc(org.name)}
                    </button>
                    <span class="block text-[10px] text-slate-500">ID: ${esc(org.id.slice(0, 8))}...</span>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 font-mono text-[11px] text-slate-400">
                /org/${esc(org.slug)}
              </td>
              <td class="px-4 py-3">
                <div class="font-medium text-slate-200">${esc(leadName)}</div>
                <div class="text-[10px] text-slate-400 font-mono">${esc(leadEmail)}</div>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="inline-block rounded-full bg-orange-950/70 px-2 py-0.5 text-[10px] font-bold text-orange-400 border border-orange-800/50">
                  ${eventsCount} Event
                </span>
              </td>
              <td class="px-4 py-3 text-center">
                <span class="inline-block rounded-full bg-slate-800 px-2 py-0.5 text-[10px] font-bold text-slate-300">
                  ${membersCount} Staf
                </span>
              </td>
              <td class="px-4 py-3 text-[11px] text-slate-400">
                ${fmtDate(org.createdAt)}
              </td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-2">
                  <button
                    type="button"
                    class="btn-view-detail rounded border border-slate-700 px-2 py-1 text-[10px] font-semibold text-slate-300 hover:bg-slate-800 hover:text-white transition-colors cursor-pointer"
                    data-org-id="${esc(org.id)}"
                    data-org-name="${esc(org.name)}"
                    data-org-slug="${esc(org.slug)}"
                    data-lead-name="${esc(leadName)}"
                    data-lead-email="${esc(leadEmail)}"
                    data-events-count="${eventsCount}"
                  >
                    Detail
                  </button>
                  <a
                    href="/org/${esc(org.slug)}/dashboard"
                    class="rounded bg-orange-600 px-2.5 py-1 text-[10px] font-bold text-white hover:bg-orange-500 transition-colors"
                  >
                    Buka Portal &rarr;
                  </a>
                </div>
              </td>
            </tr>`;
        })
        .join("");

      // Bind detail button clicks
      tbody.querySelectorAll(".btn-view-detail").forEach((btn) => {
        btn.addEventListener("click", () => {
          const orgId = btn.getAttribute("data-org-id") || "";
          const orgName = btn.getAttribute("data-org-name") || "";
          const orgSlug = btn.getAttribute("data-org-slug") || "";
          const leadName = btn.getAttribute("data-lead-name") || "";
          const leadEmail = btn.getAttribute("data-lead-email") || "";
          const eventsCount = btn.getAttribute("data-events-count") || "0";

          (document.getElementById("detail-badge") as HTMLElement).textContent = (orgName || "OR").substring(0, 2).toUpperCase();
          (document.getElementById("detail-title") as HTMLElement).textContent = orgName;
          (document.getElementById("detail-slug") as HTMLElement).textContent = `/org/${orgSlug}`;
          (document.getElementById("detail-lead-name") as HTMLElement).textContent = leadName;
          (document.getElementById("detail-lead-email") as HTMLElement).textContent = leadEmail;
          (document.getElementById("detail-events-count") as HTMLElement).textContent = `${eventsCount} Event Terdaftar`;

          const portalBtn = document.getElementById("detail-open-portal") as HTMLAnchorElement;
          portalBtn.href = `/org/${orgSlug}/dashboard`;

          // Fetch events for this org
          const eventsContainer = document.getElementById("detail-events-list") as HTMLElement;
          eventsContainer.innerHTML = `<p class="text-slate-400 italic">Memuat event organisasi...</p>`;

          authedFetch(`/organizations/${orgSlug}/events`)
            .then((evList) => {
              if (!evList || evList.length === 0) {
                eventsContainer.innerHTML = `
                  <div class="rounded-lg border border-slate-800 bg-slate-950 p-3 text-center text-slate-400">
                    Belum ada event yang dibuat oleh organizer ini.
                  </div>`;
              } else {
                eventsContainer.innerHTML = evList
                  .map((ev: any) => `
                    <div class="flex items-center justify-between rounded-lg border border-slate-800 bg-slate-950 p-3">
                      <div>
                        <div class="font-bold text-white">${esc(ev.name)}</div>
                        <div class="text-[10px] text-slate-400 font-mono">Slug: ${esc(ev.slug || ev.id)}</div>
                      </div>
                      <a
                        href="/org/${orgSlug}/events/${esc(ev.slug || ev.id)}"
                        class="rounded bg-slate-800 px-2.5 py-1 text-[10px] font-semibold text-orange-400 hover:bg-slate-700"
                      >
                        Buka Event &rarr;
                      </a>
                    </div>
                  `)
                  .join("");
              }
            })
            .catch(() => {
              eventsContainer.innerHTML = `
                <div class="rounded-lg border border-slate-800 bg-slate-950 p-3 text-center text-slate-400">
                  Akses langsung melalui portal organizer untuk mengelola event.
                </div>`;
            });

          detailModal.classList.remove("hidden");
        });
      });
    }

    async function loadOrganizers() {
      try {
        const data = await authedFetch("/admin/organizers");
        rawOrgs = data || [];

        // Update stats
        statTotalOrgs.textContent = String(rawOrgs.length);
        const totalEv = rawOrgs.reduce((acc, o) => acc + (o.eventCount || 0), 0);
        statTotalEvents.textContent = String(totalEv);
        const totalMb = rawOrgs.reduce((acc, o) => acc + (o.memberCount || 0), 0);
        statTotalMembers.textContent = String(totalMb);

        renderTable(rawOrgs);
      } catch (err: any) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="px-4 py-8 text-center text-red-400">
              Gagal memuat data penyelenggara: ${esc(err.message)}
            </td>
          </tr>`;
      }
    }

    // Search filter
    searchInput?.addEventListener("input", () => {
      const q = searchInput.value.toLowerCase().trim();
      if (!q) {
        renderTable(rawOrgs);
        return;
      }
      const filtered = rawOrgs.filter(
        (o) =>
          o.name.toLowerCase().includes(q) ||
          o.slug.toLowerCase().includes(q) ||
          (o.leadEmail && o.leadEmail.toLowerCase().includes(q)) ||
          (o.leadName && o.leadName.toLowerCase().includes(q))
      );
      renderTable(filtered);
    });

    // Form submit: create organizer
    createForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      modalErr.classList.add("hidden");
      submitBtn.disabled = true;
      submitBtn.textContent = "Menyimpan...";

      const fd = new FormData(createForm);
      const payload = {
        name: String(fd.get("name") || "").trim(),
        slug: String(fd.get("slug") || "").trim(),
        leadFullName: String(fd.get("leadFullName") || "").trim(),
        leadEmail: String(fd.get("leadEmail") || "").trim(),
        leadPassword: String(fd.get("leadPassword") || "").trim(),
        leadPhone: String(fd.get("leadPhone") || "").trim(),
      };

      try {
        await authedFetch("/admin/organizers", {
          method: "POST",
          body: payload,
        });

        createModal.classList.add("hidden");
        await loadOrganizers();
      } catch (err: any) {
        modalErr.textContent = err.message || "Gagal membuat organizer baru.";
        modalErr.classList.remove("hidden");
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Simpan & Buat Akun";
      }
    });

    loadOrganizers();
  </script>
</AdminLayout>
