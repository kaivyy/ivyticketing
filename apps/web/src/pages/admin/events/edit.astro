        case "snowflake":
          return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><path d="M20 9v22M9 20h22M12 12l16 16M12 28l16-16" stroke-linecap="round" /><path d="M17 11l3 3 3-3M17 29l3-3 3 3M11 17l3 3-3 3M29 17l-3 3 3 3" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
        case "water":
          return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><path d="M20 10c0 0-7 9-7 13a7 7 0 0014 0c0-4-7-13-7-13z" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
        case "thermometer":
