---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Studio Kustomisasi Event : IvyTicketing">
  <!-- Top Header & Action Bar -->
  <div class="sticky top-0 z-30 border-b border-slate-800 bg-slate-900/95 px-3.5 py-2.5 sm:px-6 sm:py-3 backdrop-blur shadow-md">
    <div class="mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 sm:gap-3">
        <a
          href="/admin/events"
          class="min-h-[44px] min-w-[44px] flex items-center justify-center rounded-xl border border-slate-700 bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-colors cursor-pointer shrink-0"
          title="Kembali ke Daftar Event"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </a>

        <div class="min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="rounded bg-orange-600/20 border border-orange-500/40 px-2 py-0.5 text-[10px] font-bold text-orange-400 uppercase">
              Studio Halaman Kustom
            </span>
            <h1 class="text-sm sm:text-lg font-bold uppercase tracking-tight text-white truncate" id="page-event-title">
              Kustomisasi Event
            </h1>
          </div>
          <p class="text-xs text-slate-400 mt-0.5 hidden sm:block">
            Kustomisasi tata letak hero, posisi judul, tema warna, blok konten bebas, kategori tiket, rute, hingga formulir pelari.
          </p>
        </div>
      </div>

      <div class="flex items-center justify-between sm:justify-end gap-2 sm:gap-2.5 w-full sm:w-auto">
        <a
          id="btn-preview-event"
          href="/events"
          target="_blank"
          class="min-h-[44px] inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-700 bg-slate-800 px-3 sm:px-4 py-2 text-xs font-semibold text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>Pratinjau Live</span>
        </a>

        <button
          type="button"
          id="btn-save-event-top"
          class="min-h-[44px] flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 rounded-xl bg-orange-600 px-4 sm:px-5 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-lg shadow-orange-600/30 hover:bg-orange-500 transition-colors cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Simpan Perubahan</span>
        </button>
      </div>
    </div>
  </div>

  <main class="mx-auto max-w-7xl p-4 sm:p-6 space-y-6">
    <!-- Toast Notification -->
    <div id="toast-msg" class="hidden rounded-xl border border-emerald-500/40 bg-emerald-950/90 p-4 text-emerald-300 text-xs font-semibold shadow-lg backdrop-blur transition-all">
      Perubahan berhasil disimpan!
    </div>

    <!-- Tab Bar: Tanpa scrollbar, dengan tombol kiri-kanan & dukungan drag mouse/trackpad -->
    <div class="relative flex items-center gap-2 rounded-2xl border border-slate-800 bg-slate-900/90 p-2 shadow-sm">
      <!-- Tombol Scroll Kiri -->
      <button
        type="button"
        id="tab-scroll-left"
        class="min-h-[44px] min-w-[40px] flex items-center justify-center rounded-xl border border-slate-700 bg-slate-800 text-slate-300 hover:text-white hover:border-orange-500 transition-colors shrink-0 cursor-pointer shadow"
        aria-label="Geser Tab ke Kiri"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Container Tabs (Scrollbar Tersembunyi) -->
      <div
        class="flex gap-1.5 overflow-x-auto scroll-smooth py-1 px-1 flex-1 select-none cursor-grab active:cursor-grabbing no-scrollbar"
        id="customizer-tabs"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        <button
          type="button"
          class="c-tab-btn active min-h-[44px] px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-xl bg-orange-600 text-white whitespace-nowrap shadow transition-all cursor-pointer"
          data-tab="c-tab-basic"
        >
          1. Info & Banner
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-layout"
        >
          2. Tata Letak & Posisi
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-titles"
        >
          3. Judul Seksi & Teks
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-blocks"
        >
          4. Blok Konten Bebas
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-categories"
        >
          5. Kategori & Kuota
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-route"
        >
          6. Rute & Fasilitas
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-rpc"
        >
          7. Pengambilan Racepack
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-schedule"
        >
          8. Jadwal Hari H
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-form"
        >
          9. Formulir Pelari
        </button>
        <button
          type="button"
          class="c-tab-btn min-h-[44px] px-4 py-2 text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 rounded-xl transition-colors whitespace-nowrap cursor-pointer"
          data-tab="c-tab-timing"
        >
          10. Timing & Race RFID
        </button>
      </div>

      <!-- Tombol Scroll Kanan -->
      <button
        type="button"
        id="tab-scroll-right"
        class="min-h-[44px] min-w-[40px] flex items-center justify-center rounded-xl border border-slate-700 bg-slate-800 text-slate-300 hover:text-white hover:border-orange-500 transition-colors shrink-0 cursor-pointer shadow"
        aria-label="Geser Tab ke Kanan"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Main Customizer Form Section -->
    <form id="customizer-form" class="rounded-2xl border border-slate-800 bg-slate-900/80 p-5 sm:p-7 space-y-6 shadow-xl">
      <input type="hidden" id="c-event-id" />

      <!-- Tab 1: Info & Banner -->
      <div id="c-tab-basic" class="c-tab-pane space-y-5">
        <div class="space-y-3 rounded-xl border border-slate-800 bg-slate-950/70 p-4 sm:p-5">
          <label class="text-xs font-bold uppercase tracking-wider text-orange-400 block">
            Gambar Cover / Banner Event
          </label>

          <div class="relative h-56 sm:h-72 w-full overflow-hidden rounded-xl border border-slate-700 bg-slate-900">
            <img
              id="c-banner-preview"
              src="/images/events/hero_marathon.jpg"
              alt="Live Cover Preview"
              class="h-full w-full object-cover"
            />
            <div class="absolute bottom-3 right-3 rounded-lg bg-slate-950/85 px-3 py-1.5 text-xs font-mono text-slate-300 backdrop-blur border border-slate-700">
              Live Preview Banner
            </div>
          </div>

          <div>
            <label for="c-banner-url" class="text-xs font-semibold text-slate-300 block mb-1">
              URL Gambar Banner:
            </label>
            <input
              id="c-banner-url"
              type="text"
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white placeholder-slate-500 focus:border-orange-500 focus:outline-none"
              placeholder="https://... atau /images/events/..."
            />
          </div>

          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">
              Atau Pilih Cepat Preset AI Photography:
            </span>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="modal-quick-images">
              <!-- Injected by JS -->
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="c-name" class="text-xs font-semibold text-slate-300 block mb-1">Nama Lengkap Event</label>
            <input
              id="c-name"
              type="text"
              required
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="c-tagline" class="text-xs font-semibold text-slate-300 block mb-1">Tagline Slogan</label>
            <input
              id="c-tagline"
              type="text"
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label for="c-desc" class="text-xs font-semibold text-slate-300 block mb-1">Deskripsi Lengkap Event</label>
          <textarea
            id="c-desc"
            rows="3"
            class="w-full rounded-lg border border-slate-700 bg-slate-950 p-3 text-xs text-white focus:border-orange-500 focus:outline-none"
          ></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label for="c-city" class="text-xs font-semibold text-slate-300 block mb-1">Kota</label>
            <input
              id="c-city"
              type="text"
              required
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="c-venue" class="text-xs font-semibold text-slate-300 block mb-1">Nama Venue / Titik Start</label>
            <input
              id="c-venue"
              type="text"
              required
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="c-certified" class="text-xs font-semibold text-slate-300 block mb-1">Sertifikasi Resmi Rute</label>
            <input
              id="c-certified"
              type="text"
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
              placeholder="World Athletics & PASI"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label for="c-date" class="text-xs font-semibold text-slate-300 block mb-1">Tanggal Perlombaan</label>
            <input
              id="c-date"
              type="date"
              required
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
            />
          </div>

          <div>
            <label for="c-flagoff" class="text-xs font-semibold text-slate-300 block mb-1">Waktu Flag-Off Lomba</label>
            <input
              id="c-flagoff"
              type="text"
              required
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
              placeholder="04:30 WIB"
            />
          </div>

          <div>
            <label for="c-status" class="text-xs font-semibold text-slate-300 block mb-1">Status Publikasi</label>
            <select
              id="c-status"
              class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
            >
              <option value="published">Published (Tampil di Katalog)</option>
              <option value="draft">Draft (Disembunyikan)</option>
              <option value="archived">Archived</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Tab 2: Tata Letak & Posisi -->
      <div id="c-tab-layout" class="c-tab-pane hidden space-y-5">
        <div>
          <h4 class="text-sm font-bold uppercase text-white">Template Desain, Tata Letak & Posisi Judul</h4>
          <p class="text-xs text-slate-400">Pilih template arsitektur halaman lomba otentik dari referensi resmi, atur perataan judul event, gaya layout hero, dan tema visual.</p>
        </div>

        <div class="rounded-xl border border-orange-500/40 bg-orange-950/20 p-4 space-y-3">
          <div class="flex items-center justify-between">
            <label for="c-template-id" class="text-xs font-bold uppercase tracking-wider text-orange-400 block">
              Pilihan Template Desain Halaman Event
            </label>
            <span class="rounded bg-orange-950 px-2 py-0.5 text-[10px] font-bold text-orange-400 border border-orange-500/40">
              8 Desain Otentik Tersedia
            </span>
          </div>

          <select
            id="c-template-id"
            class="min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-950 px-3 py-2 text-xs text-white font-semibold focus:border-orange-500 focus:outline-none"
          >
            <option value="template-summarecon">Summarecon Bandung Run Fest (Kuning Neon #F5EB15, 4 Kartu Vertikal Hitam 01-04, Warm Paper Finish)</option>
            <option value="template-tokyo">Tokyo International Marathon (Abbott Major Platinum, Tipografi Bilingual Tokyo, Tabel Kuota 38.000)</option>
            <option value="template-berlin">BMW Berlin Speed Marathon (Speed Blue #0066b2, Split-Screen 2-Kolom, Elevasi Datar 20m Rekor Dunia)</option>
            <option value="template-borobudur">Borobudur Heritage Marathon (Terakota #ea580c & Emas Antik, Rute Rolling Hills 285m, Pasar Medang)</option>
            <option value="template-sydney">TCS Sydney Harbour Marathon (Maritime Teal & Cyan, Sydney Harbour Bridge ke Opera House Forecourt)</option>
            <option value="template-bangkok">Bangkok Midnight Marathon (Fire Orange & Amber, Tiket Sobek Sirkular, Skew-Box -15 deg, Jembatan Rama VIII)</option>
            <option value="template-ironman">IRONMAN 70.3 & Full Triathlon (IRONMAN Red #e10600, 3-Disiplin Swim/Bike/Run, 45 Slot Kona Hawaii)</option>
            <option value="template-baa">Boston Athletic Association (B.A.A.) Marathon (Official Navy #00172e & Gold, Logo Unicorn Spike, Moving Sponsor Reel, Standar Kualifikasi BAA)</option>
            <option value="template-custom">Super Custom Studio (Bebas Penuh 100% : Rata Kiri/Tengah/Kanan, Blok Bebas, Tema Hex Mandiri)</option>
          </select>

          <div id="c-template-info-box" class="rounded-lg border border-slate-800 bg-slate-900/90 p-3 text-xs text-slate-300"></div>
        </div>

        <!-- Dynamic Template Parameters -->
        <div id="c-template-specific-container" class="rounded-xl border border-slate-800 bg-slate-950 p-4 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2.5">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-orange-500 animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-white block">
                Parameter Khusus Template Terpilih
              </span>
            </div>
            <span id="c-active-template-badge" class="rounded bg-slate-900 border border-slate-700 px-2.5 py-0.5 text-[10px] font-bold text-orange-400 font-mono">
              Aktif: Summarecon
            </span>
          </div>

          <!-- IRONMAN Triathlon Panel -->
          <div id="panel-tpl-ironman" class="tpl-panel hidden space-y-6">
            <div class="rounded-xl bg-gradient-to-r from-red-950/50 via-red-900/20 to-slate-900/50 border border-red-500/40 p-4 text-xs text-red-200 shadow-sm flex items-start gap-3">
              <span class="text-2xl shrink-0">🏊🚴🏃</span>
              <div>
                <p class="font-bold text-white text-sm">Konfigurasi Menyeluruh Template IRONMAN 70.3 Triathlon</p>
                <p class="text-[11px] text-slate-300 mt-0.5">Semua elemen halaman (Pita Slogan, 6 Metrik Cuaca & Karakteristik dengan pilihan Ikon/Upload Gambar, Video YouTube, 3 Segel Resmi, Seksi Why Race dengan warna background custom, dan Sticky Mobile Bar) dapat dikustomisasi secara penuh.</p>
              </div>
            </div>

            <!-- 1. Hero Badge & CTA -->
            <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4 sm:p-5 space-y-4">
              <div class="flex items-center gap-2 border-b border-slate-800 pb-2">
                <span class="h-2 w-2 rounded-full bg-red-500"></span>
                <h3 class="text-xs font-bold uppercase tracking-wider text-red-400">1. Hero Badge & Tombol Aksi (CTA)</h3>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label for="c-im-tag-badge" class="text-[11px] font-semibold text-slate-300 block mb-1">Hero Tag Badge (Badge Putih Tajam)</label>
                  <input
                    type="text"
                    id="c-im-tag-badge"
                    class="min-h-[40px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-white placeholder-slate-500 focus:border-red-500 focus:outline-none"
                    placeholder="FLEX90 ELIGIBLE"
                  />
                </div>
                <div>
                  <label for="c-im-kona" class="text-[11px] font-semibold text-slate-300 block mb-1">Slot Kona Qualifier</label>
                  <input
                    type="text"
                    id="c-im-kona"
                    class="min-h-[40px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-white placeholder-slate-500 focus:border-red-500 focus:outline-none"
                    placeholder="45 SLOTS"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                <div>
                  <label for="c-im-cta-primary-text" class="text-[11px] font-semibold text-slate-300 block mb-1">Teks Tombol CTA Utama (Oranye)</label>
                  <input
                    type="text"
                    id="c-im-cta-primary-text"
                    class="min-h-[40px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-white placeholder-slate-500"
                    placeholder="VIEW ENTRY OPTIONS"
                  />
                </div>
                <div>
                  <label for="c-im-cta-primary-link" class="text-[11px] font-semibold text-slate-300 block mb-1">Link Target CTA Utama</label>
                  <input
                    type="text"
                    id="c-im-cta-primary-link"
                    class="min-h-[40px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-white placeholder-slate-500"
                    placeholder="#im-tiers"
                  />
                </div>
                <div>
                  <label for="c-im-cta-sec-text" class="text-[11px] font-semibold text-slate-300 block mb-1">Teks Tombol CTA Sekunder (Outline)</label>
                  <input
                    type="text"
                    id="c-im-cta-sec-text"
                    class="min-h-[40px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-white placeholder-slate-500"
                    placeholder="COURSE OVERVIEW"
                  />
                </div>
                <div>
                  <label for="c-im-cta-sec-link" class="text-[11px] font-semibold text-slate-300 block mb-1">Link Target CTA Sekunder</label>
                  <input
                    type="text"
                    id="c-im-cta-sec-link"
                    class="min-h-[40px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-white placeholder-slate-500"
                    placeholder="#im-course"
                  />
                </div>
              </div>
            </div>

            <!-- 2. Strip 6 Metrik Karakteristik Lintasan & Cuaca (Bawah Banner) -->
            <div class="rounded-xl border border-slate-800 bg-slate-950/60 p-4 sm:p-5 space-y-4">
              <div class="flex items-center justify-between border-b border-slate-800 pb-2">
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-red-500"></span>
                  <h3 class="text-xs font-bold uppercase tracking-wider text-red-400">2. Strip 6 Metrik Karakteristik Lintasan & Cuaca</h3>
                </div>
                <span class="text-[10px] text-slate-400 font-mono">Di Bawah Hero Banner</span>
              </div>

              <!-- Grid 6 Metrik -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Metrik 0: Swim -->
                <div class="rounded-lg border border-slate-800 bg-slate-900/90 p-3.5 space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-bold text-red-400 uppercase">Metrik 1: Renang (Swim)</span>
                    <div id="c-im-m0-preview" class="h-10 w-10 rounded-full border border-slate-700 bg-slate-950 flex items-center justify-center p-1.5 shrink-0 overflow-hidden"></div>
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <div>
