    function bindFileUpload(fileInputId: string, urlInputId: string, onUpdate?: () => void) {
      const fileInput = document.getElementById(fileInputId) as HTMLInputElement | null;
      const urlInput = document.getElementById(urlInputId) as HTMLInputElement | null;
      if (!fileInput || !urlInput) return;

      fileInput.addEventListener("change", () => {
        const file = fileInput.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
          const dataUrl = e.target?.result as string;
          if (dataUrl) {
            urlInput.value = dataUrl;
            if (onUpdate) onUpdate();
          }
        };
        reader.readAsDataURL(file);
      });
    }

    function updateMetricIconUI(i: number) {
      const radioCustom = document.querySelector(`input[name="c-im-m${i}-icon-type"][value="custom"]`) as HTMLInputElement | null;
      const isCustom = radioCustom?.checked ?? false;
      const presetWrap = document.getElementById(`c-im-m${i}-preset-wrap`);
      const customWrap = document.getElementById(`c-im-m${i}-custom-wrap`);
      const previewBox = document.getElementById(`c-im-m${i}-preview`);

      if (presetWrap && customWrap) {
        if (isCustom) {
          presetWrap.classList.add("hidden");
          customWrap.classList.remove("hidden");
        } else {
          presetWrap.classList.remove("hidden");
          customWrap.classList.add("hidden");
        }
      }

      if (previewBox) {
        if (isCustom) {
          const url = (document.getElementById(`c-im-m${i}-custom-url`) as HTMLInputElement)?.value.trim();
          if (url) {
            previewBox.innerHTML = `<img src="${esc(url)}" alt="Preview" class="h-full w-full object-contain" />`;
          } else {
            previewBox.innerHTML = `<span class="text-[9px] text-slate-500 font-mono">No Img</span>`;
          }
        } else {
          const preset = (document.getElementById(`c-im-m${i}-preset`) as HTMLSelectElement)?.value || "swim";
          previewBox.innerHTML = getAdminPresetSvg(preset);
        }
      }
    }

    function updateSealUI(i: number) {
      const previewBox = document.getElementById(`c-im-s${i}-preview`);
      const customUrl = (document.getElementById(`c-im-s${i}-custom-url`) as HTMLInputElement)?.value.trim();
      const theme = (document.getElementById(`c-im-s${i}-theme`) as HTMLSelectElement)?.value || "blue";
      if (!previewBox) return;

      if (customUrl) {
        previewBox.innerHTML = `<img src="${esc(customUrl)}" alt="Seal" class="h-full w-full object-contain" />`;
      } else {
        const bg = theme === "blue" ? "bg-sky-600 border-sky-400 text-white" :
                   theme === "gold" ? "bg-amber-500 border-amber-300 text-black" :
                   theme === "red" ? "bg-red-600 border-red-400 text-white" :
                   theme === "emerald" ? "bg-emerald-600 border-emerald-400 text-white" : "bg-neutral-800 border-neutral-600 text-white";
        previewBox.innerHTML = `<div class="h-7 w-7 rounded-full border-2 ${bg} flex items-center justify-center text-[8px] font-black">IM</div>`;
      }
    }

    function renderIronmanWhyCardsList() {
      const list = document.getElementById("im-why-cards-list");
      if (!list) return;
      list.innerHTML = activeIronmanWhyCards.map((card, idx) => `
        <div class="rounded-lg border border-slate-800 bg-slate-900/80 p-3 space-y-2">
          <div class="flex items-center justify-between border-b border-slate-800 pb-1.5">
            <span class="text-xs font-bold text-red-400 uppercase">Kartu #${idx + 1}</span>
            <button type="button" class="btn-del-im-why text-xs text-rose-400 hover:text-rose-300 font-semibold cursor-pointer" data-idx="${idx}">Hapus</button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-2">
            <div>
              <label class="text-[10px] text-slate-400 block mb-0.5 font-semibold">Ikon / Emoji</label>
              <input type="text" class="im-why-card-emoji w-full rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-white" value="${esc(card.iconEmoji || '🏖️')}" data-idx="${idx}" />
            </div>
            <div class="sm:col-span-3">
              <label class="text-[10px] text-slate-400 block mb-0.5 font-semibold">Judul Keunggulan</label>
              <input type="text" class="im-why-card-title w-full rounded border border-slate-700 bg-slate-950 px-2.5 py-1 text-xs text-white" value="${esc(card.title || '')}" data-idx="${idx}" placeholder="Judul keunggulan..." />
            </div>
          </div>
          <div>
            <label class="text-[10px] text-slate-400 block mb-0.5 font-semibold">Deskripsi Singkat</label>
            <textarea rows="2" class="im-why-card-desc w-full rounded border border-slate-700 bg-slate-950 p-2 text-xs text-white" data-idx="${idx}" placeholder="Deskripsi fitur...">${esc(card.description || '')}</textarea>
          </div>
        </div>
      `).join("");

      list.querySelectorAll(".btn-del-im-why").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-idx"));
          if (!isNaN(idx)) {
            activeIronmanWhyCards.splice(idx, 1);
            renderIronmanWhyCardsList();
          }
        });
      });

      list.querySelectorAll<HTMLInputElement>(".im-why-card-emoji").forEach(input => {
        input.addEventListener("input", () => {
          const idx = Number(input.dataset.idx);
          if (activeIronmanWhyCards[idx]) activeIronmanWhyCards[idx].iconEmoji = input.value;
        });
      });

      list.querySelectorAll<HTMLInputElement>(".im-why-card-title").forEach(input => {
        input.addEventListener("input", () => {
          const idx = Number(input.dataset.idx);
          if (activeIronmanWhyCards[idx]) activeIronmanWhyCards[idx].title = input.value;
        });
      });

      list.querySelectorAll<HTMLTextAreaElement>(".im-why-card-desc").forEach(textarea => {
        textarea.addEventListener("input", () => {
          const idx = Number(textarea.dataset.idx);
          if (activeIronmanWhyCards[idx]) activeIronmanWhyCards[idx].description = textarea.value;
        });
      });
    }

    function initIronmanEditorControls() {
      // Why race background color picker sync
      const bgPicker = document.getElementById("c-im-why-bg-picker") as HTMLInputElement | null;
      const bgInput = document.getElementById("c-im-why-bg") as HTMLInputElement | null;
      if (bgPicker && bgInput) {
        bgPicker.addEventListener("input", () => { bgInput.value = bgPicker.value; });
        bgInput.addEventListener("input", () => { bgPicker.value = bgInput.value; });
      }

      // Video thumbnail
      const thumbUrlInput = document.getElementById("c-im-thumb-url") as HTMLInputElement | null;
      const thumbPreview = document.getElementById("c-im-thumb-preview") as HTMLImageElement | null;
      const updateThumbPreview = () => {
        if (thumbPreview && thumbUrlInput) {
          thumbPreview.src = thumbUrlInput.value.trim() || "/images/events/ironman_triathlon.jpg";
        }
      };
      thumbUrlInput?.addEventListener("input", updateThumbPreview);
      bindFileUpload("c-im-thumb-file", "c-im-thumb-url", updateThumbPreview);

      // 6 Metrics
      for (let i = 0; i < 6; i++) {
        const idx = i;
        const presetSel = document.getElementById(`c-im-m${idx}-preset`) as HTMLSelectElement | null;
        presetSel?.addEventListener("change", () => updateMetricIconUI(idx));

        const urlInp = document.getElementById(`c-im-m${idx}-custom-url`) as HTMLInputElement | null;
        urlInp?.addEventListener("input", () => updateMetricIconUI(idx));

        bindFileUpload(`c-im-m${idx}-file`, `c-im-m${idx}-custom-url`, () => updateMetricIconUI(idx));

        const radios = document.querySelectorAll(`input[name="c-im-m${idx}-icon-type"]`);
        radios.forEach((r) => r.addEventListener("change", () => updateMetricIconUI(idx)));
      }

      // 3 Seals
      for (let i = 0; i < 3; i++) {
        const idx = i;
        const themeSel = document.getElementById(`c-im-s${idx}-theme`) as HTMLSelectElement | null;
        themeSel?.addEventListener("change", () => updateSealUI(idx));

        const urlInp = document.getElementById(`c-im-s${idx}-custom-url`) as HTMLInputElement | null;
        urlInp?.addEventListener("input", () => updateSealUI(idx));

        bindFileUpload(`c-im-s${idx}-file`, `c-im-s${idx}-custom-url`, () => updateSealUI(idx));
      }

      // Add Why Card button
      document.getElementById("btn-add-im-why-card")?.addEventListener("click", () => {
        activeIronmanWhyCards.push({
          id: `why-${Date.now()}`,
          iconEmoji: "⭐",
          title: "Keunggulan Baru",
          description: "Deskripsi pengalaman berkesan bagi atlet triathlon.",
        });
        renderIronmanWhyCardsList();
      });
    }

    interface AdminCheckpointRow {
      code: string;
      name: string;
      checkpointType: string;
      distanceMeters: number;
      aliases: string;
    }
    let activeCheckpoints: AdminCheckpointRow[] = [];
    let currentEvent: MarathonEvent | null = null;

    // Populate Preset Banner Images
    if (modalQuickImages) {
      modalQuickImages.innerHTML = GENERATED_IMAGE_PRESETS.map(
        (img) => `
        <button
          type="button"
          class="group relative h-14 overflow-hidden rounded-lg border border-slate-700 bg-slate-950 text-left hover:border-orange-500 transition-all cursor-pointer"
          data-img-url="${img.url}"
        >
          <img src="${img.url}" alt="${img.name}" class="h-full w-full object-cover group-hover:scale-105 transition-transform" />
          <div class="absolute inset-0 bg-slate-950/60 p-1 flex items-end">
            <span class="text-[9px] font-bold text-white leading-tight truncate">${img.name}</span>
          </div>
        </button>
      `
      ).join("");

      modalQuickImages.querySelectorAll<HTMLButtonElement>("button[data-img-url]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const url = btn.dataset.imgUrl || "";
          if (bannerInput && bannerPreview) {
            bannerInput.value = url;
            bannerPreview.src = url;
          }
        });
      });
    }

    if (bannerInput && bannerPreview) {
      bannerInput.addEventListener("input", () => {
        bannerPreview.src = bannerInput.value.trim() || "/images/events/hero_marathon.jpg";
      });
    }

    // Tab Navigation & Horizontal Scroll (Buttons + Mouse Drag)
    const tabsContainer = document.getElementById("customizer-tabs")!;
    const scrollLeftBtn = document.getElementById("tab-scroll-left");
    const scrollRightBtn = document.getElementById("tab-scroll-right");

    scrollLeftBtn?.addEventListener("click", () => {
      tabsContainer.scrollBy({ left: -220, behavior: "smooth" });
    });

    scrollRightBtn?.addEventListener("click", () => {
      tabsContainer.scrollBy({ left: 220, behavior: "smooth" });
    });

    // Mouse drag scrolling without scrollbar
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    tabsContainer.addEventListener("mousedown", (e) => {
      isDown = true;
      tabsContainer.classList.add("cursor-grabbing");
      startX = e.pageX - tabsContainer.offsetLeft;
      scrollLeft = tabsContainer.scrollLeft;
    });

    tabsContainer.addEventListener("mouseleave", () => {
      isDown = false;
      tabsContainer.classList.remove("cursor-grabbing");
    });

    tabsContainer.addEventListener("mouseup", () => {
      isDown = false;
      tabsContainer.classList.remove("cursor-grabbing");
    });

    tabsContainer.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - tabsContainer.offsetLeft;
      const walk = (x - startX) * 1.5;
      tabsContainer.scrollLeft = scrollLeft - walk;
    });

    // Tab switching
    const tabBtns = document.querySelectorAll<HTMLButtonElement>(".c-tab-btn");
    const tabPanes = document.querySelectorAll<HTMLDivElement>(".c-tab-pane");

    tabBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const target = btn.dataset.tab;
        tabBtns.forEach((b) => {
          b.classList.remove("active", "bg-orange-600", "text-white", "font-bold", "shadow");
          b.classList.add("text-slate-400", "font-semibold");
        });
        btn.classList.add("active", "bg-orange-600", "text-white", "font-bold", "shadow");
        btn.classList.remove("text-slate-400", "font-semibold");

        tabPanes.forEach((pane) => {
          if (pane.id === target) {
            pane.classList.remove("hidden");
          } else {
            pane.classList.add("hidden");
          }
        });
      });
    });

    // Helper Toast
    function showToast(msg: string) {
      toast.textContent = msg;
      toast.classList.remove("hidden");
      setTimeout(() => {
        toast.classList.add("hidden");
      }, 4000);
    }

    // Template specific panel switcher
    function updateTemplateSpecificPanels(templateId: string) {
      document.querySelectorAll(".tpl-panel").forEach((p) => p.classList.add("hidden"));
      const badge = document.getElementById("c-active-template-badge");

      if (templateId === "template-ironman") {
        document.getElementById("panel-tpl-ironman")?.classList.remove("hidden");
        if (badge) badge.textContent = "Aktif: IRONMAN Triathlon";
      } else if (templateId === "template-bangkok") {
        document.getElementById("panel-tpl-bangkok")?.classList.remove("hidden");
        if (badge) badge.textContent = "Aktif: Bangkok Midnight";
      } else if (templateId === "template-tokyo") {
        document.getElementById("panel-tpl-tokyo")?.classList.remove("hidden");
        if (badge) badge.textContent = "Aktif: Tokyo Marathon";
      } else if (templateId === "template-berlin") {
        document.getElementById("panel-tpl-berlin")?.classList.remove("hidden");
        if (badge) badge.textContent = "Aktif: Berlin Speed";
      } else if (templateId === "template-borobudur") {
        document.getElementById("panel-tpl-borobudur")?.classList.remove("hidden");
        if (badge) badge.textContent = "Aktif: Borobudur Heritage";
      } else if (templateId === "template-baa") {
        document.getElementById("panel-tpl-baa")?.classList.remove("hidden");
        if (badge) badge.textContent = "Aktif: Boston Marathon (BAA)";
      } else if (templateId === "template-summarecon") {
        document.getElementById("panel-tpl-summarecon")?.classList.remove("hidden");
        if (badge) badge.textContent = "Aktif: Summarecon Bandung";
      } else {
        document.getElementById("panel-tpl-generic")?.classList.remove("hidden");
        if (badge) badge.textContent = "Aktif: Universal Custom";
      }
    }

    const tplSelect = document.getElementById("c-template-id") as HTMLSelectElement;
    tplSelect?.addEventListener("change", () => {
      updateTemplateSpecificPanels(tplSelect.value);
    });

    // Load Event Data from URL Query Params (?id=... or ?new=1)
    const urlParams = new URLSearchParams(window.location.search);
    const eventIdParam = urlParams.get("id");
    const isNew = urlParams.get("new") === "1";

    if (isNew) {
      // Create fresh new event
      const newId = `event-${Date.now()}`;
      currentEvent = {
        id: newId,
        slug: newId,
        name: "Event Marathon Baru 2026",
        tagline: "Sports Endurance Challenge",
        description: "Ajang olahraga prestisius dengan lintasan bersertifikat dan sistem antrean war adil.",
        eventType: "MARATHON",
        status: "published",
        organizerName: "IvyTicketing Organizer",
        organizerSlug: "ivy-org",
        city: "Jakarta",
        venueName: "Gelora Bung Karno",
        startsAt: "2026-09-20T05:00:00+07:00",
        flagOffTime: "05:00 WIB",
        bannerUrl: "/images/events/hero_marathon.jpg",
        themeColor: "#ea580c",
        accentColor: "#f59e0b",
        elevationGain: "80m (Flat)",
        waterStationsCount: 12,
        medicalStationsCount: 6,
        categories: [
          {
            id: `cat-${Date.now()}-1`,
            code: "FM42K",
            name: "Full Marathon 42K",
            distance: "42.195 KM",
            distanceKm: 42.195,
            price: 750000,
            quota: 5000,
            registeredCount: 0,
            mode: "WAR_QUEUE",
            status: "OPEN",
          },
          {
            id: `cat-${Date.now()}-2`,
            code: "HM21K",
            name: "Half Marathon 21K",
            distance: "21.097 KM",
            distanceKm: 21.097,
            price: 500000,
            quota: 8000,
            registeredCount: 0,
            mode: "WAR_QUEUE",
            status: "OPEN",
          },
        ],
        layoutConfig: { ...DEFAULT_LAYOUT_CONFIG },
      };
      populateForm(currentEvent);
    } else if (eventIdParam) {
      const found = getMarathonEventById(eventIdParam);
      if (found) {
        currentEvent = found;
        populateForm(found);
      } else {
        alert("Event tidak ditemukan!");
        window.location.href = "/admin/events";
      }
    } else {
      // Default to first event if no query param
      const all = getMarathonEvents();
      if (all.length > 0) {
        currentEvent = all[0];
        populateForm(currentEvent);
      }
    }

    function populateForm(ev: MarathonEvent) {
      const titleEl = document.getElementById("page-event-title");
      if (titleEl) titleEl.textContent = `Kustomisasi: ${ev.name}`;

      if (previewBtn) previewBtn.href = `/events/${ev.slug || ev.id}`;

      (document.getElementById("c-event-id") as HTMLInputElement).value = ev.id;
      (document.getElementById("c-name") as HTMLInputElement).value = ev.name;
      (document.getElementById("c-tagline") as HTMLInputElement).value = ev.tagline || "";
      (document.getElementById("c-desc") as HTMLTextAreaElement).value = ev.description || "";
      (document.getElementById("c-city") as HTMLInputElement).value = ev.city || "";
      (document.getElementById("c-venue") as HTMLInputElement).value = ev.venueName || "";
      (document.getElementById("c-certified") as HTMLInputElement).value = ev.certifiedBy || "";
      (document.getElementById("c-date") as HTMLInputElement).value = ev.startsAt ? ev.startsAt.substring(0, 10) : "";
      (document.getElementById("c-flagoff") as HTMLInputElement).value = ev.flagOffTime || "";
      (document.getElementById("c-status") as HTMLSelectElement).value = ev.status || "published";

      const bannerUrl = ev.bannerUrl || "/images/events/hero_marathon.jpg";
      bannerInput.value = bannerUrl;
      bannerPreview.src = bannerUrl;

      // Layout config
      const lc = ev.layoutConfig || DEFAULT_LAYOUT_CONFIG;
      tplSelect.value = lc.templateId || "template-summarecon";
      updateTemplateSpecificPanels(tplSelect.value);

      const alignRadios = document.querySelectorAll<HTMLInputElement>('input[name="c-hero-align"]');
      alignRadios.forEach((r) => {
        r.checked = r.value === (lc.heroAlignment || "center");
      });

      (document.getElementById("c-hero-variant") as HTMLSelectElement).value = lc.heroVariant || "poster";
      (document.getElementById("c-theme-style") as HTMLSelectElement).value = lc.themeStyle || "summarecon_neon";
      (document.getElementById("c-paper-texture") as HTMLInputElement).checked = lc.paperTexture !== false;
      (document.getElementById("c-show-ticker") as HTMLInputElement).checked = lc.showTicker !== false;
      (document.getElementById("c-ticker-text") as HTMLInputElement).value = lc.tickerText || "";

      (document.getElementById("c-show-countdown") as HTMLInputElement).checked = lc.showCountdown !== false;
      (document.getElementById("c-show-categories") as HTMLInputElement).checked = lc.showCategories !== false;
      (document.getElementById("c-show-route") as HTMLInputElement).checked = lc.showRoute !== false;
      (document.getElementById("c-show-rpc") as HTMLInputElement).checked = lc.showRpc !== false;
      (document.getElementById("c-show-schedule") as HTMLInputElement).checked = lc.showSchedule !== false;
      (document.getElementById("c-show-blocks") as HTMLInputElement).checked = lc.showCustomBlocks !== false;
      (document.getElementById("c-show-sponsors") as HTMLInputElement).checked = lc.showSponsors !== false;

      // Titles
      (document.getElementById("c-title-cat") as HTMLInputElement).value = lc.categorySectionTitle || "";
      (document.getElementById("c-sub-cat") as HTMLTextAreaElement).value = lc.categorySectionSubtitle || "";
      (document.getElementById("c-title-route") as HTMLInputElement).value = lc.routeSectionTitle || "";
      (document.getElementById("c-sub-route") as HTMLTextAreaElement).value = lc.routeSectionSubtitle || "";
      (document.getElementById("c-title-rpc") as HTMLInputElement).value = lc.rpcSectionTitle || "";
      (document.getElementById("c-sub-rpc") as HTMLTextAreaElement).value = lc.rpcSectionSubtitle || "";
      (document.getElementById("c-title-schedule") as HTMLInputElement).value = lc.scheduleSectionTitle || "";
      (document.getElementById("c-cta-text") as HTMLInputElement).value = lc.ctaButtonText || "DAFTAR SEKARANG";

      // BAA Config
      const bc = lc.baaConfig;
      const baaAlertEl = document.getElementById("c-baa-alert-text") as HTMLInputElement | null;
      if (baaAlertEl) baaAlertEl.value = bc?.topAlertText || "";
      const baaLinkEl = document.getElementById("c-baa-alert-link") as HTMLInputElement | null;
      if (baaLinkEl) baaLinkEl.value = bc?.topAlertLinkUrl || "";
      const baaEdEl = document.getElementById("c-baa-edition") as HTMLInputElement | null;
      if (baaEdEl) baaEdEl.value = bc?.editionText || "";
      const baaSloganEl = document.getElementById("c-baa-slogan") as HTMLInputElement | null;
      if (baaSloganEl) baaSloganEl.value = bc?.sloganText || "";
      const baaPresEl = document.getElementById("c-baa-presented") as HTMLInputElement | null;
      if (baaPresEl) baaPresEl.value = bc?.presentedByText || "";
      const baaPhotoEl = document.getElementById("c-baa-finish-photo") as HTMLInputElement | null;
      if (baaPhotoEl) baaPhotoEl.value = bc?.finishLinePhotoUrl || "";

      // Navbar Branding Config
      const nc = lc.navbarConfig;
      const navTitleEl = document.getElementById("c-nav-brand-title") as HTMLInputElement | null;
      if (navTitleEl) navTitleEl.value = nc?.brandTitle || "";
      const navSubEl = document.getElementById("c-nav-brand-sub") as HTMLInputElement | null;
      if (navSubEl) navSubEl.value = nc?.brandSubtitle || "";
      const navIconEl = document.getElementById("c-nav-brand-icon-url") as HTMLInputElement | null;
      if (navIconEl) navIconEl.value = nc?.brandIconUrl || "";
      const navBadgeTextEl = document.getElementById("c-nav-brand-badge-text") as HTMLInputElement | null;
      if (navBadgeTextEl) navBadgeTextEl.value = nc?.brandBadgeText || "";
      const navBadgeBgEl = document.getElementById("c-nav-brand-badge-bg") as HTMLInputElement | null;
      if (navBadgeBgEl) navBadgeBgEl.value = nc?.brandBadgeBg || "";

      // IRONMAN Config
      const imc = lc.ironmanConfig;
      const setVal = (id: string, val?: string) => {
        const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el && val !== undefined) el.value = val;
      };

      setVal("c-im-tag-badge", imc?.tagBadge || "FLEX90 ELIGIBLE");
      setVal("c-im-kona", imc?.konaSlots || "45 SLOTS");
      setVal("c-im-cta-primary-text", imc?.heroCtaPrimaryText || "VIEW ENTRY OPTIONS");
      setVal("c-im-cta-primary-link", imc?.heroCtaPrimaryLink || "#im-tiers");
      setVal("c-im-cta-sec-text", imc?.heroCtaSecondaryText || "COURSE OVERVIEW");
      setVal("c-im-cta-sec-link", imc?.heroCtaSecondaryLink || "#im-course");

      // 6 Metrics
      const mList = (imc?.metrics && imc.metrics.length === 6) ? imc.metrics : [
        { id: "swim", label: "Swim", value: imc?.swimMetric || "Ocean (1.9K)", iconType: "preset", presetIcon: "swim" },
        { id: "bike", label: "Bike", value: imc?.bikeMetric || "Hilly (90K)", iconType: "preset", presetIcon: "bike" },
        { id: "run", label: "Run", value: imc?.runMetric || "Flat (21.1K)", iconType: "preset", presetIcon: "run" },
        { id: "airHigh", label: "High Air Temp", value: imc?.airTempMetric || "86 °F / 30 °C", iconType: "preset", presetIcon: "sun" },
        { id: "airLow", label: "Low Air Temp", value: imc?.lowAirTempMetric || "75 °F / 24 °C", iconType: "preset", presetIcon: "snowflake" },
        { id: "waterTemp", label: "Avg. Water Temp", value: imc?.waterTempMetric || "84 °F / 29 °C", iconType: "preset", presetIcon: "water" },
      ];

      mList.forEach((m: any, i: number) => {
        setVal(`c-im-m${i}-label`, m.label || "");
        setVal(`c-im-m${i}-val`, m.value || "");
        setVal(`c-im-m${i}-custom-url`, m.customIconUrl || "");

        const presetSel = document.getElementById(`c-im-m${i}-preset`) as HTMLSelectElement | null;
        if (presetSel && m.presetIcon) presetSel.value = m.presetIcon;

        const isCustom = m.iconType === "custom";
        const radioPreset = document.querySelector(`input[name="c-im-m${i}-icon-type"][value="preset"]`) as HTMLInputElement | null;
        const radioCustom = document.querySelector(`input[name="c-im-m${i}-icon-type"][value="custom"]`) as HTMLInputElement | null;
        if (isCustom && radioCustom) radioCustom.checked = true;
        else if (radioPreset) radioPreset.checked = true;

        updateMetricIconUI(i);
      });

      // Video & Splendor
      setVal("c-im-splendor-title", imc?.splendorTitle || "DIVE INTO THE TROPICAL SPLENDOR OF LANGKAWI");
      setVal("c-im-splendor-desc", imc?.splendorDescription || ev.description || "");
      setVal("c-im-yt-url", imc?.youtubeUrl || "https://www.youtube.com/watch?v=17mCq3YV6c8");
      setVal("c-im-video-badge", imc?.videoBadgeText || "Official Race Rewind & Highlights");
      setVal("c-im-thumb-url", imc?.videoThumbnailUrl || ev.bannerUrl || "");
      const thumbPrev = document.getElementById("c-im-thumb-preview") as HTMLImageElement | null;
      if (thumbPrev) thumbPrev.src = imc?.videoThumbnailUrl || ev.bannerUrl || "/images/events/ironman_triathlon.jpg";

      // 3 Seals
      const sList = (imc?.seals && imc.seals.length === 3) ? imc.seals : [
        { id: "seal-1", badgeTag: "QUALIFYING", title: "VinFast World Championship", subtitle: "45 Age-Group Slots to Kona", colorTheme: "blue" },
        { id: "seal-2", badgeTag: "ATHLETES' CHOICE", title: "Athletes' Choice Award", subtitle: "Top-Rated Global Race Experience", colorTheme: "gold" },
        { id: "seal-3", badgeTag: "FLEX90", title: "Flex90 Registration", subtitle: "Free deferral & transfer options within 90 days", colorTheme: "red" },
      ];

      sList.forEach((s: any, i: number) => {
        setVal(`c-im-s${i}-tag`, s.badgeTag || "");
        setVal(`c-im-s${i}-title`, s.title || "");
        setVal(`c-im-s${i}-sub`, s.subtitle || "");
        setVal(`c-im-s${i}-custom-url`, s.iconUrl || "");
        const themeSel = document.getElementById(`c-im-s${i}-theme`) as HTMLSelectElement | null;
        if (themeSel && s.colorTheme) themeSel.value = s.colorTheme;
        updateSealUI(i);
      });

      // Why Race
      setVal("c-im-why-tagline", imc?.whySectionTagline || "RACE IN PARADISE");
      setVal("c-im-why-title", imc?.whySectionTitle || "WHY DO IRONMAN 70.3 LANGKAWI");
      setVal("c-im-why-desc", imc?.whySectionSubtitle || "Pengalaman triathlon kelas dunia di salah satu destinasi kepulauan tropis terindah di Asia Tenggara.");
      const whyBg = imc?.whyBgColor || "#c35607";
      setVal("c-im-why-bg", whyBg);
      const bgPicker = document.getElementById("c-im-why-bg-picker") as HTMLInputElement | null;
      if (bgPicker) bgPicker.value = whyBg.startsWith("#") ? whyBg : "#c35607";

      activeIronmanWhyCards = (imc?.whyCards && imc.whyCards.length > 0)
        ? JSON.parse(JSON.stringify(imc.whyCards))
        : JSON.parse(JSON.stringify(DEFAULT_IRONMAN_WHY_CARDS));
      renderIronmanWhyCardsList();

      // Mobile Bottom Bar
      const stickyCheck = document.getElementById("c-im-sticky-enable") as HTMLInputElement | null;
      if (stickyCheck) stickyCheck.checked = imc?.showStickyMobileCta !== false;
      setVal("c-im-sticky-title", imc?.stickyMobileTitle || "Lock in your spot");
      setVal("c-im-sticky-sub", imc?.stickyMobileSubtitle || "Early bird tier 1 open");
      setVal("c-im-sticky-btn", imc?.stickyMobileBtnText || "View options");
      setVal("c-im-sticky-link", imc?.stickyMobileBtnLink || "#im-tiers");

      // Route & RPC
      (document.getElementById("c-elevation") as HTMLInputElement).value = ev.elevationGain || "";
      (document.getElementById("c-water-stations") as HTMLInputElement).value = String(ev.waterStationsCount || 15);
      (document.getElementById("c-med-stations") as HTMLInputElement).value = String(ev.medicalStationsCount || 8);
      (document.getElementById("c-highlights") as HTMLTextAreaElement).value = (ev.routeHighlights || []).join("\n");

      (document.getElementById("c-rpc-dates") as HTMLInputElement).value = ev.racepackInfo?.dates || "";
      (document.getElementById("c-rpc-hours") as HTMLInputElement).value = ev.racepackInfo?.hours || "";
      (document.getElementById("c-rpc-venue") as HTMLInputElement).value = ev.racepackInfo?.venue || "";
      (document.getElementById("c-rpc-reqs") as HTMLTextAreaElement).value = (ev.racepackInfo?.requirements || []).join("\n");

      // State arrays
      activeCategories = JSON.parse(JSON.stringify(ev.categories || []));
      activeCustomBlocks = JSON.parse(JSON.stringify(lc.customBlocks || []));
      activeSchedule = JSON.parse(JSON.stringify(ev.schedule || []));

      // Timing & Race RFID Config
      const tc = (ev as any).timingConfig || {};
      (document.getElementById("timing-provider") as HTMLSelectElement).value = tc.provider || "RACE_RESULT";
      (document.getElementById("timing-transport") as HTMLSelectElement).value = tc.transport || "HTTP_PUSH";
      (document.getElementById("timing-sync-mode") as HTMLSelectElement).value = tc.syncMode || "RAW_PASSINGS";
      (document.getElementById("timing-external-race-id") as HTMLInputElement).value = tc.externalRaceId || "";

      const pol = tc.policy || {};
      (document.getElementById("timing-policy-debounce") as HTMLInputElement).value = String(pol.debounceWindowSeconds ?? 15);
      (document.getElementById("timing-policy-cutoff") as HTMLInputElement).value = String(pol.cutoffMinutes ?? 360);
      (document.getElementById("timing-policy-allow-missing-start") as HTMLInputElement).checked = pol.allowMissingStart !== false;

      const endpointEl = document.getElementById("timing-endpoint-url");
      if (endpointEl) {
        endpointEl.textContent = `${window.location.origin}/api/v1/organizations/${ev.organizerSlug || "default"}/events/${ev.id}/results/timing/passings`;
      }

      if (tc.checkpoints && tc.checkpoints.length > 0) {
        activeCheckpoints = tc.checkpoints.map((cp: any) => ({
          code: cp.code,
          name: cp.name,
          checkpointType: cp.checkpointType || "SPLIT",
          distanceMeters: cp.distanceMeters || 0,
          aliases: Array.isArray(cp.aliases) ? cp.aliases.join(", ") : (cp.aliases || ""),
        }));
      } else {
        activeCheckpoints = [
          { code: "START", name: "Matras Gerbang Start", checkpointType: "START", distanceMeters: 0, aliases: "START_MAT, RR_START" },
          { code: "CP10K", name: "Checkpoint 10 KM", checkpointType: "SPLIT", distanceMeters: 10000, aliases: "10K, SPLIT1, MAT_10K" },
          { code: "CP21K", name: "Halfway 21.1 KM", checkpointType: "SPLIT", distanceMeters: 21097, aliases: "21K, HALF, MAT_HALF" },
          { code: "FINISH", name: "Matras Gerbang Finish", checkpointType: "FINISH", distanceMeters: 42195, aliases: "FINISH_MAT, RR_FINISH" },
        ];
      }

      // Queue & Virtual Waiting Room Settings
      const qc = lc.queueConfig;
      const qEnabled = document.getElementById("c-queue-enabled") as HTMLInputElement | null;
      if (qEnabled) qEnabled.checked = qc?.enabled !== false;
      const qMode = document.getElementById("c-queue-mode") as HTMLSelectElement | null;
      if (qMode) qMode.value = qc?.mode || "auto";
      const qAlgo = document.getElementById("c-queue-algorithm") as HTMLSelectElement | null;
      if (qAlgo) qAlgo.value = qc?.algorithm || "fifo";
      const qThresh = document.getElementById("c-queue-threshold") as HTMLInputElement | null;
      if (qThresh) qThresh.value = String(qc?.trafficThreshold ?? 50);
      const qActive = document.getElementById("c-queue-active-waiting") as HTMLInputElement | null;
      if (qActive) qActive.value = String(qc?.activeWaitingCount ?? 0);
      const qRate = document.getElementById("c-queue-release-rate") as HTMLInputElement | null;
      if (qRate) qRate.value = String(qc?.releaseRatePerMinute ?? 60);

      renderCategoriesList();
      renderCustomBlocksList();
      renderScheduleList();
      renderCheckpointsList();
    }

    function renderCategoriesList() {
      const container = document.getElementById("categories-editor-list");
      if (!container) return;
      container.innerHTML = activeCategories
        .map(
          (cat, idx) => `
        <div class="rounded-xl border border-slate-800 bg-slate-950 p-4 space-y-3">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-orange-400">Kategori #${idx + 1}: ${esc(cat.name)}</span>
            <button type="button" class="btn-del-cat text-xs text-rose-400 hover:text-rose-300 font-semibold cursor-pointer" data-idx="${idx}">Hapus</button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Nama Kategori</label>
              <input type="text" class="cat-name w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white" value="${esc(cat.name)}" data-idx="${idx}" />
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Jarak (KM)</label>
              <input type="text" class="cat-distance w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white" value="${esc(cat.distance)}" data-idx="${idx}" />
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Biaya (Rp)</label>
              <input type="number" class="cat-price w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white" value="${cat.price}" data-idx="${idx}" />
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Mode War / Ballot</label>
              <select class="cat-mode w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white" data-idx="${idx}">
                <option value="WAR_QUEUE" ${cat.mode === "WAR_QUEUE" ? "selected" : ""}>War Ticket (Antrean Cepat)</option>
                <option value="BALLOT" ${cat.mode === "BALLOT" ? "selected" : ""}>Sistem Ballot (Undian)</option>
                <option value="NORMAL" ${cat.mode === "NORMAL" ? "selected" : ""}>Normal (Buka Langsung)</option>
              </select>
            </div>
          </div>
        </div>
      `
        )
        .join("");

      container.querySelectorAll<HTMLButtonElement>(".btn-del-cat").forEach((btn) => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.dataset.idx);
          activeCategories.splice(idx, 1);
          renderCategoriesList();
        });
      });

      container.querySelectorAll<HTMLInputElement>(".cat-name").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCategories[Number(inp.dataset.idx)].name = inp.value;
        });
      });

      container.querySelectorAll<HTMLInputElement>(".cat-distance").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCategories[Number(inp.dataset.idx)].distance = inp.value;
        });
      });

      container.querySelectorAll<HTMLInputElement>(".cat-price").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCategories[Number(inp.dataset.idx)].price = Number(inp.value) || 0;
        });
      });

      container.querySelectorAll<HTMLSelectElement>(".cat-mode").forEach((sel) => {
        sel.addEventListener("change", () => {
          activeCategories[Number(sel.dataset.idx)].mode = sel.value as any;
        });
      });
    }

    document.getElementById("btn-add-category")?.addEventListener("click", () => {
      activeCategories.push({
        id: `cat-${Date.now()}`,
        code: "NEW",
        name: "Kategori Baru 10K",
        distance: "10.000 KM",
        distanceKm: 10.0,
        price: 350000,
        quota: 3000,
        registeredCount: 0,
        mode: "WAR_QUEUE",
        status: "OPEN",
      });
      renderCategoriesList();
    });

    function renderCustomBlocksList() {
      const container = document.getElementById("custom-blocks-editor-list");
      if (!container) return;
      container.innerHTML = activeCustomBlocks
        .map(
          (b, idx) => `
        <div class="rounded-xl border border-slate-800 bg-slate-950 p-4 space-y-3">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <span class="text-xs font-bold text-orange-400">Blok #${idx + 1}</span>
            <button type="button" class="btn-del-block text-xs text-rose-400 hover:text-rose-300 font-semibold cursor-pointer" data-idx="${idx}">Hapus</button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Judul Blok</label>
              <input type="text" class="block-title w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white" value="${esc(b.title)}" data-idx="${idx}" />
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Badge Atas</label>
              <input type="text" class="block-badge w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white" value="${esc(b.badge || '')}" data-idx="${idx}" />
            </div>
          </div>
          <div>
            <label class="text-[10px] text-slate-400 uppercase font-bold block mb-1">Isi Konten</label>
            <textarea rows="2" class="block-content w-full rounded border border-slate-700 bg-slate-900 p-2 text-xs text-white" data-idx="${idx}">${esc(b.content)}</textarea>
          </div>
        </div>
      `
        )
        .join("");

      container.querySelectorAll<HTMLButtonElement>(".btn-del-block").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeCustomBlocks.splice(Number(btn.dataset.idx), 1);
          renderCustomBlocksList();
        });
      });

      container.querySelectorAll<HTMLInputElement>(".block-title").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCustomBlocks[Number(inp.dataset.idx)].title = inp.value;
        });
      });

      container.querySelectorAll<HTMLInputElement>(".block-badge").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCustomBlocks[Number(inp.dataset.idx)].badge = inp.value;
        });
      });

      container.querySelectorAll<HTMLTextAreaElement>(".block-content").forEach((ta) => {
        ta.addEventListener("input", () => {
          activeCustomBlocks[Number(ta.dataset.idx)].content = ta.value;
        });
      });
    }

    document.getElementById("btn-add-block")?.addEventListener("click", () => {
      activeCustomBlocks.push({
        id: `block-${Date.now()}`,
        title: "Informasi Shuttle Bus & Parkir",
        badge: "AKOMODASI & TRANSPORT",
        style: "card",
        content: "Penyelenggara menyediakan bus penjemputan gratis dari titik transit utama mulai pukul 03:00 WIB.",
      });
      renderCustomBlocksList();
    });

    function renderScheduleList() {
      const container = document.getElementById("schedule-editor-list");
      if (!container) return;
      container.innerHTML = activeSchedule
        .map(
          (s, idx) => `
        <div class="flex items-center gap-3 rounded-lg border border-slate-800 bg-slate-950 p-2.5">
          <input type="text" class="sch-time w-28 rounded border border-slate-700 bg-slate-900 px-2 py-1 text-xs text-white font-mono" value="${esc(s.time)}" data-idx="${idx}" />
          <input type="text" class="sch-act flex-1 rounded border border-slate-700 bg-slate-900 px-2.5 py-1 text-xs text-white" value="${esc(s.activity)}" data-idx="${idx}" />
          <button type="button" class="btn-del-sch text-xs text-rose-400 hover:text-rose-300 font-semibold cursor-pointer" data-idx="${idx}">Hapus</button>
        </div>
      `
        )
        .join("");

      container.querySelectorAll<HTMLButtonElement>(".btn-del-sch").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeSchedule.splice(Number(btn.dataset.idx), 1);
          renderScheduleList();
        });
      });

      container.querySelectorAll<HTMLInputElement>(".sch-time").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeSchedule[Number(inp.dataset.idx)].time = inp.value;
        });
      });

      container.querySelectorAll<HTMLInputElement>(".sch-act").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeSchedule[Number(inp.dataset.idx)].activity = inp.value;
        });
      });
    }

    document.getElementById("btn-add-schedule")?.addEventListener("click", () => {
      activeSchedule.push({
        time: "05:00 WIB",
        activity: "Flag-Off Perlombaan",
      });
      renderScheduleList();
    });

    // Checkpoints List Renderer
    function renderCheckpointsList() {
      const container = document.getElementById("checkpoints-list");
      if (!container) return;
      if (activeCheckpoints.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-500 py-2">Belum ada pos checkpoint matras.</p>`;
        return;
      }
      container.innerHTML = activeCheckpoints
        .map(
          (cp, idx) => `
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3 space-y-2">
          <div class="flex items-center justify-between border-b border-slate-800 pb-1.5">
            <span class="text-xs font-bold text-sky-400 font-mono">Pos #${idx + 1}: ${esc(cp.code || "CP")}</span>
            <button type="button" class="btn-del-cp text-[11px] text-rose-400 hover:text-rose-300 font-semibold cursor-pointer" data-idx="${idx}">Hapus</button>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-2 text-xs">
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-0.5">Kode Checkpoint</label>
              <input type="text" class="cp-code w-full rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs font-mono text-white" value="${esc(cp.code)}" data-idx="${idx}" />
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-0.5">Nama Matras</label>
              <input type="text" class="cp-name w-full rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-white" value="${esc(cp.name)}" data-idx="${idx}" />
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-0.5">Tipe Pos</label>
              <select class="cp-type w-full rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs text-white" data-idx="${idx}">
                <option value="START" ${cp.checkpointType === "START" ? "selected" : ""}>START Matras</option>
                <option value="SPLIT" ${cp.checkpointType === "SPLIT" ? "selected" : ""}>SPLIT Matras Antara</option>
                <option value="FINISH" ${cp.checkpointType === "FINISH" ? "selected" : ""}>FINISH Matras</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-0.5">Jarak (Meter)</label>
              <input type="number" class="cp-dist w-full rounded border border-slate-700 bg-slate-950 px-2 py-1 text-xs font-mono text-white" value="${cp.distanceMeters}" data-idx="${idx}" />
            </div>
            <div class="sm:col-span-4">
              <label class="text-[10px] text-slate-400 uppercase font-bold block mb-0.5">Alias Hardware / Vendor (Pisahkan dengan Koma)</label>
              <input type="text" class="cp-aliases w-full rounded border border-slate-700 bg-slate-950 px-2.5 py-1 text-xs font-mono text-orange-300" placeholder="Misal: MAT_1, RR_START, START_CHIP" value="${esc(cp.aliases)}" data-idx="${idx}" />
            </div>
          </div>
        </div>
      `
        )
        .join("");

      container.querySelectorAll<HTMLButtonElement>(".btn-del-cp").forEach((btn) => {
        btn.addEventListener("click", () => {
          activeCheckpoints.splice(Number(btn.dataset.idx), 1);
          renderCheckpointsList();
        });
      });

      container.querySelectorAll<HTMLInputElement>(".cp-code").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCheckpoints[Number(inp.dataset.idx)].code = inp.value.trim().toUpperCase();
        });
      });
      container.querySelectorAll<HTMLInputElement>(".cp-name").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCheckpoints[Number(inp.dataset.idx)].name = inp.value;
        });
      });
      container.querySelectorAll<HTMLSelectElement>(".cp-type").forEach((sel) => {
        sel.addEventListener("change", () => {
          activeCheckpoints[Number(sel.dataset.idx)].checkpointType = sel.value;
        });
      });
      container.querySelectorAll<HTMLInputElement>(".cp-dist").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCheckpoints[Number(inp.dataset.idx)].distanceMeters = Number(inp.value) || 0;
        });
      });
      container.querySelectorAll<HTMLInputElement>(".cp-aliases").forEach((inp) => {
        inp.addEventListener("input", () => {
          activeCheckpoints[Number(inp.dataset.idx)].aliases = inp.value;
        });
      });
    }

    document.getElementById("btn-add-checkpoint")?.addEventListener("click", () => {
      activeCheckpoints.push({
        code: `CP${(activeCheckpoints.length + 1) * 5}K`,
        name: `Pos Checkpoint ${(activeCheckpoints.length + 1) * 5} KM`,
        checkpointType: "SPLIT",
        distanceMeters: (activeCheckpoints.length + 1) * 5000,
        aliases: "",
      });
      renderCheckpointsList();
    });

    document.getElementById("btn-generate-timing-token")?.addEventListener("click", () => {
      const randBytes = Array.from(crypto.getRandomValues(new Uint8Array(16)))
        .map((b) => b.toString(16).padStart(2, "0"))
        .join("");
      const token = `ivy_live_${randBytes}`;
      const tokenBox = document.getElementById("timing-token-box");
      const tokenVal = document.getElementById("timing-token-val");
      if (tokenBox && tokenVal) {
        tokenVal.textContent = token;
        tokenBox.classList.remove("hidden");
      }
      showToast("Ingestion Token baru berhasil dibuat!");
    });

    document.getElementById("btn-copy-timing-token")?.addEventListener("click", () => {
      const tokenVal = document.getElementById("timing-token-val")?.textContent || "";
      if (tokenVal) {
        navigator.clipboard.writeText(tokenVal);
        showToast("Token berhasil disalin ke clipboard!");
      }
    });

    // Save Event Handler
    async function handleSaveEvent(e?: Event) {
      if (e) e.preventDefault();
      if (!currentEvent) return;

      const eventId = (document.getElementById("c-event-id") as HTMLInputElement).value;
      const name = (document.getElementById("c-name") as HTMLInputElement).value.trim();
      const tagline = (document.getElementById("c-tagline") as HTMLInputElement).value.trim();
      const description = (document.getElementById("c-desc") as HTMLTextAreaElement).value.trim();
      const city = (document.getElementById("c-city") as HTMLInputElement).value.trim();
      const venueName = (document.getElementById("c-venue") as HTMLInputElement).value.trim();
      const certifiedBy = (document.getElementById("c-certified") as HTMLInputElement).value.trim();
      const dateVal = (document.getElementById("c-date") as HTMLInputElement).value;
      const flagOffTime = (document.getElementById("c-flagoff") as HTMLInputElement).value.trim();
      const status = (document.getElementById("c-status") as HTMLSelectElement).value as any;
      const bannerUrl = bannerInput.value.trim() || "/images/events/hero_marathon.jpg";

      const selectedAlign = (document.querySelector('input[name="c-hero-align"]:checked') as HTMLInputElement)?.value || "center";
      const heroVariant = (document.getElementById("c-hero-variant") as HTMLSelectElement).value as any;
      const themeStyle = (document.getElementById("c-theme-style") as HTMLSelectElement).value as any;
      const paperTexture = (document.getElementById("c-paper-texture") as HTMLInputElement).checked;
      const showTicker = (document.getElementById("c-show-ticker") as HTMLInputElement).checked;
      const tickerText = (document.getElementById("c-ticker-text") as HTMLInputElement).value.trim();

      const showCountdown = (document.getElementById("c-show-countdown") as HTMLInputElement).checked;
      const showCategories = (document.getElementById("c-show-categories") as HTMLInputElement).checked;
      const showRoute = (document.getElementById("c-show-route") as HTMLInputElement).checked;
      const showRpc = (document.getElementById("c-show-rpc") as HTMLInputElement).checked;
      const showSchedule = (document.getElementById("c-show-schedule") as HTMLInputElement).checked;
      const showCustomBlocks = (document.getElementById("c-show-blocks") as HTMLInputElement).checked;
      const showSponsors = (document.getElementById("c-show-sponsors") as HTMLInputElement).checked;

      const categorySectionTitle = (document.getElementById("c-title-cat") as HTMLInputElement).value.trim();
      const categorySectionSubtitle = (document.getElementById("c-sub-cat") as HTMLTextAreaElement).value.trim();
      const routeSectionTitle = (document.getElementById("c-title-route") as HTMLInputElement).value.trim();
      const routeSectionSubtitle = (document.getElementById("c-sub-route") as HTMLTextAreaElement).value.trim();
      const rpcSectionTitle = (document.getElementById("c-title-rpc") as HTMLInputElement).value.trim();
      const rpcSectionSubtitle = (document.getElementById("c-sub-rpc") as HTMLTextAreaElement).value.trim();
      const scheduleSectionTitle = (document.getElementById("c-title-schedule") as HTMLInputElement).value.trim();
      const scheduleSectionSubtitle = (document.getElementById("c-sub-schedule") as HTMLTextAreaElement).value.trim();
      const ctaButtonText = (document.getElementById("c-cta-text") as HTMLInputElement).value.trim();

      const elevationGain = (document.getElementById("c-elevation") as HTMLInputElement).value.trim();
      const waterStationsCount = Number((document.getElementById("c-water-stations") as HTMLInputElement).value) || 15;
      const medicalStationsCount = Number((document.getElementById("c-med-stations") as HTMLInputElement).value) || 8;
      const routeHighlights = (document.getElementById("c-highlights") as HTMLTextAreaElement).value
        .split("\n")
        .map((s) => s.trim())
        .filter(Boolean);

      const rpcDates = (document.getElementById("c-rpc-dates") as HTMLInputElement).value.trim();
      const rpcHours = (document.getElementById("c-rpc-hours") as HTMLInputElement).value.trim();
      const rpcVenue = (document.getElementById("c-rpc-venue") as HTMLInputElement).value.trim();
      const rpcReqs = (document.getElementById("c-rpc-reqs") as HTMLTextAreaElement).value
        .split("\n")
        .map((s) => s.trim())
        .filter(Boolean);

      const baaConfig: BaaLayoutConfig = {
        ...(currentEvent.layoutConfig?.baaConfig || {}),
        topAlertText: (document.getElementById("c-baa-alert-text") as HTMLInputElement)?.value.trim() || undefined,
        topAlertLinkUrl: (document.getElementById("c-baa-alert-link") as HTMLInputElement)?.value.trim() || undefined,
        editionText: (document.getElementById("c-baa-edition") as HTMLInputElement)?.value.trim() || undefined,
        sloganText: (document.getElementById("c-baa-slogan") as HTMLInputElement)?.value.trim() || undefined,
        presentedByText: (document.getElementById("c-baa-presented") as HTMLInputElement)?.value.trim() || undefined,
        finishLinePhotoUrl: (document.getElementById("c-baa-finish-photo") as HTMLInputElement)?.value.trim() || undefined,
      };

      const navbarConfig: EventNavbarConfig = {
        ...(currentEvent.layoutConfig?.navbarConfig || {}),
        brandTitle: (document.getElementById("c-nav-brand-title") as HTMLInputElement)?.value.trim() || undefined,
        brandSubtitle: (document.getElementById("c-nav-brand-sub") as HTMLInputElement)?.value.trim() || undefined,
        brandIconUrl: (document.getElementById("c-nav-brand-icon-url") as HTMLInputElement)?.value.trim() || undefined,
        brandBadgeText: (document.getElementById("c-nav-brand-badge-text") as HTMLInputElement)?.value.trim() || undefined,
        brandBadgeBg: (document.getElementById("c-nav-brand-badge-bg") as HTMLInputElement)?.value.trim() || undefined,
      };

      // Collect 6 Metrics
      const metrics: IronmanMetricItem[] = [];
      for (let i = 0; i < 6; i++) {
        const lbl = (document.getElementById(`c-im-m${i}-label`) as HTMLInputElement)?.value.trim();
        const val = (document.getElementById(`c-im-m${i}-val`) as HTMLInputElement)?.value.trim();
        const iconTypeRadio = document.querySelector(`input[name="c-im-m${i}-icon-type"]:checked`) as HTMLInputElement | null;
        const iconType = (iconTypeRadio?.value as "preset" | "custom") || "preset";
        const presetIcon = (document.getElementById(`c-im-m${i}-preset`) as HTMLSelectElement)?.value as any;
        const customIconUrl = (document.getElementById(`c-im-m${i}-custom-url`) as HTMLInputElement)?.value.trim();
        const metricId = i === 0 ? "swim" : i === 1 ? "bike" : i === 2 ? "run" : i === 3 ? "airHigh" : i === 4 ? "airLow" : "waterTemp";

        metrics.push({
          id: metricId,
          label: lbl || (i === 0 ? "Swim" : i === 1 ? "Bike" : i === 2 ? "Run" : i === 3 ? "High Air Temp" : i === 4 ? "Low Air Temp" : "Avg. Water Temp"),
          value: val || "",
          iconType,
          presetIcon,
          customIconUrl: customIconUrl || undefined,
        });
      }

      // Collect 3 Seals
      const seals: IronmanSealItem[] = [];
      for (let i = 0; i < 3; i++) {
        const tag = (document.getElementById(`c-im-s${i}-tag`) as HTMLInputElement)?.value.trim();
        const title = (document.getElementById(`c-im-s${i}-title`) as HTMLInputElement)?.value.trim();
        const sub = (document.getElementById(`c-im-s${i}-sub`) as HTMLInputElement)?.value.trim();
        const theme = (document.getElementById(`c-im-s${i}-theme`) as HTMLSelectElement)?.value as any;
        const customUrl = (document.getElementById(`c-im-s${i}-custom-url`) as HTMLInputElement)?.value.trim();

        seals.push({
          id: `seal-${i + 1}`,
          badgeTag: tag || (i === 0 ? "QUALIFYING" : i === 1 ? "ATHLETES' CHOICE" : "FLEX90"),
          title: title || (i === 0 ? "VinFast World Championship" : i === 1 ? "Athletes' Choice Award" : "Flex90 Registration"),
          subtitle: sub || (i === 0 ? "45 Age-Group Slots to Kona" : i === 1 ? "Top-Rated Global Race Experience" : "Free deferral & transfer options within 90 days"),
          colorTheme: theme || (i === 0 ? "blue" : i === 1 ? "gold" : "red"),
          iconUrl: customUrl || undefined,
        });
      }

      const ironmanConfig: IronmanLayoutConfig = {
        ...(currentEvent.layoutConfig?.ironmanConfig || {}),
        tagBadge: (document.getElementById("c-im-tag-badge") as HTMLInputElement)?.value.trim() || undefined,
        konaSlots: (document.getElementById("c-im-kona") as HTMLInputElement)?.value.trim() || undefined,
        heroCtaPrimaryText: (document.getElementById("c-im-cta-primary-text") as HTMLInputElement)?.value.trim() || undefined,
        heroCtaPrimaryLink: (document.getElementById("c-im-cta-primary-link") as HTMLInputElement)?.value.trim() || undefined,
        heroCtaSecondaryText: (document.getElementById("c-im-cta-sec-text") as HTMLInputElement)?.value.trim() || undefined,
        heroCtaSecondaryLink: (document.getElementById("c-im-cta-sec-link") as HTMLInputElement)?.value.trim() || undefined,
        metrics,
        swimMetric: metrics[0]?.value,
        bikeMetric: metrics[1]?.value,
        runMetric: metrics[2]?.value,
        airTempMetric: metrics[3]?.value,
        lowAirTempMetric: metrics[4]?.value,
        waterTempMetric: metrics[5]?.value,
        splendorTitle: (document.getElementById("c-im-splendor-title") as HTMLInputElement)?.value.trim() || undefined,
        splendorDescription: (document.getElementById("c-im-splendor-desc") as HTMLTextAreaElement)?.value.trim() || undefined,
        youtubeUrl: (document.getElementById("c-im-yt-url") as HTMLInputElement)?.value.trim() || undefined,
        videoBadgeText: (document.getElementById("c-im-video-badge") as HTMLInputElement)?.value.trim() || undefined,
        videoThumbnailUrl: (document.getElementById("c-im-thumb-url") as HTMLInputElement)?.value.trim() || undefined,
        seals,
        whySectionTagline: (document.getElementById("c-im-why-tagline") as HTMLInputElement)?.value.trim() || undefined,
        whySectionTitle: (document.getElementById("c-im-why-title") as HTMLInputElement)?.value.trim() || undefined,
        whySectionSubtitle: (document.getElementById("c-im-why-desc") as HTMLInputElement)?.value.trim() || undefined,
        whyBgColor: (document.getElementById("c-im-why-bg") as HTMLInputElement)?.value.trim() || undefined,
        whyCards: activeIronmanWhyCards,
        showStickyMobileCta: (document.getElementById("c-im-sticky-enable") as HTMLInputElement)?.checked ?? true,
        stickyMobileTitle: (document.getElementById("c-im-sticky-title") as HTMLInputElement)?.value.trim() || undefined,
        stickyMobileSubtitle: (document.getElementById("c-im-sticky-sub") as HTMLInputElement)?.value.trim() || undefined,
        stickyMobileBtnText: (document.getElementById("c-im-sticky-btn") as HTMLInputElement)?.value.trim() || undefined,
        stickyMobileBtnLink: (document.getElementById("c-im-sticky-link") as HTMLInputElement)?.value.trim() || undefined,
      };

      const queueEnabled = (document.getElementById("c-queue-enabled") as HTMLInputElement)?.checked ?? true;
      const queueMode = (document.getElementById("c-queue-mode") as HTMLSelectElement)?.value as ("auto" | "bypass" | "always_queue") || "auto";
      const queueAlgorithm = (document.getElementById("c-queue-algorithm") as HTMLSelectElement)?.value as ("fifo" | "randomized") || "fifo";
      const queueTrafficThreshold = Number((document.getElementById("c-queue-threshold") as HTMLInputElement)?.value) || 50;
      const queueActiveWaiting = Number((document.getElementById("c-queue-active-waiting") as HTMLInputElement)?.value) || 0;
      const queueReleaseRate = Number((document.getElementById("c-queue-release-rate") as HTMLInputElement)?.value) || 60;

      const queueConfig: EventQueueConfig = {
        enabled: queueEnabled,
        mode: queueMode,
        algorithm: queueAlgorithm,
        trafficThreshold: queueTrafficThreshold,
        activeWaitingCount: queueActiveWaiting,
        releaseRatePerMinute: queueReleaseRate,
      };

      const updatedLayout: MarathonLayoutConfig = {
        ...currentEvent.layoutConfig,
        templateId: tplSelect.value as MarathonTemplateId,
        heroAlignment: selectedAlign as any,
        heroVariant,
        themeStyle,
        paperTexture,
        showTicker,
        tickerText,
        showCountdown,
        showCategories,
        showRoute,
        showRpc,
        showSchedule,
        showCustomBlocks,
        showSponsors,
        categorySectionTitle,
        categorySectionSubtitle,
        routeSectionTitle,
        routeSectionSubtitle,
        rpcSectionTitle,
        rpcSectionSubtitle,
        scheduleSectionTitle,
        scheduleSectionSubtitle,
        ctaButtonText,
        customBlocks: activeCustomBlocks,
        baaConfig,
        navbarConfig,
        ironmanConfig,
        queueConfig,
      };

      const timingProvider = (document.getElementById("timing-provider") as HTMLSelectElement).value;
      const timingTransport = (document.getElementById("timing-transport") as HTMLSelectElement).value;
      const timingSyncMode = (document.getElementById("timing-sync-mode") as HTMLSelectElement).value;
      const timingExternalRaceId = (document.getElementById("timing-external-race-id") as HTMLInputElement).value.trim();
      const timingDebounce = Number((document.getElementById("timing-policy-debounce") as HTMLInputElement).value) || 15;
      const timingCutoff = Number((document.getElementById("timing-policy-cutoff") as HTMLInputElement).value) || 360;
      const timingAllowMissingStart = (document.getElementById("timing-policy-allow-missing-start") as HTMLInputElement).checked;

      const timingConfig = {
        provider: timingProvider,
        transport: timingTransport,
        syncMode: timingSyncMode,
        externalRaceId: timingExternalRaceId,
        policy: {
          debounceWindowSeconds: timingDebounce,
          cutoffMinutes: timingCutoff,
          allowMissingStart: timingAllowMissingStart,
        },
        checkpoints: activeCheckpoints.map((cp, idx) => ({
          code: cp.code,
          name: cp.name,
          checkpointType: cp.checkpointType,
          orderIndex: idx + 1,
          distanceMeters: cp.distanceMeters,
          aliases: cp.aliases
            .split(",")
            .map((s) => s.trim())
            .filter(Boolean),
        })),
      };

      const updatedEvent: MarathonEvent = {
        ...currentEvent,
        id: eventId,
        name,
        tagline,
        description,
        city,
        venueName,
        certifiedBy,
        startsAt: dateVal ? `${dateVal}T05:00:00+07:00` : currentEvent.startsAt,
        flagOffTime,
        status,
        bannerUrl,
        elevationGain,
        waterStationsCount,
        medicalStationsCount,
        routeHighlights,
        racepackInfo: {
          dates: rpcDates,
          hours: rpcHours,
          venue: rpcVenue,
          requirements: rpcReqs,
        },
        categories: activeCategories,
        schedule: activeSchedule,
        layoutConfig: updatedLayout,
        timingConfig,
        updatedAt: new Date().toISOString(),
      };

      saveMarathonEvent(updatedEvent);
      currentEvent = updatedEvent;
      showToast(`Event "${name}" berhasil disimpan.`);
      const titleEl = document.getElementById("page-event-title");
      if (titleEl) titleEl.textContent = `Kustomisasi: ${name}`;
      if (previewBtn) previewBtn.href = `/events/${updatedEvent.slug || updatedEvent.id}`;
    }

    initIronmanEditorControls();

    form.addEventListener("submit", handleSaveEvent);
    document.getElementById("btn-save-event-top")?.addEventListener("click", () => handleSaveEvent());
  </script>
</AdminLayout>
