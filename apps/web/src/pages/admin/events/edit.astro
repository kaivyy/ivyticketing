        case "run":
          return `<svg class="${cls}" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="20" cy="20" r="18" /><circle cx="23" cy="12" r="2.5" /><path d="M19 16l3 4 4-2" stroke-linecap="round" stroke-linejoin="round" /><path d="M19 16l-3 5 3 4" stroke-linecap="round" stroke-linejoin="round" /><path d="M22 20l-4 7-4-2" stroke-linecap="round" stroke-linejoin="round" /><path d="M22 20l3 4 4 3" stroke-linecap="round" stroke-linejoin="round" /></svg>`;
