---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Manajemen Status : ivyticketing">
  <div class="border-b border-slate-800 bg-slate-900/60 px-4 py-3 sm:px-6">
    <div class="mx-auto flex max-w-4xl items-center justify-between">
      <h1 class="text-base font-bold uppercase tracking-wider text-white">Manajemen Status & Insiden</h1>
      <span class="text-xs text-slate-400">Pembaruan Komponen & Laporan Gangguan</span>
    </div>
  </div>

  <main class="mx-auto max-w-4xl p-4 sm:p-6">
    <div id="root" class="space-y-6">
      <p class="text-slate-400">Memuat status sistem…</p>
    </div>
  </main>

  <script>
    import {
      fetchPublicStatus,
      listIncidentsAdmin,
      createIncident,
      addIncidentUpdate,
      updateComponent,
      COMPONENT_STATUS_LABELS,
      IMPACT_LABELS,
      INCIDENT_STATUS_LABELS,
      type Component,
      type Incident,
    } from "../../lib/status";
    import { esc } from "../../lib/safe";

    const root = document.getElementById("root")!;

    function fmtDate(s: string | null): string {
      if (!s) return "-";
      try {
        return new Date(s).toLocaleString("id-ID", { dateStyle: "medium", timeStyle: "short" });
      } catch {
        return s;
      }
    }

    function msg(id: string, text: string, isError = false) {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = text;
      el.className = isError ? "text-sm text-red-400 font-medium" : "text-sm text-emerald-400 font-medium";
    }

    const COMP_STATUSES = ["OPERATIONAL", "DEGRADED", "DOWN"];
    const IMPACTS = ["MINOR", "MAJOR", "CRITICAL", "NONE"];
    const INC_STATUSES = ["INVESTIGATING", "IDENTIFIED", "MONITORING", "RESOLVED"];

    function componentControls(components: Component[]): string {
      return `
        <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-6">
          <h2 class="mb-4 text-base font-bold text-white uppercase tracking-wider">Komponen Sistem</h2>
          <div class="space-y-3">
            ${components
              .map(
                (c) => `
                <div class="flex items-center justify-between gap-3 border-b border-slate-800/80 pb-3 last:border-0 last:pb-0">
                  <span class="font-medium text-slate-200">${esc(c.name)}</span>
                  <select data-comp="${esc(c.key)}" class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-sm text-white focus:outline-none focus:border-orange-500">
                    ${COMP_STATUSES.map(
                      (s) =>
                        `<option value="${s}" ${s === c.status ? "selected" : ""}>${esc(COMPONENT_STATUS_LABELS[s] ?? s)}</option>`,
                    ).join("")}
                  </select>
                </div>`,
              )
              .join("")}
          </div>
          <p id="comp-msg" class="mt-3 text-sm text-slate-400"></p>
        </section>`;
    }

    function createIncidentForm(components: Component[]): string {
      return `
        <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-6">
          <h2 class="mb-4 text-base font-bold text-white uppercase tracking-wider">Buka Insiden Baru</h2>
          <form id="create-incident-form" class="space-y-4">
            <div>
              <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="title">Judul Insiden</label>
              <input id="title" name="title" required class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" placeholder="Contoh: Gangguan Pembayaran QRIS" />
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="impact">Tingkat Dampak</label>
                <select id="impact" name="impact" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500">
                  ${IMPACTS.map((im) => `<option value="${im}">${esc(IMPACT_LABELS[im] ?? im)}</option>`).join("")}
                </select>
              </div>
              <div>
                <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="componentKey">Komponen Terdampak</label>
                <select id="componentKey" name="componentKey" class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500">
                  <option value="">(Tidak spesifik)</option>
                  ${components.map((c) => `<option value="${esc(c.key)}">${esc(c.name)}</option>`).join("")}
                </select>
              </div>
            </div>
            <div>
              <label class="block text-xs uppercase tracking-wider text-slate-400 mb-1" for="body">Pesan Pembaruan Awal</label>
              <textarea id="body" name="body" rows="3" required class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500" placeholder="Kami sedang menginvestigasi gangguan pada gateway pembayaran..."></textarea>
            </div>
            <p id="create-msg"></p>
            <button type="submit" class="rounded-lg bg-orange-600 px-4 py-2 text-sm font-bold uppercase tracking-wider text-white hover:bg-orange-500 transition-colors">
              Buat Insiden
            </button>
          </form>
        </section>`;
    }

    function incidentList(incidents: Incident[]): string {
      if (!incidents.length) {
        return `
          <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-6">
            <h2 class="mb-2 text-base font-bold text-white uppercase tracking-wider">Daftar Insiden Aktif & Riwayat</h2>
            <p class="text-sm text-slate-400">Tidak ada insiden tercatat saat ini.</p>
          </section>`;
      }

      return `
        <section class="rounded-xl border border-slate-800 bg-slate-900/80 p-6 space-y-4">
          <h2 class="text-base font-bold text-white uppercase tracking-wider">Daftar Insiden Aktif & Riwayat</h2>
          ${incidents
            .map((inc) => {
              const statusLabel = INCIDENT_STATUS_LABELS[inc.status] ?? inc.status;
              const isResolved = inc.status === "RESOLVED";
              return `
                <div class="rounded-lg border border-slate-800 bg-slate-900/60 p-4 space-y-3">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <span class="inline-block rounded px-2 py-0.5 text-xs font-semibold ${isResolved ? "bg-slate-800 text-slate-400" : "bg-red-950/60 text-red-400 border border-red-500/30"}">
                        ${esc(statusLabel)}
                      </span>
                      <h3 class="mt-1 font-semibold text-white">${esc(inc.title)}</h3>
                      <p class="text-xs text-slate-400 mt-0.5">Dibuat: ${fmtDate(inc.createdAt)}</p>
                    </div>
                  </div>

                  <div class="space-y-2 border-l-2 border-slate-800 pl-3">
                    ${(inc.updates ?? [])
                      .map(
                        (u) => `
                        <div class="text-xs">
                          <span class="font-bold text-slate-300">[${esc(INCIDENT_STATUS_LABELS[u.status] ?? u.status)}]</span>
                          <span class="text-slate-400"> · ${fmtDate(u.createdAt)}</span>
                          <p class="mt-0.5 text-slate-300 leading-relaxed">${esc(u.body)}</p>
                        </div>`,
                      )
                      .join("")}
                  </div>

                  ${
                    !isResolved
                      ? `
                      <form class="update-form mt-3 border-t border-slate-800/80 pt-3 space-y-2" data-incident="${esc(inc.id)}">
                        <div class="flex gap-2">
                          <select name="status" class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs text-white">
                            ${INC_STATUSES.map(
                              (s) => `<option value="${s}" ${s === inc.status ? "selected" : ""}>${esc(INCIDENT_STATUS_LABELS[s] ?? s)}</option>`,
                            ).join("")}
                          </select>
                          <input name="body" required class="flex-1 rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs text-white" placeholder="Ketik status pembaruan terbaru..." />
                          <button type="submit" class="rounded-lg bg-slate-800 border border-slate-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-slate-700">
                            Perbarui
                          </button>
                        </div>
                      </form>`
                      : ""
                  }
                </div>`;
            })
            .join("")}
        </section>`;
    }

    function render(components: Component[], incidents: Incident[]) {
      root.innerHTML = `
        ${componentControls(components)}
        ${createIncidentForm(components)}
        ${incidentList(incidents)}`;

      root.querySelectorAll<HTMLSelectElement>("select[data-comp]").forEach((select) => {
        select.addEventListener("change", async () => {
          const compKey = select.dataset.comp!;
          const status = select.value;
          try {
            await updateComponent(compKey, status);
            msg("comp-msg", `Komponen ${compKey} diperbarui menjadi ${status}.`);
          } catch (err) {
            msg("comp-msg", (err as Error).message, true);
          }
        });
      });

      const createForm = document.getElementById("create-incident-form") as HTMLFormElement | null;
      createForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(createForm);
        try {
          await createIncident({
            title: String(fd.get("title") ?? "").trim(),
            impact: String(fd.get("impact") ?? "MINOR"),
            componentKey: String(fd.get("componentKey") ?? "") || undefined,
            body: String(fd.get("body") ?? "").trim(),
          });
          await reload();
        } catch (err) {
          msg("create-msg", (err as Error).message, true);
        }
      });

      root.querySelectorAll<HTMLFormElement>("form.update-form").forEach((form) => {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const fd = new FormData(form);
          const incidentId = form.dataset.incident!;
          try {
            await addIncidentUpdate(incidentId, {
              status: String(fd.get("status") ?? ""),
              body: String(fd.get("body") ?? "").trim(),
            });
            await reload();
          } catch (err) {
            alert((err as Error).message);
          }
        });
      });
    }

    async function reload() {
      const [page, incidents] = await Promise.all([
        fetchPublicStatus(),
        listIncidentsAdmin(50, 0).catch(() => [] as Incident[]),
      ]);
      render(page.components ?? [], incidents ?? []);
    }

    reload().catch((e) => {
      root.innerHTML = `<p class="text-red-400">Gagal memuat: ${esc((e as Error).message)}</p>`;
    });
  </script>
</AdminLayout>
