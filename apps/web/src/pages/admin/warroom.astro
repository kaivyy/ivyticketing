---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="War Room : ivyticketing">
  <div class="border-b border-slate-800 bg-slate-900/60 px-4 py-3 sm:px-6">
    <div class="mx-auto flex max-w-6xl items-center justify-between">
      <div class="flex items-center gap-3">
        <h1 class="text-base font-bold uppercase tracking-wider text-white">Monitoring War Room</h1>
        <span id="live-dot" class="inline-flex items-center gap-1.5 rounded-full bg-slate-800 px-2.5 py-0.5 text-xs text-slate-300">
          <span class="h-2 w-2 rounded-full bg-slate-500"></span> Menghubungkan…
        </span>
      </div>
      <div class="flex items-center gap-2 text-xs text-slate-400">
        <span>Pembaruan terakhir:</span>
        <span id="captured" class="font-mono text-slate-200">-</span>
      </div>
    </div>
  </div>

  <main class="mx-auto max-w-6xl p-4 sm:p-6">
    <div id="root" class="space-y-6">
      <p class="text-slate-400">Memuat data metrik…</p>
    </div>
  </main>

  <script>
    import { fetchWarRoom, type WarRoomSnapshot } from "../../lib/warroom";

    const root = document.getElementById("root")!;
    const liveDot = document.getElementById("live-dot")!;
    const capturedEl = document.getElementById("captured")!;
    const REFRESH_MS = 5000;

    const pct = (v: number) => `${(v * 100).toFixed(1)}%`;
    const ms = (s: number) => `${(s * 1000).toFixed(0)} ms`;
    const num = (v: number) => Math.round(v).toLocaleString("id-ID");

    // Health thresholds -> tile accent colour
    function errorTone(rate: number): string {
      if (rate >= 0.05) return "border-red-500/40 bg-red-500/10 text-red-300";
      if (rate >= 0.01) return "border-amber-500/40 bg-amber-500/10 text-amber-300";
      return "border-emerald-500/30 bg-emerald-500/10 text-emerald-300";
    }
    function successTone(rate: number, total: number): string {
      if (total === 0) return "border-slate-700 bg-slate-900 text-slate-300";
      if (rate >= 0.95) return "border-emerald-500/30 bg-emerald-500/10 text-emerald-300";
      if (rate >= 0.8) return "border-amber-500/40 bg-amber-500/10 text-amber-300";
      return "border-red-500/40 bg-red-500/10 text-red-300";
    }
    function latencyTone(s: number): string {
      if (s >= 1) return "border-red-500/40 bg-red-500/10 text-red-300";
      if (s >= 0.5) return "border-amber-500/40 bg-amber-500/10 text-amber-300";
      return "border-emerald-500/30 bg-emerald-500/10 text-emerald-300";
    }
    function dbTone(inUse: number, idle: number): string {
      const total = inUse + idle;
      const frac = total > 0 ? inUse / total : 0;
      if (frac >= 0.9) return "border-red-500/40 bg-red-500/10 text-red-300";
      if (frac >= 0.7) return "border-amber-500/40 bg-amber-500/10 text-amber-300";
      return "border-slate-700 bg-slate-900 text-slate-300";
    }

    function tile(label: string, value: string, tone: string, sub = ""): string {
      return `
        <div class="rounded-xl border ${tone} p-5">
          <p class="text-xs uppercase tracking-wide opacity-70">${label}</p>
          <p class="mt-2 text-3xl font-bold tabular-nums">${value}</p>
          ${sub ? `<p class="mt-1 text-xs opacity-60">${sub}</p>` : ""}
        </div>`;
    }

    function render(s: WarRoomSnapshot) {
      const checkoutTotal = s.checkoutSucceeded + s.checkoutFailed;
      const paymentTotal = s.paymentSucceeded + s.paymentFailed;

      root.innerHTML = `
        <section>
          <h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">Kesehatan Sistem</h2>
          <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
            ${tile("Error Rate (5xx)", pct(s.errorRate), errorTone(s.errorRate), `${num(s.httpErrors)} dari ${num(s.httpRequests)} request`)}
            ${tile("Latensi API p95", ms(s.httpP95Seconds), latencyTone(s.httpP95Seconds), "perkiraan lintas rute")}
            ${tile("Request Berjalan", num(s.httpInFlight), "border-slate-700 bg-slate-900 text-slate-300", "in-flight saat ini")}
            ${tile("Koneksi DB", `${num(s.dbConnsInUse)} / ${num(s.dbConnsInUse + s.dbConnsIdle)}`, dbTone(s.dbConnsInUse, s.dbConnsIdle), "dipakai / total pool")}
          </div>
        </section>

        <section>
          <h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">Throughput & Transaksi</h2>
          <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
            ${tile("Checkout Berhasil", num(s.checkoutSucceeded), successTone(s.checkoutSuccessRate, checkoutTotal), `${pct(s.checkoutSuccessRate)} berhasil (${num(checkoutTotal)} total)`)}
            ${tile("Checkout Gagal", num(s.checkoutFailed), s.checkoutFailed > 0 ? "border-amber-500/40 bg-amber-500/10 text-amber-300" : "border-slate-700 bg-slate-900 text-slate-300", "gagal checkout")}
            ${tile("Pembayaran Berhasil", num(s.paymentSucceeded), successTone(s.paymentSuccessRate, paymentTotal), `${pct(s.paymentSuccessRate)} konversi (${num(paymentTotal)} total)`)}
            ${tile("Pembayaran Gagal", num(s.paymentFailed), s.paymentFailed > 0 ? "border-red-500/40 bg-red-500/10 text-red-300" : "border-slate-700 bg-slate-900 text-slate-300", "gagal bayar")}
          </div>
        </section>

        <section>
          <h2 class="mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">Status Antrean & Keamanan</h2>
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            ${tile("Pengguna Dalam Antrean", num(s.queueDepth), "border-slate-700 bg-slate-900 text-slate-300", "peserta menunggu giliran")}
            ${tile("Tingkat Kelulusan Antrean", `${num(s.admittedPerMinute)} / mnt`, "border-slate-700 bg-slate-900 text-slate-300", "peserta masuk per menit")}
            ${tile("Upaya Bot Dicegah", num(s.blockedBots), s.blockedBots > 0 ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-300" : "border-slate-700 bg-slate-900 text-slate-300", "blokir Turnstile & rate-limit")}
          </div>
        </section>`;
    }

    function setLive(ok: boolean) {
      liveDot.innerHTML = ok
        ? `<span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span> Live`
        : `<span class="h-2 w-2 rounded-full bg-red-500"></span> Terputus`;
    }

    async function tick() {
      try {
        const s = await fetchWarRoom();
        render(s);
        setLive(true);
        capturedEl.textContent = new Date(s.capturedAt).toLocaleTimeString("id-ID");
      } catch (e) {
        setLive(false);
        if (!root.querySelector("section")) {
          root.innerHTML = `<p class="text-red-400">Gagal memuat metrik: ${(e as Error).message}</p>`;
        }
      }
    }

    tick();
    setInterval(tick, REFRESH_MS);
  </script>
</AdminLayout>
