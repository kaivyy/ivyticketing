  <!-- Script Konfigurasi Website Utama Superadmin -->
  <script>
    import {
      getHomepageConfig,
      saveHomepageConfig,
      resetHomepageConfig,
      DEFAULT_HOMEPAGE_CONFIG,
      type HomepageConfig,
      type HeroSlideConfig,
      type NavbarStyleType,
      type MobileNavType,
      type ElementCornerStyle,
      type WebsiteThemeMode,
    } from "../../lib/events-store";
    import { esc } from "../../lib/safe";

    const toast = document.getElementById("toast-msg")!;
    function showToast(msg: string) {
      toast.textContent = msg;
      toast.classList.remove("hidden");
      setTimeout(() => {
        toast.classList.add("hidden");
      }, 3500);
    }

    let activeHomepageConfig: HomepageConfig = getHomepageConfig();
    let workingSlides: HeroSlideConfig[] = JSON.parse(
      JSON.stringify(activeHomepageConfig.hero?.slides || DEFAULT_HOMEPAGE_CONFIG.hero.slides)
    );

    // Elements
    const brandNameInput = document.getElementById("hp-brand-name") as HTMLInputElement;
    const brandTaglineInput = document.getElementById("hp-brand-tagline") as HTMLInputElement;
    const brandPreviewIcon = document.getElementById("hp-preview-icon");
    const brandPreviewText = document.getElementById("hp-preview-text");
    const brandPreviewTitle = document.getElementById("hp-preview-title");
    const brandPreviewTag = document.getElementById("hp-preview-tag");

    const opacityInput = document.getElementById("hp-navbar-opacity") as HTMLInputElement;
    const opacityLabel = document.getElementById("hp-opacity-label");
    const blurSelect = document.getElementById("hp-navbar-blur") as HTMLSelectElement;
    const borderCheck = document.getElementById("hp-navbar-border") as HTMLInputElement;

    const glassBlurInput = document.getElementById("hp-glass-blur") as HTMLInputElement;
    const glassBlurVal = document.getElementById("hp-glass-blur-val");
    const glassSaturateInput = document.getElementById("hp-glass-saturate") as HTMLInputElement;
    const glassSaturateVal = document.getElementById("hp-glass-saturate-val");
    const glassTintInput = document.getElementById("hp-glass-tint") as HTMLInputElement;
    const glassRadiusInput = document.getElementById("hp-glass-radius") as HTMLInputElement;
    const glassRadiusVal = document.getElementById("hp-glass-radius-val");
    const liquidGlassParamsBox = document.getElementById("liquid-glass-params");

    const bgInput = document.getElementById("hp-theme-bg") as HTMLInputElement;
    const bgPicker = document.getElementById("hp-theme-bg-picker") as HTMLInputElement;
    const surfaceInput = document.getElementById("hp-theme-surface") as HTMLInputElement;
    const surfacePicker = document.getElementById("hp-theme-surface-picker") as HTMLInputElement;
    const textInput = document.getElementById("hp-theme-text") as HTMLInputElement;
    const textPicker = document.getElementById("hp-theme-text-picker") as HTMLInputElement;
    const accentInput = document.getElementById("hp-theme-accent") as HTMLInputElement;
    const accentPicker = document.getElementById("hp-theme-accent-picker") as HTMLInputElement;

    const heroMode = document.getElementById("hp-hero-mode") as HTMLSelectElement;
    const heroAutoplay = document.getElementById("hp-hero-autoplay") as HTMLInputElement;
    const heroInterval = document.getElementById("hp-hero-interval") as HTMLInputElement;
    const heroOverlayInput = document.getElementById("hp-hero-overlay") as HTMLInputElement;
    const heroOverlayVal = document.getElementById("hp-hero-overlay-val");
    const heroStatsStyleSelect = document.getElementById("hp-hero-stats-style") as HTMLSelectElement;
    const heroImagePosSelect = document.getElementById("hp-hero-image-pos") as HTMLSelectElement;
    const heroShowTagsInput = document.getElementById("hp-hero-show-tags") as HTMLInputElement;
    const heroShowTagsLabel = document.getElementById("hp-hero-show-tags-label");
    const heroBottomBlurInput = document.getElementById("hp-hero-bottom-blur") as HTMLInputElement;
    const heroBottomBlurLabel = document.getElementById("hp-hero-bottom-blur-label");
    const slidesListContainer = document.getElementById("hp-slides-list")!;
    const slidesCountLabel = document.getElementById("hp-slides-count")!;
    const btnAddSlide = document.getElementById("btn-add-slide")!;
    const showSportFilterEl = document.getElementById("hp-feat-sport-filter") as HTMLInputElement;

    const navSim = document.getElementById("hp-navbar-sim");
    const simTitle = document.getElementById("hp-sim-title");

    function updateLivePreview() {
      // 1. Brand Preview
      const selectedBrandMode = (document.querySelector('input[name="brand-display-mode"]:checked') as HTMLInputElement)?.value || "icon_only";
      if (brandPreviewIcon && brandPreviewText) {
        if (selectedBrandMode === "icon_only") {
          brandPreviewIcon.classList.remove("hidden");
          brandPreviewText.classList.add("hidden");
        } else if (selectedBrandMode === "text_only") {
          brandPreviewIcon.classList.add("hidden");
          brandPreviewText.classList.remove("hidden");
        } else {
          brandPreviewIcon.classList.remove("hidden");
          brandPreviewText.classList.remove("hidden");
        }
      }
      if (brandPreviewTitle && brandNameInput) {
        brandPreviewTitle.textContent = brandNameInput.value || "IvyTicketing";
      }
      if (brandPreviewTag && brandTaglineInput) {
        brandPreviewTag.textContent = brandTaglineInput.value || "Sports Registration Engine";
      }

      // 2. Navbar Sim
      const selectedStyle = (document.querySelector('input[name="hp-navbar-style"]:checked') as HTMLInputElement)?.value || "full_width";
      if (liquidGlassParamsBox) {
        if (selectedStyle === "liquid_glass") {
          liquidGlassParamsBox.classList.remove("hidden");
        } else {
          liquidGlassParamsBox.classList.add("hidden");
        }
      }

      if (navSim) {
        const op = Number(opacityInput?.value || "0.92");
        const blurMap: Record<string, string> = { none: "none", sm: "blur(4px)", md: "blur(12px)", lg: "blur(20px)" };
        const chosenBlur = blurMap[blurSelect?.value || "md"] || "blur(12px)";
        const hasBorder = borderCheck?.checked;

        if (selectedStyle === "transparent_gradient") {
          navSim.style.background = "linear-gradient(180deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0) 100%)";
          navSim.style.backgroundColor = "transparent";
          navSim.style.backdropFilter = "none";
          navSim.style.borderRadius = "0px";
          navSim.style.borderColor = "transparent";
          navSim.style.maxWidth = "100%";
          if (simTitle) simTitle.textContent = "Transparan Gradasi (Ironman)";
        } else if (selectedStyle === "liquid_glass") {
          navSim.style.background = "";
          const gBlur = glassBlurInput?.value || "0";
          const gSat = glassSaturateInput?.value || "1";
          const gTint = glassTintInput?.value || "rgba(255, 255, 255, 0.255)";
          const gRad = glassRadiusInput?.value || "48";
          navSim.style.backgroundColor = gTint;
          navSim.style.backdropFilter = `blur(${gBlur}px) saturate(${gSat})`;
          navSim.style.borderRadius = `${gRad}px`;
          navSim.style.borderColor = "rgba(255, 255, 255, 0.25)";
          navSim.style.maxWidth = "420px";
          if (simTitle) simTitle.textContent = "Liquid Glass Pill";
        } else if (selectedStyle === "floating_compact") {
          navSim.style.background = "";
          navSim.style.backgroundColor = `rgba(16, 26, 46, ${op})`;
          navSim.style.backdropFilter = chosenBlur;
          navSim.style.borderRadius = "16px";
          navSim.style.borderColor = hasBorder ? "rgba(255, 255, 255, 0.2)" : "transparent";
          navSim.style.maxWidth = "460px";
          if (simTitle) simTitle.textContent = "Floating Compact Bar";
        } else {
          navSim.style.background = "";
          navSim.style.backgroundColor = `rgba(16, 26, 46, ${op})`;
          navSim.style.backdropFilter = chosenBlur;
          navSim.style.borderRadius = "0px";
          navSim.style.borderColor = hasBorder ? "rgba(255, 255, 255, 0.1)" : "transparent";
          navSim.style.maxWidth = "100%";
          if (simTitle) simTitle.textContent = "Full-Width Bar";
        }
      }

      if (heroOverlayVal && heroOverlayInput) {
        heroOverlayVal.textContent = `${Math.round(Number(heroOverlayInput.value) * 100)}%`;
      }
    }

    function renderSlidesList() {
      slidesCountLabel.textContent = String(workingSlides.length);
      if (workingSlides.length === 0) {
        slidesListContainer.innerHTML = `
          <div class="rounded-xl border border-dashed border-slate-700 p-6 text-center text-xs text-slate-400">
            Belum ada slide hero. Klik tombol "+ Tambah Slide Baru" di atas.
          </div>
        `;
        return;
      }

      slidesListContainer.innerHTML = workingSlides.map((slide, idx) => `
        <div class="rounded-xl border border-slate-800 bg-slate-950 p-4 space-y-3 relative group" data-slide-index="${idx}">
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
            <div class="flex items-center gap-2">
              <span class="flex h-5 w-5 items-center justify-center rounded-full bg-orange-600/20 text-[10px] font-bold text-orange-400">
                ${idx + 1}
              </span>
              <span class="text-xs font-bold text-white uppercase truncate max-w-[200px] sm:max-w-xs">
                ${esc(slide.title || "Slide Tanpa Judul")}
              </span>
            </div>
            <div class="flex items-center gap-1">
              ${idx > 0 ? `
                <button type="button" class="btn-move-slide-up rounded p-1 text-slate-400 hover:text-white" data-index="${idx}" title="Geser ke atas">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
                </button>
              ` : ""}
              ${idx < workingSlides.length - 1 ? `
                <button type="button" class="btn-move-slide-down rounded p-1 text-slate-400 hover:text-white" data-index="${idx}" title="Geser ke bawah">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
              ` : ""}
              <button type="button" class="btn-remove-slide rounded p-1 text-rose-400 hover:text-rose-300" data-index="${idx}" title="Hapus slide">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
            <div>
              <label class="block text-[10px] font-semibold text-slate-400 uppercase">Tag / Badge Atas</label>
              <input type="text" class="slide-tag-input mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-white" value="${esc(slide.tag || "")}" data-index="${idx}" placeholder="Kosongkan jika tanpa badge" />
            </div>
            <div>
              <label class="block text-[10px] font-semibold text-slate-400 uppercase">Judul Hero Utama</label>
              <input type="text" class="slide-title-input mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-white font-bold" value="${esc(slide.title || "")}" data-index="${idx}" />
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="block text-[10px] font-semibold text-slate-400 uppercase">Deskripsi Subtitle</label>
              <label class="inline-flex items-center gap-1.5 cursor-pointer select-none">
                <input
                  type="checkbox"
                  class="slide-show-sub-input rounded accent-orange-500 cursor-pointer"
                  data-index="${idx}"
                  ${slide.showSubtitle !== false ? "checked" : ""}
                />
                <span class="text-[11px] font-medium ${slide.showSubtitle !== false ? "text-orange-400 font-semibold" : "text-slate-400"}">
                  ${slide.showSubtitle !== false ? "Tampilkan Deskripsi" : "Sembunyikan (Hidden)"}
                </span>
              </label>
            </div>
            <textarea rows="2" class="slide-sub-input w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-xs text-white transition-opacity ${slide.showSubtitle === false ? "opacity-40" : ""}" data-index="${idx}">${esc(slide.subtitle || "")}</textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
            <div>
              <label class="block text-[10px] font-semibold text-slate-400 uppercase">URL Background Gambar</label>
              <input type="text" class="slide-bg-input mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-white font-mono text-[11px]" value="${esc(slide.bgImage || "")}" data-index="${idx}" />
            </div>
            <div>
              <label class="block text-[10px] font-semibold text-slate-400 uppercase">Teks Tombol CTA Utama</label>
              <input type="text" class="slide-cta-text-input mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-white" value="${esc(slide.primaryCtaText || "")}" data-index="${idx}" />
            </div>
            <div>
              <label class="block text-[10px] font-semibold text-slate-400 uppercase">Link Tombol CTA Utama</label>
              <input type="text" class="slide-cta-link-input mt-1 w-full rounded border border-slate-700 bg-slate-900 px-2.5 py-1.5 text-white font-mono text-[11px]" value="${esc(slide.primaryCtaLink || "")}" data-index="${idx}" />
            </div>
          </div>
        </div>
      `).join("");

      // Bind input events to workingSlides
      slidesListContainer.querySelectorAll(".slide-show-sub-input").forEach(input => {
        input.addEventListener("change", (e) => {
          const target = e.target as HTMLInputElement;
          const idx = Number(target.getAttribute("data-index"));
          const isChecked = target.checked;
          workingSlides[idx].showSubtitle = isChecked;
          const labelSpan = target.parentElement?.querySelector("span");
          if (labelSpan) {
            labelSpan.textContent = isChecked ? "Tampilkan Deskripsi" : "Sembunyikan (Hidden)";
            labelSpan.className = `text-[11px] font-medium ${isChecked ? "text-orange-400 font-semibold" : "text-slate-400"}`;
          }
          const textarea = slidesListContainer.querySelector(`.slide-sub-input[data-index="${idx}"]`);
          if (textarea) {
            textarea.classList.toggle("opacity-40", !isChecked);
          }
        });
      });
      slidesListContainer.querySelectorAll(".slide-tag-input").forEach(input => {
        input.addEventListener("input", (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute("data-index"));
          workingSlides[idx].tag = (e.target as HTMLInputElement).value;
        });
      });
      slidesListContainer.querySelectorAll(".slide-title-input").forEach(input => {
        input.addEventListener("input", (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute("data-index"));
          workingSlides[idx].title = (e.target as HTMLInputElement).value;
        });
      });
      slidesListContainer.querySelectorAll(".slide-sub-input").forEach(input => {
        input.addEventListener("input", (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute("data-index"));
          workingSlides[idx].subtitle = (e.target as HTMLTextAreaElement).value;
        });
      });
      slidesListContainer.querySelectorAll(".slide-bg-input").forEach(input => {
        input.addEventListener("input", (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute("data-index"));
          workingSlides[idx].bgImage = (e.target as HTMLInputElement).value;
        });
      });
      slidesListContainer.querySelectorAll(".slide-cta-text-input").forEach(input => {
        input.addEventListener("input", (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute("data-index"));
          workingSlides[idx].primaryCtaText = (e.target as HTMLInputElement).value;
        });
      });
      slidesListContainer.querySelectorAll(".slide-cta-link-input").forEach(input => {
        input.addEventListener("input", (e) => {
          const idx = Number((e.target as HTMLElement).getAttribute("data-index"));
          workingSlides[idx].primaryCtaLink = (e.target as HTMLInputElement).value;
        });
      });

      // Actions
      slidesListContainer.querySelectorAll(".btn-remove-slide").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-index"));
          if (confirm("Hapus slide ini dari carousel hero?")) {
            workingSlides.splice(idx, 1);
            renderSlidesList();
          }
        });
      });
      slidesListContainer.querySelectorAll(".btn-move-slide-up").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-index"));
          if (idx > 0) {
            const temp = workingSlides[idx];
            workingSlides[idx] = workingSlides[idx - 1];
            workingSlides[idx - 1] = temp;
            renderSlidesList();
          }
        });
      });
      slidesListContainer.querySelectorAll(".btn-move-slide-down").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.getAttribute("data-index"));
          if (idx < workingSlides.length - 1) {
            const temp = workingSlides[idx];
            workingSlides[idx] = workingSlides[idx + 1];
            workingSlides[idx + 1] = temp;
            renderSlidesList();
          }
        });
      });
    }

    function initForm() {
      activeHomepageConfig = getHomepageConfig();
      workingSlides = JSON.parse(
        JSON.stringify(activeHomepageConfig.hero?.slides || DEFAULT_HOMEPAGE_CONFIG.hero.slides)
      );

      // Brand
      const currentMode = activeHomepageConfig.brand?.displayMode || "icon_only";
      const brandRadio = document.querySelector(`input[name="brand-display-mode"][value="${currentMode}"]`) as HTMLInputElement;
      if (brandRadio) brandRadio.checked = true;
      if (brandNameInput) brandNameInput.value = activeHomepageConfig.brand?.brandName || "IvyTicketing";
      if (brandTaglineInput) brandTaglineInput.value = activeHomepageConfig.brand?.tagline || "Sports Registration Engine";

      // Navbar
      const currentNavStyle = activeHomepageConfig.navbar?.style || "full_width";
      const navStyleRadio = document.querySelector(`input[name="hp-navbar-style"][value="${currentNavStyle}"]`) as HTMLInputElement;
      if (navStyleRadio) navStyleRadio.checked = true;

      // Mobile Nav Type
      const currentMobNavType = activeHomepageConfig.navbar?.mobileNavType || "bottom_nav";
      const mobNavRadio = document.querySelector(`input[name="hp-mobile-nav-type"][value="${currentMobNavType}"]`) as HTMLInputElement;
      if (mobNavRadio) mobNavRadio.checked = true;

      // Corners
      const currentCornerStyle = activeHomepageConfig.corners?.style || "square";
      const cornerRadio = document.querySelector(`input[name="hp-corner-style"][value="${currentCornerStyle}"]`) as HTMLInputElement;
      if (cornerRadio) cornerRadio.checked = true;

      // Liquid Glass params
      if (glassBlurInput) glassBlurInput.value = String(activeHomepageConfig.navbar?.glassBlur ?? 0);
      if (glassBlurVal) glassBlurVal.textContent = `${activeHomepageConfig.navbar?.glassBlur ?? 0}px`;
      if (glassSaturateInput) glassSaturateInput.value = String(activeHomepageConfig.navbar?.glassSaturate ?? 1.0);
      if (glassSaturateVal) glassSaturateVal.textContent = `${activeHomepageConfig.navbar?.glassSaturate ?? 1.0}x`;
      if (glassTintInput) glassTintInput.value = activeHomepageConfig.navbar?.glassTint || "rgba(255, 255, 255, 0.255)";
      if (glassRadiusInput) glassRadiusInput.value = String(activeHomepageConfig.navbar?.glassRadius ?? 48);
      if (glassRadiusVal) glassRadiusVal.textContent = `${activeHomepageConfig.navbar?.glassRadius ?? 48}px`;

      // Standard navbar
      if (opacityInput) opacityInput.value = String(activeHomepageConfig.navbar?.opacity ?? 0.92);
      if (opacityLabel) opacityLabel.textContent = `${Math.round((activeHomepageConfig.navbar?.opacity ?? 0.92) * 100)}%`;
      if (blurSelect) blurSelect.value = activeHomepageConfig.navbar?.blur || "md";
      if (borderCheck) borderCheck.checked = activeHomepageConfig.navbar?.showBorder !== false;

      // Theme
      if (bgInput) bgInput.value = activeHomepageConfig.theme?.bgColor || "#0a1120";
      if (bgPicker) bgPicker.value = activeHomepageConfig.theme?.bgColor || "#0a1120";
      if (surfaceInput) surfaceInput.value = activeHomepageConfig.theme?.surfaceColor || "#101a2e";
      if (surfacePicker) surfacePicker.value = activeHomepageConfig.theme?.surfaceColor || "#101a2e";
      if (textInput) textInput.value = activeHomepageConfig.theme?.textColor || "#f8fafc";
      if (textPicker) textPicker.value = activeHomepageConfig.theme?.textColor || "#f8fafc";
      if (accentInput) accentInput.value = activeHomepageConfig.theme?.accentColor || "#ea580c";
      if (accentPicker) accentPicker.value = activeHomepageConfig.theme?.accentColor || "#ea580c";

      // Hero
      if (heroMode) heroMode.value = activeHomepageConfig.hero?.mode || "slider";
      if (heroAutoplay) heroAutoplay.checked = activeHomepageConfig.hero?.autoplay !== false;
      if (heroInterval) heroInterval.value = String(activeHomepageConfig.hero?.intervalSeconds || 5);
      if (heroOverlayInput) heroOverlayInput.value = String(activeHomepageConfig.hero?.overlayDarkness ?? 0.35);
      if (heroOverlayVal) heroOverlayVal.textContent = `${Math.round((activeHomepageConfig.hero?.overlayDarkness ?? 0.35) * 100)}%`;
      if (heroStatsStyleSelect) heroStatsStyleSelect.value = activeHomepageConfig.hero?.statsStyle || "transparent";
      if (heroImagePosSelect) heroImagePosSelect.value = activeHomepageConfig.hero?.imagePosition || "top";
      if (heroShowTagsInput) {
        heroShowTagsInput.checked = activeHomepageConfig.hero?.showTags === true;
        if (heroShowTagsLabel) {
          heroShowTagsLabel.textContent = heroShowTagsInput.checked ? "Tampilkan Tag di Beranda" : "Sembunyikan Tag di Beranda (Bersih)";
        }
      }
      if (heroBottomBlurInput) {
        heroBottomBlurInput.checked = activeHomepageConfig.hero?.bottomBlur !== false;
        if (heroBottomBlurLabel) {
          heroBottomBlurLabel.textContent = heroBottomBlurInput.checked ? "Gradasi Bawah Aktif" : "Tanpa Gradasi Bawah (Polos)";
        }
      }
      if (showSportFilterEl) showSportFilterEl.checked = activeHomepageConfig.features?.showSportFilter !== false;

      renderSlidesList();
      updateLivePreview();
    }

    heroShowTagsInput?.addEventListener("change", () => {
      if (heroShowTagsLabel) {
        heroShowTagsLabel.textContent = heroShowTagsInput.checked ? "Tampilkan Tag di Beranda" : "Sembunyikan Tag di Beranda (Bersih)";
      }
    });

    heroBottomBlurInput?.addEventListener("change", () => {
      if (heroBottomBlurLabel) {
        heroBottomBlurLabel.textContent = heroBottomBlurInput.checked ? "Gradasi Bawah Aktif" : "Tanpa Gradasi Bawah (Polos)";
      }
    });

    // Event Listeners for Live Preview
    document.querySelectorAll('input[name="brand-display-mode"]').forEach(r => r.addEventListener("change", updateLivePreview));
    document.querySelectorAll('input[name="hp-navbar-style"]').forEach(r => r.addEventListener("change", updateLivePreview));
    brandNameInput?.addEventListener("input", updateLivePreview);
    brandTaglineInput?.addEventListener("input", updateLivePreview);

    heroOverlayInput?.addEventListener("input", (e) => {
      const val = Number((e.target as HTMLInputElement).value);
      if (heroOverlayVal) heroOverlayVal.textContent = `${Math.round(val * 100)}%`;
    });

    opacityInput?.addEventListener("input", (e) => {
      const val = Number((e.target as HTMLInputElement).value);
      if (opacityLabel) opacityLabel.textContent = `${Math.round(val * 100)}%`;
      updateLivePreview();
    });

    blurSelect?.addEventListener("change", updateLivePreview);
    borderCheck?.addEventListener("change", updateLivePreview);

    glassBlurInput?.addEventListener("input", (e) => {
      if (glassBlurVal) glassBlurVal.textContent = `${(e.target as HTMLInputElement).value}px`;
      updateLivePreview();
    });
    glassSaturateInput?.addEventListener("input", (e) => {
      if (glassSaturateVal) glassSaturateVal.textContent = `${(e.target as HTMLInputElement).value}x`;
      updateLivePreview();
    });
    glassTintInput?.addEventListener("input", updateLivePreview);
    glassRadiusInput?.addEventListener("input", (e) => {
      if (glassRadiusVal) glassRadiusVal.textContent = `${(e.target as HTMLInputElement).value}px`;
      updateLivePreview();
    });

    // Theme pickers sync
    bgPicker?.addEventListener("input", () => { bgInput.value = bgPicker.value; });
    bgInput?.addEventListener("input", () => { bgPicker.value = bgInput.value; });
    surfacePicker?.addEventListener("input", () => { surfaceInput.value = surfacePicker.value; });
    surfaceInput?.addEventListener("input", () => { surfacePicker.value = surfaceInput.value; });
    textPicker?.addEventListener("input", () => { textInput.value = textPicker.value; });
    textInput?.addEventListener("input", () => { textPicker.value = textInput.value; });
    accentPicker?.addEventListener("input", () => { accentInput.value = accentPicker.value; });
    accentInput?.addEventListener("input", () => { accentPicker.value = accentInput.value; });

    // Preset buttons
    document.querySelectorAll(".btn-theme-preset").forEach(btn => {
      btn.addEventListener("click", () => {
        const bg = btn.getAttribute("data-bg") || "#0a1120";
        const surf = btn.getAttribute("data-surface") || "#101a2e";
        const txt = btn.getAttribute("data-text") || "#f8fafc";
        const acc = btn.getAttribute("data-accent") || "#ea580c";

        if (bgInput) bgInput.value = bg;
        if (bgPicker) bgPicker.value = bg;
        if (surfaceInput) surfaceInput.value = surf;
        if (surfacePicker) surfacePicker.value = surf;
        if (textInput) textInput.value = txt;
        if (textPicker) textPicker.value = txt;
        if (accentInput) accentInput.value = acc;
        if (accentPicker) accentPicker.value = acc;
      });
    });

    // Add Slide
    btnAddSlide?.addEventListener("click", () => {
      const newId = `slide-${Date.now()}`;
      workingSlides.push({
        id: newId,
        tag: "RACE BARU · PENDAFTARAN BUKA",
        tagColor: "bg-orange-500 text-black font-bold",
        title: "Nama Perlombaan Baru",
        subtitle: "Deskripsi singkat dan keistimewaan rute resmi perlombaan.",
        showSubtitle: true,
        bgImage: "/images/events/bangkok_marathon.jpg",
        primaryCtaText: "Daftar Sekarang",
        primaryCtaLink: "/events",
        secondaryCtaText: "Info Rute",
        secondaryCtaLink: "/events",
        stats: [
          { label: "Jarak", value: "42.2 KM" },
          { label: "Kategori", value: "Full Marathon" },
          { label: "Status", value: "Buka" },
        ],
      });
      renderSlidesList();
    });

    // Save Homepage Config
    const btnSave = document.getElementById("btn-save-homepage");
    btnSave?.addEventListener("click", () => {
      const selectedBrandMode = ((document.querySelector('input[name="brand-display-mode"]:checked') as HTMLInputElement)?.value || "icon_only") as "icon_only" | "text_only" | "both";
      const selectedNavStyle = ((document.querySelector('input[name="hp-navbar-style"]:checked') as HTMLInputElement)?.value || "full_width") as NavbarStyleType;
      const selectedMobNavType = ((document.querySelector('input[name="hp-mobile-nav-type"]:checked') as HTMLInputElement)?.value || "bottom_nav") as MobileNavType;
      const selectedCornerStyle = ((document.querySelector('input[name="hp-corner-style"]:checked') as HTMLInputElement)?.value || "square") as ElementCornerStyle;

      const updatedConfig: HomepageConfig = {
        brand: {
          displayMode: selectedBrandMode,
          brandName: brandNameInput?.value.trim() || "IvyTicketing",
          tagline: brandTaglineInput?.value.trim() || "Sports Registration Engine",
          iconShape: "rounded",
        },
        navbar: {
          style: selectedNavStyle,
          mobileNavType: selectedMobNavType,
          opacity: Number(opacityInput?.value || "0.92"),
          blur: (blurSelect?.value || "md") as "none" | "sm" | "md" | "lg",
          showBorder: borderCheck?.checked ?? true,
          glassBlur: Number(glassBlurInput?.value || "0"),
          glassSaturate: Number(glassSaturateInput?.value || "1.0"),
          glassTint: glassTintInput?.value.trim() || "rgba(255, 255, 255, 0.255)",
          glassRadius: Number(glassRadiusInput?.value || "48"),
        },
        corners: {
          style: selectedCornerStyle,
        },
        theme: {
          mode: "athletic_dark",
          bgColor: bgInput?.value.trim() || "#0a1120",
          surfaceColor: surfaceInput?.value.trim() || "#101a2e",
          textColor: textInput?.value.trim() || "#f8fafc",
          accentColor: accentInput?.value.trim() || "#ea580c",
        },
        hero: {
          mode: (heroMode?.value || "slider") as "slider" | "single",
          autoplay: heroAutoplay?.checked ?? true,
          intervalSeconds: Number(heroInterval?.value || "5"),
          overlayDarkness: Number(heroOverlayInput?.value || "0.35"),
          statsStyle: (heroStatsStyleSelect?.value || "transparent") as "transparent" | "boxed",
          imagePosition: (heroImagePosSelect?.value || "top") as "top" | "center",
          showTags: heroShowTagsInput?.checked ?? false,
          bottomBlur: heroBottomBlurInput?.checked ?? true,
          slides: workingSlides,
        },
        features: {
          showSportFilter: showSportFilterEl?.checked ?? true,
        },
      };

      saveHomepageConfig(updatedConfig);
      activeHomepageConfig = updatedConfig;
      showToast("Pengaturan Website Utama & Desain Platform berhasil disimpan!");
    });

    // Reset Default
    const btnReset = document.getElementById("btn-reset-homepage");
    btnReset?.addEventListener("click", () => {
      if (confirm("Kembalikan semua pengaturan website utama dan navbar ke setelan bawaan standar?")) {
        resetHomepageConfig();
        initForm();
        showToast("Pengaturan website utama telah dikembalikan ke bawaan standar.");
      }
    });

    // Initialize
    initForm();
  </script>
</AdminLayout>
