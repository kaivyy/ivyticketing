---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Pengaturan Website Utama & Desain Platform : ivyticketing">
  <!-- Top Bar / Breadcrumb Header -->
  <div class="border-b border-slate-800 bg-slate-900/60 px-4 py-3 sm:px-6">
    <div class="mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-3 max-w-7xl">
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-sm sm:text-base font-bold uppercase tracking-wider text-white">
            Pengaturan Website Utama & Desain Platform
          </h1>
          <span class="rounded bg-orange-950 px-2 py-0.5 text-[10px] font-bold uppercase text-orange-400 border border-orange-500/30">
            Khusus Superadmin Platform
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-0.5 hidden sm:block">
          Kelola identitas brand, bentuk & gaya navbar (Liquid Glass / Full Width / Floating), transparansi, navigasi mobile, tema warna website, serta carousel slider hero.
        </p>
      </div>

      <div class="flex items-center gap-2 w-full sm:w-auto">
        <a
          href="/"
          target="_blank"
          class="min-h-[44px] inline-flex items-center justify-center gap-1.5 rounded-xl border border-slate-700 bg-slate-800 px-3.5 py-2 text-xs font-semibold text-slate-300 hover:bg-slate-700 hover:text-white transition-colors"
        >
          <svg class="h-4 w-4 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>Lihat Web Publik</span>
        </a>

        <button
          type="button"
          id="btn-reset-homepage"
          class="min-h-[44px] rounded-xl border border-slate-700 bg-slate-800 px-3.5 py-2 text-xs font-semibold text-slate-400 hover:bg-slate-700 hover:text-white transition-colors cursor-pointer"
        >
          Reset Default
        </button>

        <button
          type="button"
          id="btn-save-homepage"
          class="min-h-[44px] inline-flex items-center justify-center gap-1.5 rounded-xl bg-orange-600 px-5 py-2 text-xs font-bold uppercase tracking-wider text-white hover:bg-orange-500 shadow-md shadow-orange-600/30 transition-colors cursor-pointer"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Simpan Pengaturan</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Top Navigation Tabs: Pemisahan Jelas Event vs Website Utama -->
  <div class="border-b border-slate-800 bg-slate-950 px-4 py-2 sm:px-6">
    <div class="mx-auto flex items-center justify-between gap-4 max-w-7xl">
      <div class="flex items-center gap-2 overflow-x-auto py-0.5">
        <a
          href="/admin/events"
          class="flex items-center gap-2 rounded-lg px-3 py-1.5 text-xs font-medium text-slate-400 hover:bg-slate-800 hover:text-white transition-colors"
        >
          <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Kelola Event & Template</span>
        </a>

        <a
          href="/admin/settings"
          class="flex items-center gap-2 rounded-lg bg-orange-500/20 border border-orange-500/40 px-3 py-1.5 text-xs font-bold text-orange-400"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Pengaturan Website Utama</span>
        </a>
      </div>

      <div class="hidden sm:flex items-center gap-2 text-[11px] text-slate-400">
        <span>Peran:</span>
        <span class="font-bold text-orange-400">Superadmin Platform</span>
      </div>
    </div>
  </div>

  <main class="mx-auto max-w-7xl p-4 sm:p-6 space-y-6">
    <!-- Toast Notification -->
    <div id="toast-msg" class="hidden rounded-xl border border-emerald-500/40 bg-emerald-950/90 p-4 text-emerald-300 text-xs font-semibold shadow-lg backdrop-blur transition-all">
      Perubahan pengaturan website utama berhasil disimpan ke server!
    </div>

    <!-- Info Box: Pemisahan 3 Peran Pengguna (Admin, Organizer, Peserta) -->
    <div class="rounded-2xl border border-sky-500/30 bg-sky-950/20 p-4 sm:p-5 space-y-3">
      <div class="flex items-center gap-2">
        <span class="flex h-2 w-2 rounded-full bg-sky-400"></span>
        <h2 class="text-xs sm:text-sm font-bold uppercase tracking-wider text-sky-300">
          Struktur Arsitektur & Pemisahan Peran Pengguna
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-1 text-xs">
        <div class="rounded-xl border border-sky-900/60 bg-sky-950/40 p-3.5 space-y-1">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white uppercase tracking-wider">1. Platform Admin</span>
            <span class="rounded bg-sky-500/20 px-1.5 py-0.5 text-[10px] font-bold text-sky-400 uppercase">Halaman Ini</span>
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            Mengontrol website utama publik (/), branding platform, gaya navbar, tema global, katalog template, dan sistem antrean war secara menyeluruh.
          </p>
        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3.5 space-y-1">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white uppercase tracking-wider">2. Penyelenggara (Organizer)</span>
            <a href="/org/ivy-sports/dashboard" class="text-[10px] font-bold text-orange-400 hover:underline uppercase">Buka Portal &rarr;</a>
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            Hanya mengelola event mereka sendiri: memilih template lomba (Ironman/Marathon), mengatur kategori tiket, formulir pelari, dan loket racepack pickup.
          </p>
        </div>

        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-3.5 space-y-1">
          <div class="flex items-center justify-between">
            <span class="font-bold text-white uppercase tracking-wider">3. Peserta (Pelari / Pembeli)</span>
            <a href="/participant/dashboard" class="text-[10px] font-bold text-emerald-400 hover:underline uppercase">Buka Portal &rarr;</a>
          </div>
          <p class="text-slate-400 text-[11px] leading-relaxed">
            Mendaftar lomba di beranda, masuk ruang tunggu antrean (FIFO/Acak), membayar tiket, dan melihat nomor BIB, QR code tiket, serta sertifikat finisher.
          </p>
        </div>
      </div>
    </div>

    <!-- Studio Pengaturan Website Utama -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Kolom Kiri: Brand, Navbar & Tema Global -->
      <div class="lg:col-span-6 space-y-6">
        <!-- A. Mode Tampilan Brand / Logo -->
        <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-4 sm:p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-orange-400">
              A. Mode Tampilan Brand & Logo Header
            </h3>
            <span class="text-[10px] text-slate-400">Pilih gaya header</span>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <label for="brand-mode-icon" class="relative flex flex-col items-center justify-center p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30 text-center">
              <input type="radio" name="brand-display-mode" value="icon_only" id="brand-mode-icon" class="sr-only" />
              <span class="pointer-events-none text-xs sm:text-sm font-bold text-white">Hanya Icon</span>
              <span class="pointer-events-none text-[10px] text-slate-400 mt-0.5">Icon IVY tanpa teks (Default)</span>
            </label>

            <label for="brand-mode-text" class="relative flex flex-col items-center justify-center p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30 text-center">
              <input type="radio" name="brand-display-mode" value="text_only" id="brand-mode-text" class="sr-only" />
              <span class="pointer-events-none text-xs sm:text-sm font-bold text-white">Hanya Teks</span>
              <span class="pointer-events-none text-[10px] text-slate-400 mt-0.5">Hanya nama brand</span>
            </label>

            <label for="brand-mode-both" class="relative flex flex-col items-center justify-center p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30 text-center">
              <input type="radio" name="brand-display-mode" value="both" id="brand-mode-both" class="sr-only" />
              <span class="pointer-events-none text-xs sm:text-sm font-bold text-white">Icon + Teks</span>
              <span class="pointer-events-none text-[10px] text-slate-400 mt-0.5">Kombinasi lengkap</span>
            </label>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            <div>
              <label for="hp-brand-name" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider">Nama Brand Platform</label>
              <input
                type="text"
                id="hp-brand-name"
                class="mt-1 min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
                value="IvyTicketing"
              />
            </div>
            <div>
              <label for="hp-brand-tagline" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider">Tagline Platform</label>
              <input
                type="text"
                id="hp-brand-tagline"
                class="mt-1 min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none"
                value="Sports Registration Engine"
              />
            </div>
          </div>

          <!-- Live Brand Preview Box -->
          <div class="rounded-lg border border-slate-800 bg-[#0a1120] p-3 flex items-center justify-between">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Pratinjau Brand Header:</span>
            <div id="hp-brand-preview" class="flex items-center gap-3 p-1.5 rounded-lg bg-slate-900/80 border border-slate-800">
              <img id="hp-preview-icon" src="/images/ivy-icon.svg" alt="IVY" class="h-8 w-8 shrink-0" />
              <div id="hp-preview-text" class="hidden flex-col">
                <span id="hp-preview-title" class="font-display text-lg font-bold text-white uppercase leading-none">Ivy<span class="text-orange-500">Ticketing</span></span>
                <span id="hp-preview-tag" class="text-[9px] font-semibold text-slate-400 uppercase tracking-wider">Sports Registration Engine</span>
              </div>
            </div>
          </div>
        </div>

        <!-- B. Bentuk, Gaya & Efek Navbar -->
        <div class="rounded-xl border border-slate-800 bg-slate-900/80 p-4 sm:p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-orange-400">
              B. Bentuk & Efek Desain Navbar (Website Utama)
            </h3>
            <span class="text-[10px] text-slate-400">Liquid Glass / Full Width / Floating</span>
          </div>

          <!-- Pilihan Bentuk Navbar -->
          <div>
            <label class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider mb-2">Bentuk & Gaya Navbar</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
              <label for="hp-navbar-style-transparent" class="relative flex flex-col p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30 text-center">
                <input type="radio" name="hp-navbar-style" id="hp-navbar-style-transparent" value="transparent_gradient" class="sr-only" />
                <span class="pointer-events-none text-xs font-bold text-white">Transparan Gradasi</span>
                <span class="pointer-events-none text-[10px] text-slate-400 mt-0.5">Model Ironman Triathlon (Transparan di atas, blur saat scroll)</span>
              </label>

              <label for="hp-navbar-style-liquid" class="relative flex flex-col p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30 text-center">
                <input type="radio" name="hp-navbar-style" id="hp-navbar-style-liquid" value="liquid_glass" class="sr-only" />
                <span class="pointer-events-none text-xs font-bold text-white">Liquid Glass Pill</span>
                <span class="pointer-events-none text-[10px] text-slate-400 mt-0.5">Floating 720x72px (Vanta Refraction)</span>
              </label>

              <label for="hp-navbar-style-full" class="relative flex flex-col p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30 text-center">
                <input type="radio" name="hp-navbar-style" id="hp-navbar-style-full" value="full_width" checked class="sr-only" />
                <span class="pointer-events-none text-xs font-bold text-white">Full-Width Bar</span>
                <span class="pointer-events-none text-[10px] text-slate-400 mt-0.5">Bar Modern Tepi-ke-Tepi</span>
              </label>

              <label for="hp-navbar-style-compact" class="relative flex flex-col p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30 text-center">
                <input type="radio" name="hp-navbar-style" id="hp-navbar-style-compact" value="floating_compact" class="sr-only" />
                <span class="pointer-events-none text-xs font-bold text-white">Floating Compact</span>
                <span class="pointer-events-none text-[10px] text-slate-400 mt-0.5">Melayang Melengkung 5XL</span>
              </label>
            </div>
          </div>

          <!-- Pilihan Tipe Navigasi Khusus Layar Mobile -->
          <div class="rounded-xl border border-slate-800 bg-slate-900/40 p-3 space-y-2">
            <div class="flex items-center justify-between">
              <label class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider">
                Navigasi Khusus Mobile
              </label>
              <span class="text-[10px] text-orange-400 font-bold uppercase">Bisa Diatur Admin</span>
            </div>
            <p class="text-[11px] text-slate-400">
              Pilih model navigasi saat pengunjung membuka website lewat smartphone atau tablet kecil.
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
              <label for="hp-mobnav-bottom" class="relative flex flex-col p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30">
                <input type="radio" name="hp-mobile-nav-type" id="hp-mobnav-bottom" value="bottom_nav" checked class="sr-only" />
                <div class="flex items-center justify-between">
                  <span class="pointer-events-none text-xs font-bold text-white">Mobile Bottom Navbar</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-orange-500/20 text-orange-400 font-bold uppercase">Default</span>
                </div>
                <span class="pointer-events-none text-[10px] text-slate-400 mt-1">4 tab navigasi di bagian bawah layar, ramah satu jempol (Beranda, Event, War, Akun)</span>
              </label>

              <label for="hp-mobnav-top" class="relative flex flex-col p-3 rounded-xl border border-slate-700 bg-slate-900 cursor-pointer hover:border-orange-500 transition-colors has-[:checked]:border-orange-500 has-[:checked]:bg-orange-950/30">
                <input type="radio" name="hp-mobile-nav-type" id="hp-mobnav-top" value="top_bar" class="sr-only" />
                <div class="flex items-center justify-between">
                  <span class="pointer-events-none text-xs font-bold text-white">Top Navbar Klasik</span>
                </div>
                <span class="pointer-events-none text-[10px] text-slate-400 mt-1">Tombol menu hamburger di kanan atas dengan menu drawer drop-down</span>
              </label>
            </div>
          </div>

          <!-- Panel Parameter Khusus Liquid Glass -->
          <div id="liquid-glass-params" class="rounded-xl border border-slate-800 bg-slate-900/60 p-3 space-y-3">
            <div class="flex items-center justify-between border-b border-slate-800 pb-1.5">
              <span class="text-[11px] font-bold text-orange-400 uppercase tracking-wider">Parameter Material Liquid Glass</span>
              <span class="text-[10px] text-slate-500 font-mono">Refraction & Rim</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <div class="flex items-center justify-between text-xs">
                  <label for="hp-glass-blur" class="text-[11px] font-semibold text-slate-300">Glass Blur</label>
                  <span id="hp-glass-blur-val" class="font-mono text-[11px] font-bold text-orange-400">0px</span>
                </div>
                <input
                  type="range"
                  id="hp-glass-blur"
                  min="0"
                  max="24"
                  step="1"
                  value="0"
                  class="mt-1 w-full accent-orange-500 cursor-pointer"
                />
              </div>

              <div>
                <div class="flex items-center justify-between text-xs">
                  <label for="hp-glass-saturate" class="text-[11px] font-semibold text-slate-300">Saturate</label>
                  <span id="hp-glass-saturate-val" class="font-mono text-[11px] font-bold text-orange-400">1.0x</span>
                </div>
                <input
                  type="range"
                  id="hp-glass-saturate"
                  min="0.5"
                  max="2.0"
                  step="0.1"
                  value="1.0"
                  class="mt-1 w-full accent-orange-500 cursor-pointer"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <div>
                <label for="hp-glass-tint" class="block text-[11px] font-semibold text-slate-300">Glass Tint (RGBA / Hex)</label>
                <input
                  type="text"
                  id="hp-glass-tint"
                  value="rgba(255, 255, 255, 0.255)"
                  class="mt-1 min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-1.5 text-xs text-white font-mono"
                />
              </div>

              <div>
                <div class="flex items-center justify-between text-xs">
                  <label for="hp-glass-radius" class="text-[11px] font-semibold text-slate-300">Border Radius</label>
                  <span id="hp-glass-radius-val" class="font-mono text-[11px] font-bold text-orange-400">48px</span>
                </div>
                <input
                  type="range"
                  id="hp-glass-radius"
                  min="12"
                  max="60"
                  step="2"
                  value="48"
                  class="mt-2 w-full accent-orange-500 cursor-pointer"
                />
              </div>
            </div>
          </div>

          <!-- Standard Opacity & Blur Controls -->
          <div>
            <div class="flex items-center justify-between text-xs">
              <label for="hp-navbar-opacity" class="font-semibold text-slate-300">Tingkat Transparansi (Opacity)</label>
              <span id="hp-opacity-label" class="font-mono font-bold text-orange-400">92%</span>
            </div>
            <input
              type="range"
              id="hp-navbar-opacity"
              min="0.10"
              max="1.00"
              step="0.02"
              value="0.92"
              class="mt-2 w-full accent-orange-500 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-slate-500 mt-1">
              <span>Transparan (10%)</span>
              <span>Semi-Glass (50%)</span>
              <span>Solid (100%)</span>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
            <div>
              <label for="hp-navbar-blur" class="block text-[11px] font-semibold text-slate-300 uppercase tracking-wider">Efek Backdrop Blur Fallback</label>
              <select
                id="hp-navbar-blur"
                class="mt-1 min-h-[44px] w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-white focus:border-orange-500 focus:outline-none cursor-pointer"
              >
                <option value="none">Tanpa Blur (none)</option>
                <option value="sm">Blur Ringan (sm : 4px)</option>
                <option value="md" selected>Blur Sedang (md : 12px)</option>
                <option value="lg">Blur Tebal (lg : 20px)</option>
              </select>
            </div>

            <div class="flex flex-col justify-end">
              <label class="flex items-center gap-2 min-h-[44px] p-2 rounded-lg border border-slate-700 bg-slate-900 cursor-pointer hover:border-slate-500">
                <input type="checkbox" id="hp-navbar-border" checked class="rounded accent-orange-500" />
                <span class="text-xs text-slate-300 font-semibold">Tampilkan Garis Tepi Bawah</span>
              </label>
            </div>
          </div>

          <!-- Navbar Preview Strip -->
          <div class="relative rounded-xl overflow-hidden border border-slate-800 h-28 flex items-center justify-center p-3" style="background-image: url('/images/events/bangkok_marathon.jpg'); background-size: cover; background-position: center;">
            <div id="hp-navbar-sim" class="transition-all flex items-center justify-between px-4 py-2 border shadow-lg" style="background-color: rgba(255, 255, 255, 0.255); backdrop-filter: blur(0px) saturate(1); border-radius: 48px; border-color: rgba(255, 255, 255, 0.128); max-width: 480px; width: 100%;">
              <div class="flex items-center gap-2">
                <img src="/images/ivy-icon.svg" class="h-6 w-6" alt="IVY" />
                <span id="hp-sim-title" class="text-xs font-bold text-white uppercase font-display">Simulasi Liquid Glass</span>
