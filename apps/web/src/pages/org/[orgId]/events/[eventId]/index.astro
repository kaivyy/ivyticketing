---
export const prerender = false;
import OrganizerLayout from "../../../../../layouts/OrganizerLayout.astro";
const { orgId, eventId } = Astro.params;
---

<OrganizerLayout title="Ringkasan Event : ivyticketing" orgId={orgId}>
  <div id="event-detail-root" data-org-id={orgId} data-event-id={eventId} class="space-y-6">
    <!-- Header Ringkasan Event -->
    <div id="event-header" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-slate-500">Memuat data event…</p>
    </div>

    <!-- Metrik Cepat -->
    <div id="metrics-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Kategori</p>
        <p id="cat-count" class="font-display text-2xl font-bold text-slate-900 mt-1">-</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Kuota Slot</p>
        <p id="quota-count" class="font-display text-2xl font-bold text-slate-900 mt-1">-</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Mode Antrean</p>
        <p id="queue-mode-badge" class="font-display text-base font-bold text-orange-600 mt-1">Token-Bucket</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Status Registrasi</p>
        <p id="reg-status-badge" class="font-display text-base font-bold text-emerald-600 mt-1">Aktif</p>
      </div>
    </div>

    <!-- Grid Navigasi Modul Event -->
    <div>
      <h2 class="font-display text-lg font-bold uppercase tracking-wider text-slate-900 mb-3">
        Modul Pengelolaan Event
      </h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <!-- 1. Kategori Tiket -->
        <a
          href={`/org/${orgId}/events/${eventId}/categories`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Kategori Tiket</span>
              <span class="rounded bg-orange-100 px-2 py-0.5 text-[11px] font-semibold text-orange-700">Setup Kunci</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Atur jarak race (Marathon, Triathlon, Gran Fondo), kuota slot, biaya registrasi, dan mode War / Ballot.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Kelola Kategori</span>
        </a>

        <!-- Kustomisasi Desain & Tampilan -->
        <a
          href={`/org/${orgId}/events/${eventId}/customize`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Kustomisasi Desain</span>
              <span class="rounded bg-orange-100 px-2 py-0.5 text-[11px] font-semibold text-orange-700">Studio Visual</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Atur tata letak hero (kiri/tengah/split), bentuk tombol pendaftaran, palet warna lomba, dan konten pendukung dengan mudah.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Buka Studio Kustomisasi</span>
        </a>

        <!-- Formulir Kustom -->
        <a
          href={`/org/${orgId}/events/${eventId}/form`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Formulir Kustom</span>
              <span class="rounded bg-orange-100 px-2 py-0.5 text-[11px] font-semibold text-orange-700">Form Builder</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Kustomisasi formulir pendaftaran atlet: tambah pertanyaan khusus, opsi shuttle bus, catatan PB lomba, dan pratinjau langsung.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Buka Form Builder</span>
        </a>

        <!-- 2. Kontrol Antrean War -->
        <a
          href={`/org/${orgId}/events/${eventId}/queue-controls`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Kontrol Antrean War</span>
              <span class="rounded bg-amber-100 px-2 py-0.5 text-[11px] font-semibold text-amber-700">Live Engine</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Buka atau jeda antrean tiket, atur laju rilis peserta per menit, dan pantau status lonjakan traffic.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Buka Kontrol Antrean</span>
        </a>

        <!-- 3. Tiket & Alokasi BIB -->
        <a
          href={`/org/${orgId}/events/${eventId}/tickets`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Tiket & Nomor BIB</span>
              <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700">Peserta</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Daftar tiket terbit, penetapan otomatis nomor BIB atlet, dan status verifikasi e-ticket QR.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Buka Daftar Tiket</span>
        </a>

        <!-- 4. Corporate & Prioritas -->
        <a
          href={`/org/${orgId}/events/${eventId}/corporate`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Corporate & Komunitas</span>
              <span class="rounded bg-purple-100 px-2 py-0.5 text-[11px] font-semibold text-purple-700">Akses Khusus</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Alokasikan kuota khusus grup, pendaftaran rombongan korporat, dan pembuatan kode akses diskon.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Kelola Corporate</span>
        </a>

        <!-- 5. Racepack Distribution -->
        <a
          href={`/org/${orgId}/events/${eventId}/racepack-dashboard`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Racepack Collection</span>
              <span class="rounded bg-blue-100 px-2 py-0.5 text-[11px] font-semibold text-blue-700">Operasional</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Monitoring pengambilan race pack, alokasi loket counter, slot jadwal temu, dan penanganan problem desk.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Buka Racepack Desk</span>
        </a>

        <!-- 6. Hasil Balap & Timing -->
        <a
          href={`/org/${orgId}/events/${eventId}/results`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Hasil & Sertifikat</span>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-[11px] font-semibold text-emerald-700">Pasca-Lomba</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Upload waktu tempuh chip timing (gun time, chip time), penentuan juara kategori, dan sertifikat finisher digital.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Kelola Hasil Balap</span>
        </a>

        <!-- 7. Laporan Finansial -->
        <a
          href={`/org/${orgId}/events/${eventId}/reports`}
          class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="font-display text-base font-bold uppercase text-slate-900">Laporan & Ekspor</span>
              <span class="rounded bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-700">Finansial</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 leading-relaxed">
              Rekapitulasi penjualan tiket, ekspor CSV data pelari untuk asuransi dan medis, serta rekonsiliasi pembayaran.
            </p>
          </div>
          <span class="mt-4 text-xs font-bold text-orange-600">&rarr; Buka Laporan</span>
        </a>
      </div>
    </div>
  </div>

  <script>
    import { authedFetch } from "../../../../../lib/api";
    import { esc } from "../../../../../lib/safe";

    const root = document.getElementById("event-detail-root");
    const orgId = root?.dataset.orgId || window.location.pathname.split("/")[2] || "";
    const eventId = root?.dataset.eventId || window.location.pathname.split("/")[4] || "";

    const header = document.getElementById("event-header");
    const catCount = document.getElementById("cat-count");
    const quotaCount = document.getElementById("quota-count");

    async function loadData() {
      try {
        const [ev, categories] = await Promise.all([
          authedFetch(`/organizations/${orgId}/events/${eventId}`),
          authedFetch(`/organizations/${orgId}/events/${eventId}/categories`).catch(() => []),
        ]);

        const isPublished = ev.status === "PUBLISHED";
        const startDateStr = ev.startsAt
          ? new Date(ev.startsAt).toLocaleDateString("id-ID", {
              weekday: "long",
              day: "numeric",
              month: "long",
              year: "numeric",
              hour: "2-digit",
              minute: "2-digit",
            })
          : "Tanggal belum ditentukan";

        header.innerHTML = `
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="rounded px-2 py-0.5 text-xs font-bold uppercase ${
                  isPublished
                    ? "bg-green-100 text-green-800 border border-green-200"
                    : "bg-slate-100 text-slate-700 border border-slate-200"
                }">
                  ${isPublished ? "Dipublikasikan" : "Draf / Belum Publik"}
                </span>
                <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                  ${esc(ev.eventType ?? "MARATHON")}
                </span>
              </div>
              <h1 class="font-display text-3xl font-bold uppercase tracking-tight text-slate-900">
                ${esc(ev.name)}
              </h1>
              <p class="text-xs text-slate-500 mt-1">
                &bull; Waktu Lomba: <span class="font-medium text-slate-700">${startDateStr}</span>
                ${ev.venueName ? ` &bull; Lokasi: <span class="font-medium text-slate-700">${esc(ev.venueName)}</span>` : ""}
              </p>
            </div>

            <div class="flex items-center gap-2">
              <a
                href="/events/${eventId}"
                target="_blank"
                class="rounded-lg border border-slate-300 px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-700 hover:bg-slate-50 transition-colors"
              >
                Lihat Halaman Publik &nearr;
              </a>
              <button
                id="btn-toggle-publish"
                class="rounded-lg ${isPublished ? "bg-slate-800 hover:bg-slate-700" : "bg-orange-600 hover:bg-orange-500"} px-4 py-2 text-xs font-bold uppercase tracking-wider text-white transition-colors"
              >
                ${isPublished ? "Tarik Publikasi" : "Publikasikan Event"}
              </button>
            </div>
          </div>`;

        document.getElementById("btn-toggle-publish")?.addEventListener("click", async () => {
          const action = isPublished ? "unpublish" : "publish";
          try {
            await authedFetch(`/organizations/${orgId}/events/${eventId}/${action}`, { method: "POST" });
            loadData();
          } catch (err) {
            alert(err.message || "Gagal mengubah status publikasi.");
          }
        });

        // Hitung metrik
        const cats = Array.isArray(categories) ? categories : [];
        catCount.textContent = String(cats.length);
        const totalQuota = cats.reduce((sum, c) => sum + (c.capacity || 0), 0);
        quotaCount.textContent = totalQuota > 0 ? totalQuota.toLocaleString("id-ID") : "0";
      } catch (err) {
        header.innerHTML = `<p class="text-red-600 text-sm">Gagal memuat detail event: ${esc(err.message)}</p>`;
      }
    }

    loadData();
  </script>
</OrganizerLayout>
