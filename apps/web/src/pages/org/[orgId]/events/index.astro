---
export const prerender = false;
import OrganizerLayout from "../../../../layouts/OrganizerLayout.astro";
const { orgId } = Astro.params;
---

<OrganizerLayout title="Daftar Event : ivyticketing" orgId={orgId}>
  <div id="org-events-root" data-org-id={orgId} class="space-y-6">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4">
      <div>
        <h1 class="font-display text-2xl font-bold uppercase tracking-tight text-slate-900">Events Organisasi</h1>
        <p class="text-xs text-slate-500 mt-0.5">Kelola perlombaan, pantau penjualan tiket, dan atur antrean registrasi.</p>
      </div>
      <a
        href={`/org/${orgId}/events/new`}
        class="inline-flex items-center gap-1.5 rounded-lg bg-orange-600 px-4 py-2 text-xs font-bold uppercase tracking-wider text-white shadow hover:bg-orange-500 transition-colors"
      >
        + Buat Event Baru
      </a>
    </div>

    <div id="events-list" class="space-y-3">
      <p class="text-slate-500">Memuat data event…</p>
    </div>

    <p class="text-xs text-slate-400">
      <a href={`/org/${orgId}/dashboard`} class="underline hover:text-slate-600">Kembali ke Dashboard</a>
    </p>
  </div>
</OrganizerLayout>

<script>
  import { authedFetch } from "../../../../lib/api";
  import { getMarathonEvents } from "../../../../lib/events-store";
  import { esc } from "../../../../lib/safe";

  const root = document.getElementById("org-events-root");
  const orgId = root?.getAttribute("data-org-id") || window.location.pathname.split("/")[2] || "";

  function statusLabel(status) {
    const map = {
      DRAFT:     "Draf",
      PUBLISHED: "Dipublikasikan",
      ARCHIVED:  "Diarsipkan",
    };
    return map[status] ?? status;
  }

  function statusClass(status) {
    const map = {
      DRAFT:     "bg-slate-100 text-slate-700 border border-slate-300",
      PUBLISHED: "bg-emerald-100 text-emerald-800 border border-emerald-300",
      ARCHIVED:  "bg-amber-100 text-amber-800 border border-amber-300",
    };
    return map[status] ?? "bg-slate-100 text-slate-700";
  }

  const list = document.getElementById("events-list");

  try {
    let events: any[] = [];
    try {
      events = await authedFetch(`/organizations/${orgId}/events`).catch(() => []);
    } catch {
      events = [];
    }

    if (!events || events.length === 0) {
      const localEvents = getMarathonEvents();
      const matching = localEvents.filter(
        (e) =>
          !orgId ||
          orgId === "ivy-sports" ||
          orgId === "org_marathon_indo" ||
          e.organizerSlug === orgId ||
          e.id.includes(orgId)
      );
      if (matching.length > 0) {
        events = matching;
      }
    }

    if (!events || events.length === 0) {
      list.innerHTML = `
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-center">
          <p class="font-semibold text-slate-800">Belum ada event yang dibuat</p>
          <p class="text-xs text-slate-500 mt-1 mb-4">Mulai buat event lari, marathon, atau triathlon pertama Anda sekarang.</p>
          <a
            href="/org/${orgId}/events/new"
            class="inline-block rounded-lg bg-orange-600 px-4 py-2 text-xs font-bold uppercase text-white hover:bg-orange-500"
          >
            + Buat Event Pertama
          </a>
        </div>`;
    } else {
      list.replaceChildren(
        ...events.map((ev) => {
          const a = document.createElement("a");
          // Arahkan ke event overview command center
          a.href = `/org/${orgId}/events/${ev.id}`;
          a.className =
            "block rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow-md transition-all";

          const header = document.createElement("div");
          header.className = "flex items-center justify-between gap-2 mb-2";

          const title = document.createElement("span");
          title.className = "font-display text-lg font-bold uppercase text-slate-900 truncate";
          title.textContent = ev.name ?? ev.title ?? ev.id;

          const badge = document.createElement("span");
          badge.className = `inline-flex items-center rounded px-2.5 py-0.5 text-[11px] font-bold uppercase ${statusClass(ev.status)}`;
          badge.textContent = statusLabel(ev.status);

          header.append(title, badge);

          const dateStr = ev.startsAt || ev.startAt
            ? new Date(ev.startsAt || ev.startAt).toLocaleDateString("id-ID", {
                weekday: "long",
                day: "numeric",
                month: "short",
                year: "numeric",
              })
            : "Tanggal belum ditentukan";

          const venueStr = ev.venueName ? ` · ${ev.venueName}` : "";

          const sub = document.createElement("p");
          sub.className = "text-xs text-slate-500";
          sub.textContent = `${ev.eventType ?? "MARATHON"} · ${dateStr}${venueStr}`;

          const footer = document.createElement("div");
          footer.className = "mt-3 flex items-center justify-between border-t border-slate-100 pt-3 text-xs";
          footer.innerHTML = `
            <span class="text-slate-400">ID: <code class="font-mono text-[11px]">${ev.id.slice(0, 8)}...</code></span>
            <span class="font-bold text-orange-600">&rarr; Buka Workspace Event</span>
          `;

          a.append(header, sub, footer);
          return a;
        })
      );
    }
  } catch (e) {
    const p = document.createElement("p");
    p.className = "text-red-600 text-sm";
    p.textContent = e.message || "Gagal memuat daftar event.";
    list.replaceChildren(p);
  }
</script>
