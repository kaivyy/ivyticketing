---
export const prerender = false;
import OrganizerLayout from "../../../layouts/OrganizerLayout.astro";
const { orgId } = Astro.params;
---

<OrganizerLayout title="Pengaturan Organisasi : ivyticketing" orgId={orgId}>
  <div id="settings-root" data-org-id={orgId} class="space-y-6 max-w-6xl">
    <div class="border-b border-slate-200 pb-4">
      <h1 class="font-display text-2xl font-bold uppercase tracking-tight text-slate-900">
        Pengaturan Organisasi
      </h1>
      <p class="text-xs text-slate-500 mt-0.5">Informasi profil organisasi, modul terkait, dan riwayat audit aktivitas tim.</p>
    </div>

    <!-- Org info card -->
    <div id="org-info" class="space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <p class="text-slate-500 text-sm">Memuat profil organisasi...</p>
    </div>

    <!-- Quick navigation grid -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a
        href={`/org/${orgId}/branding`}
        class="rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow transition-all"
      >
        <h3 class="font-display text-base font-bold uppercase text-slate-900">Branding & Domain</h3>
        <p class="mt-1 text-xs text-slate-500">Kustomisasi logo, warna brand, dan domain kustom event.</p>
      </a>

      <a
        href={`/org/${orgId}/billing`}
        class="rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow transition-all"
      >
        <h3 class="font-display text-base font-bold uppercase text-slate-900">Tagihan & Payout</h3>
        <p class="mt-1 text-xs text-slate-500">Saldo bersih tiket, rekening bank pencairan, dan penarikan dana.</p>
      </a>

      <a
        href={`/org/${orgId}/enterprise`}
        class="rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow transition-all"
      >
        <h3 class="font-display text-base font-bold uppercase text-slate-900">API & Webhooks</h3>
        <p class="mt-1 text-xs text-slate-500">Kelola API key dan webhook integrasi sistem pihak ketiga.</p>
      </a>

      <a
        href="/admin/payments"
        class="rounded-xl border border-slate-200 bg-white p-5 hover:border-orange-500 hover:shadow transition-all"
      >
        <h3 class="font-display text-base font-bold uppercase text-slate-900">Gateway Pembayaran</h3>
        <p class="mt-1 text-xs text-slate-500">Kelola gateway aktif (Xendit, Duitku, Midtrans) dan kanal aktif.</p>
      </a>
    </div>

    <!-- Audit Log Section -->
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 bg-slate-50/60">
        <div>
          <h2 class="font-display text-base font-bold uppercase text-slate-900">Riwayat Aktivitas & Audit Trail</h2>
          <p class="text-xs text-slate-500">Catatan aktivitas operasional, penomoran BIB, broadcast, dan konfigurasi organisasi.</p>
        </div>
        <div class="flex items-center gap-2">
          <input
            type="text"
            id="audit-filter"
            placeholder="Cari aksi atau pelaksana..."
            class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs text-slate-900 shadow-sm focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500"
          />
          <button
            id="audit-refresh-btn"
            type="button"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 shadow-sm focus:outline-none"
          >
            <svg class="h-3.5 w-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span>Segarkan</span>
          </button>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600">
          <thead class="bg-slate-50 text-[11px] font-bold uppercase tracking-wider text-slate-500 border-b border-slate-200">
            <tr>
              <th class="px-5 py-3">Waktu</th>
              <th class="px-5 py-3">Pelaksana</th>
              <th class="px-5 py-3">Aksi</th>
              <th class="px-5 py-3">Target</th>
              <th class="px-5 py-3">Rincian Metadata</th>
            </tr>
          </thead>
          <tbody id="audit-table-body" class="divide-y divide-slate-100">
            <tr>
              <td colspan="5" class="px-5 py-8 text-center text-slate-400">
                Memuat riwayat aktivitas...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <p class="text-xs text-slate-400">
      <a href={`/org/${orgId}/dashboard`} class="underline hover:text-slate-600">Kembali ke Dashboard</a>
    </p>
  </div>

  <script>
    import { authedFetch } from "../../../lib/api";
    import { esc } from "../../../lib/safe";

    const root = document.getElementById("settings-root");
    const orgId = root?.dataset.orgId || window.location.pathname.split("/")[2] || "";

    const container = document.getElementById("org-info");
    const auditTbody = document.getElementById("audit-table-body");
    const filterInput = document.getElementById("audit-filter") as HTMLInputElement | null;
    const refreshBtn = document.getElementById("audit-refresh-btn");

    let auditLogsCache: any[] = [];

    async function loadOrg() {
      if (!container) return;
      try {
        const org = await authedFetch(`/organizations/${orgId}`);
        container.innerHTML = `
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Nama Organisasi</p>
              <p class="text-base font-semibold text-slate-900 mt-1">${esc(org.name ?? "Organisasi")}</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">URL Slug</p>
              <p class="font-mono text-sm text-slate-800 mt-1">${esc(org.slug ?? "-")}</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">ID Organisasi</p>
              <p class="font-mono text-xs text-slate-500 mt-1 truncate" title="${esc(org.id ?? orgId)}">${esc(org.id ?? orgId)}</p>
            </div>
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Status Akun</p>
              <span class="inline-block mt-1 rounded bg-emerald-100 px-2.5 py-0.5 text-xs font-bold uppercase text-emerald-800 border border-emerald-300">
                Terverifikasi
              </span>
            </div>
          </div>`;
      } catch (err: any) {
        container.innerHTML = `<p class="text-red-600 text-sm">Gagal memuat profil organisasi: ${esc(err.message)}</p>`;
      }
    }

    function renderAuditTable(logs: any[]) {
      if (!auditTbody) return;
      if (!logs || logs.length === 0) {
        auditTbody.innerHTML = `
          <tr>
            <td colspan="5" class="px-5 py-8 text-center text-slate-400">
              Belum ada riwayat aktivitas yang tercatat untuk organisasi ini.
            </td>
          </tr>`;
        return;
      }

      auditTbody.innerHTML = logs.map((item) => {
        const dateStr = item.createdAt ? new Date(item.createdAt).toLocaleString("id-ID", {
          day: "2-digit",
          month: "short",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit"
        }) : "-";

        const actorDisplay = item.actorName || item.actorEmail || (item.actorUserId ? item.actorUserId.substring(0, 8) + "..." : "Sistem");

        let badgeClass = "bg-slate-100 text-slate-700 border-slate-200";
        const act = (item.action || "").toUpperCase();
        if (act.includes("BIB")) {
          badgeClass = "bg-blue-50 text-blue-700 border-blue-200";
        } else if (act.includes("REFUND") || act.includes("CANCEL")) {
          badgeClass = "bg-amber-50 text-amber-700 border-amber-200";
        } else if (act.includes("BROADCAST")) {
          badgeClass = "bg-purple-50 text-purple-700 border-purple-200";
        } else if (act.includes("PAYOUT")) {
          badgeClass = "bg-emerald-50 text-emerald-700 border-emerald-200";
        } else if (act.includes("EVENT") || act.includes("CATEGORY")) {
          badgeClass = "bg-indigo-50 text-indigo-700 border-indigo-200";
        }

        let metaStr = "-";
        if (item.metadata && Object.keys(item.metadata).length > 0) {
          metaStr = Object.entries(item.metadata)
            .map(([k, v]) => `<span class="inline-block rounded bg-slate-100 px-1.5 py-0.5 font-mono text-[10px] text-slate-700 mr-1 mb-1 border border-slate-200"><strong>${esc(k)}</strong>: ${esc(typeof v === 'object' ? JSON.stringify(v) : v)}</span>`)
            .join("");
        }

        const targetDisplay = item.targetType ? `${esc(item.targetType)}: <span class="font-mono text-slate-500">${esc(item.targetId || "-")}</span>` : "-";

        return `
          <tr class="hover:bg-slate-50/80 transition-colors">
            <td class="px-5 py-3 whitespace-nowrap text-slate-500 font-mono text-[11px]">${dateStr}</td>
            <td class="px-5 py-3 whitespace-nowrap font-medium text-slate-900">${esc(actorDisplay)}</td>
            <td class="px-5 py-3 whitespace-nowrap">
              <span class="inline-block rounded px-2 py-0.5 text-[11px] font-bold border ${badgeClass}">
                ${esc(item.action)}
              </span>
            </td>
            <td class="px-5 py-3 whitespace-nowrap text-slate-700">${targetDisplay}</td>
            <td class="px-5 py-3 text-slate-600 max-w-md break-words">${metaStr}</td>
          </tr>
        `;
      }).join("");
    }

    async function loadAuditLogs() {
      if (!auditTbody) return;
      try {
        const logs = await authedFetch(`/organizations/${orgId}/audit-logs?limit=50`);
        auditLogsCache = Array.isArray(logs) ? logs : [];
        applyFilter();
      } catch (err: any) {
        auditTbody.innerHTML = `
          <tr>
            <td colspan="5" class="px-5 py-8 text-center text-red-500">
              Gagal memuat log audit: ${esc(err.message)}
            </td>
          </tr>`;
      }
    }

    function applyFilter() {
      const q = filterInput?.value.trim().toLowerCase() || "";
      if (!q) {
        renderAuditTable(auditLogsCache);
        return;
      }
      const filtered = auditLogsCache.filter((item) => {
        const act = (item.action || "").toLowerCase();
        const actor = (item.actorName || item.actorEmail || "").toLowerCase();
        const target = (item.targetType || "").toLowerCase() + " " + (item.targetId || "").toLowerCase();
        return act.includes(q) || actor.includes(q) || target.includes(q);
      });
      renderAuditTable(filtered);
    }

    filterInput?.addEventListener("input", applyFilter);
    refreshBtn?.addEventListener("click", () => {
      loadAuditLogs();
    });

    loadOrg();
    loadAuditLogs();
  </script>
</OrganizerLayout>
