import fs from "node:fs";
import path from "node:path";
import { DEFAULT_HOMEPAGE_CONFIG, type HomepageConfig } from "../lib/events-store";

// Load configuration for SSR from server file with fallback
let homepageConfig: HomepageConfig = DEFAULT_HOMEPAGE_CONFIG;
try {
  const configFile = path.resolve(process.cwd(), "homepage-config.json");
  if (fs.existsSync(configFile)) {
    const raw = fs.readFileSync(configFile, "utf-8");
    const parsed = JSON.parse(raw);
    homepageConfig = {
      brand: { ...DEFAULT_HOMEPAGE_CONFIG.brand, ...(parsed.brand || {}) },
      navbar: { ...DEFAULT_HOMEPAGE_CONFIG.navbar, ...(parsed.navbar || {}) },
      corners: { ...DEFAULT_HOMEPAGE_CONFIG.corners, ...(parsed.corners || {}) },
      theme: { ...DEFAULT_HOMEPAGE_CONFIG.theme, ...(parsed.theme || {}) },
      features: { ...DEFAULT_HOMEPAGE_CONFIG.features, ...(parsed.features || {}) },
      hero: {
        ...DEFAULT_HOMEPAGE_CONFIG.hero,
        ...(parsed.hero || {}),
        slides:
          Array.isArray(parsed.hero?.slides) && parsed.hero.slides.length > 0
            ? parsed.hero.slides
            : DEFAULT_HOMEPAGE_CONFIG.hero.slides,
      },
    };
  }
} catch {
  // fallback
}

const brandMode = homepageConfig.brand?.displayMode || "icon_only";
const brandName = homepageConfig.brand?.brandName || "IvyTicketing";
const brandTagline = homepageConfig.brand?.tagline || "Sports Registration Engine";
const navStyle = homepageConfig.navbar?.style || "transparent_gradient";
const mobileNavType = homepageConfig.navbar?.mobileNavType || "bottom_nav";
const cornersStyle = homepageConfig.corners?.style || "square";
const currentTheme = homepageConfig.theme || DEFAULT_HOMEPAGE_CONFIG.theme;
const heroOverlayDarkness = homepageConfig.hero?.overlayDarkness ?? 0.35;
const heroStatsStyle = homepageConfig.hero?.statsStyle || "transparent";
const heroImagePos = homepageConfig.hero?.imagePosition || "top";
const heroShowTags = homepageConfig.hero?.showTags === true;
const heroBottomBlur = homepageConfig.hero?.bottomBlur !== false;
const topOverlayAlpha = Math.min(0.20, Number((heroOverlayDarkness * 0.15).toFixed(2)));
const midOverlayAlpha = Number((heroOverlayDarkness * 0.35).toFixed(2));
const botOverlayAlpha = Math.min(0.95, Number((heroOverlayDarkness * 1.9).toFixed(2)));
const activeSlides = homepageConfig.hero?.slides && homepageConfig.hero.slides.length > 0
  ? homepageConfig.hero.slides
  : initialSlides;
---

<!doctype html>
<html lang="id" class={`scroll-smooth corner-${cornersStyle}`} style={`--color-bg-dark: ${currentTheme.bgColor || '#0a1120'}; --color-surface-dark: ${currentTheme.surfaceColor || '#101a2e'}; --color-accent: ${currentTheme.accentColor || '#ea580c'}; --color-text: ${currentTheme.textColor || '#f8fafc'};`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>IvyTicketing: Platform Registrasi Event Olahraga, Marathon & Triathlon</title>
    <meta
      name="description"
      content="Platform tiket dan registrasi event lari marathon, triathlon, sepeda, dan trail run berkapasitas tinggi. Antrean war adil, sistem ballot transparan, dan tanpa oversell."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --color-bg-dark: #0a1120;
        --color-bg-rgb: 10, 17, 32;
        --color-surface-dark: #101a2e;
        --color-surface-rgb: 16, 26, 46;
        --color-surface-card: #15223c;
        --color-surface-card-rgb: 21, 34, 60;
        --color-accent: #ea580c;
        --color-accent-rgb: 234, 88, 12;
        --color-accent-hover: #c2410c;
        --color-text: #f8fafc;
        --color-text-muted: #94a3b8;
      }
      body {
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        background-color: var(--color-bg-dark);
        color: var(--color-text);
      }
      .font-display {
        font-family: "Oswald", system-ui, sans-serif;
        letter-spacing: 0.02em;
      }

      /* Fixed navbar enforcement: header must never push content down in normal flow */
      #main-nav {
        position: fixed !important;
        top: 0;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 50;
        box-sizing: border-box;
      }

      /* Theme utility classes */
      .theme-bg-primary {
        background-color: var(--color-bg-dark) !important;
      }
      .theme-bg-surface {
        background-color: var(--color-surface-dark) !important;
      }
      .theme-card {
        background-color: var(--color-surface-card) !important;
        border-color: rgba(255, 255, 255, 0.08) !important;
      }
      .theme-accent-bg {
        background-color: var(--color-accent) !important;
        color: #ffffff !important;
      }
      .theme-accent-bg:hover {
        background-color: var(--color-accent-hover) !important;
      }
      .theme-accent-text {
        color: var(--color-accent) !important;
      }
      .theme-accent-border {
        border-color: var(--color-accent) !important;
      }

      /* Hide scrollbar for Chrome, Safari, Opera and Firefox */
      .no-scrollbar::-webkit-scrollbar {
        display: none;
      }
      .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      /* Centered slider track with safe overflow alignment */
      .slider-track-centered {
        display: flex;
        justify-content: safe center;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        cursor: grab;
      }
      .slider-track-centered.active-drag {
        cursor: grabbing;
        user-select: none;
        scroll-snap-type: none;
      }

      /* Dynamic Corner Radius Enforcements (Square / Rounded / Pill) */
      .corner-square .theme-card,
      .corner-square .category-card,
      .corner-square .card-box,
      .corner-square article,
      .corner-square .rounded-xl,
      .corner-square .rounded-2xl,
      .corner-square .rounded-lg,
      .corner-square .rounded-md {
        border-radius: 0px !important;
      }
      .corner-square button,
      .corner-square .theme-accent-bg,
      .corner-square .sport-btn,
      .corner-square .mode-btn,
      .corner-square .dist-chip,
      .corner-square .mob-bottom-tab {
        border-radius: 0px !important;
      }

      .corner-pill .theme-card,
      .corner-pill .category-card {
        border-radius: 24px !important;
      }

      .corner-rounded .theme-card,
      .corner-rounded .category-card {
        border-radius: 12px !important;
      }

      /* Slider Slide Transitions */
      .hero-slide {
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .hero-slide.active-slide {
        opacity: 1;
        pointer-events: auto;
        transform: scale(1);
        z-index: 10;
      }
      .hero-slide.inactive-slide {
        opacity: 0;
        pointer-events: none;
        transform: scale(1.02);
        z-index: 1;
      }

      /* Liquid glass : built with https://vanta.supply/tools/glassmorphism-generator */
      /* Drawn for a navbar, 720x72px : the refraction filter's map is baked
         for that box. Different size? Regenerate at the tool rather than stretching. */
      .glass {
        /* The material, in numbers : retune here. */
        --glass-blur: 0px;
        --glass-saturate: 1;
        --glass-tint: rgba(255, 255, 255, 0.255);
        --glass-radius: 48px;

        box-sizing: border-box;
        -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
        backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
        background: var(--glass-tint);
        border-radius: var(--glass-radius);
        border: 1px solid rgba(255, 255, 255, 0.128);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.245);
      }

      /* The rim: a 1px gradient ring, light where the light is. */
      .glass::before {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.38) 0%,
          rgba(255, 255, 255, 0.16) 35%,
          rgba(255, 255, 255, 0.04) 65%,
          rgba(255, 255, 255, 0.22) 100%
        );
        -webkit-mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
      }

      /* The shine: an inner highlight along the top edge.
         Pseudo on a pseudo doesn't exist, so this is a child layer. */
      .glass > .glass-specular {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        overflow: hidden;
        pointer-events: none;
      }
      .glass > .glass-specular::before {
        content: "";
        position: absolute;
        top: 0;
        left: 24px;
        right: 24px;
        height: 50%;
        background: radial-gradient(
          ellipse at top,
          rgba(255, 255, 255, 0.42) 0%,
          rgba(255, 255, 255, 0) 70%
        );
      }

      /* The distortion: live refraction displacement map.
         Backdrop-filter: url(#id) needs an inline SVG with that filter in the DOM.
         Chromium desktop only (behind flag or recent build). Fallback to plain blur elsewhere. */
      @supports (background: paint(gg-glass-probe)) {
        .glass {
          -webkit-backdrop-filter: url(#gg-glass-filter) blur(var(--glass-blur)) saturate(var(--glass-saturate));
          backdrop-filter: url(#gg-glass-filter) blur(var(--glass-blur)) saturate(var(--glass-saturate));
        }
      }

      /* Accessibility: respect user choice on reduced transparency. */
      @media (prefers-reduced-transparency: reduce) {
        .glass {
          -webkit-backdrop-filter: none;
          backdrop-filter: none;
          background: #0f172a;
          border-color: rgba(255, 255, 255, 0.15);
        }
      }

      /* Transparent Gradient Navbar (Ironman Triathlon Style) */
      .nav-transparent-gradient {
        background: linear-gradient(180deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.45) 60%, rgba(0, 0, 0, 0) 100%) !important;
        background-color: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border-bottom: none !important;
        box-shadow: none !important;
      }
      .nav-transparent-gradient.scrolled {
        background: rgba(10, 17, 32, 0.96) !important;
        background-color: rgba(10, 17, 32, 0.96) !important;
        backdrop-filter: blur(12px) !important;
        -webkit-backdrop-filter: blur(12px) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25) !important;
      }

      /* Hero Stats Styling: Transparent Clean vs Boxed */
      .slide-stats.stats-transparent {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem 1.5rem;
      }
      .slide-stats.stats-transparent .stat-chip {
        display: inline-flex;
        align-items: baseline;
        gap: 0.375rem;
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
        backdrop-filter: none !important;
        box-shadow: none !important;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.9));
      }
      .slide-stats.stats-transparent .stat-chip:first-child .stat-divider {
        display: none;
      }
      .slide-stats.stats-transparent .stat-chip .stat-divider {
        display: inline;
        color: rgba(249, 115, 22, 0.7);
        font-weight: 700;
        margin-right: 0.5rem;
        user-select: none;
      }
      .slide-stats.stats-transparent .stat-chip .stat-label {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #cbd5e1;
      }
      .slide-stats.stats-transparent .stat-chip .stat-value {
        font-family: "Oswald", sans-serif;
        font-weight: 700;
        font-size: 0.9375rem;
        color: #ffffff;
        letter-spacing: 0.025em;
      }

      .slide-stats.stats-boxed {
        display: flex;
        flex-wrap: wrap;
        gap: 0.625rem;
      }
      .slide-stats.stats-boxed .stat-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 0.5rem;
