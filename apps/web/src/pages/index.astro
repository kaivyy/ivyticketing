        function getSavedConfig() {
          try {
            const raw = localStorage.getItem(HOMEPAGE_CONFIG_STORAGE_KEY);
            if (raw) {
              const parsed = JSON.parse(raw);
              return {
                brand: { ...defaultCfg.brand, ...(parsed.brand || {}) },
                navbar: { ...defaultCfg.navbar, ...(parsed.navbar || {}) },
                corners: { ...defaultCfg.corners, ...(parsed.corners || {}) },
                theme: { ...defaultCfg.theme, ...(parsed.theme || {}) },
                hero: {
                  ...defaultCfg.hero,
                  ...(parsed.hero || {}),
                  slides:
                    parsed.hero?.slides && parsed.hero.slides.length > 0
                      ? parsed.hero.slides
                      : defaultCfg.hero.slides,
                },
                features: {
                  showSportFilter: parsed.features?.showSportFilter !== false,
                },
              };
            }
          } catch (e) {
            // fallback
          }
          return defaultCfg;
        }

        // 1. Sinkronisasi Brand Navbar (icon_only, text_only, both)
        function applyBrandConfig(brand) {
          const iconWrapper = document.getElementById("nav-brand-icon-wrapper");
          const textWrapper = document.getElementById("nav-brand-text-wrapper");
          const titleEl = document.getElementById("nav-brand-title");
          const tagEl = document.getElementById("nav-brand-tagline");

          const mode = brand.displayMode || "icon_only";

          if (iconWrapper && textWrapper) {
            if (mode === "icon_only") {
              iconWrapper.classList.remove("hidden");
              textWrapper.classList.add("hidden");
            } else if (mode === "text_only") {
              iconWrapper.classList.add("hidden");
              textWrapper.classList.remove("hidden");
            } else {
              // "both"
              iconWrapper.classList.remove("hidden");
              textWrapper.classList.remove("hidden");
            }
          }

          if (titleEl && brand.brandName) {
            titleEl.innerHTML = brand.brandName.includes("Ivy")
              ? brand.brandName.replace("Ivy", 'Ivy<span class="brand-accent-highlight theme-accent-text">') + "</span>"
              : brand.brandName;
          }
          if (tagEl && brand.tagline) {
            tagEl.textContent = brand.tagline;
          }
        }

        // Helper fungsi konversi hex dan kalkulasi variasi warna
        function hexToRgb(hex) {
          if (!hex) return { r: 10, g: 17, b: 32 };
          let clean = String(hex).replace("#", "").trim();
          if (clean.length === 3) {
            clean = clean.split("").map((c) => c + c).join("");
          }
          const num = parseInt(clean, 16);
          if (isNaN(num)) return { r: 10, g: 17, b: 32 };
          return {
            r: (num >> 16) & 255,
            g: (num >> 8) & 255,
            b: num & 255,
          };
        }

        function adjustHexBrightness(hex, percent) {
          const { r, g, b } = hexToRgb(hex);
          const adjust = (val) => Math.min(255, Math.max(0, Math.round(val + (val * percent) / 100)));
          const nr = adjust(r).toString(16).padStart(2, "0");
          const ng = adjust(g).toString(16).padStart(2, "0");
          const nb = adjust(b).toString(16).padStart(2, "0");
          return `#${nr}${ng}${nb}`;
        }

        // 2. Sinkronisasi Bentuk, Transparansi & Efek Navbar
        function applyNavbarConfig(navCfg) {
          const nav = document.getElementById("main-nav");
          const specular = document.getElementById("main-nav-specular");
          const inner = document.getElementById("main-nav-inner");
          const mobileMenu = document.getElementById("mobile-menu");
          if (!nav) return;

          const isMobile = window.innerWidth < 1024;
          const style = navCfg?.style || "full_width";
          const op = navCfg.opacity !== undefined ? Number(navCfg.opacity) : 0.92;
          const blurMap = { none: "none", sm: "blur(4px)", md: "blur(12px)", lg: "blur(20px)" };
          const chosenBlur = blurMap[navCfg.blur || "md"] || "blur(12px)";
          const showBorder = navCfg.showBorder !== false;
          const isMenuOpen = mobileMenu && !mobileMenu.classList.contains("hidden");

          const currentTheme = getSavedConfig().theme || defaultCfg.theme;
          const bgRgb = hexToRgb(currentTheme.bgColor || "#0a1120");
          const navBg = `rgba(${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}, ${op})`;
          const navBgSolid = `rgba(${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}, 0.98)`;

          // Header navbar selalu fixed di viewport atas
          nav.style.position = "fixed";
          nav.style.zIndex = "50";

          if (style === "transparent_gradient") {
            nav.classList.remove("glass");
            nav.classList.add("nav-transparent-gradient");

            nav.style.top = "0";
            nav.style.left = "0";
            nav.style.right = "0";
            nav.style.transform = "none";
            nav.style.width = "100%";
            nav.style.maxWidth = "none";
            nav.style.minHeight = "64px";
            nav.style.borderRadius = "0";
            nav.style.overflow = "hidden";
            nav.style.border = "none";

            const updateTransparentScroll = () => {
              if (window.scrollY > 50) {
                nav.classList.add("scrolled");
              } else {
                nav.classList.remove("scrolled");
              }
            };

            window.addEventListener("scroll", updateTransparentScroll, { passive: true });
            updateTransparentScroll();

            if (specular) specular.classList.add("hidden");
            if (inner) {
              inner.style.maxWidth = "1280px";
              inner.style.padding = isMobile ? "0 16px" : "0 24px";
              inner.style.height = "64px";
            }

            if (mobileMenu) {
              mobileMenu.style.backgroundColor = navBgSolid;
              mobileMenu.style.borderTop = "1px solid rgba(255, 255, 255, 0.1)";
              mobileMenu.style.borderBottom = "none";
            }
          } else if (style === "liquid_glass") {
            nav.classList.remove("nav-transparent-gradient");
            nav.classList.remove("scrolled");
            nav.classList.add("glass");

            const gBlur = navCfg.glassBlur !== undefined ? Number(navCfg.glassBlur) : 0;
            const gSat = navCfg.glassSaturate !== undefined ? Number(navCfg.glassSaturate) : 1;
            const gTint = navCfg.glassTint || "rgba(255, 255, 255, 0.255)";
            const gRad = navCfg.glassRadius !== undefined ? Number(navCfg.glassRadius) : 48;

            nav.style.setProperty("--glass-blur", `${gBlur}px`);
            nav.style.setProperty("--glass-saturate", `${gSat}`);
            nav.style.setProperty("--glass-tint", gTint);
            nav.style.setProperty("--glass-radius", `${gRad}px`);

            if (isMobile) {
              nav.style.top = "12px";
              nav.style.left = "50%";
              nav.style.right = "auto";
              nav.style.transform = "translateX(-50%)";
              nav.style.width = "calc(100vw - 1.5rem)";
              nav.style.maxWidth = "720px";
              nav.style.minHeight = "64px";
              nav.style.borderRadius = isMenuOpen ? "24px" : `${gRad}px`;
              nav.style.overflow = "hidden";
              nav.style.boxShadow = "0 12px 32px rgba(0, 0, 0, 0.35)";
            } else {
              nav.style.top = "16px";
              nav.style.left = "50%";
              nav.style.right = "auto";
              nav.style.transform = "translateX(-50%)";
              nav.style.width = "min(720px, calc(100vw - 2rem))";
              nav.style.maxWidth = "720px";
              nav.style.minHeight = "72px";
              nav.style.borderRadius = `${gRad}px`;
              nav.style.overflow = "hidden";
              nav.style.boxShadow = "";
            }

            nav.style.border = "";
            nav.style.borderBottom = "";
            nav.style.backgroundColor = "";
            nav.style.backdropFilter = "";

            if (specular) specular.classList.remove("hidden");
            if (inner) {
              inner.style.maxWidth = "720px";
              inner.style.padding = isMobile ? "0 16px" : "0 20px";
              inner.style.height = isMobile ? "64px" : "72px";
            }

            if (mobileMenu) {
              mobileMenu.style.backgroundColor = navBgSolid;
              mobileMenu.style.borderTop = "1px solid rgba(255, 255, 255, 0.12)";
              mobileMenu.style.borderBottom = "none";
            }
          } else if (style === "floating_compact") {
            nav.classList.remove("nav-transparent-gradient");
            nav.classList.remove("scrolled");
            nav.classList.remove("glass");

            if (isMobile) {
              nav.style.top = "12px";
              nav.style.left = "50%";
              nav.style.right = "auto";
              nav.style.transform = "translateX(-50%)";
              nav.style.width = "calc(100vw - 1.5rem)";
              nav.style.maxWidth = "1152px";
              nav.style.minHeight = "64px";
              nav.style.borderRadius = "16px";
              nav.style.overflow = "hidden";
            } else {
              nav.style.top = "16px";
              nav.style.left = "50%";
              nav.style.right = "auto";
              nav.style.transform = "translateX(-50%)";
              nav.style.width = "min(1152px, calc(100vw - 2rem))";
              nav.style.maxWidth = "1152px";
              nav.style.minHeight = "64px";
              nav.style.borderRadius = "16px";
              nav.style.overflow = "hidden";
            }

            nav.style.backgroundColor = navBg;
            nav.style.backdropFilter = chosenBlur;
            nav.style.webkitBackdropFilter = chosenBlur;
            nav.style.border = showBorder ? "1px solid rgba(255, 255, 255, 0.12)" : "none";
            nav.style.boxShadow = "0 8px 30px rgba(0, 0, 0, 0.3)";

            if (specular) specular.classList.add("hidden");
            if (inner) {
              inner.style.maxWidth = "1152px";
              inner.style.padding = isMobile ? "0 16px" : "0 16px";
              inner.style.height = "64px";
            }

            if (mobileMenu) {
              mobileMenu.style.backgroundColor = navBgSolid;
              mobileMenu.style.borderTop = showBorder ? "1px solid rgba(255, 255, 255, 0.12)" : "none";
              mobileMenu.style.borderBottom = "none";
            }
          } else {
            // full_width
            nav.classList.remove("nav-transparent-gradient");
            nav.classList.remove("scrolled");
            nav.classList.remove("glass");

            nav.style.top = "0";
            nav.style.left = "0";
            nav.style.right = "0";
            nav.style.transform = "none";
            nav.style.width = "100%";
            nav.style.maxWidth = "none";
            nav.style.minHeight = "64px";
            nav.style.borderRadius = "0";
            nav.style.overflow = "hidden";
            nav.style.backgroundColor = navBg;
            nav.style.backdropFilter = chosenBlur;
            nav.style.webkitBackdropFilter = chosenBlur;
            nav.style.border = "none";
            nav.style.borderBottom = showBorder ? "1px solid rgba(255, 255, 255, 0.1)" : "none";
            nav.style.boxShadow = "none";

            if (specular) specular.classList.add("hidden");
            if (inner) {
              inner.style.maxWidth = "1280px";
              inner.style.padding = isMobile ? "0 16px" : "0 24px";
              inner.style.height = "64px";
            }

            if (mobileMenu) {
              mobileMenu.style.backgroundColor = navBgSolid;
              mobileMenu.style.borderTop = showBorder ? "1px solid rgba(255, 255, 255, 0.1)" : "none";
              mobileMenu.style.borderBottom = "none";
            }
          }

          // Kontrol visibilitas Mobile Bottom Navbar vs Top Bar
          const mobileNavType = navCfg?.mobileNavType || "bottom_nav";
          const bottomNav = document.getElementById("mobile-bottom-nav");
          const menuBtn = document.getElementById("mobile-menu-btn");

          if (isMobile) {
            if (mobileNavType === "bottom_nav") {
              if (bottomNav) bottomNav.classList.remove("hidden");
              if (menuBtn) menuBtn.classList.add("hidden");
              if (mobileMenu) mobileMenu.classList.add("hidden");
            } else {
              if (bottomNav) bottomNav.classList.add("hidden");
              if (menuBtn) menuBtn.classList.remove("hidden");
            }
          } else {
            if (bottomNav) bottomNav.classList.add("hidden");
            if (menuBtn) menuBtn.classList.add("hidden");
            if (mobileMenu) mobileMenu.classList.add("hidden");
          }
        }

        // 3. Sinkronisasi Gaya Sudut Elemen (Kotak Tegas / Rounded / Pill)
        function applyCornerConfig(cornerCfg) {
          const cornerStyle = cornerCfg?.style || "square";
          document.body.classList.remove("corner-square", "corner-rounded", "corner-pill");
          document.body.classList.add(`corner-${cornerStyle}`);
        }

        // 3. Sinkronisasi Tema Global Website
        function applyThemeConfig(themeCfg) {
          if (!themeCfg) return;
          const bg = themeCfg.bgColor || "#0a1120";
          const surface = themeCfg.surfaceColor || "#101a2e";
          const text = themeCfg.textColor || "#f8fafc";
          const accent = themeCfg.accentColor || "#ea580c";
          const accentHover = adjustHexBrightness(accent, -15);
          const cardBg = adjustHexBrightness(surface, 12);

          const bgRgb = hexToRgb(bg);
          const surfaceRgb = hexToRgb(surface);
          const cardRgb = hexToRgb(cardBg);
          const accentRgb = hexToRgb(accent);

          const root = document.documentElement;
          root.style.setProperty("--color-bg-dark", bg);
          root.style.setProperty("--color-bg-rgb", `${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}`);
          root.style.setProperty("--color-surface-dark", surface);
          root.style.setProperty("--color-surface-rgb", `${surfaceRgb.r}, ${surfaceRgb.g}, ${surfaceRgb.b}`);
          root.style.setProperty("--color-surface-card", cardBg);
          root.style.setProperty("--color-surface-card-rgb", `${cardRgb.r}, ${cardRgb.g}, ${cardRgb.b}`);
          root.style.setProperty("--color-accent", accent);
          root.style.setProperty("--color-accent-rgb", `${accentRgb.r}, ${accentRgb.g}, ${accentRgb.b}`);
          root.style.setProperty("--color-accent-hover", accentHover);
          root.style.setProperty("--color-text", text);

          document.body.style.backgroundColor = bg;
          document.body.style.color = text;

          // Update brand accent highlight
          document.querySelectorAll(".brand-accent-highlight").forEach((el) => {
            el.style.color = accent;
          });

          // Update slide overlay gradients to match theme background color
          document.querySelectorAll(".slide-overlay-bg").forEach((el) => {
            const img = el.getAttribute("data-bg-img") || "";
            el.style.backgroundImage = `linear-gradient(180deg, rgba(${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}, 0.72) 0%, rgba(${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}, 0.88) 60%, rgba(${bgRgb.r}, ${bgRgb.g}, ${bgRgb.b}, 0.98) 100%), url('${img}')`;
          });

          // Refresh navbar color with new theme bg
          const navCfg = getSavedConfig().navbar;
          if (navCfg) {
            applyNavbarConfig(navCfg);
          }
        }

        // 3. Hero Slider Logic
        let currentSlide = 0;
        let slideTimer = null;
        let totalSlides = defaultCfg.hero.slides.length;

        function showSlide(index) {
          const slides = document.querySelectorAll(".hero-slide");
          const dots = document.querySelectorAll(".slider-dot-btn");
          const counter = document.getElementById("slider-counter");
          if (!slides || slides.length === 0) return;

          totalSlides = slides.length;
          currentSlide = (index + totalSlides) % totalSlides;

          slides.forEach((sl, idx) => {
            if (idx === currentSlide) {
              sl.classList.remove("inactive-slide");
              sl.classList.add("active-slide");
            } else {
              sl.classList.remove("active-slide");
              sl.classList.add("inactive-slide");
            }
          });

          dots.forEach((dot, idx) => {
            if (idx === currentSlide) {
              dot.classList.remove("w-2", "bg-slate-700");
              dot.classList.add("w-8");
              dot.style.backgroundColor = "var(--color-accent)";
              dot.setAttribute("aria-selected", "true");
            } else {
              dot.classList.remove("w-8");
              dot.classList.add("w-2", "bg-slate-700");
              dot.style.backgroundColor = "";
              dot.setAttribute("aria-selected", "false");
            }
          });

          if (counter) {
            const curStr = String(currentSlide + 1).padStart(2, "0");
            const totStr = String(totalSlides).padStart(2, "0");
            counter.textContent = `${curStr} / ${totStr}`;
          }
        }

        function nextSlide() {
          showSlide(currentSlide + 1);
        }

        function prevSlide() {
          showSlide(currentSlide - 1);
        }

        function startAutoplay(intervalSeconds) {
          stopAutoplay();
          const sec = intervalSeconds && intervalSeconds >= 2 ? intervalSeconds : 5;
          slideTimer = setInterval(nextSlide, sec * 1000);
        }

        function stopAutoplay() {
          if (slideTimer) {
            clearInterval(slideTimer);
            slideTimer = null;
          }
        }

        // Bind Arrow Navigation
        const prevBtn = document.getElementById("slider-prev-btn");
        const nextBtn = document.getElementById("slider-next-btn");
        if (prevBtn) {
          prevBtn.addEventListener("click", () => {
            prevSlide();
            stopAutoplay();
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener("click", () => {
            nextSlide();
            stopAutoplay();
          });
        }

        // Bind Dot Navigation
        document.querySelectorAll(".slider-dot-btn").forEach((dot) => {
          dot.addEventListener("click", () => {
            const target = Number(dot.getAttribute("data-target-slide"));
            if (!isNaN(target)) {
              showSlide(target);
              stopAutoplay();
            }
          });
        });

        // Pause autoplay on mouse hover over slider
        const sliderSec = document.getElementById("hero-slider-section");
        if (sliderSec) {
          sliderSec.addEventListener("mouseenter", stopAutoplay);
          sliderSec.addEventListener("mouseleave", () => {
            const cfg = getSavedConfig();
            if (cfg.hero.autoplay !== false) {
              startAutoplay(cfg.hero.intervalSeconds);
            }
          });
        }

        // Keyboard navigation (ArrowLeft & ArrowRight)
        window.addEventListener("keydown", (e) => {
          if (e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA")) return;
          if (e.key === "ArrowLeft") {
            prevSlide();
          } else if (e.key === "ArrowRight") {
            nextSlide();
          }
        });

        // Touch swipe navigation for mobile screens
        if (sliderSec) {
          let touchStartX = 0;
          let touchStartY = 0;
          let touchEndX = 0;
          let touchEndY = 0;

          sliderSec.addEventListener(
            "touchstart",
            (e) => {
              if (e.touches && e.touches.length === 1) {
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
                touchEndX = touchStartX;
                touchEndY = touchStartY;
              }
            },
            { passive: true }
          );

          sliderSec.addEventListener(
            "touchmove",
            (e) => {
              if (e.touches && e.touches.length === 1) {
                touchEndX = e.touches[0].clientX;
                touchEndY = e.touches[0].clientY;
              }
            },
            { passive: true }
          );

          sliderSec.addEventListener(
            "touchend",
            () => {
              const diffX = touchEndX - touchStartX;
              const diffY = touchEndY - touchStartY;
              if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY) * 1.3) {
                if (diffX < 0) {
                  nextSlide();
                  stopAutoplay();
                } else {
                  prevSlide();
                  stopAutoplay();
                }
              }
            },
            { passive: true }
          );
        }

        function applyFeaturesConfig(features) {
          const filterContainer = document.getElementById("homepage-sport-filter-container");
          if (filterContainer) {
            if (features && features.showSportFilter === false) {
              filterContainer.classList.add("hidden");
            } else {
              filterContainer.classList.remove("hidden");
            }
          }
        }

        // 2b. Sinkronisasi Visual Hero (Overlay Darkness, Tipografi Keterangan, Posisi Foto & Blur Gradien)
        function applyHeroConfig(heroCfg) {
          if (!heroCfg) return;
          const darkness = heroCfg.overlayDarkness !== undefined ? Number(heroCfg.overlayDarkness) : 0.35;
          const statsStyle = heroCfg.statsStyle || "transparent";
          const imagePos = heroCfg.imagePosition || "top";
          const bottomBlur = heroCfg.bottomBlur !== false;

          const topA = Math.min(0.20, Number((darkness * 0.15).toFixed(2)));
          const midA = Number((darkness * 0.35).toFixed(2));
          const botA = Math.min(0.95, Number((darkness * 1.9).toFixed(2)));

          document.querySelectorAll(".slide-overlay-bg").forEach((bgEl) => {
            const bgImg = bgEl.getAttribute("data-bg-img") || "";
            const el = bgEl;
            el.style.backgroundImage = `linear-gradient(180deg, rgba(10, 17, 32, ${topA}) 0%, rgba(10, 17, 32, ${midA}) 35%, rgba(10, 17, 32, ${botA}) 100%), url('${bgImg}')`;
            el.style.backgroundPosition = imagePos === "top" ? "center top" : "center center";
          });

          const blurEls = document.querySelectorAll(".hero-bottom-gradient-layer, #hero-bottom-gradient-blur");
          blurEls.forEach((el) => {
            if (bottomBlur) {
              el.classList.remove("hidden", "opacity-0");
              el.classList.add("opacity-100");
            } else {
              el.classList.remove("opacity-100");
              el.classList.add("opacity-0", "hidden");
            }
          });

          document.querySelectorAll(".slide-stats").forEach((statsEl) => {
            if (statsStyle === "transparent") {
              statsEl.classList.remove("stats-boxed");
              statsEl.classList.add("stats-transparent");
            } else {
              statsEl.classList.remove("stats-transparent");
              statsEl.classList.add("stats-boxed");
            }
          });

          const showHeroTags = heroCfg.showTags === true;
          if (heroCfg.slides && Array.isArray(heroCfg.slides)) {
            heroCfg.slides.forEach((sl, idx) => {
              const slideEl = document.querySelector(`.hero-slide[data-slide-index="${idx}"]`);
              if (slideEl) {
                const badgeEl = slideEl.querySelector(".slide-badge");
                if (badgeEl) {
                  if (!showHeroTags || !sl.tag || !sl.tag.trim()) {
                    badgeEl.classList.add("hidden");
                  } else {
                    badgeEl.classList.remove("hidden");
                    const spanEl = badgeEl.querySelector("span");
                    if (spanEl) {
                      spanEl.textContent = sl.tag;
                      if (sl.tagColor) spanEl.className = `px-2.5 py-0.5 rounded text-[11px] ${sl.tagColor}`;
                    }
                  }
                }

                const subEl = slideEl.querySelector(".slide-subtitle");
                if (subEl) {
                  if (sl.showSubtitle === false) {
                    subEl.classList.add("hidden");
                  } else {
                    subEl.classList.remove("hidden");
                  }
                }
              }
            });
          }
        }

        // Inisialisasi Tampilan Berdasarkan Konfigurasi
        function initFromConfig() {
          const cfg = getSavedConfig();
          applyBrandConfig(cfg.brand);
          applyNavbarConfig(cfg.navbar);
          applyCornerConfig(cfg.corners);
          applyThemeConfig(cfg.theme);
          applyFeaturesConfig(cfg.features);
          applyHeroConfig(cfg.hero);

          if (cfg.hero.mode === "single") {
            // Tampilkan slide pertama saja, sembunyikan navigasi
            showSlide(0);
            stopAutoplay();
            if (prevBtn) prevBtn.classList.add("hidden");
            if (nextBtn) nextBtn.classList.add("hidden");
            const dotsEl = document.getElementById("slider-dots");
            if (dotsEl) dotsEl.classList.add("hidden");
            const counterEl = document.getElementById("slider-counter");
            if (counterEl) counterEl.classList.add("hidden");
          } else {
            if (prevBtn) prevBtn.classList.remove("hidden");
            if (nextBtn) nextBtn.classList.remove("hidden");
            const dotsEl = document.getElementById("slider-dots");
            if (dotsEl) dotsEl.classList.remove("hidden");
            const counterEl = document.getElementById("slider-counter");
            if (counterEl) counterEl.classList.remove("hidden");

            showSlide(0);
            if (cfg.hero.autoplay !== false) {
              startAutoplay(cfg.hero.intervalSeconds);
            }
          }
        }

        // Dengarkan Perubahan dari Admin Customizer (Live Event)
        window.addEventListener("ivy:homepage_config_changed", (ev) => {
          if (ev.detail) {
            applyBrandConfig(ev.detail.brand || defaultCfg.brand);
            applyNavbarConfig(ev.detail.navbar || defaultCfg.navbar);
            applyCornerConfig(ev.detail.corners || defaultCfg.corners);
            applyThemeConfig(ev.detail.theme || defaultCfg.theme);
            applyFeaturesConfig(ev.detail.features);
            applyHeroConfig(ev.detail.hero);
            if (ev.detail.hero) {
              if (ev.detail.hero.mode === "single") {
                stopAutoplay();
                showSlide(0);
              } else if (ev.detail.hero.autoplay !== false) {
                startAutoplay(ev.detail.hero.intervalSeconds);
              } else {
                stopAutoplay();
              }
            }
          }
        });

        // Jalankan inisialisasi awal
        initFromConfig();

        // Sinkronisasi konfigurasi dari server agar perubahan admin desktop otomatis tampil di mobile
        fetch("/platform-config.json", { cache: "no-store" })
          .then((res) => (res.ok ? res.json() : null))
          .then((remoteCfg) => {
            if (remoteCfg && remoteCfg.navbar) {
              const current = getSavedConfig();
              const merged = {
                brand: { ...current.brand, ...(remoteCfg.brand || {}) },
                navbar: { ...current.navbar, ...(remoteCfg.navbar || {}) },
                corners: { ...current.corners, ...(remoteCfg.corners || {}) },
                theme: { ...current.theme, ...(remoteCfg.theme || {}) },
                hero: { ...current.hero, ...(remoteCfg.hero || {}) },
              };
              localStorage.setItem(HOMEPAGE_CONFIG_STORAGE_KEY, JSON.stringify(merged));
              initFromConfig();
            }
          })
          .catch(() => {});

        // 4. Mobile Menu Toggle & Live Sync
        function updateNavRadiusForMenu(isOpen) {
          const nav = document.getElementById("main-nav");
          if (!nav) return;
          const cfg = getSavedConfig();
          const style = cfg.navbar?.style || "full_width";
          const isMobile = window.innerWidth < 1024;
          if (style === "liquid_glass") {
            const gRad = cfg.navbar?.glassRadius !== undefined ? Number(cfg.navbar.glassRadius) : 48;
            nav.style.borderRadius = (isOpen && isMobile) ? "24px" : `${gRad}px`;
          } else if (style === "floating_compact") {
            nav.style.borderRadius = "16px";
          } else {
            nav.style.borderRadius = "0";
          }
        }

        const menuBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const iconOpen = document.getElementById("menu-icon-open");
        const iconClose = document.getElementById("menu-icon-close");

        if (menuBtn && mobileMenu) {
          menuBtn.addEventListener("click", () => {
            const isOpen = !mobileMenu.classList.contains("hidden");
            if (isOpen) {
              mobileMenu.classList.add("hidden");
              menuBtn.setAttribute("aria-expanded", "false");
              iconOpen?.classList.remove("hidden");
              iconClose?.classList.add("hidden");
              updateNavRadiusForMenu(false);
            } else {
              mobileMenu.classList.remove("hidden");
              menuBtn.setAttribute("aria-expanded", "true");
              iconOpen?.classList.add("hidden");
              iconClose?.classList.remove("hidden");
              updateNavRadiusForMenu(true);
            }
          });

          document.querySelectorAll(".mobile-nav-link").forEach((link) => {
            link.addEventListener("click", () => {
              mobileMenu.classList.add("hidden");
              menuBtn.setAttribute("aria-expanded", "false");
              iconOpen?.classList.remove("hidden");
              iconClose?.classList.add("hidden");
              updateNavRadiusForMenu(false);
            });
          });

          document.addEventListener("click", (e) => {
            if (!mobileMenu.classList.contains("hidden")) {
              const nav = document.getElementById("main-nav");
              if (nav && !nav.contains(e.target)) {
                mobileMenu.classList.add("hidden");
                menuBtn.setAttribute("aria-expanded", "false");
                iconOpen?.classList.remove("hidden");
                iconClose?.classList.add("hidden");
                updateNavRadiusForMenu(false);
              }
            }
          });
        }

        // Sinkronisasi live saat window resize atau perubahan config dari tab lain
        window.addEventListener("resize", () => {
          const cfg = getSavedConfig();
          applyNavbarConfig(cfg.navbar);
        });

        window.addEventListener("storage", (e) => {
          if (e.key === HOMEPAGE_CONFIG_STORAGE_KEY) {
            initFromConfig();
          }
        });

        // 5. Interaksi Drag & Scroll Slider Carousel (Desktop & Mobile)
        const eventTrack = document.getElementById("events-slider-track");
        const catTrack = document.getElementById("categories-slider-track");
        const eventDotsContainer = document.getElementById("events-slider-dots");
        const catDotsContainer = document.getElementById("categories-slider-dots");

        function scrollCardToCenter(track, card) {
          if (!track || !card) return;
          const trackCenter = track.clientWidth / 2;
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const targetScrollLeft = cardCenter - trackCenter;
          track.scrollTo({
            left: Math.max(0, targetScrollLeft),
            behavior: "smooth",
          });
        }

        function enableDragToScroll(slider) {
          if (!slider) return;
          let isDown = false;
          let startX = 0;
          let scrollLeft = 0;
          let hasDragged = false;

          slider.addEventListener("mousedown", (e) => {
            isDown = true;
            hasDragged = false;
            slider.classList.add("active-drag");
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
          });

          slider.addEventListener("mouseleave", () => {
            isDown = false;
            slider.classList.remove("active-drag");
          });

          slider.addEventListener("mouseup", () => {
            isDown = false;
            slider.classList.remove("active-drag");
          });

          slider.addEventListener("mousemove", (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX) * 1.5;
            if (Math.abs(walk) > 5) {
              hasDragged = true;
            }
            slider.scrollLeft = scrollLeft - walk;
          });

          // Cegah aksi klik jika pengguna sedang menggeser mouse
          slider.addEventListener(
            "click",
            (e) => {
              if (hasDragged) {
                e.preventDefault();
                e.stopPropagation();
                hasDragged = false;
              }
            },
            true
          );
        }

        enableDragToScroll(eventTrack);
        enableDragToScroll(catTrack);

        // 6. Dot Pagination Navigasi Event Pilihan (Model Indonesia Marathon)
        const eventCards = eventTrack ? Array.from(eventTrack.querySelectorAll(".event-slide-card")) : [];

        function updateEventDots() {
          if (!eventTrack || !eventDotsContainer) return;
          const dots = Array.from(eventDotsContainer.querySelectorAll(".event-dot-btn"));
          if (!eventCards.length || !dots.length) return;

          const trackCenter = eventTrack.scrollLeft + eventTrack.clientWidth / 2;
          let closestIndex = 0;
          let minDiff = Infinity;

          eventCards.forEach((card, idx) => {
            const cardCenter = card.offsetLeft + card.offsetWidth / 2;
            const diff = Math.abs(trackCenter - cardCenter);
            if (diff < minDiff) {
              minDiff = diff;
              closestIndex = idx;
            }
          });

          dots.forEach((dot, idx) => {
            const pill = dot.querySelector(".carousel-dot-pill");
            const isActive = idx === closestIndex;
            dot.setAttribute("aria-current", isActive ? "true" : "false");
            if (pill) {
              if (isActive) {
                pill.classList.remove("w-1.5", "bg-white/30", "group-hover:bg-white/60");
                pill.classList.add("w-6", "theme-accent-bg");
                pill.style.backgroundColor = "var(--color-accent)";
              } else {
                pill.classList.remove("w-6", "theme-accent-bg");
                pill.classList.add("w-1.5", "bg-white/30", "group-hover:bg-white/60");
                pill.style.backgroundColor = "";
              }
            }
          });
        }

        if (eventDotsContainer && eventTrack) {
          const dots = eventDotsContainer.querySelectorAll(".event-dot-btn");
          dots.forEach((dot) => {
            dot.addEventListener("click", () => {
              const idx = parseInt(dot.getAttribute("data-slide-index") || "0", 10);
              if (eventCards[idx]) {
                scrollCardToCenter(eventTrack, eventCards[idx]);
              }
            });
          });

          let eventTicking = false;
          eventTrack.addEventListener(
            "scroll",
            () => {
              if (!eventTicking) {
                window.requestAnimationFrame(() => {
                  updateEventDots();
                  eventTicking = false;
                });
                eventTicking = true;
              }
            },
            { passive: true }
          );

          window.addEventListener("resize", updateEventDots);
        }

        // 7. Dot Pagination Navigasi Kategori Lomba & Filter Cabang Olahraga
        function getVisibleCategoryCards() {
          if (!catTrack) return [];
          return Array.from(catTrack.querySelectorAll(".category-card:not(.hidden)"));
        }

        function renderCategoryDots() {
          if (!catTrack || !catDotsContainer) return;
          const visibleCards = getVisibleCategoryCards();
          catDotsContainer.innerHTML = "";

          visibleCards.forEach((card, idx) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "category-dot-btn flex h-8 w-6 sm:w-8 items-center justify-center cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded-full";
            btn.setAttribute("aria-label", `Slide ${idx + 1}`);
            btn.setAttribute("aria-current", idx === 0 ? "true" : "false");
            btn.dataset.slideIndex = String(idx);

            const pill = document.createElement("span");
            pill.className = `carousel-dot-pill h-1.5 block rounded-full transition-all duration-300 ${
              idx === 0 ? "w-6 theme-accent-bg" : "w-1.5 bg-white/30 group-hover:bg-white/60"
            }`;
            if (idx === 0) {
              pill.style.backgroundColor = "var(--color-accent)";
            }

            btn.appendChild(pill);
            btn.addEventListener("click", () => {
              scrollCardToCenter(catTrack, card);
            });

            catDotsContainer.appendChild(btn);
          });

          updateCategoryDots();
        }

        function updateCategoryDots() {
          if (!catTrack || !catDotsContainer) return;
          const visibleCards = getVisibleCategoryCards();
          const dots = Array.from(catDotsContainer.querySelectorAll(".category-dot-btn"));
          if (!visibleCards.length || !dots.length) return;

          const trackCenter = catTrack.scrollLeft + catTrack.clientWidth / 2;
          let closestIndex = 0;
          let minDiff = Infinity;

          visibleCards.forEach((card, idx) => {
            const cardCenter = card.offsetLeft + card.offsetWidth / 2;
            const diff = Math.abs(trackCenter - cardCenter);
            if (diff < minDiff) {
              minDiff = diff;
              closestIndex = idx;
            }
          });

          dots.forEach((dot, idx) => {
            const pill = dot.querySelector(".carousel-dot-pill");
            const isActive = idx === closestIndex;
            dot.setAttribute("aria-current", isActive ? "true" : "false");
            if (pill) {
              if (isActive) {
                pill.classList.remove("w-1.5", "bg-white/30", "group-hover:bg-white/60");
                pill.classList.add("w-6", "theme-accent-bg");
                pill.style.backgroundColor = "var(--color-accent)";
              } else {
                pill.classList.remove("w-6", "theme-accent-bg");
                pill.classList.add("w-1.5", "bg-white/30", "group-hover:bg-white/60");
                pill.style.backgroundColor = "";
              }
            }
          });
        }

        if (catDotsContainer && catTrack) {
          const initialDots = catDotsContainer.querySelectorAll(".category-dot-btn");
          const initialCards = getVisibleCategoryCards();
          initialDots.forEach((dot, idx) => {
            dot.addEventListener("click", () => {
              if (initialCards[idx]) {
                scrollCardToCenter(catTrack, initialCards[idx]);
              }
            });
          });

          let catTicking = false;
          catTrack.addEventListener(
            "scroll",
            () => {
              if (!catTicking) {
                window.requestAnimationFrame(() => {
                  updateCategoryDots();
                  catTicking = false;
                });
                catTicking = true;
              }
            },
            { passive: true }
          );

          window.addEventListener("resize", updateCategoryDots);
        }

        // Filter Cabang Olahraga Interaktif
        const filterButtons = document.querySelectorAll(".sport-filter-btn");
        const cards = document.querySelectorAll(".category-card");

        filterButtons.forEach((button) => {
          button.addEventListener("click", () => {
            const selectedSport = button.getAttribute("data-sport");

            filterButtons.forEach((btn) => {
              btn.classList.remove("active", "theme-accent-bg", "theme-accent-border", "text-white");
              btn.classList.add("bg-slate-800/80", "border-slate-700", "text-slate-300");
              btn.style.backgroundColor = "";
              btn.style.borderColor = "";
            });
            button.classList.add("active", "theme-accent-bg", "theme-accent-border", "text-white");
            button.classList.remove("bg-slate-800/80", "border-slate-700", "text-slate-300");
            button.style.backgroundColor = "var(--color-accent)";
            button.style.borderColor = "var(--color-accent)";

            cards.forEach((card) => {
              const cardSport = card.getAttribute("data-sport");
              if (selectedSport === "all" || cardSport === selectedSport) {
                card.classList.remove("hidden");
              } else {
                card.classList.add("hidden");
              }
            });

            // Kembalikan slider ke posisi awal saat filter berganti dan update dots
            if (catTrack) {
              catTrack.scrollTo({ left: 0, behavior: "smooth" });
              renderCategoryDots();
            }
          });
        });
      })();
    </script>
  </body>
</html>
